	СУММА(ВЫБОР
			КОГДА ЕСТЬNULL(ПартииТоваровБезДокументаОприходования.КоличествоОстаток, 1) = 0
				ТОГДА ЕСТЬNULL(ТоварыПереданныеОстатки.КоличествоОстаток, 0) * ЕСТЬNULL(ПартииТоваровПереданныеОстатки.Номенклатура.ЕдиницаХраненияОстатков.Коэффициент, 1)
			ИНАЧЕ ЕСТЬNULL(ТоварыПереданныеОстатки.КоличествоОстаток, 0) * ЕСТЬNULL(ПартииТоваровПереданныеОстатки.Номенклатура.ЕдиницаХраненияОстатков.Коэффициент, 1) / ЕСТЬNULL(ПартииТоваровБезДокументаОприходования.КоличествоОстаток, 1)
		КОНЕЦ * ЕСТЬNULL(ПартииТоваровПереданныеОстатки.КоличествоОстаток, 1)) КАК Количество,
	максимум(ЕСТЬNULL(ТоварыПереданныеОстатки.КоличествоОстаток, 0)) КАК КоличествоОстатковПереданныхТоваров,
	максимум(ЕСТЬNULL(ПартииТоваровПереданныеОстатки.КоличествоОстаток, 1)) КАК ОстатокПоПартиям,
	максимум(ЕСТЬNULL(ПартииТоваровБезДокументаОприходования.КоличествоОстаток, 1)) КАК КоличествоБезДокументовОприходования,
	максимум(ВЫБОР
			КОГДА ЕСТЬNULL(ПартииТоваровПереданныеОстатки.КоличествоОстаток, 0) = 0
				ТОГДА 0
			ИНАЧЕ ЕСТЬNULL(ПартииТоваровПереданныеОстатки.СтоимостьОстаток, 0) * ЕСТЬNULL(ТоварыПереданныеОстатки.КоличествоОстаток, 0) / ПартииТоваровПереданныеОстатки.КоличествоОстаток
		КОНЕЦ) КАК Сумма,
	максимум(ВЫБОР
			КОГДА ЕСТЬNULL(ПартииТоваровПереданныеОстатки.КоличествоОстаток, 0) = 0
				ТОГДА 0
			ИНАЧЕ ЕСТЬNULL(ПартииТоваровПереданныеОстатки.СтоимостьОстаток, 0) * ЕСТЬNULL(ТоварыПереданныеОстатки.КоличествоОстаток, 0) / ПартииТоваровПереданныеОстатки.КоличествоОстаток
		КОНЕЦ * ВЫБОР
			КОГДА ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 0) &gt; 0
					И ЕСТЬNULL(КурсыВалютСрезПоследних.Кратность, 0) &gt; 0
				ТОГДА КурсыВалютСрезПоследних.Курс / КурсыВалютСрезПоследних.Кратность
			ИНАЧЕ 0
		КОНЕЦ) КАК СуммаСНДСРегл,
	ЕСТЬNULL(ТоварыПереданныеОстатки.СерияНоменклатуры.НомерГТД, ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка)) КАК НомерГТД,
	ЕСТЬNULL(ТоварыПереданныеОстатки.СерияНоменклатуры.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)) КАК СтранаПроисхождения,
	ЕСТЬNULL(ТоварыПереданныеОстатки.СерияНоменклатуры.ПометкаУдаления, ЛОЖЬ) КАК ПометкаУдаления,
	ПартииТоваровПереданныеОстатки.ДокументОприходования КАК ДокументОприходования
ПОМЕСТИТЬ ВсеЗаписи
ИЗ
	РегистрНакопления.ПартииТоваровПереданные.Остатки(&amp;ДатаОстатков, СтатусПередачи = ЗНАЧЕНИЕ(Перечисление.СтатусыПолученияПередачиТоваров.НаКомиссию)) КАК ПартииТоваровПереданныеОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ ТоварыПереданныеОстатки КАК ТоварыПереданныеОстатки
		ПО ПартииТоваровПереданныеОстатки.Номенклатура = ТоварыПереданныеОстатки.Номенклатура
			И ПартииТоваровПереданныеОстатки.ХарактеристикаНоменклатуры = ТоварыПереданныеОстатки.ХарактеристикаНоменклатуры
			И ПартииТоваровПереданныеОстатки.ДоговорКонтрагента = ТоварыПереданныеОстатки.ДоговорКонтрагента
			И ПартииТоваровПереданныеОстатки.ДокументПередачи.Организация = ТоварыПереданныеОстатки.Организация
		ЛЕВОЕ СОЕДИНЕНИЕ ПартииТоваровБезДокументаОприходования КАК ПартииТоваровБезДокументаОприходования
		ПО ПартииТоваровПереданныеОстатки.Номенклатура = ПартииТоваровБезДокументаОприходования.Номенклатура
			И ПартииТоваровПереданныеОстатки.ХарактеристикаНоменклатуры = ПартииТоваровБезДокументаОприходования.ХарактеристикаНоменклатуры
			И ПартииТоваровПереданныеОстатки.ДоговорКонтрагента = ПартииТоваровБезДокументаОприходования.ДоговорКонтрагента
			И ПартииТоваровПереданныеОстатки.ДокументПередачи.Организация = ПартииТоваровБезДокументаОприходования.Организация
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&amp;ДатаОстатков, Валюта = &amp;ВалютаУпрУчета) КАК КурсыВалютСрезПоследних
		ПО (ИСТИНА)

СГРУППИРОВАТЬ ПО
	ПартииТоваровПереданныеОстатки.ДоговорКонтрагента,
	ПартииТоваровПереданныеОстатки.Номенклатура,
	ЕСТЬNULL(ПартииТоваровПереданныеОстатки.ДокументПередачи.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)),
	ПартииТоваровПереданныеОстатки.ХарактеристикаНоменклатуры,
	ЕСТЬNULL(ТоварыПереданныеОстатки.СерияНоменклатуры.НомерГТД, ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка)),
	ПартииТоваровПереданныеОстатки.ДокументОприходования,
	ЕСТЬNULL(ТоварыПереданныеОстатки.СерияНоменклатуры.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)),
	ЕСТЬNULL(ТоварыПереданныеОстатки.СерияНоменклатуры.ПометкаУдаления, ЛОЖЬ),
	ЕСТЬNULL(ПартииТоваровПереданныеОстатки.ДоговорКонтрагента.Владелец, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)),
	ЕСТЬNULL(ПартииТоваровПереданныеОстатки.ДоговорКонтрагента.ВалютаВзаиморасчетов, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)),
	ПартииТоваровПереданныеОстатки.Номенклатура.СтавкаНДС
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВсеЗаписи.Организация КАК Организация,
	ВсеЗаписи.Контрагент КАК Контрагент,
	ВсеЗаписи.ВалютаВзаиморасчетов,
	ВсеЗаписи.ДоговорКонтрагента КАК ДоговорКонтрагента,
	ВсеЗаписи.Номенклатура,
	ВсеЗаписи.СтавкаНДС,
	ВсеЗаписи.ХарактеристикаНоменклатуры КАК Характеристика,
	ВсеЗаписи.Количество,
	выбор когда ВсеЗаписи.КоличествоБезДокументовОприходования = 0 Тогда
	0 иначе ВсеЗаписи.Количество*ВсеЗаписи.Сумма/ВсеЗаписи.КоличествоБезДокументовОприходования конец как Сумма,
	выбор когда ВсеЗаписи.КоличествоБезДокументовОприходования = 0 тогда
	0
	иначе
	ВсеЗаписи.Количество*ВсеЗаписи.СуммаСНДСРегл/ВсеЗаписи.КоличествоБезДокументовОприходования конец как СуммаСНДСРегл,
	ВсеЗаписи.НомерГТД,
	ВсеЗаписи.СтранаПроисхождения,
	ВсеЗаписи.ПометкаУдаления,
	ВсеЗаписи.ДокументОприходования КАК ДокументОприходования,
	ВсеЗаписи.КоличествоОстатковПереданныхТоваров,
	ВсеЗаписи.КоличествоБезДокументовОприходования,
	ВсеЗаписи.ОстатокПоПартиям
ИЗ
	ВсеЗаписи КАК ВсеЗаписи

УПОРЯДОЧИТЬ ПО
	Организация,
	Контрагент,
	ДоговорКонтрагента,
	ДокументОприходования,
	ВсеЗаписи.Номенклатура.Наименование,
	ВсеЗаписи.ХарактеристикаНоменклатуры.Наименование</Текст>
		</Запрос>
		<Запрос Имя="УчетнаяПолитикаНалоговыйУчет" ИспользуетсяПриЗагрузке="false">
			<Текст>ВЫБРАТЬ
	УчетнаяПолитикаНалоговыйУчетСрезПоследних.ОрганизацияНеЯвляетсяПлательщикомНДС КАК БезНДС
ИЗ
	РегистрСведений.УчетнаяПолитикаНалоговыйУчет.СрезПоследних(&amp;ДатаДокумента, Организация = &amp;Организация) КАК УчетнаяПолитикаНалоговыйУчетСрезПоследних</Текст>
		</Запрос>
	</Запросы>
</ПравилаОбмена>