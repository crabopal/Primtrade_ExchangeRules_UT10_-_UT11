				МассивСтрок = КоллекцияОбъектов.НайтиСтроки(Ключ);
				КолВоРезерв = ДокРезерва.Количество*ДокРезерва.Коэффициент;
	
					Для каждого Рез Из МассивСтрок Цикл  
