					<ПослеЗагрузки>// СорокинСС - 21.08.2019 - начало
// Код взят из переноса УПП - ЕРП.
// Мы перенесли фактурную стоимость как таможенную. Нужно пересчитать теперь.
Для Каждого СтрокаРаздела Из Объект.Разделы Цикл
	НомерРаздела = СтрокаРаздела.НомерРаздела;
	
	ТаможеннаяСтоимость = 0;
	Для Каждого СтрокаТовара Из Объект.Товары ЦИкл
		Если НомерРаздела = СтрокаТовара.НомерРаздела Тогда
			ТаможеннаяСтоимость = ТаможеннаяСтоимость + СтрокаТовара.ТаможеннаяСтоимость;
		КонецЕсли;
	КонецЦикла;
	ТС = СтрокаРаздела.ТаможеннаяСтоимость;
	Коэффициент = ТС / ТаможеннаяСтоимость;
	
	Для Каждого СтрокаТовара Из Объект.Товары ЦИкл
		Если НомерРаздела = СтрокаТовара.НомерРаздела Тогда
			//++Луцевич 03 05 2019
