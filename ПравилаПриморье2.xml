			ЗаказКлиента = &amp;ЗаказКлиента И Номенклатура = &amp;Номенклатура
			И Характеристика = &amp;Характеристика И Серия = &amp;Серия) КАК ЗаказыКлиентовОбороты
ГДЕ
	ЗаказыКлиентовОбороты.КОформлениюОборот &gt; 0</Текст>
		</Запрос>
		<Запрос Имя="ОборотыРегистраЗаказовПокупателейПоРеализации" ИспользуетсяПриЗагрузке="false">
			<Текст>ВЫБРАТЬ
	ЗаказыПокупателейОбороты.ДоговорКонтрагента,
	ЗаказыПокупателейОбороты.ЗаказПокупателя КАК ЗаказПокупателя,
	ЗаказыПокупателейОбороты.Номенклатура,
	ЗаказыПокупателейОбороты.ХарактеристикаНоменклатуры,
	ЗаказыПокупателейОбороты.ЕдиницаИзмерения,
	ЗаказыПокупателейОбороты.Цена,
	-СУММА(ЗаказыПокупателейОбороты.КоличествоОборот) КАК Количество
ИЗ
	РегистрНакопления.ЗаказыПокупателей.Обороты(
			,
			,
			Регистратор,
			ДоговорКонтрагента = &amp;ДоговорКонтрагента
				И ЗаказПокупателя = &amp;ЗаказПокупателя) КАК ЗаказыПокупателейОбороты
ГДЕ
	(ЗаказыПокупателейОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
			ИЛИ ЗаказыПокупателейОбороты.Регистратор ССЫЛКА Документ.КорректировкаРеализации) И  Не ЗаказыПокупателейОбороты.КоличествоОборот = 0

СГРУППИРОВАТЬ ПО
	ЗаказыПокупателейОбороты.ДоговорКонтрагента,
	ЗаказыПокупателейОбороты.ЗаказПокупателя,
	ЗаказыПокупателейОбороты.ЕдиницаИзмерения,
	ЗаказыПокупателейОбороты.ХарактеристикаНоменклатуры,
	ЗаказыПокупателейОбороты.Номенклатура,
	ЗаказыПокупателейОбороты.Цена</Текст>
		</Запрос>
		<Запрос Имя="ОрганизацияПлательщикЕНВД" ИспользуетсяПриЗагрузке="false">
			<Текст>ВЫБРАТЬ
	УчетнаяПолитикаНалоговыйУчетСрезПоследних.ОрганизацияЯвляетсяПлательщикомЕНВД
ИЗ
	РегистрСведений.УчетнаяПолитикаНалоговыйУчет.СрезПоследних(&amp;Дата, Организация = &amp;Организация) КАК УчетнаяПолитикаНалоговыйУчетСрезПоследних</Текст>
		</Запрос>
		<Запрос Имя="ОрдернаяСхемаСкладов" ИспользуетсяПриЗагрузке="false">
			<Текст>ВЫБРАТЬ
	Склады.Ссылка КАК Склад,
	МИНИМУМ(РасходныйОрдерНаТовары.Дата) КАК ИспользоватьОрдернуюСхемуПриОтгрузке,
	МИНИМУМ(ПриходныйОрдерНаТовары.Дата) КАК ИспользоватьОрдернуюСхемуПриПоступлении
ИЗ
	Справочник.Склады КАК Склады
