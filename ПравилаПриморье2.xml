			<Алгоритм Имя="ПередЗаписьюДокументаКорректировкаРегистров" ИспользуетсяПриЗагрузке="true">
				<Текст>Выполнить(Алгоритмы.УстановитьОтветственногоВДокумент);

Если Объект.ЭтоНовый() Тогда
	Объект.УстановитьНовыйНомер();
КонецЕсли;

Выполнить(Алгоритмы.УстановитьФлагиЗаписиУДвижений);</Текст>
				<Параметры>Объект</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ПослеЗагрузкиДокумента" ИспользуетсяПриЗагрузке="true">
				<Текст>Если Не Отказ Тогда

	МетаданныеОбъекта = Объект.Метаданные();
	РеквизитыОбъекта = МетаданныеОбъекта.Реквизиты;

	Если РеквизитыОбъекта.Найти("НалогообложениеНДС") &lt;&gt; Неопределено Тогда
		Если Не ЗначениеЗаполнено(Объект.НалогообложениеНДС) Тогда
			ПараметрыУчетаПоОрганизации = УчетНДСУП.ПараметрыУчетаПоОрганизации(Объект.Организация, Объект.Дата);
			Объект.НалогообложениеНДС = ПараметрыУчетаПоОрганизации.ОсновноеНалогообложениеНДСПродажи;
		КонецЕсли;
		Если РеквизитыОбъекта.Найти("Склад") &lt;&gt; Неопределено И ЗначениеЗаполнено(Объект.Склад)
			И Не ЗначениеЗаполнено(Объект.НалогообложениеНДС) Тогда
			
			ТипСклада = ОбщегоНазначения.ПолучитьЗначениеРеквизита(Объект.Склад, "ТипСклада");
			Если ТипСклада = Перечисления.ТипыСкладов.ОптовыйСклад тогда
				Объект.НалогообложениеНДС = ЗначениеНастроекПовтИсп.НалогообложениеНДС(Объект.Организация,,,,Объект.Дата);
			Иначе
				Объект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если РеквизитыОбъекта.Найти("СпособДоставки") &lt;&gt; Неопределено И Не ЗначениеЗаполнено(Объект.СпособДоставки) Тогда
		Объект.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
	КонецЕсли;

	ТипДокумента = ТипЗнч(Объект);
	
	Если ТипДокумента = Тип("ДокументОбъект.ВводОстатков")
		Или ТипДокумента = Тип("ДокументОбъект.ВводОстатковВзаиморасчетов")
				Или ТипДокумента = Тип("ДокументОбъект.ВводОстатковДенежныхСредств")
				Или ТипДокумента = Тип("ДокументОбъект.ВводОстатковТоваров") Тогда
		
		Если РеквизитыОбъекта.Найти("Валюта") &lt;&gt; Неопределено И Не ЗначениеЗаполнено(Объект.Валюта) Тогда
			Объект.Валюта = Константы.ВалютаУправленческогоУчета.Получить();
		КонецЕсли;
		
		Если Метаданные.Имя = "КомплекснаяАвтоматизация" Тогда
			Объект.Комментарий = СтрЗаменить(Объект.Комментарий, "УТ11", "КА 2");
		ИначеЕсли Метаданные.Имя = "УправлениеПредприятием" Тогда
			Объект.Комментарий = СтрЗаменить(Объект.Комментарий, "УТ11", "ERP 2");
		КонецЕсли;

	КонецЕсли;

	Если РеквизитыОбъекта.Найти("ПорядокОплаты") &lt;&gt; Неопределено И Не ЗначениеЗаполнено(Объект.ПорядокОплаты) Тогда
		Объект.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВРубляхОплатаВРублях;
	КонецЕсли;

	Если РеквизитыОбъекта.Найти("ФормаОплаты") &lt;&gt; Неопределено И Не ЗначениеЗаполнено(Объект.ФормаОплаты) Тогда
		Объект.ФормаОплаты = Перечисления.ФормыОплаты.Безналичная;
	КонецЕсли;

	Если РеквизитыОбъекта.Найти("Менеджер") &lt;&gt; Неопределено И Не ЗначениеЗаполнено(Объект.Менеджер) Тогда
		Выполнить(Алгоритмы.УстановитьМенеджераВДокумент);
	КонецЕсли;

	Если РеквизитыОбъекта.Найти("Ответственный") &lt;&gt; Неопределено И Не ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Выполнить(Алгоритмы.УстановитьОтветственногоВДокумент);
	КонецЕсли;

	Если РеквизитыОбъекта.Найти("Автор") &lt;&gt; Неопределено И Не ЗначениеЗаполнено(Объект.Автор) Тогда
		Объект.Автор = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;

	Если РеквизитыОбъекта.Найти("ПорядокРасчетов") &lt;&gt; Неопределено И РеквизитыОбъекта.Найти("ИдентификаторПлатежа") &lt;&gt; Неопределено Тогда
		Если Объект.ПорядокРасчетов &lt;&gt; Перечисления.ПорядокРасчетов.ПоНакладным Тогда
			Объект.ИдентификаторПлатежа = ОбщегоНазначенияУТ.ПолучитьУникальныйИдентификаторПлатежа(Объект.Ссылка);
		Иначе
			Объект.ИдентификаторПлатежа = Неопределено;	
		КонецЕсли;
	КонецЕсли;

	Если МетаданныеОбъекта.ТабличныеЧасти.Найти("ЭтапыГрафикаОплаты") &lt;&gt; Неопределено Тогда //И Объект.ЭтапыГрафикаОплаты.Количество() = 0 Тогда

		// Сообщить("Запущено заполнение этапов оплаты у документа " + МетаданныеОбъекта.Имя + " № " + Объект.Номер + " от " + Объект.Дата);
		СуммаДокумента = 0;
		Если МетаданныеОбъекта.ТабличныеЧасти.Найти("Товары") &lt;&gt; Неопределено Тогда
			СуммаДокумента = СуммаДокумента + Объект.Товары.Итог("СуммаСНДС");
			// Сообщить("Итого сумма с ндс = " + Объект.Товары.Итог("СуммаСНДС"));
			// Сообщить("Итого сумма = " + Объект.Товары.Итог("Сумма"));
		КонецЕсли;
		
		
		Если СуммаДокумента = 0 И РеквизитыОбъекта.Найти("СуммаДокумента") &lt;&gt; Неопределено Тогда
			СуммаДокумента = Объект.СуммаДокумента;
			// Сообщить("Установили сумму документа = " + Объект.СуммаДокумента);
		КонецЕсли;
		
		ДатаПлатежа = Объект.Дата;
		Если РеквизитыОбъекта.Найти("ЖелаемаяДатаПоступления") &lt;&gt; Неопределено
			И ЗначениеЗаполнено(Объект.ЖелаемаяДатаПоступления) Тогда	
			ДатаПлатежа = Объект.ЖелаемаяДатаПоступления;	
		КонецЕсли;
		Если МетаданныеОбъекта.Реквизиты.Найти("ЖелаемаяДатаОтгрузки") &lt;&gt; Неопределено
			И ЗначениеЗаполнено(Объект.ЖелаемаяДатаОтгрузки) Тогда	
			ДатаПлатежа = Объект.ЖелаемаяДатаОтгрузки;	
		КонецЕсли;
		
		МойЗаказ = Неопределено; //Агаларов 26,04,2019 не проводятся взаиморасчеты по заказам
		Если РеквизитыОбъекта.Найти("ЗаказКлиента") &lt;&gt; Неопределено 
			И ЗначениеЗаполнено(Объект.ЗаказКлиента) Тогда
			МойЗаказ = Объект.ЗаказКлиента;
		КонецЕсли; //Агаларов 26,04,2019
		
		// Сообщить("Посчитали сумму документа = " + СуммаДокумента);
		Объект.ЭтапыГрафикаОплаты.Очистить();
		Попытка
			ОбъектРасчетов = Объект.ОбъектРасчетов;
		Исключение
			Если Объект.Товары.Количество() &gt; 0 Тогда
				ОбъектРасчетов = Объект.Товары.Получить(0).ОбъектРасчетов;
			КонецЕсли;
		КонецПопытки;
		
		Если МетаданныеОбъекта.ТабличныеЧасти.ЭтапыГрафикаОплаты.Реквизиты.Найти("ВариантОплаты") &lt;&gt; Неопределено Тогда
			Если РеквизитыОбъекта.Соглашение.Тип = Метаданные.Справочники.СоглашенияСКлиентами.СтандартныеРеквизиты.Ссылка.Тип Тогда
		
				ЗаполнитьЗначенияСвойств(Объект.ЭтапыГрафикаОплаты.Добавить(), 
			 							Новый Структура("Заказ, ДатаПлатежа,СуммаПлатежа,ПроцентПлатежа,ВариантОплаты, СуммаВзаиморасчетов, ОбъектРасчетов", 
										МойЗаказ, ДатаПлатежа, СуммаДокумента, 100, Перечисления.ВариантыКонтроляОплатыКлиентом.КредитПослеОтгрузки, СуммаДокумента, ОбъектРасчетов)); //Агаларов 26,04,2019 добавил заполнение поля заказ
			Иначе // поставщик
				ЗаполнитьЗначенияСвойств(Объект.ЭтапыГрафикаОплаты.Добавить(), 
			 							Новый Структура("ДатаПлатежа,СуммаПлатежа,ПроцентПлатежа,ВариантОплаты, СуммаВзаиморасчетов, ОбъектРасчетов", 
										ДатаПлатежа, СуммаДокумента, 100, Перечисления.ВариантыКонтроляОплатыПоставщику.КредитПослеПоступления, СуммаДокумента, ОбъектРасчетов));

			КонецЕсли;							
		Иначе 
			ЗаполнитьЗначенияСвойств(Объект.ЭтапыГрафикаОплаты.Добавить(), 
		 							Новый Структура("ДатаПлатежа,СуммаПлатежа,ПроцентПлатежа, СуммаВзаиморасчетов, ОбъектРасчетов", ДатаПлатежа, 
													СуммаДокумента, 100, СуммаДокумента, ОбъектРасчетов));
		КонецЕсли;							
		 
	КонецЕсли;

	Если МетаданныеОбъекта.Имя = "ЗаказКлиента" Тогда
		ДатаПлатежа = Объект.ДатаОтгрузки;	
		
		Для Каждого ТекСтрока Из Объект.ЭтапыГрафикаОплаты Цикл
			Если ТекСтрока.ДатаПлатежа &lt; ДатаПлатежа Тогда
				ТекСтрока.ДатаПлатежа = ДатаПлатежа;
			КонецЕсли;
		КонецЦикла;							
	КонецЕсли;

	Если РеквизитыОбъекта.Найти("Соглашение") &lt;&gt; Неопределено И Не ЗначениеЗаполнено(Объект.Соглашение) Тогда
		
		ТипСоглашениеСКлиентами = Метаданные.Справочники.СоглашенияСКлиентами.СтандартныеРеквизиты.Ссылка.Тип;
		Если РеквизитыОбъекта.Соглашение.Тип = ТипСоглашениеСКлиентами Тогда // это соглашение с клиентом (тип)
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Согл.Ссылка ИЗ Справочник.СоглашенияСКлиентами КАК Согл ГДЕ НЕ Согл.ПометкаУдаления И Согл.Типовое";
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Объект.Соглашение = Выборка.Ссылка;
			Иначе
				Соглашение = Справочники.СоглашенияСКлиентами.СоздатьЭлемент();
				Соглашение.Наименование = "Типовое соглашение";
				Соглашение.Типовое = Истина;
				Соглашение.ИспользуютсяДоговорыКонтрагентов = Ложь;
				Соглашение.Записать();
				Объект.Соглашение = Соглашение.Ссылка;
			КонецЕсли;
			
	 	КонецЕсли;
		
	КонецЕсли;

	Если МетаданныеОбъекта.ТабличныеЧасти.Найти("Товары") &lt;&gt; Неопределено Тогда
		// Заполнение обзательного поля вида цены поставщика в документах закупок
		Если МетаданныеОбъекта.ТабличныеЧасти.Товары.Реквизиты.Найти("ВидЦеныПоставщика") &lt;&gt; Неопределено
			И РеквизитыОбъекта.Найти("Партнер") &lt;&gt; Неопределено
			И ЗначениеЗаполнено(Объект.Партнер) Тогда
			
			Запрос = Новый Запрос("ВЫБРАТЬ
								|	ВидыЦенПоставщиков.Ссылка
								|ИЗ
								|	Справочник.ВидыЦенПоставщиков КАК ВидыЦенПоставщиков
								|ГДЕ
								|	ВидыЦенПоставщиков.Валюта = &amp;Валюта
								|	И ВидыЦенПоставщиков.Владелец = &amp;Владелец
								|
								|СГРУППИРОВАТЬ ПО
								|	ВидыЦенПоставщиков.Ссылка");
								
			Запрос.УстановитьПараметр("Валюта", Параметры.ВалютаРегламентированногоУчета);
			Запрос.УстановитьПараметр("Владелец", Объект.Партнер);
			
			Результат = Запрос.Выполнить().Выбрать();
			ВидЦеныПоставщика = Неопределено;
			Если Результат.Следующий() Тогда
				ВидЦеныПоставщика = Результат.Ссылка;
			Иначе
				Спр = Справочники.ВидыЦенПоставщиков.СоздатьЭлемент();
				Спр.Наименование    = "Цена поступления " + Объект.Партнер.Наименование;
				Спр.Валюта          = Параметры.ВалютаРегламентированногоУчета;
				Спр.ЦенаВключаетНДС = истина;
				Спр.Владелец        = Объект.Партнер;
				Спр.Записать();	
				ВидЦеныПоставщика = Спр.Ссылка;
			КонецЕсли;
			
			Для Каждого ТекСтрока Из Объект.Товары Цикл
				Если ТекСтрока.ВидЦеныПоставщика &lt;&gt; Справочники.ВидыЦенПоставщиков.ПустаяСсылка() Тогда
					Продолжить;
				КонецЕсли;
				ТекСтрока.ВидЦеныПоставщика = ВидЦеныПоставщика;
			КонецЦикла;	
		КонецЕсли;
		
		// Заполнение статьи расходов для услуг в табличной части документов закупок
		Если МетаданныеОбъекта.ТабличныеЧасти.Товары.Реквизиты.Найти("СтатьяРасходов") &lt;&gt; Неопределено Тогда
			
			Если Не Параметры.Свойство("ПараметрыАлгоритмов") Тогда
				Параметры.Вставить("ПараметрыАлгоритмов", Новый Структура());
			КонецЕсли;
			Если Не Параметры.ПараметрыАлгоритмов.Свойство("ПрочиеРасходы") Тогда
				Параметры.ПараметрыАлгоритмов.Вставить("ПрочиеРасходы", Неопределено);
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Параметры.ПараметрыАлгоритмов.ПрочиеРасходы) Тогда
				Параметры.ПараметрыАлгоритмов.ПрочиеРасходы = ПланыВидовХарактеристик.СтатьиРасходов.НайтиПоНаименованию("Прочие расходы");
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Параметры.ПараметрыАлгоритмов.ПрочиеРасходы) Тогда
				Прочие = ПланыВидовХарактеристик.СтатьиРасходов.СоздатьЭлемент();
				Прочие.Наименование = "Прочие расходы";
				Прочие.Записать();
				Параметры.ПараметрыАлгоритмов.ПрочиеРасходы = Прочие.Ссылка;
			КонецЕсли;
			
			Для Каждого СтрокаУслуг Из Объект.Товары Цикл
				Если СтрокаУслуг.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда
					СтрокаУслуг.СтатьяРасходов = Параметры.ПараметрыАлгоритмов.ПрочиеРасходы;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Если (РеквизитыОбъекта.Найти("СтатьяДвиженияДенежныхСредств") &lt;&gt; Неопределено 
		И Не ЗначениеЗаполнено(Объект.СтатьяДвиженияДенежныхСредств))
		Или МетаданныеОбъекта.Имя = "ОперацияПоПлатежнойКарте" Тогда
		
		Выполнить(Алгоритмы.ЗаполнитьСДДСПоУмолчанию);
		
	КонецЕсли;

	Если РеквизитыОбъекта.Найти("СтатьяАктивовПассивов") &lt;&gt; Неопределено 
		И Не ЗначениеЗаполнено(Объект.СтатьяАктивовПассивов) Тогда
		Объект.СтатьяАктивовПассивов = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ПрибылиИУбытки;
	КонецЕсли;

	Если ТипДокумента = Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств")
		Или ТипДокумента = Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств")
		Или ТипДокумента = Тип("ДокументОбъект.ЗаявкаНаРасходованиеДенежныхСредств") Тогда
		Выполнить(Алгоритмы.ЗаполнитьБанковскийСчетКонтрагентаПоУмолчанию);
	КонецЕсли;

	// Заполнение СДДС в списании ден. средств по заявке на расходование ден. средств
	Если ТипДокумента = Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств") 
		Или ТипДокумента = Тип("ДокументОбъект.РасходныйКассовыйОрдер") Тогда
		Выполнить(Алгоритмы.ЗаполнитьСДДССписанияПоЗаявке);
	КонецЕсли;
	
	Если ТипДокумента = Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств") Тогда
		Объект.ОплатаПоЗаявкам = ЗначениеЗаполнено(Объект.ЗаявкаНаРасходованиеДенежныхСредств);
	КонецЕсли;

	// Сообщить("...");
	// Сообщить("После загрузки: " + Объект);
	// Сообщить("Проведен: " + Объект.Проведен);
	Если Объект.Проведен Тогда
		РежимЗаписи = "Проведение";
	КонецЕсли;

	Если Параметры.ДокументыДляПроведения.Найти(Объект, "Объект") = Неопределено Тогда
		
		НужноПроводитьДокумент = Истина;
		
		Если Объект.ПометкаУдаления Тогда
			НужноПроводитьДокумент = Ложь;
		КонецЕсли;
		Если (РежимЗаписи &lt;&gt; "Проведение" 
				И ТипДокумента &lt;&gt; Тип("ДокументОбъект.ВводОстатков") 
				И ТипДокумента &lt;&gt; Тип("ДокументОбъект.ЗаказКлиента")
				И ТипДокумента &lt;&gt; Тип("ДокументОбъект.ВводОстатковВзаиморасчетов")
				И ТипДокумента &lt;&gt; Тип("ДокументОбъект.ВводОстатковДенежныхСредств")
				И ТипДокумента &lt;&gt; Тип("ДокументОбъект.ВводОстатковТоваров")
			  )
			Или ТипДокумента = Тип("ДокументОбъект.КорректировкаРегистров") Тогда // корректировка регистров не проводится
			НужноПроводитьДокумент = Ложь;
		КонецЕсли;
		// Если документ выгружен по ссылке и его дата менее даты остатков, то его не надо проводить
		Если Объект.Дата &lt; Параметры.ДатаОстатков И ТипДокумента &lt;&gt; Тип("ДокументОбъект.ВводОстатков")
			И ТипДокумента &lt;&gt; Тип("ДокументОбъект.ВводОстатковВзаиморасчетов")
				И ТипДокумента &lt;&gt; Тип("ДокументОбъект.ВводОстатковДенежныхСредств")
				И ТипДокумента &lt;&gt; Тип("ДокументОбъект.ВводОстатковТоваров")
			И ТипДокумента &lt;&gt; Тип("ДокументОбъект.ЗаказПоставщику")
			И ТипДокумента &lt;&gt; Тип("ДокументОбъект.ЗаказКлиента") Тогда
			
			НужноПроводитьДокумент = Ложь;
			// Сообщить("Дата меньше, документ не проводим");
		КонецЕсли;
		
		Если ТипДокумента = Тип("ДокументОбъект.СчетФактураВыданный") Или ТипДокумента = Тип("ДокументОбъект.СчетФактураПолученный") Тогда
			
			ДокументОснование = Неопределено;
			Если ТипДокумента = Тип("ДокументОбъект.СчетФактураВыданный") Тогда
				ДокументОснование = Объект.ДокументОснование;
			ИначеЕсли Объект.ДокументыОснования.Количество() &gt; 0 Тогда
				ДокументОснование = Объект.ДокументыОснования.Получить(0).ДокументОснование;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
				НужноПроводитьДокумент = Ложь;
			Иначе
				ПараметрыПоиска = Новый Структура("Объект", ДокументОснование.ПолучитьОбъект());
				НайденныеСтроки = Параметры.ДокументыДляПроведения.НайтиСтроки(ПараметрыПоиска);
				Если НайденныеСтроки.Количество() = 0 Тогда
					// Сообщить("Не найден документ-основание СФ в таблице к проведению: " + ДокументОснование + " для " + Объект);
					НужноПроводитьДокумент = Ложь;
				Иначе
					РежимЗаписиОснования = НайденныеСтроки[0].РежимЗаписи;
					Если РежимЗаписиОснования &lt;&gt; "Проведение" Тогда
						НужноПроводитьДокумент = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ТипДокумента = Тип("ДокументОбъект.ЗаказПоставщику") Или ТипДокумента = Тип("ДокументОбъект.ЗаказКлиента") 
			Или ТипДокумента = Тип("ДокументОбъект.РеализацияТоваровУслуг") Или ТипДокумента = Тип("ДокументОбъект.ПриобретениеТоваровУслуг") Тогда
			
			Если Объект.Товары.Количество() = 0 Тогда
				НужноПроводитьДокумент = Ложь;
				// Сообщить("Нет товаров, документ не проводим");
			Иначе
				Для Каждого Строка Из Объект.Товары Цикл
					Если Строка.Цена = 0 Или Строка.Сумма = 0 Или Строка.Количество = 0 Тогда
						НужноПроводитьДокумент = Ложь;
						Сообщить("Есть нулевая цена/сумма/количество, документ не проводим: " + ТипДокумента + " № " + Объект.Номер + " от " + Объект.Дата);
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		Если ТипДокумента = Тип("ДокументОбъект.ДоверенностьВыданная") Тогда
			НужноПроводитьДокумент = Ложь;
		КонецЕсли;
		
		Если НужноПроводитьДокумент И ТипДокумента &lt;&gt; Тип("ДокументОбъект.ВводОстатков")
			И ТипДокумента &lt;&gt; Тип("ДокументОбъект.ВводОстатковВзаиморасчетов")
				И ТипДокумента &lt;&gt; Тип("ДокументОбъект.ВводОстатковДенежныхСредств")
				И ТипДокумента &lt;&gt; Тип("ДокументОбъект.ВводОстатковТоваров")
				И Не Объект.Проведен Тогда
			НужноПроводитьДокумент = Ложь;
			// Сообщить("Не проведен в исходной базе, документ не проводим");
		КонецЕсли;
		
		Если ТипДокумента = Тип("ДокументОбъект.ВводОстатков")
			Или ТипДокумента = Тип("ДокументОбъект.ВводОстатковВзаиморасчетов")
				Или ТипДокумента = Тип("ДокументОбъект.ВводОстатковДенежныхСредств")
				Или ТипДокумента = Тип("ДокументОбъект.ВводОстатковТоваров") Тогда
			РежимЗаписи = "Проведение";
		КонецЕсли;
		
		Если НужноПроводитьДокумент Тогда
			ЗаполнитьЗначенияСвойств(Параметры.ДокументыДляПроведения.Добавить(), 
									 Новый Структура("Объект, РежимЗаписи, Дата", Объект, РежимЗаписи, Объект.Дата));
									 
			// Сообщить("Добавлен в список проведения: " + Объект);
		КонецЕсли;						 
								 
	КонецЕсли;

	Если РеквизитыОбъекта.Найти("Подразделение") &lt;&gt; Неопределено И Не ЗначениеЗаполнено(Объект.Подразделение) Тогда
		Объект.Подразделение = Параметры.ПодразделениеПоУмолчанию;
	КонецЕсли;

	Если ТипДокумента = Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств") 
		Или ТипДокумента = Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств")
		Или ТипДокумента = Тип("ДокументОбъект.ПриходныйКассовыйОрдер")
		Или ТипДокумента = Тип("ДокументОбъект.РасходныйКассовыйОрдер") Тогда
		
		Для Каждого СтрокаРасшифровка Из Объект.РасшифровкаПлатежа Цикл
			Если Не ЗначениеЗаполнено(СтрокаРасшифровка.Подразделение) Тогда
				СтрокаРасшифровка.Подразделение = Параметры.ПодразделениеПоУмолчанию;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;

	Если ТипДокумента = Тип("ДокументОбъект.АвансовыйОтчет") Тогда
		Для Каждого Строка Из Объект.ПрочиеРасходы Цикл
			Если Не ЗначениеЗаполнено(Строка.Подразделение) Тогда
				Строка.Подразделение = Параметры.ПодразделениеПоУмолчанию;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;

	Если ТипДокумента = Тип("ДокументОбъект.ЗаказКлиента") Тогда
		Если Не ЗначениеЗаполнено(Объект.Склад) Тогда
			Объект.Склад = Параметры.СкладПоУмолчанию;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.ОбъектРасчетов) Тогда
			Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
				Объект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			Объект.ОбъектРасчетов = Объект.Ссылка;
		КонецЕсли;
	КонецЕсли;

	// Режим записи уже сохранен в параметр и проведение будет выполнено после загрузки всех данных.
	// Для экономии времени сейчас отменим проведением (т.к. проведение будет выполнено позже).
	Если (РежимЗаписи = "Проведение" Или РежимЗаписи = "Запись") И ТипДокумента &lt;&gt; Тип("ДокументОбъект.ЧекККМ") И ЗначениеЗаполнено(Объект.Ссылка) Тогда
		// РежимЗаписи = "Запись";
		РежимЗаписи = "Запись"; // "ОтменаПроведения";
	КонецЕсли; 
	РежимЗаписи = "Запись";// БОС 180425 - выше код не понятен. Надо не проводить всем объектам сейчас(алгорит проведения позже идет). Иначе летят ошибки без последовательности. Если будут исключения, сделайте проверки точнее,а не как выше
	Объект.Проведен = Ложь;

КонецЕсли; 

//Липатников начало 20.07.2022
Если МетаданныеОбъекта.ТабличныеЧасти.Найти("ЭтапыГрафикаОплаты") &lt;&gt; Неопределено Тогда // И Объект.ЭтапыГрафикаОплаты.Количество() = 0 Тогда
	
	Объект.ЭтапыГрафикаОплаты.Очистить();
	
	// Сообщить("2. После загрузки документа - объект: " + Объект.Ссылка);
	
	СуммаДокумента = 0;
	Если МетаданныеОбъекта.ТабличныеЧасти.Найти("Товары") &lt;&gt; Неопределено Тогда
		СуммаДокумента = СуммаДокумента + Объект.Товары.Итог("СуммаСНДС");
		//		Сообщить("Объект.Товары.Итог(""СуммаСНДС"") = " + Объект.Товары.Итог("СуммаСНДС"));
	КонецЕсли;
	
	Если СуммаДокумента = 0 И РеквизитыОбъекта.Найти("СуммаДокумента") &lt;&gt; Неопределено Тогда
		СуммаДокумента = Объект.СуммаДокумента;
		//		Сообщить("Объект.СуммаДокумента = " + Объект.СуммаДокумента);
	КонецЕсли;
	
	ДатаПлатежа = Объект.Дата;
	Если РеквизитыОбъекта.Найти("ЖелаемаяДатаПоступления") &lt;&gt; Неопределено
		И ЗначениеЗаполнено(Объект.ЖелаемаяДатаПоступления) Тогда	
		ДатаПлатежа = Объект.ЖелаемаяДатаПоступления;	
	КонецЕсли;
	Если МетаданныеОбъекта.Реквизиты.Найти("ЖелаемаяДатаОтгрузки") &lt;&gt; Неопределено
		И ЗначениеЗаполнено(Объект.ЖелаемаяДатаОтгрузки) Тогда	
		ДатаПлатежа = Объект.ЖелаемаяДатаОтгрузки;	
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаПлатежа) Тогда
		ДатаПлатежа = Объект.Дата;
	КонецЕсли;
	
	Если МетаданныеОбъекта.ТабличныеЧасти.ЭтапыГрафикаОплаты.Реквизиты.Найти("ВариантОплаты") &lt;&gt; Неопределено Тогда
		Если РеквизитыОбъекта.Найти("Соглашение") &lt;&gt; Неопределено И ЗначениеЗаполнено(Объект.Соглашение) 
			И РеквизитыОбъекта.Соглашение.Тип = Метаданные.Справочники.СоглашенияСКлиентами.СтандартныеРеквизиты.Ссылка.Тип Тогда
			
			Если СтрНайти(Метаданные.Версия, ".5.7.") &gt; 0 Тогда
				ЗаполнитьЗначенияСвойств(Объект.ЭтапыГрафикаОплаты.Добавить(), 
				Новый Структура("ДатаПлатежа,СуммаПлатежа,ПроцентПлатежа,ВариантОплаты", 
				ДатаПлатежа, СуммаДокумента, 100, Перечисления.ВариантыКонтроляОплатыКлиентом.КредитПослеОтгрузки));
			Иначе
				ЗаполнитьЗначенияСвойств(Объект.ЭтапыГрафикаОплаты.Добавить(), 
					Новый Структура("ДатаПлатежа,СуммаПлатежа,ПроцентПлатежа,ВариантОплаты, ВариантОтсчета", 
								ДатаПлатежа, СуммаДокумента, 100, Перечисления.ВариантыКонтроляОплатыКлиентом.КредитПослеОтгрузки, 
								Перечисления.ВариантыОтсчетаДатыПлатежа.ОтДатыОтгрузки)); // изменение в 2.5.8
			КонецЕсли;
			
		Иначе // поставщик
			
			Если СтрНайти(Метаданные.Версия, ".5.7.") &gt; 0 Тогда
				ЗаполнитьЗначенияСвойств(Объект.ЭтапыГрафикаОплаты.Добавить(), 
				Новый Структура("ДатаПлатежа,СуммаПлатежа,ПроцентПлатежа,ВариантОплаты", 
				ДатаПлатежа, СуммаДокумента, 100, Перечисления.ВариантыКонтроляОплатыПоставщику.КредитПослеПоступления));
			Иначе
				ЗаполнитьЗначенияСвойств(Объект.ЭтапыГрафикаОплаты.Добавить(), 
				Новый Структура("ДатаПлатежа,СуммаПлатежа,ПроцентПлатежа,ВариантОплаты, ВариантОтсчета", 
				ДатаПлатежа, СуммаДокумента, 100, Перечисления.ВариантыКонтроляОплатыПоставщику.КредитПослеПоступления, 
								Перечисления.ВариантыОтсчетаДатыПлатежа.ОтДатыОтгрузки)); // изменение в 2.5.8

			КонецЕсли;
			
		КонецЕсли;							
	ИначеЕсли МетаданныеОбъекта.ТабличныеЧасти.ЭтапыГрафикаОплаты.Реквизиты.Найти("ВариантОтсчета") &lt;&gt; Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Объект.ЭтапыГрафикаОплаты.Добавить(), 
			Новый Структура("ДатаПлатежа,СуммаПлатежа,ПроцентПлатежа,ВариантОтсчета", ДатаПлатежа, СуммаДокумента, 100,
				Перечисления.ВариантыОтсчетаДатыПлатежа.ОтДатыОтгрузки));
	Иначе 
		ЗаполнитьЗначенияСвойств(Объект.ЭтапыГрафикаОплаты.Добавить(), 
			Новый Структура("ДатаПлатежа,СуммаПлатежа,ПроцентПлатежа", ДатаПлатежа, СуммаДокумента, 100));
	КонецЕсли;
	//Заполним Программно Щербаков 01.09.2019
	//Щербаков 26.08.2019
	Если МетаданныеОбъекта.Реквизиты.Найти("ЗаказКлиента") &lt;&gt; Неопределено 
		И ТипЗнч(Объект) &lt;&gt; Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда // И Объект.ЭтапыГрафикаОплаты.Количество() = 0 Тогда
		
		Если ЗначениеЗаполнено(Объект.ЗаказКлиента)Тогда
			//			Объект.ЗаполнитьЭтапыГрафикаОплаты();
			//			ПараметрыВзаиморасчеты = Документы[МетаданныеОбъекта.Имя].ПараметрыВзаиморасчеты( Объект.ХозяйственнаяОперация );
			ВзаиморасчетыСервер.ПроверитьЗаполнитьЭтапыГрафикаОплаты( Объект, Документы[МетаданныеОбъекта.Имя].ПараметрыВзаиморасчеты( Объект ) );
		КонецЕсли;
	КонецЕсли;
	//_Щербаков
	//
	
	//+, Липатов А.В., 2019.11.21
	//Скорректируем сумму по этапам графика в зависимости от отмененных строк
	//Если ТипДокумента = Тип("ДокументОбъект.ЗаказКлиента") И Параметры.ЗакрытиеЗаказаБезКорректировкиНазначения Тогда
	Если ТипДокумента = Тип("ДокументОбъект.ЗаказКлиента") Тогда
		СуммаПодРаспределение = 0;
		Запрос = Новый Запрос;
		Запрос.Текст = "Выбрать Т.СуммаСНДС КАК СуммаПодРаспределение 
		|Поместить ДанныеСравнения
		|ИЗ &amp;ТаблицаТовары КАК Т
		|ГДЕ Т.Отменено
		|;
		|Выбрать Сумма(Т.СуммаПодРаспределение) КАК СуммаПодРаспределение Из ДанныеСравнения КАК Т";
		Запрос.УстановитьПараметр("ТаблицаТовары", Объект.Товары.Выгрузить(,"СуммаСНДС, Отменено"));
		
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			СуммаПодРаспределение = ?(ЗначениеЗаполнено(Выборка.СуммаПодРаспределение), Выборка.СуммаПодРаспределение, 0);
		КонецЕсли;
		
		Для Каждого Этап Из Объект.ЭтапыГрафикаОплаты Цикл
			Списать = Мин(СуммаПодРаспределение, Этап.СуммаПлатежа);
			Этап.СуммаПлатежа = Этап.СуммаПлатежа - Списать;
			СуммаПодРаспределение = СуммаПодРаспределение - Списать;
		КонецЦикла;
		
	КонецЕсли;
	//-, Липатов А.В., 2019.11.21
	
КонецЕсли;
//Липатников окончание 20.07.2022</Текст>
				<Параметры>Объект, РежимЗаписи, Отказ, ОбъектНайден, Параметры</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ПослеЗагрузкиПрисоединенногоФайла" ИспользуетсяПриЗагрузке="true">
				<Текст>Объект.Автор						= ПараметрыСеанса.ТекущийПользователь;
Объект.ДатаСоздания					= ТекущаяДата();
Объект.ДатаМодификацииУниверсальная	= УниверсальноеВремя(ТекущаяДата());
Объект.Изменил						= ПараметрыСеанса.ТекущийПользователь;
Объект.ИндексКартинки				= РаботаСФайламиСлужебныйКлиентСервер.ИндексПиктограммыФайла(Объект.Расширение);</Текст>
				<Параметры>Объект</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ПроверитьТипДоговора" ИспользуетсяПриЗагрузке="true">
				<Текст>Для Каждого Строка Из Объект.РасчетыСПартнерами Цикл
	Договор = Строка.ОбъектРасчетов;
	Если ТипЗнч(Договор) &lt;&gt; Тип("СправочникСсылка.ДОговорыКонтрагентов") Тогда
		Продолжить;
	КонецЕсли;
	
	Если ТипВзаиморасчетов = "Продажа" И Договор.ТипДоговора &lt;&gt; Перечисления.ТипыДОговоров.СПокупателем
		И Договор.ТипДоговора &lt;&gt; Перечисления.ТипыДоговоров.СКомиссионером Тогда
		
		Об = Договор.ПолучитьОбъект();
		Об.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
		Об.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем;
		Об.Записать();
	КонецЕсли;
КонецЦикла;</Текст>
				<Параметры>Объект, Параметры, ТипВзаиморасчетов</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ПроверкаНеЗамещатьСуществующие" ИспользуетсяПриЗагрузке="true">
				<Текст>Если Не Отказ И Параметры.НеЗамещатьОбъектыТолькоСоздаватьНовые И ОбъектНайден Тогда
	
	Отказ = Истина;
	
	Если ТипЗнч(Объект) = Тип("СправочникОбъект.Номенклатура") 
		И (Не ЗначениеЗаполнено(Объект.ВидНоменклатуры) Или Не ЗначениеЗаполнено(Объект.ТипНоменклатуры))
		И Не Объект.ЭтоГруппа Тогда
		
		Отказ = Ложь;
		
	КонецЕсли;
	
	Если Отказ Тогда
		Сообщить("Отказ перезаписи объекта " + Объект.Наименование);
	КонецЕсли;
	
