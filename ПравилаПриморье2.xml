//				ИначеЕсли КолВоОбработать &gt; ДокРезерва.Количество Тогда
//					МассивСтрок[0].Количество =	МассивСтрок[0].Количество - ДокРезерва.Количество;
//					КолВоОбработать = КолВоОбработать - ДокРезерва.Количество;
//					
//					МассивСтрок[0].Сумма = МассивСтрок[0].Цена * МассивСтрок[0].Количество;
//					МассивСтрок[0].СуммаНДС = УчетНДС.РассчитатьСуммуНДС(МассивСтрок[0].Сумма,
//					Источник.УчитыватьНДС, Источник.СуммаВключаетНДС,
