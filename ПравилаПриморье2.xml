				НоваяСтрока.РасчетыСПартнерами.Колонки.Добавить("ДатаВходящегоДокумента",  ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
				НоваяСтрока.РасчетыСПартнерами.Колонки.Добавить("ДокументРасчетов");
				НоваяСтрока.РасчетыСПартнерами.Колонки.Добавить("ТипПервичногоДокумента");
				НоваяСтрока.РасчетыСПартнерами.Колонки.Добавить("ПорядокРасчетов");
				НоваяСтрока.РасчетыСПартнерами.Колонки.Добавить("ДатаПлатежа");
				НоваяСтрока.РасчетыСПартнерами.Колонки.Добавить("СуммаРегл", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
				НоваяСтрока.РасчетыСПартнерами.Колонки.Добавить("СуммаУпр", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
			КонецЕсли;
			
			НоваяСтрокаРасчетыСПартнерами = НоваяСтрока.РасчетыСПартнерами.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРасчетыСПартнерами, ВыборкаДетальныеЗаписи);
			
			Если ВыведеноСтрок = 1999 Тогда
				ВыведеноСтрок = 0;
			Иначе
				ВыведеноСтрок = ВыведеноСтрок + 1;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
КонецЦикла;</Текст>
				<Параметры>ИмяПравила, ВыборкаДанных</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ВыгрузитьУчетныеПолитики" ИспользуетсяПриЗагрузке="false">
				<Текст>Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	УчетнаяПолитикаНалоговыйУчет.Период,
	|	истина как Активность,
	|	УчетнаяПолитикаНалоговыйУчет.Организация,
	|	УчетнаяПолитикаНалоговыйУчет.МоментОпределенияНалоговойБазыНДС,
	|	УчетнаяПолитикаНалоговыйУчет.ОрганизацияЯвляетсяПлательщикомЕНВД,
	|	УчетнаяПолитикаНалоговыйУчет.РозничнаяТорговляОблагаетсяЕНВД,
	|	УчетнаяПолитикаНалоговыйУчет.СложныйУчетНДС,
	|	УчетнаяПолитикаНалоговыйУчет.СистемаНалогообложения,
	|	УчетнаяПолитикаНалоговыйУчет.ОбъектНалогообложенияУСН,
	|	УчетнаяПолитикаНалоговыйУчет.НДСРежимУчетаРаспределенныхОплат,
	|	УчетнаяПолитикаНалоговыйУчет.НДСИспользованиеОплатПокупателя_Приоритет0,
	|	УчетнаяПолитикаНалоговыйУчет.НДСНалоговыйПериод,
	|	УчетнаяПолитикаНалоговыйУчет.ПартионныйУчетНДСвРазрезеСерийИХарактеристик,
	|	УчетнаяПолитикаНалоговыйУчет.ПартионныйУчетНДСвРазрезеСкладов,
	|	УчетнаяПолитикаНалоговыйУчет.НДСПриНеподтвержденииСверху,
	|	УчетнаяПолитикаНалоговыйУчет.ОрганизацияНеЯвляетсяПлательщикомНДС КАК ПрименяетсяОсвобождениеОтУплатыНДС,
	|	УчетнаяПолитикаНалоговыйУчет.ПорядокРегистрацииСчетовФактурНаАванс
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаНалоговыйУчет КАК УчетнаяПолитикаНалоговыйУчет");

Выгрузка = Запрос.Выполнить().Выгрузить();

Для Каждого Строка Из Выгрузка Цикл
	
	Если Не ЗначениеЗаполнено(Параметры.Организации) 
		Или (Параметры.Организации.Количество() &gt; 0 И Параметры.Организации.Найти(Строка.Организация) &lt;&gt; Неопределено) Тогда
		
//		ВыгрузитьПоПравилу(Строка,,,, "УчетнаяПолитикаОрганизаций");

		ВыгрузитьПоПравилу(Строка,,,, "УчетныеПолитикиНУ");
	КонецЕсли;
	
КонецЦикла;</Текст>
			</Алгоритм>
			<Алгоритм Имя="ДокументПроведен" ИспользуетсяПриЗагрузке="false">
				<Текст>Попытка
	Значение = Источник.Проведен;
Исключение
	Значение = Не Источник.ПометкаУдаления;
КонецПопытки;</Текст>
				<Параметры>Источник</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ДокументРасчетов" ИспользуетсяПриЗагрузке="false">
				<Текст>Попытка
	Значение = ОбъектКоллекции.РасчетныйДокумент;
	
	Если ТипЗнч(ОбъектКоллекции.РасчетныйДокумент) = Тип("ДокументСсылка.ЗаказПокупателя")
		Или ТипЗнч(ОбъектКоллекции.РасчетныйДокумент) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		Значение = ОбъектКоллекции.РасчетныйДокумент.ДоговорКонтрагента;
	КонецЕсли;
	
	Выполнить(Алгоритмы.ВыбратьПКООбъекта);
Исключение
	Сообщить("Документ: " + Источник + ", ошибка: " + ОписаниеОшибки());
	Отказ = Истина;
КонецПопытки;

Если Не Отказ Тогда
	ИсходящиеДанные = Новый Структура("СуммаДокумента", ОбъектКоллекции.СуммаРегл);
	
	ВидПартнера = "Клиент";
	Если Источник.ИмяПКО = "ВводОстатковДолгиПоставщикамПоДоговорам"
		Или Источник.ИмяПКО = "ВводОстатковДолгиПоставщикамПоЗаказам"
		Или Источник.ИмяПКО = "ВводОстатковДолгиПоставщикамПоПоступлениям"
		Или Источник.ИмяПКО = "ВводОстатковДолгиКомитентамПоДоговорам"
		Или Источник.ИмяПКО = "ВводОстатковДолгиКомитентамЗаПроданныеТовары"
		Или Источник.ИмяПКО = "ВводОстатковАвансыПоДоговорамУплаченныеПоставщикам"
		Или Источник.ИмяПКО = "ВводОстатковАвансыПоЗаказамУплаченныеПоставщикам"
		Или Источник.ИмяПКО = "ВводОстатковПрочиеАвансыУплаченныеПоставщикам"
		Или Источник.ИмяПКО = "ВводОстатковПрочаяКредиторскаяЗадолженность" Тогда
			ВидПартнера = "Поставщик";
	КонецЕсли;

	Если ВидПартнера = "Клиент" И Найти(Источник.ИмяПКО, "Аванс") &gt; 0 Тогда
		ТипПервичногоДокумента = "ОплатаОтКлиента";
	ИначеЕсли ВидПартнера = "Клиент" Тогда // долг
		ТипПервичногоДокумента = "РеализацияКлиенту";
	ИначеЕсли ВидПартнера = "Поставщик" И Найти(Источник.ИмяПКО, "Аванс") &gt; 0 Тогда
		ТипПервичногоДокумента = "ОплатаПоставщику";
	Иначе // Если ВидПартнера = "Поставщик" Тогда
		ТипПервичногоДокумента = "ПриобретениеУПоставщика";
	КонецЕсли;
	
	ИсходящиеДанные.Вставить("ТипПервичногоДокумента", ТипПервичногоДокумента);
	
КонецЕсли;

Если ТипЗнч(Значение) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
	ИмяПКО = "ДоговорыКонтрагентов_ПервичныеДокументы";
КонецЕсли;</Текст>
				<Параметры>ОбъектКоллекции, ИсходящиеДанные, ИмяПКО, Отказ</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ЗаполнитьИдентификаторыСтрокВоВходящихДанных" ИспользуетсяПриЗагрузке="false">
				<Текст>Если Не Отказ Тогда
	
	Если Не ЗначениеЗаполнено(ВходящиеДанные) Тогда
		ВходящиеДанные = Новый Структура();
	КонецЕсли;
	
	Если Не ВходящиеДанные.Свойство("ИдентификаторыСтрок") Тогда
		
		ВходящиеДанные.Вставить("ИдентификаторыСтрок", Новый Соответствие());
		
		Если Источник.Метаданные().ТабличныеЧасти.Найти("Товары") &lt;&gt; Неопределено Тогда
			Для Каждого Строка Из Источник.Товары Цикл
				ВходящиеДанные.ИдентификаторыСтрок.Вставить("Товары" + Строка.НомерСтроки, СокрЛП(Новый УникальныйИдентификатор()));
			КонецЦикла;
		КонецЕсли;	
		
		Если Источник.Метаданные().ТабличныеЧасти.Найти("Услуги") &lt;&gt; Неопределено Тогда
			Для Каждого Строка Из Источник.Услуги Цикл
				ВходящиеДанные.ИдентификаторыСтрок.Вставить("Услуги" + Строка.НомерСтроки, СокрЛП(Новый УникальныйИдентификатор()));
			КонецЦикла;
		КонецЕсли;
		
		Если Источник.Метаданные().ТабличныеЧасти.Найти("Материалы") &lt;&gt; Неопределено Тогда
			Для Каждого Строка Из Источник.Материалы Цикл
				ВходящиеДанные.ИдентификаторыСтрок.Вставить("Материалы" + Строка.НомерСтроки, СокрЛП(Новый УникальныйИдентификатор()));
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не Параметры.ПараметрыАлгоритмов.Свойство("ВходящиеДанные") Тогда
		Параметры.ПараметрыАлгоритмов.Вставить("ВходящиеДанные");
	КонецЕсли;
	
	Параметры.ПараметрыАлгоритмов.ВходящиеДанные = ВходящиеДанные;
	
КонецЕсли;</Текст>
				<Параметры>Источник, ВходящиеДанные</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ЗаполнитьКассыККМСклады" ИспользуетсяПриЗагрузке="false">
				<Текст>Запрос = Новый Запрос("
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КассыККМ.Ссылка КАК КассаККМ,
	|	ОтчетОРозничныхПродажах.Склад КАК Склад
	|ПОМЕСТИТЬ КассыИСклады
	|ИЗ
	|	Справочник.КассыККМ КАК КассыККМ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетОРозничныхПродажах КАК ОтчетОРозничныхПродажах
	|		ПО КассыККМ.Ссылка = ОтчетОРозничныхПродажах.КассаККМ
	|			И (ОтчетОРозничныхПродажах.Проведен = ИСТИНА)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КассаККМ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕСТЬNULL(КассыИСклады.Склад, ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)) КАК Склад,
	|	ВЫБОР
	|		КОГДА ТорговоеОборудование.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыТорговогоОборудования.ФискальныйРегистратор)
	|				ИЛИ ТорговоеОборудование.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыТорговогоОборудования.ККМOnline)
	|			ТОГДА ""ФискальныйРегистратор""
	|		КОГДА ТорговоеОборудование.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыТорговогоОборудования.ККМOffline)
	|			ТОГДА ""ККМOffline""
	|		ИНАЧЕ ""АвтономнаяККМ""
	|	КОНЕЦ КАК ТипКассы,
	|	КассыИСклады.КассаККМ.Владелец КАК Владелец,
	|	КассыИСклады.КассаККМ.Наименование КАК Наименование,
	|	КассыИСклады.КассаККМ,
	|	КассыИСклады.КассаККМ.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	КассыИСклады КАК КассыИСклады
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТорговоеОборудование КАК ТорговоеОборудование
	|		ПО КассыИСклады.КассаККМ = ТорговоеОборудование.КассаККМ
	|			И (ТорговоеОборудование.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыТорговогоОборудования.ФискальныйРегистратор)
	|				ИЛИ ТорговоеОборудование.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыТорговогоОборудования.ККМOffline)
	|				ИЛИ ТорговоеОборудование.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыТорговогоОборудования.ККМOnline))");
	
Если Параметры.Организации.Количество() &gt; 0 Тогда
	
	Запрос.Текст = Запрос.Текст + " ГДЕ КассыИСклады.КассаККМ.Владелец В (&amp;МассивОрганизаций) ";
	Запрос.УстановитьПараметр("МассивОрганизаций", Параметры.Организации);
	
КонецЕсли;

Параметры.КассыККМСклады = Запрос.Выполнить().Выгрузить();</Текст>
			</Алгоритм>
			<Алгоритм Имя="ЗаполнитьОрдернуюСхемуСкладов" ИспользуетсяПриЗагрузке="false">
				<Текст>Запрос = Новый Запрос;
Запрос.Текст = Запросы.ОрдернаяСхемаСкладов.Текст;
Параметры.ПараметрыАлгоритмов.Вставить("ОрдернаяСхемаСкладов", Запрос.Выполнить().Выгрузить());

Для Каждого Строка Из Параметры.ПараметрыАлгоритмов.ОрдернаяСхемаСкладов Цикл
	
	Если Не ЗначениеЗаполнено(Строка.ИспользоватьОрдернуюСхемуПриОтгрузке) Тогда
		Строка.ИспользоватьОрдернуюСхемуПриОтгрузке = Дата(1,1,1);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Строка.ИспользоватьОрдернуюСхемуПриПоступлении) Тогда
		Строка.ИспользоватьОрдернуюСхемуПриПоступлении = Дата(1,1,1);
	КонецЕсли;
	
КонецЦикла;</Текст>
			</Алгоритм>
			<Алгоритм Имя="ЗаполнитьСоответствиеСДДСХозОпераций" ИспользуетсяПриЗагрузке="false">
				<Текст>// Параметры.СтатьиДДСХозОперации

Запрос = Новый Запрос;
Запрос.Текст = 
"ВЫБРАТЬ
|	ПлатежноеПоручениеВходящее.СтатьяДвиженияДенежныхСредств,
|	ПлатежноеПоручениеВходящее.ВидОперации КАК ХозяйственнаяОперация
|ПОМЕСТИТЬ ВидыОперацийСДДС
|ИЗ
|	Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
|
|ОБЪЕДИНИТЬ ВСЕ
|
|ВЫБРАТЬ
|	ПлатежноеПоручениеИсходящее.СтатьяДвиженияДенежныхСредств,
|	ПлатежноеПоручениеИсходящее.ВидОперации
|ИЗ
|	Документ.ПлатежноеПоручениеИсходящее КАК ПлатежноеПоручениеИсходящее
|
|ОБЪЕДИНИТЬ ВСЕ
|
|ВЫБРАТЬ
|	ПлатежноеТребованиеВыставленное.СтатьяДвиженияДенежныхСредств,
|	ПлатежноеТребованиеВыставленное.ВидОперации
|ИЗ
|	Документ.ПлатежноеТребованиеВыставленное КАК ПлатежноеТребованиеВыставленное
|
|ОБЪЕДИНИТЬ ВСЕ
|
|ВЫБРАТЬ
|	ПлатежноеТребованиеПолученное.СтатьяДвиженияДенежныхСредств,
|	ПлатежноеТребованиеПолученное.ВидОперации
|ИЗ
|	Документ.ПлатежноеТребованиеПолученное КАК ПлатежноеТребованиеПолученное
|
|ОБЪЕДИНИТЬ ВСЕ
|
|ВЫБРАТЬ
|	ПлатежныйОрдерПоступлениеДенежныхСредств.СтатьяДвиженияДенежныхСредств,
|	ПлатежныйОрдерПоступлениеДенежныхСредств.ВидОперации
|ИЗ
|	Документ.ПлатежныйОрдерПоступлениеДенежныхСредств КАК ПлатежныйОрдерПоступлениеДенежныхСредств
|
|ОБЪЕДИНИТЬ ВСЕ
|
|ВЫБРАТЬ
|	ПлатежныйОрдерСписаниеДенежныхСредств.СтатьяДвиженияДенежныхСредств,
|	ПлатежныйОрдерСписаниеДенежныхСредств.ВидОперации
|ИЗ
|	Документ.ПлатежныйОрдерСписаниеДенежныхСредств КАК ПлатежныйОрдерСписаниеДенежныхСредств
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ РАЗЛИЧНЫЕ
|	ВидыОперацийСДДС.СтатьяДвиженияДенежныхСредств,
|	ВидыОперацийСДДС.ХозяйственнаяОперация
|ИЗ
|	ВидыОперацийСДДС КАК ВидыОперацийСДДС";

Параметры.СтатьиДДСХозОперации = Запрос.Выполнить().Выгрузить();</Текст>
			</Алгоритм>
			<Алгоритм Имя="ИдентификаторСтроки" ИспользуетсяПриЗагрузке="false">
				<Текст>Значение = Неопределено;

Попытка
	а = ИмяТабличнойЧасти;
Исключение
	ИмяТабличнойЧасти = "Товары";
КонецПопытки;

Значение = СокрЛП(Параметры.ПараметрыАлгоритмов.ВходящиеДанные.ИдентификаторыСтрок.Получить(ИмяТабличнойЧасти + ОбъектКоллекции.НомерСтроки));

Если Не ЗначениеЗаполнено(Значение) Или ТипЗнч(Значение) &lt;&gt; Тип("Строка") Или СтрДлина(Значение) &lt;&gt; 36 Тогда
	Отказ = Истина;
КонецЕсли;</Текст>
				<Параметры>ОбъектКоллекции, ИмяТабличнойЧасти, Отказ</Параметры>
			</Алгоритм>
			<Алгоритм Имя="КодСтрокиТоваровПоступления" ИспользуетсяПриЗагрузке="false">
				<Текст>ЗаказПоставщику = ОбъектКоллекции.ЗаказПоставщику;

Если Не ЗначениеЗаполнено(ОбъектКоллекции.ЗаказПоставщику) Тогда
	ЗаказПоставщику = Источник.Сделка;
КонецЕсли;

Если Не ЗначениеЗаполнено(ЗаказПоставщику) Тогда
	Значение = 0; // ОбъектКоллекции.НомерСтроки; // эта строка не из заказа поставщику
Иначе
	
	Товары = ЗаказПоставщику.Товары.Выгрузить();
	НайденныеСтроки = Товары.НайтиСтроки(Новый Структура("Номенклатура", ОбъектКоллекции.Номенклатура));
	Если НайденныеСтроки.Количество() &gt; 0 Тогда
		Значение = НайденныеСтроки[0].НомерСтроки;
	Иначе
		Значение = 0; // ОбъектКоллекции.НомерСтроки; // строка не из заказа поставщику
	КонецЕсли;
	
КонецЕсли;</Текст>
				<Параметры>ОбъектКоллекции, Источник</Параметры>
			</Алгоритм>
			<Алгоритм Имя="КоллекцияОбъектовТЧДокумента" ИспользуетсяПриЗагрузке="false">
				<Текст>ИмяДокумента = Источник.Метаданные().Имя;
МассивИменТЧ = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(ИменаТЧ, ",");

ТекстЗапроса = "ВЫБРАТЬ  ";

Для Каждого ТабличнаяЧасть Из МассивИменТЧ Цикл
	ТекстЗапроса = ТекстЗапроса + " " + ИмяДокумента + "." + ТабличнаяЧасть + ".()";
	
	Если ТабличнаяЧасть &lt;&gt; МассивИменТЧ[МассивИменТЧ.Количество()-1] Тогда
		ТекстЗапроса = ТекстЗапроса + ",";
	КонецЕсли;
КонецЦикла;

ТекстЗапроса = ТекстЗапроса + " ИЗ Документ." + ИмяДокумента + " КАК " + ИмяДокумента + "
							|ГДЕ
							|	" + ИмяДокумента + ".Ссылка = &amp;Ссылка ";

Запрос = Новый Запрос(ТекстЗапроса);
Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);

Выборка = Запрос.Выполнить().Выбрать();
Выборка.Следующий();

КолонкиКоллекцииОбъектов = Новый Массив;
КолонкиКоллекцииОбъектов.Добавить("ИмяТабличнойЧасти");
ТаблицыДокумента = Новый Соответствие;

Для Каждого ИмяТабличнаяЧасть Из МассивИменТЧ Цикл
	
	ТаблицаДанныеТЧ = Выборка[ИмяТабличнаяЧасть].Выгрузить();
	ТаблицыДокумента.Вставить(ИмяТабличнаяЧасть, ТаблицаДанныеТЧ);
	Для Каждого Колонка Из ТаблицаДанныеТЧ.Колонки Цикл
		Если КолонкиКоллекцииОбъектов.Найти(Колонка.Имя) = Неопределено Тогда
			КолонкиКоллекцииОбъектов.Добавить(Колонка.Имя);
		КонецЕсли;	
	КонецЦикла;
	
КонецЦикла;	
		
КоллекцияОбъектов = Новый ТаблицаЗначений;
Для Каждого Колонка Из КолонкиКоллекцииОбъектов Цикл
	КоллекцияОбъектов.Колонки.Добавить(Колонка);
КонецЦикла;

Для Каждого Таблица Из ТаблицыДокумента Цикл
	Для Каждого Строка Из Таблица.Значение Цикл
		НоваяСтрока = КоллекцияОбъектов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.ИмяТабличнойЧасти = Таблица.Ключ;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.Коэффициент) Тогда
			НоваяСтрока.Коэффициент = 1;
		КонецЕсли;
	КонецЦикла;
КонецЦикла;

//Для Каждого Элемент ИЗ КоллекцияОбъектов Цикл
//	Сообщить("Серия:" + Элемент.СерияНоменклатуры + ", х-ка:" + Элемент.ХарактеристикаНоменклатуры + ", склад:" + Элемент.Склад + ", номенклатура:"+Элемент.Номенклатура +", количество:"+ Элемент.Количество);
//КонецЦикла;

//Если КоллекцияОбъектов.Колонки.Найти("Номенклатура") &lt;&gt; Неопределено Тогда
//	КоллекцияОбъектов.Сортировать("Номенклатура Возр");
//КонецЕсли;</Текст>
				<Параметры>Источник, ИменаТЧ</Параметры>
			</Алгоритм>
			<Алгоритм Имя="Комментарий" ИспользуетсяПриЗагрузке="false">
				<Текст>Значение = "Выгружен: " + ТекущаяДата() + " из документа из УТ 10.3: " + Источник;

Если ЗначениеЗаполнено(Источник.Комментарий) Тогда
	Значение = Значение + "; Комментарий документа из УТ 10.3: " + Источник.Комментарий;
КонецЕсли;</Текст>
				<Параметры>Источник</Параметры>
			</Алгоритм>
			<Алгоритм Имя="МенеджерКонтрагента" ИспользуетсяПриЗагрузке="false">
				<Текст>Если Источник.Метаданные().Реквизиты.Найти("Контрагент") &lt;&gt; Неопределено И ЗначениеЗаполнено(Источник.Контрагент)
	И ТипЗнч(Источник.Контрагент) = Тип("СправочникСсылка.Контрагенты")
	И ЗначениеЗаполнено(Источник.Контрагент.ОсновнойМенеджерПокупателя) Тогда
	
	Значение = Источник.Контрагент.ОсновнойМенеджерПокупателя;

КонецЕсли;</Текст>
				<Параметры>Источник</Параметры>
			</Алгоритм>
			<Алгоритм Имя="НаименованиеКлючиАналитикиУчетаНоменклатуры" ИспользуетсяПриЗагрузке="false">
				<Текст>Значение = СокрЛП(Источник.Номенклатура);

Если ЗначениеЗаполнено(Источник.Серия) Тогда
	Значение = Значение + "; " + СокрЛП(Источник.Серия);
КонецЕсли;

Если ЗначениеЗаполнено(Источник.Склад) Тогда
	Значение = Значение + "; " + СокрЛП(Источник.Склад);
КонецЕсли;

Если ЗначениеЗаполнено(Источник.Характеристика) Тогда
	Значение = Значение + "; " + СокрЛП(Источник.Характеристика);
КонецЕсли;</Текст>
				<Параметры>Источник</Параметры>
			</Алгоритм>
			<Алгоритм Имя="НалогообложениеНДС" ИспользуетсяПриЗагрузке="false">
				<Текст>Запрос = Новый Запрос;
Запрос.Текст = Запросы.ОрганизацияПлательщикЕНВД.Текст;
Запрос.УстановитьПараметр("Организация", Источник.Организация);
Запрос.УстановитьПараметр("Дата", Источник.Дата);

Выборка = Запрос.Выполнить().Выбрать();

ПлательщикЕНВД = Ложь;
Если Выборка.Следующий() Тогда
	ПлательщикЕНВД = Истина;
КонецЕсли;

Если ПлательщикЕНВД Тогда
	Значение = "ПродажаОблагаетсяЕНВД";
Иначе

	Выполнить(Алгоритмы.ЦенаВключаетНДС);

	Если Не Параметры.ВрЗначение Тогда
		Значение = "ПродажаНеОблагаетсяНДС";
	Иначе

		Значение = "ПродажаОблагаетсяНДС";

		ЕстьБезНДС = Ложь;
		ЕстьНДС    = Ложь;

		Если Источник.Метаданные().ТабличныеЧасти.Найти("Товары") &lt;&gt; Неопределено Тогда
			Если ТипЗнч(Источник) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
				
				Для Каждого Строка Из Источник.Товары Цикл
					Если Строка.СуммаНДСВознаграждения = 0 Тогда
						ЕстьБезНДС = Истина;
						Если ЕстьНДС Тогда
							Прервать;
						КонецЕсли;
					Иначе
						ЕстьНДС = Истина;
						Если ЕстьБезНДС Тогда
							Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				
			ИначеЕсли ТипЗнч(Источник) = Тип("ДокументСсылка.ПоступлениеДопРасходов") Тогда
				
				Для Каждого Строка Из Источник.Товары Цикл
					Если Строка.СуммаНДС = 0 Тогда
						ЕстьБезНДС = Истина;
						Если ЕстьНДС Тогда
							Прервать;
						КонецЕсли;
					Иначе
						ЕстьНДС = Истина;
						Если ЕстьБезНДС Тогда
							Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				
			Иначе
				
				Попытка
					Для Каждого Строка Из Источник.Товары Цикл
						Если Строка.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
							ЕстьБезНДС = Истина;
							Если ЕстьНДС Тогда
								Прервать;
							КонецЕсли;
						Иначе
							ЕстьНДС = Истина;
							Если ЕстьБезНДС Тогда
								Прервать;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				Исключение
					Если ЗначениеЗаполнено(ВходящиеДанные) И ВходящиеДанные.Свойство("БезНДС") И ВходящиеДанные.БезНДС Тогда
						ЕстьБезНДС = Истина;
					КонецЕсли;
				КонецПопытки;
			КонецЕсли;	
		КонецЕсли;

		Если Не ЕстьНДС И Источник.Метаданные().ТабличныеЧасти.Найти("Услуги") &lt;&gt; Неопределено Тогда
			Для Каждого Строка Из Источник.Услуги Цикл
				Если Строка.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
					ЕстьБезНДС = Истина;
					Если ЕстьНДС Тогда
						Прервать;
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Если Не ЕстьНДС И ЕстьБезНДС Тогда
			Значение = "ПродажаНеОблагаетсяНДС";
		КонецЕсли;
	КонецЕсли;
	
КонецЕсли;</Текст>
				<Параметры>Источник</Параметры>
			</Алгоритм>
			<Алгоритм Имя="НаправлениеДеятельностиДокумента" ИспользуетсяПриЗагрузке="false">
				<Текст>ИмяПКО = "НаправленияДеятельности";

Если ТипЗнч(Источник) &lt;&gt; Тип("ДокументСсылка.КомплектацияНоменклатуры")
	И ТипЗнч(Источник) &lt;&gt; Тип("ДокументСсылка.ТребованиеНакладная")
	И Источник.Товары.Количество() &gt; 0 И ЗначениеЗаполнено(Источник.Товары.Получить(0).Номенклатура)
	И ЗначениеЗаполнено(Источник.Товары.Получить(0).Номенклатура.НоменклатурнаяГруппа)
	И Не Источник.Товары.Получить(0).Номенклатура.НоменклатурнаяГруппа.ЭтоГруппа Тогда
	
	Значение = Источник.Товары.Получить(0).Номенклатура.НоменклатурнаяГруппа;
	
ИначеЕсли ТипЗнч(Источник) = Тип("ДокументСсылка.КомплектацияНоменклатуры")
	И Источник.Комплектующие.Количество() &gt; 0 И ЗначениеЗаполнено(Источник.Комплектующие.Получить(0).Номенклатура)
	И ЗначениеЗаполнено(Источник.Комплектующие.Получить(0).Номенклатура.НоменклатурнаяГруппа)
	И не Источник.Комплектующие.Получить(0).Номенклатура.НоменклатурнаяГруппа.ЭтоГруппа Тогда
	
	Значение = Источник.Комплектующие.Получить(0).Номенклатура.НоменклатурнаяГруппа;
	
ИначеЕсли ТипЗнч(Источник) = Тип("ДокументСсылка.ТребованиеНакладная")
	И Источник.Материалы.Количество() &gt; 0 И ЗначениеЗаполнено(Источник.Материалы.Получить(0).Номенклатура)
	И ЗначениеЗаполнено(Источник.Материалы.Получить(0).Номенклатура.НоменклатурнаяГруппа) 
	И Не Источник.Материалы.Получить(0).Номенклатура.НоменклатурнаяГруппа.ЭтоГруппа Тогда
	
	Значение = Источник.Материалы.Получить(0).Номенклатура.НоменклатурнаяГруппа;
	
Иначе
	ИмяПКО = "";
	Отказ = Истина;
	
КонецЕсли;</Текст>
				<Параметры>Источник</Параметры>
			</Алгоритм>
			<Алгоритм Имя="НомерГТДИзСерииНоменклатуры" ИспользуетсяПриЗагрузке="false">
				<Текст>Если ЗначениеЗаполнено(ОбъектКоллекции.СерияНоменклатуры) Тогда
	
	Значение = ОбщегоНазначения.ПолучитьЗначениеРеквизита(ОбъектКоллекции.СерияНоменклатуры, "НомерГТД");
	
	ИсходящиеДанные = Новый Структура("СтранаПроисхождения", ОбщегоНазначения.ПолучитьЗначениеРеквизита(ОбъектКоллекции.СерияНоменклатуры, "СтранаПроисхождения"));
	
	Попытка
		ИсходящиеДанные.Вставить("Номенклатура", ОбъектКоллекции.Номенклатура);
	Исключение
	КонецПопытки;
	
	ИмяПКО = "НомераГТД";
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Отказ = Истина;
	КонецЕсли;
	
Иначе
	Отказ = Истина;
КонецЕсли;</Текст>
				<Параметры>ОбъектКоллекции</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ОбъектКоллекцииСумма" ИспользуетсяПриЗагрузке="false">
				<Текст>Если Источник.Метаданные().Реквизиты.Найти("СуммаВключаетНДС") &lt;&gt; Неопределено Тогда
	ОбъектКоллекцииСумма = ОбъектКоллекции.Сумма;
	Если Не ЗначениеЗаполнено(ОбъектКоллекцииСумма) Тогда
		ОбъектКоллекцииСумма = 0;
	КонецЕсли;
	ОбъектКоллекцииСуммаНДС = ОбъектКоллекции.СуммаНДС;
	Если Не ЗначениеЗаполнено(ОбъектКоллекцииСуммаНДС) Тогда
		ОбъектКоллекцииСуммаНДС = 0;
	КонецЕсли;
	
	Если Источник.СуммаВключаетНДС Тогда
		Значение = ОбъектКоллекцииСумма;
	Иначе
		Значение = ОбъектКоллекцииСумма - ОбъектКоллекцииСуммаНДС;
	КонецЕсли;
Иначе
	Значение = ОбъектКоллекцииСумма;
КонецЕсли;

Если Значение = 0 И Параметры.ЗаменятьНулевыеЦеныСуммыКопейкой Тогда
	Значение = ОбъектКоллекции.Количество * 0.01;
КонецЕсли;</Текст>
				<Параметры>Источник, ОбъектКоллекции</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ОбъектКоллекцииСуммаСНДС" ИспользуетсяПриЗагрузке="false">
				<Текст>ОбъектКоллекцииСумма = ОбъектКоллекции.Сумма;
Если Не ЗначениеЗаполнено(ОбъектКоллекцииСумма) Тогда
	ОбъектКоллекцииСумма = 0;
КонецЕсли;

ОбъектКоллекцииСуммаНДС = 0;
Если ТипЗнч(Источник) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
	ОбъектКоллекцииСуммаНДС = ОбъектКоллекции.СуммаНДСВознаграждения;
Иначе
	ОбъектКоллекцииСуммаНДС = ОбъектКоллекции.СуммаНДС;
КонецЕсли;
Если Не ЗначениеЗаполнено(ОбъектКоллекцииСуммаНДС) Тогда
	ОбъектКоллекцииСуммаНДС = 0;
КонецЕсли;

Если Источник.Метаданные().Реквизиты.Найти("СуммаВключаетНДС") &lt;&gt; Неопределено Тогда
	Если Источник.СуммаВключаетНДС Тогда
		Значение = ОбъектКоллекцииСумма;
	Иначе
		Значение = ОбъектКоллекцииСумма + ОбъектКоллекцииСуммаНДС;
	КонецЕсли;
Иначе
	Значение = ОбъектКоллекцииСумма;
КонецЕсли;

Значение = Окр(Значение, 2);

Если Значение = 0 И Параметры.ЗаменятьНулевыеЦеныСуммыКопейкой Тогда
	Значение = 0.01 * ОбъектКоллекции.Количество;
КонецЕсли;</Текст>
				<Параметры>Источник, ОбъектКоллекции</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ОрганизацияДокумента" ИспользуетсяПриЗагрузке="false">
				<Текст>ИмяПКО = "Организации";

// Сообщить("Тип источника: " + ТипЗнч(Источник));

Если ЗначениеЗаполнено(Источник) И ТипЗнч(Источник) &lt;&gt; Тип("Структура") И ТипЗнч(Источник) &lt;&gt; Тип("Строка") И ТипЗнч(Источник) &lt;&gt; Тип("СтрокаТаблицыЗначений")
	И Источник.Метаданные().Реквизиты.Найти("Организация") &lt;&gt; Неопределено И ЗначениеЗаполнено(Источник.Организация) Тогда
	
	Значение = Источник.Организация;
	
ИначеЕсли ТипЗнч(Источник) = Тип("Структура") Или ТипЗнч(Источник) = Тип("СтрокаТаблицыЗначений") Тогда
	
	Значение = Источник.Организация;
	
Иначе
	Отказ = Истина;
КонецЕсли;
	
Если Значение = "УправленческаяОрганизация" Тогда
	ИмяПКО = "";
КонецЕсли;

Если Не Отказ И Значение &lt;&gt; "УправленческаяОрганизация" И Параметры.ПереноситьДокументыВУпрОрганизацию
	 И ТипЗнч(Источник) &lt;&gt; Тип("Структура") И ТипЗнч(Источник) &lt;&gt; Тип("Строка") И ТипЗнч(Источник) &lt;&gt; Тип("СтрокаТаблицыЗначений")
	И Источник.Метаданные().Реквизиты.Найти("ОтражатьВБухгалтерскомУчете") &lt;&gt; Неопределено
	И Не Источник.ОтражатьВБухгалтерскомУчете Тогда

	ИмяПКО = "";
	Значение = "УправленческаяОрганизация";
	
КонецЕсли;

// Сообщить("Источник: " + Источник);
// Сообщить("ИмяПКО: " + ИмяПКО);
// Сообщить("Значение: " + Значение);

Если Не ЗначениеЗаполнено(Значение) И ЗначениеЗаполнено(Параметры.ОрганизацияПоУмолчанию) Тогда
	Значение = Параметры.ОрганизацияПоУмолчанию;
КонецЕсли;</Текст>
				<Параметры>Источник</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ОчисткаВыборки" ИспользуетсяПриЗагрузке="false">
				<Текст>Индекс = ВыборкаДанных.Количество()-1;
Пока Индекс &gt;= 0 Цикл
	Если ВыборкаДанных[Индекс].РасчетыСПартнерами.Количество() = 0 Тогда
		ВыборкаДанных.Удалить(ВыборкаДанных[Индекс]);
	КонецЕсли;
	Индекс = Индекс-1;
КонецЦикла;</Текст>
				<Параметры>ВыборкаДанных</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ПередВыгрузкойДокумента" ИспользуетсяПриЗагрузке="false">
				<Текст>Если Параметры.ПереноситьТолькоПроведенныеДокументы И Не Источник.Проведен Тогда
	Отказ = Истина;
КонецЕсли;

// Отбор по организациям
Если ЗначениеЗаполнено(Параметры.Организации) И ТипЗнч(Параметры.Организации) = Тип("Массив") 
	И Параметры.Организации.Количество() &gt; 0
	И Источник.Метаданные().Реквизиты.Найти("Организация") &lt;&gt; Неопределено 
	И Параметры.Организации.Найти(Источник.Организация) = Неопределено Тогда
	
	Отказ = Истина;
	// Сообщить("Не прошел отбор организаций документ: " + Источник);
	
КонецЕсли;

// Отбор документов по складам
Если ЗначениеЗаполнено(Параметры.СкладыДляОтбора) И ТипЗнч(Параметры.СкладыДляОтбора) = Тип("Массив")
	И Параметры.СкладыДляОтбора.Количество() &gt; 0 Тогда
	
	// Склад, СкладГруппа, СкладОрдер - один из них
	РеквизитыДокумента = Источник.Метаданные().Реквизиты;
	
	ИмяРеквизитаСклада = "";
	Если РеквизитыДокумента.Найти("Склад") &lt;&gt; Неопределено Тогда
		ИмяРеквизитаСклада = "Склад";
	ИначеЕсли РеквизитыДокумента.Найти("СкладГруппа") &lt;&gt; Неопределено Тогда
		ИмяРеквизитаСклада = "СкладГруппа";
	ИначеЕсли РеквизитыДокумента.Найти("СкладОрдер") &lt;&gt; Неопределено Тогда
		ИмяРеквизитаСклада = "СкладОрдер";
	КонецЕсли;
	
	ЗначениеСклада = Источник[ИмяРеквизитаСклада];
	Если ЗначениеЗаполнено(ЗначениеСклада) И ТипЗнч(ЗначениеСклада) = Тип("СправочникСсылка.Склады") И Параметры.СкладыДляОтбора.Найти(ЗначениеСклада) = Неопределено Тогда
		Отказ = Истина;
	ИначеЕсли ЗначениеЗаполнено(ЗначениеСклада) И ТипЗнч(ЗначениеСклада) &lt;&gt; Тип("СправочникСсылка.Склады") И ИмяРеквизитаСклада = "СкладОрдер"
		И Параметры.СкладыДляОтбора.Найти(ЗначениеСклада.Склад) = Неопределено Тогда // это документ ордер указан в поле "СкладОрдер"
		
		Отказ = Истина;
	Иначе // для СкладГруппа пока всегда разрешаем выгрузку
	КонецЕсли;
	
	
КонецЕсли;

Если Источник.ПометкаУдаления И Не Параметры.ПереноситьПомеченныеНаУдалениеДокументы Тогда
	Отказ = Истина;
КонецЕсли;

Если Не Отказ Тогда
	// Проведение при переносе в УТ 11
	Если Источник.Проведен Тогда
		РежимЗаписи = "Проведение";
	Иначе
		РежимЗаписи = "Запись"; // "ОтменаПроведения";
	КонецЕсли;
	
	КлючВыгружаемыхДанных = Источник.Ссылка;
КонецЕсли;</Текст>
				<Параметры>Источник</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ПередВыгрузкойСтрокиОстатковТоваров" ИспользуетсяПриЗагрузке="false">
				<Текст>Если Окр(ОбъектКоллекции.Количество, 3) = 0 Тогда
	Отказ = Истина;
КонецЕсли;

НаименованиеНоменклатуры = СокрЛП(ОбъектКоллекции.Номенклатура);

Если Найти(НаименованиеНоменклатуры, "&lt;Объект не найден&gt; (" ) &lt;&gt; 0 И Лев(НаименованиеНоменклатуры, 20) = "&lt;Объект не найден&gt; (" тогда
	Отказ = Истина;
КонецЕсли;</Текст>
				<Параметры>Источник, ОбъектКоллекции</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ПереносКИ" ИспользуетсяПриЗагрузке="false">
				<Текст>КоллекцияОбъектов = Новый ТаблицаЗначений;
КоллекцияОбъектов.Колонки.Добавить("Тип");
КоллекцияОбъектов.Колонки.Добавить("Вид");
КоллекцияОбъектов.Колонки.Добавить("Представление");
КоллекцияОбъектов.Колонки.Добавить("ЗначенияПолей");
КоллекцияОбъектов.Колонки.Добавить("Страна");
КоллекцияОбъектов.Колонки.Добавить("Регион");
КоллекцияОбъектов.Колонки.Добавить("Город");
КоллекцияОбъектов.Колонки.Добавить("АдресЭП");
КоллекцияОбъектов.Колонки.Добавить("ДоменноеИмяСервера");
КоллекцияОбъектов.Колонки.Добавить("НомерТелефона");
КоллекцияОбъектов.Колонки.Добавить("НомерТелефонаБезКодов");

Запрос = Новый Запрос("
|ВЫБРАТЬ
|	КонтактнаяИнформация.Тип КАК Тип,
|	КонтактнаяИнформация.Вид КАК Вид,
|	КонтактнаяИнформация.Представление КАК Представление,
|	КонтактнаяИнформация.Поле1 КАК Поле1,
|	КонтактнаяИнформация.Поле2 КАК Поле2,
|	КонтактнаяИнформация.Поле3 КАК Поле3,
|	КонтактнаяИнформация.Поле4 КАК Поле4,
|	КонтактнаяИнформация.Поле5 КАК Поле5,
|	КонтактнаяИнформация.Поле6 КАК Поле6,
|	КонтактнаяИнформация.Поле7 КАК Поле7,
|	КонтактнаяИнформация.Поле8 КАК Поле8,
|	КонтактнаяИнформация.Поле9 КАК Поле9,
|	КонтактнаяИнформация.ТипДома КАК ТипДома,
|	КонтактнаяИнформация.ТипКорпуса КАК ТипКорпуса,
|	КонтактнаяИнформация.ТипКвартиры КАК ТипКвартиры,
|	КонтактнаяИнформация.Комментарий КАК Комментарий
|ИЗ
|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
|ГДЕ
|	КонтактнаяИнформация.Объект = &amp;Контрагент
|");

Запрос.УстановитьПараметр("Контрагент", Источник.Ссылка);

Выборка = Запрос.Выполнить().Выбрать();
Пока Выборка.Следующий() Цикл
	НоваяСтрока = КоллекцияОбъектов.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);

	Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес Тогда
		
		Если ЗначениеЗаполнено(Выборка.ТипДома) Тогда
			ТипДома = НРег(Выборка.ТипДома.Метаданные().ЗначенияПеречисления[Перечисления.ТипыДомов.Индекс(Выборка.ТипДома)].Имя);
		Иначе
			ТипДома = Выборка.ТипДома;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ТипКорпуса) Тогда
			ТипКорпуса = НРег(Выборка.ТипКорпуса.Метаданные().ЗначенияПеречисления[Перечисления.ТипыКорпусов.Индекс(Выборка.ТипКорпуса)].Имя);
		Иначе
			ТипКорпуса = Выборка.ТипКорпуса;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ТипКвартиры) Тогда
			ТипКвартиры = ?(Выборка.ТипКвартиры = Перечисления.ТипыКвартир.Квартира,
				"кв.", НРег(Выборка.ТипКвартиры.Метаданные().ЗначенияПеречисления[Перечисления.ТипыКвартир.Индекс(Выборка.ТипКвартиры)].Имя));
		Иначе
			ТипКвартиры = Выборка.ТипКвартиры;
		КонецЕсли;				
		
		НоваяСтрока.ЗначенияПолей = ?(ЗначениеЗаполнено(Выборка.Поле1), "Индекс=" + Выборка.Поле1 + Символы.ПС, "")
		   + ?(ЗначениеЗаполнено(Выборка.Поле2), "Регион="			+ Выборка.Поле2 + Символы.ПС, "")
		   + ?(ЗначениеЗаполнено(Выборка.Поле3), "Район="			+ Выборка.Поле3 + Символы.ПС, "")
		   + ?(ЗначениеЗаполнено(Выборка.Поле4), "Город="			+ Выборка.Поле4 + Символы.ПС, "") 
		   + ?(ЗначениеЗаполнено(Выборка.Поле5), "НаселенныйПункт="	+ Выборка.Поле5 + Символы.ПС, "")
		   + ?(ЗначениеЗаполнено(Выборка.Поле6), "Улица="			+ Выборка.Поле6 + Символы.ПС, "")
		   + ?(ЗначениеЗаполнено(Выборка.Поле7), "Дом="				+ Выборка.Поле7 + Символы.ПС, "")
		   + ?(ЗначениеЗаполнено(Выборка.Поле8), "Корпус="			+ Выборка.Поле8 + Символы.ПС, "")
		   + ?(ЗначениеЗаполнено(Выборка.Поле9), "Квартира="		+ Выборка.Поле9 + Символы.ПС, "")
		   + ?(ЗначениеЗаполнено(ТипДома),		 "ТипДома="			+ ТипДома		+ Символы.ПС, "")
		   + ?(ЗначениеЗаполнено(ТипКорпуса),	 "ТипКорпуса="		+ ТипКорпуса	+ Символы.ПС, "")
		   + ?(ЗначениеЗаполнено(ТипКвартиры),	 "ТипКвартиры="		+ ТипКвартиры, "");
		   
	ИначеЕсли Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
		
		НоваяСтрока.ЗначенияПолей = ?(ЗначениеЗаполнено(Выборка.Поле1), "КодСтраны="     + Выборка.Поле1 + Символы.ПС, "")
		   + ?(ЗначениеЗаполнено(Выборка.Поле2), "КодГорода="     + Выборка.Поле2 + Символы.ПС, "")
		   + ?(ЗначениеЗаполнено(Выборка.Поле3), "НомерТелефона=" + Выборка.Поле3 + Символы.ПС, "")
		   + ?(ЗначениеЗаполнено(Выборка.Поле4), "Добавочный="    + Выборка.Поле4, "")
		   + ?(ЗначениеЗаполнено(Выборка.Комментарий), "Комментарий="    + Выборка.Комментарий, "");

		НоваяСтрока.НомерТелефонаБезКодов = Выборка.Поле3;
		НоваяСтрока.НомерТелефона         = Выборка.Поле1 + Выборка.Поле2 + Выборка.Поле3;
		
	ИначеЕсли Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты Тогда
		НоваяСтрока.АдресЭП = Выборка.Представление;
	КонецЕсли;
	
	// Удаление символов переноса строк.
	НоваяСтрока.Представление = СтрЗаменить(НоваяСтрока.Представление,Символы.ПС," ");

КонецЦикла;</Текст>
				<Параметры>Источник</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ПереносСвойств" ИспользуетсяПриЗагрузке="false">
				<Текст>Запрос = Новый Запрос("
|ВЫБРАТЬ РАЗЛИЧНЫЕ
|	ЗначенияСвойствОбъектов.Свойство КАК Свойство,
|	ЗначенияСвойствОбъектов.Значение КАК Значение
|ИЗ
|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
|ГДЕ
|	ЗначенияСвойствОбъектов.Объект = &amp;Объект
|");

Запрос.УстановитьПараметр("Объект", Источник.Ссылка);

/// Чераков ОВ - 10.10.2022 - начало
КоллекцияОбъектов = Запрос.Выполнить().Выгрузить();
//Выгрузка = Запрос.Выполнить().Выгрузить();

/// Чераков ОВ - 10.10.2022 - конец</Текст>
				<Параметры>Источник</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ПометкаУдаленияНепроведенных" ИспользуетсяПриЗагрузке="false">
				<Текст>Значение = Источник.ПометкаУдаления;

Если Не Значение И Параметры.ПереноситьНепроведенныеДокументыКакПомеченныеНаУда И Не Источник.Проведен Тогда
	Значение = Истина;
КонецЕсли;</Текст>
				<Параметры>Источник</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ПроверкаВыгрузкиТЧСерий" ИспользуетсяПриЗагрузке="false">
				<Текст>Если Не ЗначениеЗаполнено(ОбъектКоллекции.СерияНоменклатуры) Или Параметры.РежимВыгрузкиСерий = 0 Тогда
	Отказ = Истина;
КонецЕсли;</Текст>
				<Параметры>ОбъектКоллекции, Источник</Параметры>
			</Алгоритм>
			<Алгоритм Имя="РаспределитьОстаткиТоваровПоНомерамГТДОрганизаций" ИспользуетсяПриЗагрузке="false">
				<Текст>Если Не Параметры.ПараметрыАлгоритмов.Свойство("ТаблицаОстатковНомеровГТД") Тогда
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
					|	ТоварыОрганизацийОстатки.Номенклатура,
					// |	ТоварыОрганизацийОстатки.ХарактеристикаНоменклатуры КАК Характеристика,
					|	СУММА(ЕСТЬNULL(ТоварыОрганизацийОстатки.КоличествоОстаток, 0)) КАК Количество,
					|	ТоварыОрганизацийОстатки.СерияНоменклатуры.НомерГТД КАК НомерГТД
					|ИЗ
					|	РегистрНакопления.ТоварыОрганизаций.Остатки(&amp;ДатаОстатков, ) КАК ТоварыОрганизацийОстатки
					|
					|ГДЕ
					|	ТоварыОрганизацийОстатки.СерияНоменклатуры.НомерГТД &lt;&gt; ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка)
					|
					|СГРУППИРОВАТЬ ПО
					|	ТоварыОрганизацийОстатки.Номенклатура,
					//|	ТоварыОрганизацийОстатки.ХарактеристикаНоменклатуры,
					|	ТоварыОрганизацийОстатки.СерияНоменклатуры.НомерГТД";
					
	Запрос.УстановитьПараметр("ДатаОстатков", Новый Граница(КонецДня(НачалоДня(Параметры.ДатаОстатков)-100), ВидГраницы.Включая));

	Параметры.ПараметрыАлгоритмов.Вставить("ТаблицаОстатковНомеровГТД", Запрос.Выполнить().Выгрузить());
	Параметры.ПараметрыАлгоритмов.ТаблицаОстатковНомеровГТД.Индексы.Добавить("Номенклатура");
	
	Сообщить("Заполнены остатки собственных товаров в разрезе номеров ГТД. Количество записей: " 
			+ Параметры.ПараметрыАлгоритмов.ТаблицаОстатковНомеровГТД.Количество());
	
КонецЕсли;

Если Параметры.ПараметрыАлгоритмов.ТаблицаОстатковНомеровГТД.Количество() &gt; 0 Тогда

	Для Каждого СтрокаДокумента Из ВыборкаДанных Цикл
		ВнесеныИзмененияВДокумент = Ложь;
		
		Индекс = СтрокаДокумента.Товары.Количество()-1;
		
		Пока Индекс &gt;= 0 Цикл
			СтрокаТовара = СтрокаДокумента.Товары.Получить(Индекс);
			
			// Сообщить("Номенклатура: " + СтрокаТовара.Номенклатура + ", количество: " + СтрокаТовара.Количество);
			
			Если Не ЗначениеЗаполнено(СтрокаТовара.НомерГТД) Тогда
				НайденныеСтроки = Параметры.ПараметрыАлгоритмов.ТаблицаОстатковНомеровГТД.НайтиСтроки(Новый Структура("Номенклатура", 
																										СтрокаТовара.Номенклатура));
				// Сообщить("Выполнен поиск остатков по ГТД номенклатуры: " + СтрокаТовара.Номенклатура + ". Найдено " + НайденныеСтроки.Количество() + " строк.");
				Если НайденныеСтроки.Количество() &gt; 0 Тогда
					Сообщить("Для строки с товаром " + СтрокаТовара.Номенклатура + " найден остаток с номерами ГТД. Найдено " + НайденныеСтроки.Количество() + " строк. Склад: " 
							+ СтрокаДокумента.Склад + ", Партия: " + СтрокаДокумента.Партия);
					
					Для Каждого СтрокаГТД Из НайденныеСтроки Цикл
						Если СтрокаГТД.Количество &lt;= 0 Или СтрокаТовара.Количество &lt;= 0 Тогда
							Сообщить("Остаток меньше или равен нулю");
							Продолжить;
						КонецЕсли;
						
						Если СтрокаГТД.Количество &gt;= СтрокаТовара.Количество Тогда
							СтрокаГТД.Количество = СтрокаГТД.Количество - СтрокаТовара.Количество;
							СтрокаТовара.НомерГТД = СтрокаГТД.НомерГТД;
							
							Сообщить("Номер ГТД: " + СтрокаТовара.НомерГТД + " (остаток в строке ГТД больше)");
							
							Прервать;
						Иначе
							Сообщить("Номер ГТД: " + СтрокаГТД.НомерГТД + " (остаток больше в строке товара). Количество с ГТД: " + СтрокаГТД.Количество 
									+ ", исходной количество остатка товара: " + СтрокаТовара.Количество);
							
							НоваяСтрока = СтрокаДокумента.Товары.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовара);
							ПолноеКоличество = НоваяСтрока.Количество;
							
							Если Не ЗначениеЗаполнено(НоваяСтрока.СуммаБезНДС) Тогда
								НоваяСтрока.СуммаБезНДС = НоваяСтрока.Сумма - НоваяСтрока.СуммаНДС;
							КонецЕсли;
							
							Если Не ЗначениеЗаполнено(СтрокаТовара.СуммаБезНДС) Тогда
								СтрокаТовара.СуммаБезНДС = СтрокаТовара.Сумма - СтрокаТовара.СуммаНДС;
							КонецЕсли;
							
							// НоваяСтрока
							НоваяСтрока.Количество         = СтрокаГТД.Количество; // пропорционально уменьшаем суммы и количество упаковок
							НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
							НоваяСтрока.СуммаНДС           = Окр(НоваяСтрока.СуммаНДС * НоваяСтрока.Количество / ПолноеКоличество, 2);
							НоваяСтрока.СуммаБезНДС        = Окр(НоваяСтрока.СуммаБезНДС * НоваяСтрока.Количество / ПолноеКоличество, 2);
							НоваяСтрока.Сумма              = Окр(НоваяСтрока.Сумма * НоваяСтрока.Количество / ПолноеКоличество, 2);
							НоваяСтрока.СуммаРегл          = Окр(НоваяСтрока.СуммаРегл * НоваяСтрока.Количество / ПолноеКоличество, 2);
							НоваяСтрока.НДСРегл            = Окр(НоваяСтрока.НДСРегл * НоваяСтрока.Количество / ПолноеКоличество, 2);
							НоваяСтрока.НомерГТД           = СтрокаГТД.НомерГТД;
							Сообщить("Получилось " + НоваяСтрока.Количество + " шт и номер ГТД: " + НоваяСтрока.НомерГТД);
							
							// СтрокаТовара
							СтрокаТовара.Количество         = СтрокаТовара.Количество - СтрокаГТД.Количество; // уменьшаем суммы и кол. упаковок пропорционально
							СтрокаТовара.КоличествоУпаковок = СтрокаТовара.Количество;
							СтрокаТовара.СуммаНДС           = Окр(СтрокаТовара.СуммаНДС * СтрокаТовара.Количество / ПолноеКоличество, 2);
							СтрокаТовара.СуммаБезНДС        = Окр(СтрокаТовара.СуммаБезНДС * СтрокаТовара.Количество / ПолноеКоличество, 2);
							СтрокаТовара.Сумма              = Окр(СтрокаТовара.Сумма * СтрокаТовара.Количество / ПолноеКоличество, 2);
							СтрокаТовара.СуммаРегл          = Окр(СтрокаТовара.СуммаРегл * СтрокаТовара.Количество / ПолноеКоличество, 2);
							СтрокаТовара.НДСРегл            = Окр(СтрокаТовара.НДСРегл * СтрокаТовара.Количество / ПолноеКоличество, 2);
							
							СтрокаГТД.Количество = 0;
						КонецЕсли;	
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
			Индекс = Индекс - 1;
		КонецЦикла;
		
		// Удаление строк с нулевым количеством
		Индекс = СтрокаДокумента.Товары.Количество()-1;
		
		Пока Индекс &gt;= 0 Цикл
			СтрокаТовара = СтрокаДокумента.Товары.Получить(Индекс);
			Если СтрокаТовара.Количество = 0 Тогда
				СтрокаДокумента.Товары.Удалить(СтрокаТовара);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
		
	КонецЦикла;
КонецЕсли;</Текст>
				<Параметры>ВыборкаДанных</Параметры>
			</Алгоритм>
			<Алгоритм Имя="СерияНоменклатурыСтрокиТЧ" ИспользуетсяПриЗагрузке="false">
				<Текст>ИсходящиеДанные = Неопределено;

Если Параметры.РежимВыгрузкиСерий &lt;&gt; 0 Тогда
	Если Не ЗначениеЗаполнено(ВходящиеДанные) Тогда
		ВходящиеДанные = Новый Структура;
	КонецЕсли;
	
	Если ТипЗнч(Источник) &lt;&gt; Тип("Структура") Тогда
		Номенклатура = ОбъектКоллекции.Номенклатура;
	Иначе
		Номенклатура = Источник.Номенклатура;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Номенклатура) Или ТипЗнч(Номенклатура) &lt;&gt; Тип("СправочникСсылка.Номенклатура") Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если Не Отказ Тогда
		ПараметрыПоиска = Новый Структура("Номенклатура", Номенклатура);
		НайденныеСтроки = Параметры.ТабАлкогольнаяПродукцияНоменклатуры.НайтиСтроки(ПараметрыПоиска);

		Если НайденныеСтроки.Количество() &gt; 0 Тогда
			ВходящиеДанные.Вставить("АлкогольнаяПродукция",    НайденныеСтроки[0].АлкогольнаяПродукция);
			ВходящиеДанные.Вставить("ВидАлкогольнойПродукции", НайденныеСтроки[0].ВидАлкогольнойПродукции);
			ВходящиеДанные.Вставить("ВестиУчетПоГТД",          НайденныеСтроки[0].ВестиУчетПоГТД);
		Иначе

			// ВидАлкогольнойПродукции и АлкогольнаяПродукция
			Запрос = Новый Запрос;
			Запрос.Текст = "
				|ВЫБРАТЬ
				|	СведенияОбАлкогольнойПродукции.ВидПродукции,
				|	СведенияОбАлкогольнойПродукции.ВидЛицензии
				|ИЗ
				|	РегистрСведений.СведенияОбАлкогольнойПродукции КАК СведенияОбАлкогольнойПродукции
				|ГДЕ
				|	СведенияОбАлкогольнойПродукции.Номенклатура = &amp;Номенклатура";
				
			Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ВходящиеДанные.Вставить("АлкогольнаяПродукция", Истина);
				ВходящиеДанные.Вставить("ВидАлкогольнойПродукции", Выборка.ВидПродукции);
			Иначе
				ВходящиеДанные.Вставить("АлкогольнаяПродукция", Ложь);
				ВходящиеДанные.Вставить("ВидАлкогольнойПродукции", Справочники.ВидыАлкогольнойПродукции.ПустаяСсылка());
			КонецЕсли;

			// Вести учет по ГТД
			Запрос = Новый Запрос("
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	1
			|ИЗ
			|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
			|ГДЕ
			|	СерииНоменклатуры.НомерГТД &lt;&gt; ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка)
			|	И СерииНоменклатуры.Владелец = &amp;Номенклатура
			|");

			Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

			ВходящиеДанные.Вставить("ВестиУчетПоГТД", Не Запрос.Выполнить().Пустой());
		КонецЕсли;
		
		СоздатьВидНоменклатуры_Номенклатура					= Номенклатура;
		СоздатьВидНоменклатуры_НаименованиеВидаНоменклатуры = Номенклатура.ВидНоменклатуры.Наименование;
		СоздатьВидНоменклатуры_ТипНоменклатуры				= Номенклатура.ВидНоменклатуры.ТипНоменклатуры;
		// Сорокин - 14.06.2016 - начало
		// СоздатьВидНоменклатуры_ИспользоватьСерии			= Истина;
		СоздатьВидНоменклатуры_ИспользоватьСерии			= Номенклатура.ВестиУчетПоСериям;
		// Сорокин - 14.06.2016 - конец
		
		СоздатьВидНоменклатуры_ИмпортнаяАлкогольнаяПродукция = ВходящиеДанные.АлкогольнаяПродукция И ВходящиеДанные.ВестиУчетПоГТД;
		СоздатьВидНоменклатуры_АлкогольнаяПродукция          = ВходящиеДанные.АлкогольнаяПродукция;
		СоздатьВидНоменклатуры_ВидАлкогольнойПродукции       = ВходящиеДанные.ВидАлкогольнойПродукции;
		
		Выполнить(Алгоритмы.СоздатьВидНоменклатуры);

		ИсходящиеДанные = Новый Структура("ВидНоменклатуры", Значение);
	//	Сообщить("Исх. до очистки: " + ИсходящиеДанные.ВидНоменклатуры.Наименование);
		
		Значение  = Неопределено; // очищаем после вида номенклатуры
		
	//	Сообщить("Тип значения объекта коллекции: " + ТипЗнч(ОбъектКоллекции));
	//	Сообщить("Это строка тч: " + (ТипЗнч(ОбъектКоллекции)= Тип("СтрокаТаблицыЗначений")));
		
		Если ТипЗнч(ОбъектКоллекции)= Тип("СтрокаТаблицыЗначений") И ОбъектКоллекции.Владелец().Колонки.Найти("Серия") &lt;&gt; Неопределено Тогда
	//		Сообщить("Нашли колонку серия");
			Значение = ОбъектКоллекции.Серия;
		КонецЕсли;
		Если ТипЗнч(ОбъектКоллекции)= Тип("СтрокаТаблицыЗначений") И ОбъектКоллекции.Владелец().Колонки.Найти("СерияНоменклатуры") &lt;&gt; Неопределено Тогда
	//		Сообщить("Нашли колонку серия номенклатуры");
			Значение = ОбъектКоллекции.СерияНоменклатуры;
		КонецЕсли;
		
		// Документ "Пересортица товаров"
		Если ТипЗнч(ОбъектКоллекции)= Тип("СтрокаТаблицыЗначений") И ОбъектКоллекции.Владелец().Колонки.Найти("СерияНоменклатурыНовая") &lt;&gt; Неопределено Тогда
	//		Сообщить("Нашли колонку серия номенклатуры новая");
			Значение = ОбъектКоллекции.СерияНоменклатурыНовая;
		КонецЕсли;
		
		Если ТипЗнч(Источник) &lt;&gt; Тип("Структура") Тогда
			Попытка
				Если НЕ ЗначениеЗаполнено(Значение) И ТипЗнч(ОбъектКоллекции) &lt;&gt; Тип("СтрокаТаблицыЗначений") 
					И ((ТипЗнч(Источник) &lt;&gt; Тип("ДокументСсылка.ТребованиеНакладная") И ТипЗнч(Источник) &lt;&gt; Тип("ДокументСсылка.КомплектацияНоменклатуры") 
						И Источник.Метаданные().ТабличныеЧасти["Товары"].Реквизиты.Найти("СерияНоменклатуры") &lt;&gt; Неопределено)
					Или (ТипЗнч(Источник) = Тип("ДокументСсылка.ТребованиеНакладная")
						И Источник.Метаданные().ТабличныеЧасти["Материалы"].Реквизиты.Найти("СерияНоменклатуры") &lt;&gt; Неопределено)
					Или (ТипЗнч(Источник) = Тип("ДокументСсылка.КомплектацияНоменклатуры")
						И Источник.Метаданные().ТабличныеЧасти["Комплектующие"].Реквизиты.Найти("СерияНоменклатуры") &lt;&gt; Неопределено)) Тогда
					Значение = ОбъектКоллекции.СерияНоменклатуры;
				КонецЕсли;
			Исключение
				// падает в ошибку при выгрузке номенклатуры битой ссылки
			КонецПопытки;
			Попытка
				Значение = ОбъектКоллекции.СерияНоменклатуры;
			Исключение
			КонецПопытки;
		Иначе
			Значение = Источник.Серия;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			// Сорокин - 14.06.2016 - начало
			// Если у номенклатуры включен серийный учет, то создавать неизвестную серию нужно,
			// Иначе не проведется ни поступление, ни реализация.
			
			Если Номенклатура.ВестиУчетПоСериям И ТипЗнч(Источник) &lt;&gt; Тип("ДокументСсылка.ЗаказПокупателя") Тогда
				Значение = "1";
				ИмяПКО = "НеизвестнаяСерия";
			Иначе
				Отказ = Истина;
			КонецЕсли;
			
			//// Сорокин - 05.05.2016 - начало
			//// Отключено, т.к. ошибка проведения таких документов происходит. Нет на складе этой неизвестной серии
			//// Значение = "1";
			//// ИмяПКО = "НеизвестнаяСерия";
			//Отказ = Истина;
			//// Сорокин - 05.05.2016 - конец
			
			// Сорокин - 14.06.2016 - конец
		Иначе
			ИмяПКО = "СерииНоменклатуры";
		КонецЕсли;
		
		//Сообщить("..................................");
		//Сообщить("..................................");
		//Сообщить("Отказ:" + Отказ);
		//Сообщить("Выгрузка серии в ТЧ документа " + Источник + ", ИмяПКО: " + ИмяПКО + ", Значение: " + Значение + ". Исх.вид номенклатуры: "
		//		+ ИсходящиеДанные.ВидНоменклатуры.Наименование
		//		+ ", номенклатура: " + Номенклатура + ", вести учет по сериям: " + Номенклатура.ВестиУчетПоСериям);
				
		// Сорокин - 04.07.2016 - начало
		// Закомментировал из-за ошибки у Сафонова при выгрузке комплектаций товаров.
		// ВходящиеДанные = ИсходящиеДанные;
		// Сорокин - 04.07.2016 - конец
	КонецЕсли;
Иначе
	Отказ = Истина;
КонецЕсли;</Текст>
				<Параметры>Источник, ОбъектКоллекциии</Параметры>
			</Алгоритм>
			<Алгоритм Имя="СобственныеТоварыВыборка" ИспользуетсяПриЗагрузке="false">
				<Текст>Отказ = Ложь;

ЗапросУчетнаяПолитка = Новый Запрос;
ЗапросУчетнаяПолитка.Текст = 
	"ВЫБРАТЬ
	|	УчетнаяПолитикаСрезПоследних.ВестиПартионныйУчетПоСкладам
	|ИЗ
	|	РегистрСведений.УчетнаяПолитика.СрезПоследних(&amp;ДатаОстатков, ) КАК УчетнаяПолитикаСрезПоследних";
	
ЗапросУчетнаяПолитка.УстановитьПараметр("ДатаОстатков", Новый Граница(КонецДня(Параметры.ДатаОстатков-100), ВидГраницы.Включая));
Выборка = ЗапросУчетнаяПолитка.Выполнить().Выбрать();

Запрос = Новый Запрос;
ВедетсяПартионныйУчетПоСкладам = Выборка.Следующий() И Выборка.ВестиПартионныйУчетПоСкладам;
Сообщить("ВедетсяПартионныйУчетПоСкладам = " + ВедетсяПартионныйУчетПоСкладам);

// Параметры.МассивСобственныхТоваров
Если ВедетсяПартионныйУчетПоСкладам Тогда
	Запрос.Текст = Запросы.СобственныеТоварыНаСкладах.Текст;
	
	ВыборкаОрганизаций = Справочники.Организации.Выбрать();
	ОрганизацияПоУмолчанию = Справочники.Организации.ПустаяСсылка();
	Пока ВыборкаОрганизаций.Следующий() Цикл
		Если Не ВыборкаОрганизаций.ПометкаУдаления Тогда
			ОрганизацияПоУмолчанию = ВыборкаОрганизаций.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Запрос.УстановитьПараметр("ОрганизацияПоУмолчанию", ОрганизацияПоУмолчанию);
Иначе
	Запрос.Текст = Запросы.СобственныеТоварыПартииБезСкладов.Текст;
КонецЕсли;

Сообщить("Количество товаров к отбору: " + Параметры.МассивСобственныхТоваров.Количество());

Если Параметры.Свойство("МассивСобственныхТоваров") И Параметры.МассивСобственныхТоваров.Количество() &gt; 0 Тогда
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Номенклатура.ВидНоменклатуры.ТипНоменклатуры = ", " И Номенклатура В (&amp;МассивСобственныхТоваров) И Номенклатура.ВидНоменклатуры.ТипНоменклатуры = ");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "(&amp;ДатаОстатков, ) КАК НДСПартииТоваровОстатки", "(&amp;ДатаОстатков, Номенклатура В (&amp;МассивСобственныхТоваров)) КАК НДСПартииТоваровОстатки");
	
	Запрос.УстановитьПараметр("МассивСобственныхТоваров", Параметры.МассивСобственныхТоваров);
КонецЕсли;

Если Параметры.Организации.Количество() &gt; 0 Тогда
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПО (ИСТИНА)", 
								"ПО (ИСТИНА)
						        |ГДЕ
								|	ОстаткиПоПартиямСУчетнойПолитикой.Организация В (&amp;МассивОрганизаций) ИЛИ ОстаткиПоПартиямСУчетнойПолитикой.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) ");
	Запрос.УстановитьПараметр("МассивОрганизаций", Параметры.Организации);
КонецЕсли;

Запрос.УстановитьПараметр("ДатаОстатков", Параметры.ДатаОстатков-1);
Запрос.УстановитьПараметр("ВалютаУпрУчета", Константы.ВалютаУправленческогоУчета.Получить());

ВыборкаДанных = Новый ТаблицаЗначений;
ВыборкаДанных.Колонки.Добавить("Дата");
ВыборкаДанных.Колонки.Добавить("Организация");
ВыборкаДанных.Колонки.Добавить("Валюта");
ВыборкаДанных.Колонки.Добавить("Склад");
ВыборкаДанных.Колонки.Добавить("Партия");
ВыборкаДанных.Колонки.Добавить("Партнер");
ВыборкаДанных.Колонки.Добавить("Контрагент");
ВыборкаДанных.Колонки.Добавить("Договор");
ВыборкаДанных.Колонки.Добавить("ПредъявленСчетФактура");
ВыборкаДанных.Колонки.Добавить("НомерСчетаФактуры");
ВыборкаДанных.Колонки.Добавить("ДатаСчетаФактуры");
ВыборкаДанных.Колонки.Добавить("Товары");
ВыборкаДанных.Колонки.Добавить("Серии");
ВыборкаДанных.Колонки.Добавить("Комментарий");

Если ВедетсяПартионныйУчетПоСкладам Тогда
	
	РезультатыЗапроса = Запрос.Выполнить();
	Сообщить("Количество строк результата запроса: " + РезультатыЗапроса.Выгрузить().Количество());
	
	ВыборкаПоОрганизациям = РезультатыЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоОрганизациям.Следующий() Цикл
		
		//Сообщить("Выгружается организация - " + ВыборкаПоОрганизациям.Организация);
		ВыборкаПоСкладам = ВыборкаПоОрганизациям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоСкладам.Следующий() Цикл
			
			//Сообщить("Выгружается склад - " + ВыборкаПоСкладам.Склад);
			ВыборкаПоСложномуУчету = ВыборкаПоСкладам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПоСложномуУчету.Следующий() Цикл
				
				ВыборкаПоДокументамПоступления = ВыборкаПоСложномуУчету.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаПоДокументамПоступления.Следующий() Цикл
					НоваяСтрока = ВыборкаДанных.Добавить();
					НоваяСтрока.Дата        = КонецДня(Параметры.ДатаОстатков); 
					НоваяСтрока.Организация = ВыборкаПоОрганизациям.Организация;
					НоваяСтрока.Склад       = ВыборкаПоСкладам.Склад;
					НоваяСтрока.Комментарий = НСтр("ru = 'УТ10.3 -&gt; УТ11/КА2/ERP2: Собственные товары на складах'");
					НоваяСтрока.Валюта = Константы.ВалютаУправленческогоУчета.Получить();
					НоваяСтрока.Партия = ВыборкаПоДокументамПоступления.ДокументОприходования;
					
					ПредъявленСФ = Неопределено; ДополнениеККоментарию = "";
					ПредъявленСФ = УчетНДС.НайтиПодчиненныйДокумент(ВыборкаПоДокументамПоступления.ДокументОприходования, "СчетФактураПолученный");
					
					НоваяСтрока.ПредъявленСчетФактура = Ложь;
					Если ЗначениеЗаполнено(ВыборкаПоДокументамПоступления.ДокументОприходования) Тогда
						ДополнениеККоментарию = НСтр("ru = '. Остатки по документу номер: %1 от: %2'");
						ДополнениеККоментарию = СтрЗаменить(ДополнениеККоментарию, "%2", ВыборкаПоДокументамПоступления.ДатаДокументаОприходования);
						ДополнениеККоментарию = СтрЗаменить(ДополнениеККоментарию, "%1", ВыборкаПоДокументамПоступления.НомерДокументаОприходования);
					КонецЕсли;
					
					Контрагент = ВыборкаПоДокументамПоступления.Партнер;
					Договор    = ВыборкаПоДокументамПоступления.Договор;
					
					Если ЗначениеЗаполнено(ПредъявленСФ) Тогда
						
						ДанныеСФ = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(ПредъявленСФ, "Контрагент, ДоговорКонтрагента, НомерВходящегоДокумента, ДатаВходящегоДокумента");
						
						НоваяСтрока.ПредъявленСчетФактура = Истина;
						НоваяСтрока.НомерСчетаФактуры = ДанныеСФ.НомерВходящегоДокумента;
						НоваяСтрока.ДатаСчетаФактуры  = ДанныеСФ.ДатаВходящегоДокумента;
						
						Если Не ЗначениеЗаполнено(Контрагент) Тогда
							Контрагент = ДанныеСФ.Контрагент;
							Договор    = ДанныеСФ.ДоговорКонтрагента;
						КонецЕсли;
						
					КонецЕсли;
					
					НоваяСтрока.Партнер    = Контрагент;
					НоваяСтрока.Контрагент = Контрагент;
					НоваяСтрока.Договор    = Договор;
					
					НоваяСтрока.Комментарий = НоваяСтрока.Комментарий + ДополнениеККоментарию;

					НоваяСтрока.Товары = Новый ТаблицаЗначений;
					НоваяСтрока.Товары.Колонки.Добавить("Номенклатура");
					НоваяСтрока.Товары.Колонки.Добавить("Характеристика");
					НоваяСтрока.Товары.Колонки.Добавить("Качество");
					НоваяСтрока.Товары.Колонки.Добавить("Количество");
					НоваяСтрока.Товары.Колонки.Добавить("КоличествоУпаковок");
					НоваяСтрока.Товары.Колонки.Добавить("Цена");
					НоваяСтрока.Товары.Колонки.Добавить("Сумма");
					НоваяСтрока.Товары.Колонки.Добавить("СуммаРегл");
					НоваяСтрока.Товары.Колонки.Добавить("СтавкаНДС");
					НоваяСтрока.Товары.Колонки.Добавить("СуммаБезНДС");
					НоваяСтрока.Товары.Колонки.Добавить("СуммаНДС");
					НоваяСтрока.Товары.Колонки.Добавить("НДСРегл");
					НоваяСтрока.Товары.Колонки.Добавить("НомерГТД");
					НоваяСтрока.Товары.Колонки.Добавить("Серия");
					НоваяСтрока.Товары.Колонки.Добавить("Склад");
					
					НоваяСтрока.Серии = Новый ТаблицаЗначений;
					НоваяСтрока.Серии.Колонки.Добавить("Номенклатура");
					НоваяСтрока.Серии.Колонки.Добавить("Характеристика");
					НоваяСтрока.Серии.Колонки.Добавить("Качество");
					НоваяСтрока.Серии.Колонки.Добавить("Серия");
					НоваяСтрока.Серии.Колонки.Добавить("Количество");
					НоваяСтрока.Серии.Колонки.Добавить("КоличествоУпаковок");
			
					ВыборкаДетальныеЗаписи = ВыборкаПоДокументамПоступления.Выбрать();
					Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
						
						//Сообщить("Выгружается номенклатура - " + ВыборкаДетальныеЗаписи.Номенклатура);
			
						СтрокаСообщения = "";
						Если ВыборкаДетальныеЗаписи.Количество &lt; 0 Тогда
							СтрокаСообщения = НСтр("ru = 'Обнаружен отрицательный остаток на складе ""%1"" по товару ""%2"" при выгрузке по правилу: ""%3""'");
						ИначеЕсли ВыборкаДетальныеЗаписи.Сумма &lt; 0 Или ВыборкаДетальныеЗаписи.Количество = 0 Тогда
							СтрокаСообщения = НСтр("ru = 'Обнаружен некорректный суммовой остаток на складе ""%1"" по товару ""%2"" при выгрузке по правилу: ""%3""'");
						ИначеЕсли ВыборкаДетальныеЗаписи.СуммаСНДСРегл &lt; ВыборкаДетальныеЗаписи.НДСРегл Или ВыборкаДетальныеЗаписи.НДСРегл &lt; 0 Тогда
							СтрокаСообщения = НСтр("ru = 'Обнаружен некорректный суммовой остаток по данным регл. учета на складе ""%1"" по товару ""%2"" при выгрузке по правилу: ""%3""'");
						КонецЕсли;
						
						Если ЗначениеЗаполнено(СтрокаСообщения) Тогда
							СтрокаСообщения = СтрЗаменить(СтрокаСообщения, "%1", ВыборкаПоСкладам.Склад);
							СтрокаСообщения = СтрЗаменить(СтрокаСообщения, "%2", ВыборкаДетальныеЗаписи.Номенклатура);
							СтрокаСообщения = СтрЗаменить(СтрокаСообщения, "%3", НСтр("ru = 'Собственные товары на складах'"));
							ЗаписатьВПротоколВыполнения(СтрокаСообщения,,Ложь);
							Продолжить;
						КонецЕсли;
				
						НоваяСтрокаТовары = НоваяСтрока.Товары.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрокаТовары, ВыборкаДетальныеЗаписи);
						НоваяСтрокаТовары.Склад              = НоваяСтрока.Склад;
						НоваяСтрокаТовары.Цена               = ВыборкаДетальныеЗаписи.Сумма / ВыборкаДетальныеЗаписи.Количество;
						НоваяСтрокаТовары.КоличествоУпаковок = ВыборкаДетальныеЗаписи.Количество;
						
						Если НоваяСтрокаТовары.СтавкаНДС &lt;&gt; НоваяСтрокаТовары.Номенклатура.СтавкаНДС И ЗначениеЗаполнено( НоваяСтрокаТовары.Номенклатура.СтавкаНДС ) Тогда
							НоваяСтрокаТовары.СтавкаНДС = НоваяСтрокаТовары.Номенклатура.СтавкаНДС;
						КонецЕсли;
				
						Если НоваяСтрокаТовары.НДСРегл = 0 Тогда
							СтавкаНДСЧислом = УчетНДС.ПолучитьСтавкуНДС( НоваяСтрокаТовары.СтавкаНДС ) / 100;
							НоваяСтрокаТовары.СуммаНДС    = НоваяСтрокаТовары.Сумма / (СтавкаНДСЧислом + 1) * СтавкаНДСЧислом;
							НоваяСтрокаТовары.НДСРегл     = ВыборкаДетальныеЗаписи.СуммаСНДСРегл / (СтавкаНДСЧислом + 1) * СтавкаНДСЧислом;
							НоваяСтрокаТовары.СуммаБезНДС = НоваяСтрокаТовары.Сумма - НоваяСтрокаТовары.СуммаНДС;
						КонецЕсли;
				
						НоваяСтрокаТовары.СуммаРегл = ВыборкаДетальныеЗаписи.СуммаСНДСРегл - НоваяСтрокаТовары.НДСРегл;
				
						Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.НомерГТД) Тогда
							НоваяСтрокаТовары.НомерГТД = Новый Структура;
							НоваяСтрокаТовары.НомерГТД.Вставить("Владелец", ВыборкаДетальныеЗаписи.Номенклатура);
							НоваяСтрокаТовары.НомерГТД.Вставить("СтранаПроисхождения", ВыборкаДетальныеЗаписи.СтранаПроисхождения);
							НоваяСтрокаТовары.НомерГТД.Вставить("ПометкаУдаления", ВыборкаДетальныеЗаписи.ПометкаУдаления);
							НоваяСтрокаТовары.НомерГТД.Вставить("Код", ВыборкаДетальныеЗаписи.НомерГТД);
						КонецЕсли;
				
						// Запоминаем серии номенклатуры, если для нее ведется учет серий
						Если ВыборкаДетальныеЗаписи.ВестиУчетПоСериям Тогда
							Если Параметры.РежимВыгрузкиСерий &gt; 0 И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Серия) Тогда
								НоваяСтрокаСерии = НоваяСтрока.Серии.Добавить();
								НоваяСтрокаСерии.КоличествоУпаковок = ВыборкаДетальныеЗаписи.Количество;
								ЗаполнитьЗначенияСвойств(НоваяСтрокаСерии, ВыборкаДетальныеЗаписи);
								
								НоваяСтрокаТовары.Серия = ВыборкаДетальныеЗаписи.Серия;
							КонецЕсли;	
						КонецЕсли;
						
					КонецЦикла;
			
					Если НоваяСтрока.Товары.Количество() = 0 Тогда
						ВыборкаДанных.Удалить(НоваяСтрока);
					Иначе
						Если Параметры.РежимВыгрузкиСерий &gt; 0 Тогда
							НоваяСтрока.Серии.Свернуть("Номенклатура, Характеристика, Качество, Серия", "Количество, КоличествоУпаковок");
						Иначе
							НоваяСтрока.Серии.Очистить();
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Сообщить("Выборка данных: " + ВыборкаДанных.Количество());
	
Иначе // если не ведется партионный учет по складам
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ТаблицаПартииТоваров    = РезультатыЗапроса[РезультатыЗапроса.Количество()-2].Выгрузить();
	ТаблицаТоваровПоСкладам = РезультатыЗапроса[РезультатыЗапроса.Количество()-1].Выгрузить();
	
	Если Не Константы.ИспользоватьХарактеристикиНоменклатуры.Получить() Тогда
		ТаблицаТоваровПоСкладам.Свернуть("Организация, Склад, Номенклатура, ВестиУчетПоСериям, ВестиПартионныйУчетПоСериям, Серия, Качество", "Количество");
		ТаблицаПартииТоваров.Свернуть("Организация, Номенклатура, Качество, Серия, СтавкаНДС, НомерГТД, СтранаПроисхождения", 
										"Количество, Сумма, НДСРегл, СуммаНДС, СуммаСНДСРегл");
	КонецЕсли;
	
	ТекущийСклад          = Неопределено;
	ТекущаяОрганизация    = Неопределено;
	
	НоваяСтрока = Неопределено;
	
	Для Каждого Строка Из ТаблицаТоваровПоСкладам Цикл
		Если Строка.Организация &lt;&gt; ТекущаяОрганизация Или ТекущийСклад &lt;&gt; Строка.Склад Тогда
			
			Если Не ЗначениеЗаполнено(НоваяСтрока) Или НоваяСтрока.Товары.Количество() &gt; 0 Тогда 
				НоваяСтрока = ВыборкаДанных.Добавить();
			КонецЕсли;	
						
			ТекущаяОрганизация    = Строка.Организация;
			ТекущийСклад          = Строка.Склад;
						
			НоваяСтрока.Дата        = КонецДня(Параметры.ДатаОстатков); 
			НоваяСтрока.Организация = ТекущаяОрганизация;
			НоваяСтрока.Склад       = Строка.Склад;
			НоваяСтрока.Комментарий = НСтр("ru = 'УТ 10.3 -&gt; УТ 11: Собственные товары на складах'");
			НоваяСтрока.Валюта      = Константы.ВалютаУправленческогоУчета.Получить();
			
			НоваяСтрока.Товары = Новый ТаблицаЗначений;
			НоваяСтрока.Товары.Колонки.Добавить("Номенклатура");
			НоваяСтрока.Товары.Колонки.Добавить("Характеристика");
			НоваяСтрока.Товары.Колонки.Добавить("Качество");
			НоваяСтрока.Товары.Колонки.Добавить("Количество");
			НоваяСтрока.Товары.Колонки.Добавить("КоличествоУпаковок");
			НоваяСтрока.Товары.Колонки.Добавить("Цена");
			НоваяСтрока.Товары.Колонки.Добавить("Сумма");
			НоваяСтрока.Товары.Колонки.Добавить("СуммаРегл");
			НоваяСтрока.Товары.Колонки.Добавить("СтавкаНДС");
			НоваяСтрока.Товары.Колонки.Добавить("СуммаБезНДС");
			НоваяСтрока.Товары.Колонки.Добавить("СуммаНДС");
			НоваяСтрока.Товары.Колонки.Добавить("СуммаСНДС");
			НоваяСтрока.Товары.Колонки.Добавить("НДСРегл");
			НоваяСтрока.Товары.Колонки.Добавить("НомерГТД");
			НоваяСтрока.Товары.Колонки.Добавить("Серия");
			НоваяСтрока.Товары.Колонки.Добавить("ВестиУчетПоСериям");
			НоваяСтрока.Товары.Колонки.Добавить("ВестиПартионныйУчетПоСериям");
			НоваяСтрока.Товары.Колонки.Добавить("Склад");
			
			НоваяСтрока.Серии = Новый ТаблицаЗначений;
			НоваяСтрока.Серии.Колонки.Добавить("Номенклатура");
			НоваяСтрока.Серии.Колонки.Добавить("Характеристика");
			НоваяСтрока.Серии.Колонки.Добавить("Качество");
			НоваяСтрока.Серии.Колонки.Добавить("Серия");
			НоваяСтрока.Серии.Колонки.Добавить("Количество");
			НоваяСтрока.Серии.Колонки.Добавить("КоличествоУпаковок");
			
		КонецЕсли;
		
		СтрокаСообщения = "";
		Если Строка.Количество &lt; 0 Тогда
			СтрокаСообщения = НСтр("ru = 'Обнаружен отрицательный остаток на складе ""%1"" по товару ""%2"" при выгрузке по правилу: ""%3""'");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаСообщения) Тогда
			СтрокаСообщения = СтрЗаменить(СтрокаСообщения, "%1", Строка.Склад);
			СтрокаСообщения = СтрЗаменить(СтрокаСообщения, "%2", Строка.Номенклатура);
			СтрокаСообщения = СтрЗаменить(СтрокаСообщения, "%3", НСтр("ru = 'Собственные товары на складах'"));
			ЗаписатьВПротоколВыполнения(СтрокаСообщения,,Ложь);
			Сообщить(СтрокаСообщения);
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Сообщить("В строке остатков не обнаружена номенклатура");
			Продолжить;
		КонецЕсли;

		НоваяСтрокаТовары = НоваяСтрока.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТовары, Строка);
		НоваяСтрокаТовары.КоличествоУпаковок = Строка.Количество;
		НоваяСтрокаТовары.Склад = НоваяСтрока.Склад;
		
