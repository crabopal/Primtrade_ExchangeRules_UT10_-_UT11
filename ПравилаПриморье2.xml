			<Алгоритм Имя="ВыполнитьПроведениеДокументов" ИспользуетсяПриЗагрузке="true">
				<Текст>// УТ 10 - УТ 11

Если Не Параметры.ОтключитьПроведениеДокументовПослеЗагрузки Тогда

	Параметры.ДокументыДляПроведения.Сортировать("Дата Возр");

	СтрокаСообщения = "Запускается проведение загруженных документов. Всего " + Параметры.ДокументыДляПроведения.Количество() + " шт. документов будет проведено.";
	Сообщить(СтрокаСообщения);

	// Сначала проводим заказы клиентов для заполнения кодов строк в движениях регистра "Заказы клиентов".
	Для Каждого Строка Из Параметры.ДокументыДляПроведения Цикл
		Если ТипЗнч(Строка.Объект) = Тип("ДокументОбъект.ЗаказКлиента") Или ТипЗнч(Строка.Объект) = Тип("ДокументОбъект.ЗаказПоставщику") Тогда
			Документ = Строка.Объект;
			
			РежимЗаписи = РежимЗаписиДокумента.Запись; // РежимЗаписиДокумента.ОтменаПроведения;
			Если Строка.РежимЗаписи = "Проведение" Тогда
				РежимЗаписи = РежимЗаписиДокумента.Проведение;
			ИначеЕсли Строка.РежимЗаписи = "Запись" Тогда
				РежимЗаписи = РежимЗаписиДокумента.Запись;
			КонецЕсли;
			
			Если Не Документ.ЭтоНовый() Тогда
				
				ДокументОбъект = Документ.Ссылка.ПолучитьОбъект();
				УстановитьОбменДаннымиЗагрузка(ДокументОбъект, Ложь);
				
				Попытка
					
					Если ДокументОбъект.ПроверитьЗаполнение() Тогда
						
						ДокументОбъект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов", Истина);
