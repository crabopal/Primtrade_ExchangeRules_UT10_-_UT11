		НоваяСтрокаАлко = Параметры.ТабАлкогольнаяПродукцияНоменклатуры.Добавить();
		НоваяСтрокаАлко.Номенклатура            = Источник;
		НоваяСтрокаАлко.АлкогольнаяПродукция    = ВходящиеДанные.АлкогольнаяПродукция;
		НоваяСтрокаАлко.ВестиУчетПоГТД          = ВходящиеДанные.ВестиУчетПоГТД;
		НоваяСтрокаАлко.ВидАлкогольнойПродукции = ВходящиеДанные.ВидАлкогольнойПродукции;

	КонецЕсли;
	
	// Упаковки
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	1
	|ИЗ
	|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|ГДЕ
	|	ЕдиницыИзмерения.Владелец = &amp;Ссылка
	|	И ЕдиницыИзмерения.Коэффициент &lt;&gt; 1
	|	И НЕ ЕдиницыИзмерения.ПометкаУдаления ";
	Запрос.УстановитьПараметр("Ссылка", Источник);
	
	ВходящиеДанные.Вставить("ИспользоватьУпаковки", Не Запрос.Выполнить().Пустой());
КонецЕсли;</Текст>
				<Параметры>Источник</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ВыбратьПКОЕдиницыИзмерения" ИспользуетсяПриЗагрузке="false">
				<Текст>Если Не ЗначениеЗаполнено(Значение) Тогда
	Отказ = Истина;
ИначеЕсли Значение.Коэффициент &lt;&gt; 1 Тогда
	ИмяПКО = "ЕдиницыИзмерения_Упаковки";
	Если ЗначениеЗаполнено(ВходящиеДанные) И ВходящиеДанные.Свойство("КодНоменклатуры") Тогда
		Если Не ЗначениеЗаполнено(ИсходящиеДанные) Тогда
			ИсходящиеДанные = Новый Структура();
		КонецЕсли;
		ИсходящиеДанные.Вставить("КодНоменклатуры", ВходящиеДанные.КодНоменклатуры);
		
		Сообщить("Ура! При выгрузке упаковок получилось определить код номенклатуры текущий: " + ВходящиеДанные.КодНоменклатуры
				+ ", для номенклатуры: " + ОбъектКоллекции.Владелец + " и выгрузить во вход. данные упаковок!!");
	КонецЕсли;
Иначе
	ИмяПКО = "ЕдиницыИзмерения_ЕдиницыХранения";
КонецЕсли;</Текст>
				<Параметры>Значение</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ВыбратьПКОНоменклатуры" ИспользуетсяПриЗагрузке="false">
				<Текст>ИмяПКО = "НоменклатураНеЗамещатьСвойства";

Если ЗначениеЗаполнено(Значение) И Значение.ЭтоГруппа Тогда
	
	ИмяПКО = "ГруппаНоменклатуры";
	
ИначеЕсли Параметры.ОтключитьХарактеристикиПереноситьИхВНоменклатуру = Истина Тогда

	Характеристика = Неопределено;

	Попытка
		Характеристика = ОбъектКоллекции.ХарактеристикаНоменклатуры;
	Исключение
	КонецПопытки;

	Если Не ЗначениеЗаполнено(Характеристика) Тогда
		Попытка
			Характеристика = ОбъектКоллекции.Характеристика;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Характеристика) Тогда
		Попытка
			Характеристика = Источник.ХарактеристикаНоменклатуры;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Характеристика) Тогда
		Попытка
			Характеристика = Источник.Характеристика;
		Исключение
		КонецПопытки;
	КонецЕсли;
	     
	Если ИсходящиеДанные = Неопределено Тогда
		ИсходящиеДанные = Новый Структура();
	КонецЕсли;
	
	ЗначениеХарактеристики = Параметры.ХарактеристикиНоменклатуры.Получить(Значение);
	Если ЗначениеЗаполнено(Характеристика) И Не ЗначениеЗаполнено(ЗначениеХарактеристики) Тогда
		Параметры.ХарактеристикиНоменклатуры.Вставить(Значение, Характеристика);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Характеристика) Тогда
		ИсходящиеДанные.Вставить("КодНоменклатуры", СокрЛП(Значение.Код) + ВРег(СокрЛП(Характеристика.Наименование)));
	ИначеЕсли ЗначениеЗаполнено(ВходящиеДанные) И ВходящиеДанные.Свойство("КодНоменклатуры") 
		И ЗначениеЗаполнено(ВходящиеДанные.КодНоменклатуры) 
		И Найти(ВходящиеДанные.КодНоменклатуры, СокрЛП(Значение.Код)) &gt; 0 Тогда
		// уже все ок (передали из входящих параметров)
		ИсходящиеДанные.Вставить("КодНоменклатуры", ВходящиеДанные.КодНоменклатуры);
	ИначеЕсли ЗначениеЗаполнено(ЗначениеХарактеристики) Тогда
		ИсходящиеДанные.Вставить("КодНоменклатуры", СокрЛП(Значение.Код) + ВРег(СокрЛП(ЗначениеХарактеристики.Наименование)));	
	Иначе
		
		// По согласованию
		ЗапросХарактеристик = Новый Запрос();
		ЗапросХарактеристик.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
									|	ХарактеристикиНоменклатуры.Ссылка
									|ИЗ
									|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
									|ГДЕ
									|	ХарактеристикиНоменклатуры.Владелец = &amp;Владелец
									|	И НЕ ХарактеристикиНоменклатуры.ПометкаУдаления";
		ЗапросХарактеристик.УстановитьПараметр("Владелец", Значение);
		
		Выгрузка = ЗапросХарактеристик.Выполнить().Выгрузить();
		
		ИмяХарактеристики = "";
		Если Выгрузка.Количество() &gt; 0 Тогда
			ИмяХарактеристики = СокрЛП(Выгрузка.Получить(0).Ссылка);
		КонецЕсли;		
		ИсходящиеДанные.Вставить("КодНоменклатуры", СокрЛП(Значение.Код) + ИмяХарактеристики);
	КонецЕсли;

	ИмяПКО = "НоменклатураСХарактеристикойПоискПоКоду";
	
	// Для передачи в ПКС ЕдиницыИзмерения_Упаковки ТЕКУЩЕЙ строки передаваемой табличной части:
	Если Не ЗначениеЗаполнено(ВходящиеДанные) Тогда
		ВходящиеДанные = Новый Структура();
	КонецЕсли;
	ВходящиеДанные.Вставить("КодНоменклатуры", ИсходящиеДанные.КодНоменклатуры);

Иначе
	ИмяПКО = "НоменклатураНеЗамещатьСвойства";
КонецЕсли;</Текст>
				<Параметры>Значение, ОбъектКоллекции</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ВыбратьПКООбъекта" ИспользуетсяПриЗагрузке="false">
				<Текст>Если Не ЗначениеЗаполнено(Значение) Или ТипЗнч(Значение) = Тип("Дата") Или ТипЗнч(Значение) = Тип("Строка") 
	Или ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Отказ = Истина;
	КонецЕсли;
	
	ИмяПКО = "";

Иначе
	НайденныеСтроки = ПКО.Владелец().НайтиСтроки(Новый Структура("Источник", ТипЗнч(Значение)));
	ТипДокумента = ТипЗнч(Значение);
	
	Если НайденныеСтроки.Количество() &gt; 0 Тогда
		ИмяПКО = НайденныеСтроки[0].Имя;
		
		Если ТипДокумента = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			ИмяПКО = "ЗаказКлиента";
			
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
			ИмяПКО = "СчетНаОплатуПокупателю_ЗаказКлиента";
			
		ИначеЕсли ТипДокумента = Тип("СправочникСсылка.Номенклатура") Тогда
			Если Значение.ЭтоГруппа Тогда
				ИмяПКО = "ГруппаНоменклатуры";
			Иначе
				ИмяПКО = "НоменклатураНеЗамещатьСвойства";
			КонецЕсли;
			
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.АвансовыйОтчет") Тогда
			ИмяПКО = "АвансовыйОтчет";
			
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПоступлениеТоваровУслугВНТТ") Тогда
			ИмяПКО = "ПоступлениеТоваровУслугНТТ_ПоступлениеТоваровУслуг";
		
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда
			ИмяПКО = "ПриходныйОрдерНаТовары";
		
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			ИмяПКО = "ПоступлениеТоваровУслуг";
			
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			ИмяПКО = "РеализацияТоваровУслуг";
			
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			ИмяПКО = "ЗаказПоставщику";
			
		ИначеЕсли ТипДокумента = Тип("СправочникСсылка.Пользователи") Тогда
			ИмяПКО = "Пользователи";
			
		ИначеЕсли ТипДокумента = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			ИмяПКО = "ДоговорыКонтрагентов";
			
		ИначеЕсли ТипДокумента = Тип("СправочникСсылка.СтатьиДвиженияДенежныхСредств") Тогда
			ИмяПКО = "СтатьиДвиженияДенежныхСредств";
			
		ИначеЕсли ТипДокумента = Тип("СправочникСсылка.Контрагенты") Тогда
			ИмяПКО = "Контрагенты_Контрагенты";
			
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КорректировкаДолга") Тогда
			ИмяПКО = "КорректировкаДолгаКорректировкаРегистровСсылка";
			
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетОРозничныхПродажах") Тогда
			ИмяПКО = "ОтчетОРозничныхПродажах";
		ИначеЕсли ТипДокумента = Тип("СправочникСсылка.ТипыЦенНоменклатуры") Тогда
			ИмяПКО = "ТипыЦенНоменклатуры_ВидыЦен";
		ИначеЕсли ТипДокумента = Тип("СправочникСсылка.Склады") Тогда
			ИмяПКО = "Склады";
			
			
		ИначеЕсли НайденныеСтроки.Количество() &gt; 1 Тогда
			Сообщить("Для объекта " + Значение + " выбрано ИмяПКО: " + ИмяПКО);
			
		КонецЕсли;
		
		// Сообщить("Выгружаем " + Значение + " Тип: " + ТипЗнч(Значение) + " по правилу: " + ИмяПКО);
		
		
	Иначе
		Отказ = Истина;
		ИмяПКО = "";
		
		Если ТипДокумента &lt;&gt; Тип("ДокументСсылка.СчетНаОплатуПоставщика") И ТипДокумента &lt;&gt; Тип("ДокументСсылка.ПланируемоеПоступлениеДенежныхСредств") Тогда
			Сообщить("Не найдено ПКО для документа: " + Значение + " (" + СокрЛП(ТипДокумента) + ")");
		КонецЕсли;
		
	КонецЕсли;
	
КонецЕсли;</Текст>
				<Параметры>Значение, ПКО</Параметры>
			</Алгоритм>
			<Алгоритм Имя="ВыбратьПКОСклада" ИспользуетсяПриЗагрузке="false">
				<Текст>ИмяПКО = "Склады";

Если ЗначениеЗаполнено(Значение) Тогда
	Если Параметры.СкладыОбъединятьПоГруппе Тогда
		Если ЗначениеЗаполнено(Значение.Родитель)
			И НЕ Значение.ЭтоГруппа Тогда
			
			//Если Значение.ВидСклада = Перечисления.ВидыСкладов.НТТ
			// ИЛИ Значение.ВидСклада = Перечисления.ВидыСкладов.Розничный Тогда
			 
				Значение = Значение.Родитель;
				ИмяПКО = "ГруппыСкладов_Склады";
				
			//КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецЕсли;</Текст>
			</Алгоритм>
			<Алгоритм Имя="ВыгрузитьРасчетыСКонтрагентами" ИспользуетсяПриЗагрузке="false">
				<Текст>ВидыДоговоров = Новый Массив;
Если ИмяПравила = "ВводОстатковДолгиИАвансыПоставщикам" Тогда
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);	
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СКомитентом);	
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.Прочее);
Иначе
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);	
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером);	
КонецЕсли;	
	
Запрос = Новый Запрос(
"ВЫБРАТЬ
|	ВЫБОР
|		КОГДА ВзаиморасчетыСКонтрагентамиОстатки.ДоговорКонтрагента.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком)
|				ИЛИ ВзаиморасчетыСКонтрагентамиОстатки.ДоговорКонтрагента.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СКомитентом)
|				ИЛИ ВзаиморасчетыСКонтрагентамиОстатки.ДоговорКонтрагента.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.Прочее)
|			ТОГДА ВЫБОР
|					КОГДА ВзаиморасчетыСКонтрагентамиОстатки.СуммаВзаиморасчетовОстаток &lt; 0
|						ТОГДА ""ВводОстатковЗадолженностиПоставщикам""
|					ИНАЧЕ ""ВводОстатковАвансовПоставщикам""
|				КОНЕЦ
|		ИНАЧЕ ВЫБОР
|				КОГДА ВзаиморасчетыСКонтрагентамиОстатки.СуммаВзаиморасчетовОстаток &lt; 0
|					ТОГДА ""ВводОстатковАвансовКлиентов""
|				ИНАЧЕ ""ВводОстатковЗадолженностиКлиентов""
|			КОНЕЦ
|	КОНЕЦ КАК ХозяйственнаяОперация,
|	ВЫБОР
|		КОГДА ВзаиморасчетыСКонтрагентамиОстатки.ДоговорКонтрагента.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком)
|				ИЛИ ВзаиморасчетыСКонтрагентамиОстатки.ДоговорКонтрагента.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СКомитентом)
|				ИЛИ ВзаиморасчетыСКонтрагентамиОстатки.ДоговорКонтрагента.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.Прочее)
|			ТОГДА ВЫБОР
|					КОГДА ВзаиморасчетыСКонтрагентамиОстатки.СуммаВзаиморасчетовОстаток &lt; 0
|						ТОГДА ""ПриобретениеУПоставщика""
|					ИНАЧЕ ""ОплатаПоставщику""
|				КОНЕЦ
|		ИНАЧЕ ВЫБОР
|				КОГДА ВзаиморасчетыСКонтрагентамиОстатки.СуммаВзаиморасчетовОстаток &lt; 0
|					ТОГДА ""ОплатаОтКлиента""
|				ИНАЧЕ ""РеализацияКлиенту""
|			КОНЕЦ
|	КОНЕЦ КАК ТипПервичногоДокумента,
|	ВзаиморасчетыСКонтрагентамиОстатки.Организация КАК Организация,
|	NULL КАК Сделка,
|	ВзаиморасчетыСКонтрагентамиОстатки.Контрагент КАК Контрагент,
|	ВзаиморасчетыСКонтрагентамиОстатки.Контрагент КАК Партнер,
|	ВзаиморасчетыСКонтрагентамиОстатки.ДоговорКонтрагента КАК Договор,
|	ВзаиморасчетыСКонтрагентамиОстатки.ДоговорКонтрагента.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
|	ВзаиморасчетыСКонтрагентамиОстатки.ДоговорКонтрагента КАК ОбъектРасчетов,
|	ВЫБОР
|		КОГДА ВзаиморасчетыСКонтрагентамиОстатки.ДоговорКонтрагента.Номер = """"
|			ТОГДА ВзаиморасчетыСКонтрагентамиОстатки.ДоговорКонтрагента.Код
|		ИНАЧЕ ВзаиморасчетыСКонтрагентамиОстатки.ДоговорКонтрагента.Номер
|	КОНЕЦ КАК НомерРасчетногоДокумента,
|	ВЫБОР
|		КОГДА ВзаиморасчетыСКонтрагентамиОстатки.ДоговорКонтрагента.Дата = ДАТАВРЕМЯ(1, 1, 1)
|			ТОГДА &amp;ДатаВводаОстатков
|		ИНАЧЕ ВзаиморасчетыСКонтрагентамиОстатки.ДоговорКонтрагента.Дата
|	КОНЕЦ КАК ДатаРасчетногоДокумента,
|	NULL КАК ДокументРасчетов,
|	&amp;ДатаВводаОстатков КАК ДатаПлатежа,
|	ВЫБОР
|		КОГДА ВзаиморасчетыСКонтрагентамиОстатки.СуммаВзаиморасчетовОстаток &lt; 0
|			ТОГДА -ВзаиморасчетыСКонтрагентамиОстатки.СуммаВзаиморасчетовОстаток
|		ИНАЧЕ ВзаиморасчетыСКонтрагентамиОстатки.СуммаВзаиморасчетовОстаток
|	КОНЕЦ КАК СуммаРегл,
