//					НС.Количество = ДокРезерва.Количество;
//					НС.Размещение =	ДокРезерва.НовоеРазмещение; 
//					
//					НС.Сумма = НС.Цена * НС.Количество;
//					НС.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(НС.Сумма,
//					Источник.УчитыватьНДС, Источник.СуммаВключаетНДС,
