							Иначе
								Рез.Количество =	Рез.Количество - КолВоРезерв; 
							КонецЕсли;
							
							КолВоОбработать = КолВоОбработать - КолВоРезерв;
							
							Рез.Сумма = Рез.Цена * Рез.Количество;
							Рез.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(Рез.Сумма,
