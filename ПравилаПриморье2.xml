			<Алгоритм Имя="ЗаполнитьОбъектыРасчетовВзаиморасчетов" ИспользуетсяПриЗагрузке="true">
				<Текст>Для Каждого текСтрока Из Объект.РасчетыСПартнерами Цикл
	текОбъектРасчетов = текСтрока.ОбъектРасчетов;
	Если ЗначениеЗаполнено( текОбъектРасчетов ) Тогда
		текМенеджерОбъекта		= ОбщегоНазначения.МенеджерОбъектаПоСсылке( текОбъектРасчетов );
		ПараметрыВзаиморасчеты	= текМенеджерОбъекта.ПараметрыВзаиморасчеты( текОбъектРасчетов );

		ДополненныеПараметры	= ВзаиморасчетыСервер.ДополненныеПараметрыМеханизма( текСтрока.ОбъектРасчетов, ПараметрыВзаиморасчеты );

		ПараметрыВзаиморасчеты	= ДополненныеПараметры.МассивПараметров[0];

		ПараметрыВзаиморасчеты.Вставить( "ЭтоПродажаЗакупка", Истина );
 		ПараметрыВзаиморасчеты.Вставить( "ЭтоПлатежИлиПрочийДокумент", Истина );
		
		Если ТипЗнч( текСтрока.ОбъектРасчетов ) = Тип( "СправочникСсылка.ДоговорыКонтрагентов" ) Тогда
			ПараметрыВзаиморасчеты.Вставить( "ПорядокРасчетов", Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов );
		ИначеЕсли ТипЗнч( текСтрока.ОбъектРасчетов ) = Тип( "ДокументСсылка.ЗаказКлиента" ) Тогда
			ПараметрыВзаиморасчеты.Вставить( "ПорядокРасчетов", Перечисления.ПорядокРасчетов.ПоЗаказам );
		Иначе
			ПараметрыВзаиморасчеты.Вставить( "ПорядокРасчетов", Перечисления.ПорядокРасчетов.ПоЗаказамНакладным );
		КонецЕсли;

		текСтрока.ОбъектРасчетовОтправитель = ОбъектыРасчетовСервер.ПроверитьЗаполнитьОбъектРасчетовПоСтруктуре( текСтрока.ОбъектРасчетов.ПолучитьОбъект(), ПараметрыВзаиморасчеты );;
