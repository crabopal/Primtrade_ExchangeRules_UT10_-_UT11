			<Алгоритм Имя="ВключитьРегламентныеЗадания" ИспользуетсяПриЗагрузке="true">
				<Текст>ВсеРегламентныеЗадания = РегламентныеЗадания.ПолучитьРегламентныеЗадания();

Если Параметры.Свойство("ОтключенныеРегламентныеЗадания") Тогда
	
	Для каждого РегламентноеЗадание из ВсеРегламентныеЗадания Цикл
		Если Не РегламентноеЗадание.Использование 
			И Параметры.ОтключенныеРегламентныеЗадания.Найти(РегламентноеЗадание.Наименование) &lt;&gt; Неопределено Тогда
			
			РегламентноеЗадание.Использование = Истина;
			РегламентноеЗадание.Записать();
			
		КонецЕсли;	
	КонецЦикла;
	
