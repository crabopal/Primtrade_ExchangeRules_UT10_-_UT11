	СтатьяПоУмолчанию = Выборка.Ссылка;
Иначе
	Статья = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Статья движения денежных средств (по умолчанию)");
	
	Если Не ЗначениеЗаполнено(Статья) Тогда
		Статья = Справочники.СтатьиДвиженияДенежныхСредств.СоздатьЭлемент();
	Иначе
		Статья = Статья.ПолучитьОбъект();
	КонецЕсли;
	
	Наименование = "Статья движения денежных средств";
	
	Статья.Наименование = Наименование + " (по умолчанию)";
	Статья.Записать();
	СтатьяПоУмолчанию = Статья.Ссылка;
КонецЕсли;

Если Не ЗначениеЗаполнено(Объект.СтатьяДвиженияДенежныхСредств) Тогда
	Объект.СтатьяДвиженияДенежныхСредств = СтатьяПоУмолчанию;
