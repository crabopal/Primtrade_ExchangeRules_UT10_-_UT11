			<Алгоритм Имя="ЦенаВключаетНДС" ИспользуетсяПриЗагрузке="false">
				<Текст>Нашли = Ложь;
Если Параметры.ИспользоватьНДС &lt;&gt; Неопределено Тогда
	Попытка
		Строка = Параметры.ИспользоватьНДС.Найти(Источник.Организация,"Организация");
		Если Строка&lt;&gt;Неопределено Тогда
			Параметры.ВрЗначение = Не Строка.НеИспользоватьНДС;
			Нашли = Истина;
		КонецЕсли;
	Исключение
		НеИспользоватьНДС = Истина;
		Для Каждого Строка из Параметры.ИспользоватьНДС Цикл
			НеИспользоватьНДС = Строка.НеИспользоватьНДС;
		КонецЦикла;
		Если НеИспользоватьНДС Тогда
			Параметры.ВрЗначение = Не НеИспользоватьНДС;
			Нашли = Истина;
		КонецЕсли;
	КонецПопытки;
	
КонецЕсли;
Если Не Нашли Тогда
	Если ТипЗнч(Источник) = Тип("СправочникСсылка.ДоговорыКонтрагентов") И ЗначениеЗаполнено(Источник.ТипЦен) Тогда
		Попытка
			Параметры.ВрЗначение = Источник.ТипЦен.ЦенаВключаетНДС;
		Исключение
			Параметры.ВрЗначение = Истина;
		КонецПопытки;
	Иначе	
		Параметры.ВрЗначение = Истина;
	КонецЕсли;
КонецЕсли;</Текст>
				<Параметры>Источник</Параметры>
			</Алгоритм>
