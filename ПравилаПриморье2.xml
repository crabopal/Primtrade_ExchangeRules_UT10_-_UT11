	//вараинт 2
	Для Каждого Товара из Результат.Строки ЦИкл //товар
		Для Каждого ХарТовара из Товара.Строки ЦИкл //характеристика	
		
			Для Каждого ДокРезерва из ХарТовара.Строки ЦИкл //док резервирования -обход с первого документа 
				
				Ключ = Новый Структура("Номенклатура,ХарактеристикаНоменклатуры,Размещение",
