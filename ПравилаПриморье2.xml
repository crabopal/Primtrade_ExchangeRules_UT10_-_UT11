			<Алгоритм Имя="ХарактеристикаСтрокиТЧ" ИспользуетсяПриЗагрузке="false">
				<Текст>Если Параметры.ОтключитьПереносХарактеристик Или Параметры.ОтключитьХарактеристикиПереноситьИхВНоменклатуру Тогда
	Отказ = Истина;
КонецЕсли;
ИмяТЧ = "+";

Попытка
	Если Не ЗначениеЗаполнено(Источник) Тогда
		Отказ = Истина;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("Структура") Или ТипЗнч(Источник) = Тип("Массив") Тогда
		ИмяТЧ = "";
	ИначеЕсли Источник.Метаданные().ТабличныеЧасти.Найти("Товары") &lt;&gt; Неопределено Тогда
		ИмяТЧ = "Товары";
	ИначеЕсли Источник.Метаданные().ТабличныеЧасти.Найти("Материалы") &lt;&gt; Неопределено Тогда
		ИмяТЧ = "Материалы";
	ИначеЕсли Источник.Метаданные().ТабличныеЧасти.Найти("Комплектующие") &lt;&gt; Неопределено Тогда
		ИмяТЧ = "Комплектующие";
	ИначеЕсли Не ЗначениеЗаполнено(Значение) Тогда
		Сообщить("Не удалось определить имя табличной части при выгрузке характеристик документа " + Источник);
		Отказ = Истина;
	КонецЕсли;
Исключение
	Сообщить(ОписаниеОшибки());
	Отказ = Истина;
	Сообщить("Тип источника: " + ТипЗнч(Источник));
КонецПопытки;

Если Не Отказ Тогда
	НаименованиеКолонкиХарактеристики = "";
	Если ИмяТЧ = "" Тогда
		НаименованиеКолонкиХарактеристики = "";
	ИначеЕсли Не ЗначениеЗаполнено(НаименованиеКолонкиХарактеристики) Тогда
		Если ТипЗнч(ОбъектКоллекции)= Тип("СтрокаТаблицыЗначений") И ОбъектКоллекции.Владелец().Колонки.Найти("Характеристика") &lt;&gt; Неопределено Тогда
			НаименованиеКолонкиХарактеристики = "Характеристика";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НаименованиеКолонкиХарактеристики) И ОбщегоНазначения.ЭтоДокумент(Источник.Метаданные())
			И Источник.Метаданные().ТабличныеЧасти[ИмяТЧ].Реквизиты.Найти("ХарактеристикаНоменклатуры") &lt;&gt; Неопределено Тогда
			НаименованиеКолонкиХарактеристики = "ХарактеристикаНоменклатуры";
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(НаименованиеКолонкиХарактеристики) И Не ЗначениеЗаполнено(ОбъектКоллекции.Номенклатура) Тогда
		Отказ = Истина;
	КонецЕсли;
КонецЕсли;	

Если Не Отказ Тогда

	Если Не ЗначениеЗаполнено(ИсходящиеДанные) Тогда
		ИсходящиеДанные = Новый Структура;
	КонецЕсли;
	
	Если Параметры.ИспользоватьХарактеристикиНоменклатуры Тогда
		
		ВестиУчетПоХарактеристикам = Ложь;
		Если ИмяТЧ &lt;&gt; "" И ТипЗнч(ОбъектКоллекции.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
			ВестиУчетПоХарактеристикам = ОбщегоНазначения.ПолучитьЗначениеРеквизита(ОбъектКоллекции.Номенклатура, "ВестиУчетПоХарактеристикам");
		ИначеЕсли ТипЗнч(Источник.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
			ВестиУчетПоХарактеристикам = ОбщегоНазначения.ПолучитьЗначениеРеквизита(Источник.Номенклатура, "ВестиУчетПоХарактеристикам");
		Иначе
			ВестиУчетПоХарактеристикам = Ложь;
		КонецЕсли;
		
		Характеристика = Неопределено;
		Если ЗначениеЗаполнено(НаименованиеКолонкиХарактеристики) Тогда
			Характеристика = ОбъектКоллекции[НаименованиеКолонкиХарактеристики];
		ИначеЕсли ЗначениеЗаполнено(Значение) Тогда
			Характеристика = Значение;
		Иначе
			Характеристика = Источник.Характеристика;
		КонецЕсли;
		
		Если ВестиУчетПоХарактеристикам = Истина И НЕ ЗначениеЗаполнено(Характеристика) И ОбъектКоллекции &lt;&gt; Неопределено Тогда
			ИсходящиеДанные.Вставить("Владелец", ОбъектКоллекции.Номенклатура);
			Значение = Новый Структура("Ссылка");
			ИмяПКО = "ПустаяХарактеристикаНоменклатуры";
		ИначеЕсли ВестиУчетПоХарактеристикам = Истина И НЕ ЗначениеЗаполнено(Характеристика) И ТипЗнч(Источник) = Тип("Структура") Тогда
			ИсходящиеДанные.Вставить("Владелец", Источник.Номенклатура);
			Значение = Новый Структура("Ссылка");
			ИмяПКО = "ПустаяХарактеристикаНоменклатуры";
		Иначе	
			Значение = Характеристика;
			ИмяПКО = "ХарактеристикиНоменклатуры";
		КонецЕсли;
	Иначе
		Отказ = Истина;
	КонецЕсли;
КонецЕсли;</Текст>
				<Параметры>Источник, ОбъектКоллекции, ИмяТЧ, Значение</Параметры>
