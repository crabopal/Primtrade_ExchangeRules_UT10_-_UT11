			<Алгоритм Имя="ЗаполнитьБанковскийСчетКонтрагентаПоУмолчанию" ИспользуетсяПриЗагрузке="true">
				<Текст>Если Не ЗначениеЗаполнено(Объект.БанковскийСчетКонтрагента) И ЗначениеЗаполнено(Объект.Контрагент) Тогда
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БанковскиеСчетаКонтрагентов.Наименование,
	|	БанковскиеСчетаКонтрагентов.Ссылка
	|ИЗ
	|	Справочник.БанковскиеСчетаКонтрагентов КАК БанковскиеСчетаКонтрагентов
	|ГДЕ
	|	БанковскиеСчетаКонтрагентов.Владелец = &amp;Владелец
	|	И БанковскиеСчетаКонтрагентов.ВалютаДенежныхСредств = &amp;Валюта
	|	И НЕ БанковскиеСчетаКонтрагентов.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Владелец", Объект.Контрагент);
	Запрос.УстановитьПараметр("Валюта", Объект.Валюта);
	
	СчетаКонтрагента = Запрос.Выполнить().Выгрузить();
	
	Если СчетаКонтрагента.Количество() = 0 Тогда
		// создаем счет по умолчанию
		Счет = Справочники.БанковскиеСчетаКонтрагентов.СоздатьЭлемент();
		Счет.НомерСчета = "00000000000000000000";
		Счет.Владелец = Объект.Контрагент;
		Счет.ВалютаДенежныхСредств = Объект.Валюта;
		Счет.Наименование = "Создан автоматически при загрузке из УТ10";
		Счет.Записать();
		Объект.БанковскийСчетКонтрагента = Счет.Ссылка;
	ИначеЕсли СчетаКонтрагента.Количество() = 1 Тогда
		Объект.БанковскийСчетКонтрагента = СчетаКонтрагента.Получить(0).Ссылка;
	Иначе
		// выбираем созданный автоматически, т.к. найдено несколько счетов в этой валюте.
		// Брать один из них нельзя - можно указать неверный
		ПараметрыПоиска = Новый Структура("Наименование", "Создан автоматически при загрузке из УТ10");
		НайденныеСтроки = СчетаКонтрагента.НайтиСтроки(ПараметрыПоиска);
		Если НайденныеСтроки.Количество() &gt; 0 Тогда
			Объект.БанковскийСчетКонтрагента = НайденныеСтроки[0].Ссылка;
		Иначе
			Счет = Справочники.БанковскиеСчетаКонтрагентов.СоздатьЭлемент();
			Счет.НомерСчета = "00000000000000000000";
			Счет.Владелец = Объект.Контрагент;
			Счет.ВалютаДенежныхСредств = Объект.Валюта;
			Счет.Наименование = "Создан автоматически при загрузке из УТ10";
			Счет.Записать();
			Объект.БанковскийСчетКонтрагента = Счет.Ссылка;
		КонецЕсли;	
	КонецЕсли;
		
КонецЕсли;</Текст>
