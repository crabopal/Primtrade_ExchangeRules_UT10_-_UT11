
&НаКлиенте
Процедура Загрузить(Команда)
	СтандартнаяОбработка = Ложь;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогОткрытияФайла.Заголовок = "Выберите файл с номенклатурой партнера для открытия";
	ДиалогОткрытияФайла.Фильтр = "Excel файлы(*.xls;*.xlsx)|*.xls;*.xlsx";
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		ПутьКФайлу = ДиалогОткрытияФайла.ПолноеИмяФайла;
	КонецЕсли;
	ПрочитатьФайл();
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьФайл()
	
	ИмяФайла = ПутьКФайлу;
	ВыбФайл = Новый Файл(ИмяФайла);
	Если не ВыбФайл.Существует() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл не существует!");
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайла);
	АдресДанных = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	
	Если СтрНайти(ИмяФайла, "ФайлСертификатов") Тогда
		ПрочитатьФайлНаСервереФайлСертификатов(АдресДанных, ВыбФайл.Расширение);
	КонецЕсли;
	
	Если СтрНайти(ИмяФайла, "ФайлДоговоров") Тогда
		ПрочитатьФайлНаСервереФайлДоговоры(АдресДанных, ВыбФайл.Расширение);
	КонецЕсли;
	
	Если СтрНайти(ИмяФайла, "ФайлСроков") Тогда
		ПрочитатьФайлНаСервереФайлСроков(АдресДанных, ВыбФайл.Расширение);
	КонецЕсли;
	
	Если СтрНайти(ИмяФайла, "Маркировка") Тогда
		ПрочитатьФайлНаСервереФайлМаркировки(АдресДанных, ВыбФайл.Расширение);
	КонецЕсли;
	
	Если СтрНайти(ИмяФайла, "СМ") Тогда
		ПрочитатьФайлНаСервереФайлСМ(АдресДанных, ВыбФайл.Расширение);
	КонецЕсли;
	
	Если СтрНайти(ИмяФайла, "Цены") Тогда
		ПрочитатьФайлНаСервереФайлЦен(АдресДанных, ВыбФайл.Расширение);
	КонецЕсли;
	
	Если СтрНайти(ИмяФайла, "Ячейки") Тогда
		ПрочитатьФайлНаСервереФайлЯчеек(АдресДанных, ВыбФайл.Расширение);
	КонецЕсли;
	
	Если СтрНайти(ИмяФайла, "Авто") Тогда
		ПрочитатьФайлНаСервереФайлАвто(АдресДанных, ВыбФайл.Расширение);
	КонецЕсли;

	Если СтрНайти(ИмяФайла, "Маршруты") Тогда
		ПрочитатьФайлНаСервереФайлМаршруты(АдресДанных, ВыбФайл.Расширение);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПрочитатьФайлНаСервереФайлСертификатов(Данные, Расширение)
		
	Данные = ПолучитьИзВременногоХранилища(Данные);
	ВремФайл = ПолучитьИмяВременногоФайла(Расширение);
	Данные.Записать(ВремФайл);
	
	ТаблицаЗагрузки.Прочитать(ВремФайл);
	
	Попытка
		УдалитьФайлы(ВремФайл);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки; 
	
	Если  ТаблицаЗагрузки.ВысотаТаблицы > 0 Тогда
		
		Результат = Новый Массив;
		
		СЧ = 1;
		
		Для СчетчикСтрок = 3 По ТаблицаЗагрузки.ВысотаТаблицы Цикл
			
			Если ТаблицаЗагрузки.Область(СчетчикСтрок, 3).Текст = "" Тогда
				Продолжить;
			КонецЕсли;
			
			GUID = ТаблицаЗагрузки.Область(СчетчикСтрок, 1).Текст;
			
			Номенклатура = НайтиНоменклатуру(GUID);
			
			Если Номенклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда 
				  Продолжить;
			КонецЕсли;
			
			ОбектНоменклатура                                   = Номенклатура.ПолучитьОбъект(); 
            ОбектНоменклатура.ВестиУчетСертификатовНоменклатуры = Истина;
			ОбектНоменклатура.ОбменДанными.Загрузка             = Истина;
			ОбектНоменклатура.Записать();
			
			Сертификат                             = Справочники.СертификатыНоменклатуры.СоздатьЭлемент();
			Сертификат.Номер                       = ТаблицаЗагрузки.Область(СчетчикСтрок, 3).Текст;
			Сертификат.Наименование                = ТаблицаЗагрузки.Область(СчетчикСтрок, 3).Текст;
			Сертификат.ДатаНачалаСрокаДействия     = Дата(ТаблицаЗагрузки.Область(СчетчикСтрок, 4).Текст);
			Сертификат.ДатаОкончанияСрокаДействия  = Дата(ТаблицаЗагрузки.Область(СчетчикСтрок, 5).Текст);
			Сертификат.ОрганВыдавшийДокумент       = ТаблицаЗагрузки.Область(СчетчикСтрок, 6).Текст;
			Сертификат.Статус                      = ?(Сертификат.ДатаОкончанияСрокаДействия> ТекущаяДата(),Перечисления.СтатусыСертификатовНоменклатуры.Действующий,Перечисления.СтатусыСертификатовНоменклатуры.Недействующий);
			Сертификат.ОбменДанными.Загрузка       = Истина;
			Сертификат.Записать();
			
			НЗ = РегистрыСведений.ОбластиДействияСертификатовНоменклатуры.СоздатьМенеджерЗаписи();
			НЗ.Номенклатура           = Номенклатура;
			НЗ.СертификатНоменклатуры = Сертификат.Ссылка;
			НЗ.ВидНоменклатуры        = Номенклатура.ВидНоменклатуры;
			НЗ.Записать(Истина);
			
			СЧ = СЧ +1;
		КонецЦикла;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данные успешно загружены!");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создано " + СЧ + " сертификатов");
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл пустой!");
	КонецЕсли;
		 
	 
КонецПроцедуры

&НаСервере
Процедура ПрочитатьФайлНаСервереФайлДоговоры(Данные, Расширение)
		
	Данные = ПолучитьИзВременногоХранилища(Данные);
	ВремФайл = ПолучитьИмяВременногоФайла(Расширение);
	Данные.Записать(ВремФайл);
	
	ТаблицаЗагрузки.Прочитать(ВремФайл);
	
	Попытка
		УдалитьФайлы(ВремФайл);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки; 
	
	Если  ТаблицаЗагрузки.ВысотаТаблицы > 0 Тогда
		
		Результат = Новый Массив;
		
		СЧ = 1;
		
		Для СчетчикСтрок = 3 По ТаблицаЗагрузки.ВысотаТаблицы Цикл
			
			Если ТаблицаЗагрузки.Область(СчетчикСтрок,1).Текст = "" Тогда
				Продолжить;
			КонецЕсли;
						
			GUID = ТаблицаЗагрузки.Область(СчетчикСтрок, 1).Текст;
			
			//Договор
			Договор = НайтиДоговор(GUID);
			
			Если Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка() Тогда 
				  Продолжить;
			КонецЕсли;
			
			ОбектДоговор                             = Договор.ПолучитьОбъект(); 
			ОбектДоговор.ОбменДанными.Загрузка       = Истина;			
			ОбектДоговор.ОСГПоДоговору               = Число(?(ТаблицаЗагрузки.Область(СчетчикСтрок, 3).Текст = "",0,ТаблицаЗагрузки.Область(СчетчикСтрок, 3).Текст));
			ОбектДоговор.ОтсрочкаПоДоговору          = Число(?(ТаблицаЗагрузки.Область(СчетчикСтрок, 4).Текст = "",0,ТаблицаЗагрузки.Область(СчетчикСтрок, 4).Текст)); 
			ОбектДоговор.ИТЛ_ОсновнойДоговор         = ?(ТаблицаЗагрузки.Область(СчетчикСтрок, 5).Текст = "Да",Истина,Ложь);
			ОбектДоговор.Записать();
			
			СЧ = СЧ +1;

			//Соглашение
			Соглашение = ПолучитьСоглашение(Договор);
			
			Если Соглашение = Справочники.СоглашенияСКлиентами.ПустаяСсылка() Тогда 
				СЧ = СЧ -1;
				  Продолжить;
			КонецЕсли;
			
			ОбектСоглашение                          = Соглашение.ПолучитьОбъект(); 
			ОбектСоглашение.ОбменДанными.Загрузка    = Истина;			
			ОбектСоглашение.ОСГПоДоговору            = Число(?(ТаблицаЗагрузки.Область(СчетчикСтрок, 3).Текст = "",0,ТаблицаЗагрузки.Область(СчетчикСтрок, 3).Текст));
			ОбектСоглашение.ОтсрочкаПоДоговору       = Число(?(ТаблицаЗагрузки.Область(СчетчикСтрок, 4).Текст = "",0,ТаблицаЗагрузки.Область(СчетчикСтрок,4).Текст));
			ОбектСоглашение.ИТЛ_ОсновнойДоговор      = ?(ТаблицаЗагрузки.Область(СчетчикСтрок, 5).Текст = "Да",Истина,Ложь);
			
			ОбектСоглашение.ЭтапыГрафикаОплаты.Очистить();
			 
			НС                = ОбектСоглашение.ЭтапыГрафикаОплаты.Добавить();
			НС.ВариантОплаты  = Перечисления.ВариантыКонтроляОплатыКлиентом.КредитПослеОтгрузки;
			НС.ВариантОтсчета = Перечисления.ВариантыОтсчетаДатыПлатежа.ОтДатыЗаказа;
			НС.ПроцентПлатежа = 100;  
			НС.Сдвиг          = Число(?(ТаблицаЗагрузки.Область(СчетчикСтрок, 6).Текст = "",0,ТаблицаЗагрузки.Область(СчетчикСтрок, 6).Текст));
			
			ОбектСоглашение.Записать();
			
			
		КонецЦикла;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данные успешно загружены!");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполнено " + СЧ + " договоров и соглашений");
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл пустой!");
	КонецЕсли;
	 
КонецПроцедуры

