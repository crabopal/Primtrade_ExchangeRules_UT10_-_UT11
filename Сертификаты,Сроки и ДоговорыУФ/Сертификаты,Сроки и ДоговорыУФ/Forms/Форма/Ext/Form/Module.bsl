Функция ПолучитьСоглашение(Договор)
	
	Соглашение = Справочники.СоглашенияСКлиентами.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Партнер КАК Партнер,
	|	ДоговорыКонтрагентов.Контрагент КАК Контрагент
	|ПОМЕСТИТЬ ВтКонтрагенты
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Ссылка = &Договор
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партнер,
	|	Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоглашенияСКлиентами.Ссылка КАК Ссылка,
	|	ВтКонтрагенты.Партнер КАК Партнер,
	|	ВтКонтрагенты.Контрагент КАК Контрагент
	|ИЗ
	|	Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами,
	|	ВтКонтрагенты КАК ВтКонтрагенты
	|ГДЕ
	|	СоглашенияСКлиентами.Партнер = ВтКонтрагенты.Партнер";
	
	Запрос.УстановитьПараметр("Договор", Договор);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		Соглашение = Результат.Ссылка;
	КонецЦикла;
		
	Возврат Соглашение;
	
