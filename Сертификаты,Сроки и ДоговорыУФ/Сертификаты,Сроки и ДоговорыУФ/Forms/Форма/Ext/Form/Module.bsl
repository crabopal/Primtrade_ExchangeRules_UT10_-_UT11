Функция НайтиПомещение(ПомещениеНаименование,Склад)
	
    Помещение = Неопределено;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СкладскиеПомещения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СкладскиеПомещения КАК СкладскиеПомещения
		|ГДЕ
		|	СкладскиеПомещения.Владелец = &Владелец
		|	И СкладскиеПомещения.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Владелец", Склад);
	Запрос.УстановитьПараметр("Наименование", ПомещениеНаименование);
	
	Результат = Запрос.Выполнить().Выбрать();
		
	Пока Результат.Следующий() Цикл
		 Помещение = Результат.Ссылка; 
	КонецЦикла;
	
	Возврат Помещение;
	
КонецФункции

Функция НайтиПомещениеИерархии(Помещение,Склад)
	
    ПомещнеРодитель = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СкладскиеЯчейки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СкладскиеЯчейки КАК СкладскиеЯчейки
		|ГДЕ
		|	СкладскиеЯчейки.ЭтоГруппа = Истина
		|	И СкладскиеЯчейки.Наименование = &Помещение
		|	И СкладскиеЯчейки.Владелец = &Склад";
	
	Запрос.УстановитьПараметр("Помещение", Помещение);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	Результат = Запрос.Выполнить().Выгрузить();
		
	Пока Результат.Следующий() Цикл
		ПомещнеРодитель = Результат.Ссылка;
	КонецЦикла;
	
	Возврат ПомещнеРодитель;
	
КонеЦФункции
