Функция ПолучитьВидМаркировки(ВидТекст)
	
	ВидМарки = Справочники.КлючиВидовПродукцииИС.ПустаяСсылка();
	
	//Молочка
	Если ВидТекст = "Молочная продукция"  Тогда 
		ВидМарки = Справочники.КлючиВидовПродукцииИС.НайтиПоРеквизиту("ВидПродукцииГИСМТ", Справочники.ВидыПродукцииИС.НайтиПоНаименованию("Молочная продукция"));
	КонецЕсли;
	
	//Консервы 
    Если ВидТекст = "Консервированная продукция"  Тогда 
