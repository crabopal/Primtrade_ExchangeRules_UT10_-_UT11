&НаСервере
Процедура ПрочитатьФайлНаСервереФайлМаркировки(Данные, Расширение)
		
	Данные = ПолучитьИзВременногоХранилища(Данные);
	ВремФайл = ПолучитьИмяВременногоФайла(Расширение);
	Данные.Записать(ВремФайл);
	
	ТаблицаЗагрузки.Прочитать(ВремФайл);
	
	Попытка
		УдалитьФайлы(ВремФайл);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки; 
	
	Если  ТаблицаЗагрузки.ВысотаТаблицы > 0 Тогда
		
		Результат = Новый Массив;
		
		СЧ = 1;
		
		Для СчетчикСтрок = 2 По ТаблицаЗагрузки.ВысотаТаблицы Цикл
			
			Если ТаблицаЗагрузки.Область(СчетчикСтрок, 2).Текст = "" Тогда
				Продолжить;
			КонецЕсли;
			
			GTIN = ТаблицаЗагрузки.Область(СчетчикСтрок, 1).Текст;
			
			Номенклатура = НайтиНоменклатуруПоШтрихкоду(GTIN);
			
			Если Номенклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда 
				  Продолжить;
			КонецЕсли;
			
			ОбектНоменклатура                                   = Номенклатура.ПолучитьОбъект(); 
			ОбектНоменклатура.ОбменДанными.Загрузка             = Истина;
			ОбектНоменклатура.ЕдиницаИзмеренияСрокаГодности     = Перечисления.ЕдиницыИзмеренияВремени.День;
			ОбектНоменклатура.Записать(); 
			
			Маркировка = ПолучитьВидМаркировки(ТаблицаЗагрузки.Область(СчетчикСтрок, 3).Текст);
			
			Если НЕ Маркировка = Справочники.КлючиВидовПродукцииИС.ПустаяСсылка() Тогда
				
				МаркаИС                                     = РегистрыСведений.ОписаниеНоменклатурыИС.СоздатьМенеджерЗаписи();
				МаркаИС.Номенклатура                        = Номенклатура;
				МаркаИС.КоличествоВПотребительскойУпаковке  = 1; 
				МаркаИС.ВариантИспользованияЕдиницыХранения = Перечисления.ВариантыИспользованияЕдиницыХраненияИС.ЗаданУпаковками;
				МаркаИС.ПотребительскаяУпаковка             = Номенклатура.ЕдиницаИзмерения;
				МаркаИС.КлючВидовПродукции                  = Маркировка;
				МаркаИС.Записать(Истина);
				
			КонецЕсли;
				
			СЧ = СЧ +1;
		КонецЦикла;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данные успешно загружены!");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Добавлено " + СЧ + " типов маркировки!");
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл пустой!");
	КонецЕсли;
		 
	 
КонецПроцедуры

&НаСервере
Процедура ПрочитатьФайлНаСервереФайлСМ(Данные, Расширение)
		
	Данные = ПолучитьИзВременногоХранилища(Данные);
	ВремФайл = ПолучитьИмяВременногоФайла(Расширение);
	Данные.Записать(ВремФайл);
	
	ТаблицаЗагрузки.Прочитать(ВремФайл);
	
	Попытка
		УдалитьФайлы(ВремФайл);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки; 
	
	ТаблицаСопостав = Новый ТаблицаЗначений;
	ТаблицаСопостав.Колонки.Добавить("ПродукцияМеркурий");
	ТаблицаСопостав.Колонки.Добавить("Номенклатура");
	
	Если  ТаблицаЗагрузки.ВысотаТаблицы > 0 Тогда
		
		Результат = Новый Массив;
		
		СЧ = 1;
		
		Для СчетчикСтрок = 2 По ТаблицаЗагрузки.ВысотаТаблицы Цикл
						
			ТМеркурий = ТаблицаЗагрузки.Область(СчетчикСтрок, 1).Текст;
			Если  СтрНайти(ТМеркурий,"_//")> 0 Тогда
				ТМеркурий = СтрЗаменить(ТМеркурий,"_//","");
				Меркурий  = Справочники.астПродукцияМеркурий.НайтиПоНаименованию(ТМеркурий);
			Иначе
				Меркурий  = Справочники.астПродукцияМеркурий.НайтиПоРеквизиту("GUID",ТМеркурий);
			КонецЕсли;
			
			ТНоменклатура = ТаблицаЗагрузки.Область(СчетчикСтрок, 2).Текст;
			Номенклатура  = Справочники.Номенклатура.НайтиПоКоду(ТНоменклатура);
			
			Если Не Меркурий = Справочники.астПродукцияМеркурий.ПустаяСсылка()Тогда
				НС            = ТаблицаСопостав.Добавить();
				НС.ПродукцияМеркурий = Меркурий;
				НС.Номенклатура      = Номенклатура;
			КонецЕсли;
		
			СЧ = СЧ +1;
		КонецЦикла;
		
		НаборЗаписей = РегистрыСведений.астСоответствиеНоменклатурыМеркурий.СоздатьНаборЗаписей();
		
		Для каждого стр Из ТаблицаСопостав Цикл
			НоваяЗапись = НаборЗаписей.Добавить();
