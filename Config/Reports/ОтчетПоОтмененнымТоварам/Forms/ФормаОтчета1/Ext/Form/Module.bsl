Процедура ПараметрыПриИзменении()
	
	ИспользованиеОтбораПоПериоду =  ЗначениеЗаполнено(Период);
	
	ПараметрДатаНач = Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("НачалоПериода"); //Поиск производится по имени параметра СКД
	ПараметрДатаНач.Использование = ИспользованиеОтбораПоПериоду; //Параметр будет использоваться при отборе
	ПараметрДатаНач.Значение  = Период.ДатаНачала; //Параметру присваивается значение реквизита отчета
	
	ПараметрДатаКон = Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("КонецПериода");
	ПараметрДатаКон.Использование = ИспользованиеОтбораПоПериоду;
	ПараметрДатаКон.Значение  = КонецДня(Период.ДатаОкончания);
	
КонецПроцедуры

