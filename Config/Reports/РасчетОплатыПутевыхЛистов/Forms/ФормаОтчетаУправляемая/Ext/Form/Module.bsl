/////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

//***********************************************************************
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	//Восстановим значение периода
	Если Отчет.Период = "" Тогда
		Отчет.Период = "Сегодня";
	КонецЕсли;
	Элементы.ПериодУстановка.Заголовок = Отчет.Период;
	Элементы.ПредставлениеДаты.Заголовок = ОбновитьПредставлениеДатыНаСервере();
	
	//Видимость элементов на форме
	Элементы.КнопкаСвернутьПоказатьНастройки.Пометка = Отчет.ВыводитьОтбор;
	УстановитьВидимостьЭлементов();
	
	//Заголовок формы
	ЭтаФорма.Заголовок = ВернутьСинонимОтчета() + " (" + НаименованиеТекущегоВарианта + ")";
	ЭтаФорма.АвтоЗаголовок = Ложь;
	
	//Видимость кнопки Сохранить в Excel
	#Если НЕ ВебКлиент Тогда
	Попытка			
		xl = Новый COMОбъект("Excel.Application");
		Элементы.ФормаСохранитьВExcel.Видимость = Истина;
	Исключение
		Элементы.ФормаСохранитьВExcel.Видимость = Ложь;
	КонецПопытки;	
	#КонецЕсли
	
КонецПроцедуры

&НаСервере
//***********************************************************************
Функция ВернутьСинонимОтчета()
	
	Возврат РеквизитФормыВЗначение("Отчет").Метаданные().Синоним;
	
КонецФункции



/////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ РАБОТЫ С СИСТЕМОЙ ВЫБОРА ДАТ

//***********************************************************************
&НаКлиенте
Процедура НачалоПериодаПриИзменении(Элемент)
	
	Элементы.ПредставлениеДаты.Заголовок = ОбновитьПредставлениеДатыНаСервере();
	
КонецПроцедуры

//***********************************************************************
&НаКлиенте
Процедура КонецПериодаПриИзменении(Элемент)
	
	Элементы.ПредставлениеДаты.Заголовок = ОбновитьПредставлениеДатыНаСервере();
	
КонецПроцедуры

//***********************************************************************
&НаКлиенте
Процедура ПериодСброс(Команда)
	
	Отчет.НачалоПериода = "";
	Отчет.КонецПериода = "";
	
	Элементы.ПредставлениеДаты.Заголовок = ОбновитьПредставлениеДатыНаСервере();
	
КонецПроцедуры

//***********************************************************************
&НаКлиенте
Процедура ВыборПериодаСтандартный(Команда)
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период.ДатаНачала = Отчет.НачалоПериода;
	Диалог.Период.ДатаОкончания = Отчет.КонецПериода;
	Диалог.Период = СтПериод;
	Если Диалог.Редактировать() Тогда
		СтПериод = Диалог.Период;
	    Отчет.НачалоПериода = Диалог.Период.ДатаНачала;
		Отчет.КонецПериода = Диалог.Период.ДатаОкончания;
	КонецЕсли; 
	
	Элементы.ПредставлениеДаты.Заголовок = ОбновитьПредставлениеДатыНаСервере();

КонецПроцедуры

//***********************************************************************
&НаКлиенте
Процедура ПериодНазад(Команда)
	
	Отчет.КонецПериода = ?(ЗначениеЗаполнено(Отчет.КонецПериода), Отчет.КонецПериода, ТекущаяДата());
	
	Если Отчет.Период = "Сегодня" Тогда
		Отчет.КонецПериода = НачалоДня(Отчет.КонецПериода) - 1;
		Отчет.НачалоПериода = НачалоДня(Отчет.КонецПериода);
	ИначеЕсли Отчет.Период = "Эта неделя" Тогда
		Отчет.КонецПериода = НачалоНедели(Отчет.КонецПериода) - 1;
		Отчет.НачалоПериода = НачалоНедели(Отчет.КонецПериода);
	ИначеЕсли Отчет.Период = "Этот месяц" Тогда
		Отчет.КонецПериода = НачалоМесяца(Отчет.КонецПериода) - 1;
		Отчет.НачалоПериода = НачалоМесяца(Отчет.КонецПериода);
	ИначеЕсли Отчет.Период = "Этот квартал" Тогда
		Отчет.КонецПериода = НачалоКвартала(Отчет.КонецПериода) - 1;
		Отчет.НачалоПериода = НачалоКвартала(Отчет.КонецПериода);
	ИначеЕсли Отчет.Период = "Этот год" Тогда
		Отчет.КонецПериода = НачалоГода(Отчет.КонецПериода) - 1;
		Отчет.НачалоПериода = НачалоГода(Отчет.КонецПериода);
	КонецЕсли;
	
	Элементы.ПредставлениеДаты.Заголовок = ОбновитьПредставлениеДатыНаСервере();

КонецПроцедуры

//***********************************************************************
&НаКлиенте
Процедура ПериодУстановка(Команда)
	
	Если Отчет.Период = "Сегодня" Тогда
		Отчет.НачалоПериода = НачалоДня(ТекущаяДата());
		Отчет.КонецПериода = КонецДня(ТекущаяДата());
	ИначеЕсли Отчет.Период = "Эта неделя" Тогда
		Отчет.НачалоПериода = НачалоНедели(ТекущаяДата());
		Отчет.КонецПериода = КонецНедели(ТекущаяДата());
	ИначеЕсли Отчет.Период = "Этот месяц" Тогда
		Отчет.НачалоПериода = НачалоМесяца(ТекущаяДата());
		Отчет.КонецПериода = КонецМесяца(ТекущаяДата());
	ИначеЕсли Отчет.Период = "Этот квартал" Тогда
		Отчет.НачалоПериода = НачалоКвартала(ТекущаяДата());
		Отчет.КонецПериода = КонецКвартала(ТекущаяДата());
	ИначеЕсли Отчет.Период = "Этот год" Тогда
		Отчет.НачалоПериода = НачалоГода(ТекущаяДата());
		Отчет.КонецПериода = КонецГода(ТекущаяДата());
	КонецЕсли;
	
	Элементы.ПредставлениеДаты.Заголовок = ОбновитьПредставлениеДатыНаСервере();
	
КонецПроцедуры

//***********************************************************************
&НаКлиенте
Процедура ПериодВыбор(Команда)
	
	СписокИнтервалов = Новый СписокЗначений;
	СписокИнтервалов.Добавить("Сегодня");
	СписокИнтервалов.Добавить("Эта неделя");
	СписокИнтервалов.Добавить("Этот месяц");
	СписокИнтервалов.Добавить("Этот квартал");
	СписокИнтервалов.Добавить("Этот год");
	
	Интервал = ВыбратьИзМеню(СписокИнтервалов);
	Если Интервал <> Неопределено Тогда
		Отчет.Период = Интервал.Значение;
		Элементы.ПериодУстановка.Заголовок = Отчет.Период;
		ПериодУстановка(Неопределено); 
	КонецЕсли;
		
КонецПроцедуры

//***********************************************************************
&НаКлиенте
Процедура ПериодВперед(Команда)
	
	Отчет.КонецПериода = ?(ЗначениеЗаполнено(Отчет.КонецПериода), Отчет.КонецПериода, ТекущаяДата());
	
	Если Отчет.Период = "Сегодня" Тогда
		Отчет.НачалоПериода = КонецДня(Отчет.КонецПериода) + 1;
		Отчет.КонецПериода = КонецДня(Отчет.НачалоПериода);
	ИначеЕсли Отчет.Период = "Эта неделя" Тогда
		Отчет.НачалоПериода = КонецНедели(Отчет.КонецПериода) + 1;
		Отчет.КонецПериода = КонецНедели(Отчет.НачалоПериода);
	ИначеЕсли Отчет.Период = "Этот месяц" Тогда
		Отчет.НачалоПериода = КонецМесяца(Отчет.КонецПериода) + 1;
		Отчет.КонецПериода = КонецМесяца(Отчет.НачалоПериода);
	ИначеЕсли Отчет.Период = "Этот квартал" Тогда
		Отчет.НачалоПериода = КонецКвартала(Отчет.КонецПериода) + 1;
		Отчет.КонецПериода = КонецКвартала(Отчет.НачалоПериода);
	ИначеЕсли Отчет.Период = "Этот год" Тогда
		Отчет.НачалоПериода = КонецГода(Отчет.КонецПериода) + 1;
		Отчет.КонецПериода = КонецГода(Отчет.НачалоПериода);
	КонецЕсли;
	
	Элементы.ПредставлениеДаты.Заголовок = ОбновитьПредставлениеДатыНаСервере();
	
КонецПроцедуры

//***********************************************************************
&НаСервере
Функция ОбновитьПредставлениеДатыНаСервере()
	
	Возврат РеквизитФормыВЗначение("Отчет").ОбновитьПредставлениеДаты();
	
КонецФункции



/////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИК ДЕЙСТВИЙ фОРМЫ

//***********************************************************************
&НаКлиенте
Процедура СвернутьПоказатьНастройки(Команда)
	
	Отчет.ВыводитьОтбор = НЕ Отчет.ВыводитьОтбор;
	Элементы.КнопкаСвернутьПоказатьНастройки.Пометка = Отчет.ВыводитьОтбор;
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

//***********************************************************************
&НаКлиенте
Процедура СохранитьВExcel(Команда)
	
	ИмяФайла = ВернутьСинонимОтчета() + " (" + 
	Строка(Формат(ТекущаяДата(),"ДФ=""дд-ММ-гггг""")) + ")" 
	+".xlsx";
	
	#Если ВебКлиент Тогда		
		//Подключим расширение работы с файлами
		Если Не ПодключитьРасширениеРаботыСФайлами() Тогда 
			УстановитьРасширениеРаботыСФайлами();
			ПодключитьРасширениеРаботыСФайлами();
		КонецЕсли;
	#КонецЕсли		
	
	//Вызовем диалог сохранения файла
	ВыборФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ВыборФайла.Заголовок = "Укажите каталог и название файла для сохранения.";
	ВыборФайла.ПолноеИмяФайла = ИмяФайла;		
	Если ВыборФайла.Выбрать() Тогда
	
		#Если ВебКлиент Тогда
			
			//Получим адрес временного хранилища с файлом или сообщение об ошибке
			АдресВременногоХранилищаИлиОшибки = "";
			Если СформироватьФайлОтчетаНаСервере(Результат, ИмяФайла, АдресВременногоХранилищаИлиОшибки) Тогда
				ПолучаемыеФайлы = Новый Массив;
				ПолучаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ИмяФайла, АдресВременногоХранилищаИлиОшибки));
				ПолученныеФайлы = Новый Массив;
				//Получим файл
				Если НЕ ПолучитьФайлы(ПолучаемыеФайлы, ПолученныеФайлы, ВыборФайла.Каталог, Ложь) Тогда
					Сообщить("Ошибка передачи файла отчета с сервера.", СтатусСообщения.Важное);
					Возврат;
				КонецЕсли;				
			Иначе
				Сообщить(АдресВременногоХранилищаИлиОшибки);
				Возврат;
			КонецЕсли;
			
			//Откроем файл
			ЗапуститьПриложение(ВыборФайла.ПолноеИмяФайла);
			
		#Иначе
			
			//Сохраним файл
			Попытка
				Результат.Записать(ВыборФайла.ПолноеИмяФайла,ТипФайлаТабличногоДокумента.XLSX);
			Исключение
				Сообщить("Не удалось сохранить документ в файл " + ИмяФайла + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Важное);
				Возврат;
			КонецПопытки;
			
			//Установим параметры файла и откроем файл
			Попытка			
				xl                            = Новый COMОбъект("Excel.Application");
				xl.Application.Visible        = Истина;
				Книга                         = xl.Application.Workbooks.Open(ВыборФайла.ПолноеИмяФайла);			
				Книга.Windows(1).Visible 	  = Истина;	
				Лист                          = Книга.ActiveSheet;
				Лист.PageSetup.Orientation    = 2; // По ширине листа
				Лист.PageSetup.Zoom           = False;
				Лист.PageSetup.FitToPagesWide = 1; 
				Лист.PageSetup.FitToPagesTall = False;
				Лист.PageSetup.LeftMargin     = 1; // Поле слева
				Лист.PageSetup.RightMargin    = 1; // Поле справа
				Лист.PageSetup.TopMargin      = 2; // Поле сверху
				Лист.PageSetup.BottomMargin   = 2; // Поле снизу
				Книга.Save();			
			Исключение
				Сообщить("Не удалось установить параметры для файла " + ИмяФайла 
				+ Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Важное);
				Возврат;
			КонецПопытки;
			
		#КонецЕсли
  	
	КонецЕсли;
	
КонецПроцедуры

//***********************************************************************
&НаСервере
Функция СформироватьФайлОтчетаНаСервере(ТабличныйДокумент, ИмяФайла, АдресВременногоХранилищаИлиОшибка="")

	//Сформируем полное имя файла
	ПолноеИмяФайла = КаталогВременныхФайлов() + ИмяФайла;
	
	//Сохранение и передача файла
	Попытка
		//Запишем табличный документ в файл
		ТабличныйДокумент.Записать(ПолноеИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
		
		//Установим параметры файла и откроем файл
		xl                            = Новый COMОбъект("Excel.Application");
		xl.Application.Visible        = Истина;
		Книга                         = xl.Application.Workbooks.Open(ПолноеИмяФайла);			
		Книга.Windows(1).Visible 	  = Истина;	
		Лист                          = Книга.ActiveSheet;
		Лист.PageSetup.Orientation    = 2; // По ширине листа
		Лист.PageSetup.Zoom           = False;
		Лист.PageSetup.FitToPagesWide = 1; 
		Лист.PageSetup.FitToPagesTall = False;
		Лист.PageSetup.LeftMargin     = 1; // Поле слева
		Лист.PageSetup.RightMargin    = 1; // Поле справа
		Лист.PageSetup.TopMargin      = 2; // Поле сверху
		Лист.PageSetup.BottomMargin   = 2; // Поле снизу
		Книга.Save();
		Книга.Close();
		
		//Вернем на клиент двоичные данные файла
		АдресВременногоХранилищаИлиОшибка = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайла));
		Возврат Истина;
		
	Исключение
		АдресВременногоХранилищаИлиОшибка = "Не удалось сохранить документ в файл " + ИмяФайла 
		+ Символы.ПС + ОписаниеОшибки();
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции



/////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ФОРМЫ

//***********************************************************************
&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	Элементы.КомпоновщикНастроекНастройкиОтбор.Видимость = Отчет.ВыводитьОтбор;
	
КонецПроцедуры



/////////////////////////////////////////////////////////////////////////
// ИНФОБЛОК

//*******************************************************************
&НаКлиенте
Процедура ОсновнаяКоманднаяПанельКнопкаСсылки(Команда)
	
	Список = Новый СписокЗначений;
	Список.Добавить("http://infostart.ru/public/242708/","Домашняя страница обработки",,Элементы.КнИнфоблок.Картинка);
	Список.Добавить("http://infostart.ru/profile/187791/public/","Все публикации автора",,Элементы.КнИнфоблок.Картинка);
	Список.Добавить("http://tavalik.ru","Домашная страница автора",,Элементы.КнИнфоблок.Картинка);
	
	ТекСсылка = ВыбратьИзМеню(Список);	
	Если ТекСсылка <> Неопределено Тогда
		ЗапуститьПриложение(ТекСсылка.Значение);
	КонецЕсли;
	
КонецПроцедуры


