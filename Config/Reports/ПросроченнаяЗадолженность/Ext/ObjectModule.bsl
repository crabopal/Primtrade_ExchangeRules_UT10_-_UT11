	УниверсальныйОтчет.мСтруктураПредставлениеПолей.Вставить("ВалютаВзаиморасчетов", "Валюта взаиморасчетов");
	УниверсальныйОтчет.мСтруктураПредставлениеПолей.Вставить("ПросроченоДней", "Просрочено дней");
	УниверсальныйОтчет.мСтруктураПредставлениеПолей.Вставить("СуммаОбщегоДолга", "Остаток долга");
	УниверсальныйОтчет.мСтруктураПредставлениеПолей.Вставить("СуммаАвансов", "Авансы");
	УниверсальныйОтчет.мСтруктураПредставлениеПолей.Вставить("СуммаНепросроченныйДолг", "Непросроченный долг");
	УниверсальныйОтчет.мСтруктураПредставлениеПолей.Вставить("СуммаПросроченныйДолг", "Просроченный долг");

	УниверсальныйОтчет.ДобавитьПоказатель("ДатаДокумента", "Дата документа", Истина, "ДЛФ=Д", , );
	УниверсальныйОтчет.ДобавитьПоказатель("КоличествоДнейОтсрочки", "Количество дней отсрочки", Истина, "ЧЦ=10; ЧДЦ=0", , );
	УниверсальныйОтчет.ДобавитьПоказатель("Срок", "Срок", Истина, "ДЛФ=Д", , );
	УниверсальныйОтчет.ДобавитьПоказатель("ПросроченоДней", "Просрочено дней", Истина, "ЧЦ=10; ЧДЦ=0", , );
	УниверсальныйОтчет.ДобавитьПоказатель("СуммаОбщегоДолга", "Остаток долга", Истина, "ЧЦ=15; ЧДЦ=2", , );
	УниверсальныйОтчет.ДобавитьПоказатель("СуммаАвансов", "Авансы и возвраты", Истина, "ЧЦ=15; ЧДЦ=2", , );
	УниверсальныйОтчет.ДобавитьПоказатель("СуммаНепросроченныйДолг", "Непросроченный долг", Истина, "ЧЦ=15; ЧДЦ=2", , );
	УниверсальныйОтчет.ДобавитьПоказатель("СуммаПросроченныйДолг", "Просроченный долг", Истина, "ЧЦ=15; ЧДЦ=2", , );

