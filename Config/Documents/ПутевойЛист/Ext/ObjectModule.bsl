Функция ПрочитатьИсториюРедактирования() Экспорт
	
	СтрукНастроек = Новый Структура("ДокументыСданы,ДеньгиПолучены,ПремияЗаВыполнение,ЗарплатаВыдана", Ложь, Ложь, Ложь, Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИсторияРедактированияПутевыхЛистовСрезПоследних.ДокументыСданы,
		|	ИсторияРедактированияПутевыхЛистовСрезПоследних.ДеньгиПолучены,
		|	ИсторияРедактированияПутевыхЛистовСрезПоследних.ПремияЗаВыполнение,
		|	ИсторияРедактированияПутевыхЛистовСрезПоследних.ЗарплатаВыдана
		|ИЗ
		|	РегистрСведений.ИсторияРедактированияПутевыхЛистов.СрезПоследних(, ПутевойЛист = &ПутевойЛист) КАК ИсторияРедактированияПутевыхЛистовСрезПоследних";
	
	Запрос.УстановитьПараметр("ПутевойЛист", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтрукНастроек, Выборка);
	КонецЕсли;
	
	Возврат СтрукНастроек;
	
КонецФункции
