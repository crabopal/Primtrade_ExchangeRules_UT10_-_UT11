Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПометкаУдаления Тогда
		ПроверитьЗаполнениеТабличнойЧасти(Отказ);
	КонецЕсли;
	
	//>>Dexcel
	ТекПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	
	Если ТекПользователь.Имя = "Ведущий бухгалтер" 
		ИЛИ ТекПользователь.Имя = "Бухгалтер-кассир, взаиморасчеты"
		ИЛИ ТекПользователь.Имя = "Бухгалтер, взаиморасчеты"
		ИЛИ ТекПользователь.Имя = "Программист"Тогда
		
		СтрукНастроек = ПрочитатьИсториюРедактирования();
		Если СтрукНастроек.ДокументыСданы
			Или СтрукНастроек.ДеньгиПолучены
			ИЛИ СтрукНастроек.ЗарплатаВыдана Тогда
			ОбщегоНазначения.СообщитьОбОшибке("Документ """ + ЭтотОбъект + """ используется для расчета з\п, редактирование запрещено!", Отказ);
		КонецЕсли;
		
		Отказ = Ложь;
	Иначе
		СтрукНастроек = ПрочитатьИсториюРедактирования();
		Если СтрукНастроек.ДокументыСданы
			Или СтрукНастроек.ДеньгиПолучены
			ИЛИ СтрукНастроек.ЗарплатаВыдана Тогда
			ОбщегоНазначения.СообщитьОбОшибке("Документ """ + ЭтотОбъект + """ используется для расчета з\п, редактирование запрещено!", Отказ);
		КонецЕсли;
		
	КонецЕсли;
	//<<Dexcel
	
	Если Не Отказ
		И ДополнительныеСвойства.Свойство("СтрукНастроек") Тогда
		СохранитьИсториюРедактирования(ДополнительныеСвойства.СтрукНастроек);
	КонецЕсли;
		
КонецПроцедуры
Процедура ПроверитьЗаполнениеТабличнойЧасти(Отказ)
	
	СтруктураШапкиДокумента = ОбщегоНазначения.СформироватьСтруктуруШапкиДокумента(ЭтотОбъект);
	
	Заголовок = ОбщегоНазначения.ПредставлениеДокументаПриПроведении(СтруктураШапкиДокумента);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПутевойЛистТабРеализации.Ссылка,
		|	ПутевойЛистТабРеализации.Документ
		|ИЗ
		|	Документ.ПутевойЛист.ТабРеализации КАК ПутевойЛистТабРеализации
		|ГДЕ
		|	ПутевойЛистТабРеализации.Документ В(&Реализации)
		|	И ПутевойЛистТабРеализации.Ссылка <> &Ссылка
		|	И ПутевойЛистТабРеализации.Ссылка.Проведен
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПутевойЛистТабВозвраты.Ссылка,
		|	ПутевойЛистТабВозвраты.Документ
		|ИЗ
		|	Документ.ПутевойЛист.ТабВозвраты КАК ПутевойЛистТабВозвраты
		|ГДЕ
		|	ПутевойЛистТабВозвраты.Документ В(&Возвраты)
		|	И ПутевойЛистТабВозвраты.Ссылка <> &Ссылка
		|	И ПутевойЛистТабВозвраты.Ссылка.Проведен";

	Запрос.УстановитьПараметр("Реализации", ТабРеализации.ВыгрузитьКолонку("Документ"));
	Запрос.УстановитьПараметр("Возвраты", ТабВозвраты.ВыгрузитьКолонку("Документ"));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначения.СообщитьОбОшибке("Документ """ + Выборка.Документ + """ уже используется в """ + Выборка.Ссылка + """!", Отказ, Заголовок);
	КонецЦикла;

	ТЧ = ТабРеализации.Выгрузить();
	ТЧ.Колонки.Добавить("Количество", ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(10));
	ТЧ.ЗаполнитьЗначения(1,"Количество"); 
	ТЧ.Свернуть("Документ", "Количество");
	
	Для Каждого Строка Из ТЧ Цикл
		Если Строка.Количество > 1 Тогда
			ОбщегоНазначения.СообщитьОбОшибке("Документ """ + Строка.Документ + """ выбран более одного раза!", Отказ, Заголовок);	
		КонецЕсли;
	КонецЦикла;
	
	ТЧ = ТабВозвраты.Выгрузить();
	ТЧ.Колонки.Добавить("Количество", ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(10));
	ТЧ.ЗаполнитьЗначения(1,"Количество"); 
	ТЧ.Свернуть("Документ", "Количество");
	
	Для Каждого Строка Из ТЧ Цикл
		Если Строка.Количество > 1 Тогда
			ОбщегоНазначения.СообщитьОбОшибке("Документ """ + Строка.Документ + """ указан более одного раза!", Отказ, Заголовок);	
		КонецЕсли;
	КонецЦикла;
	
	
КонецПроцедуры


Функция _РазницаТаблицЗначений(Таблица0, Таблица1, Измерения) Экспорт
	
	// Устарело. Используйте РазницаТаблицЗначенийСверткой
	// обратите внимание, что входящие таблицы не должны иметь одинаковых строк!
	// (рекомендуется чтобы входящие таблицы были свернуты)
	
	
	
    ВсеКолонки = "";
    Для Каждого Колонка Из Таблица0.Колонки Цикл 
        ВсеКолонки = ВсеКолонки + ", " + Колонка.Имя
    КонецЦикла;
    ВсеКолонки = Сред(ВсеКолонки, 2);
    
    Таблица = Таблица1.Скопировать();    
    
    Таблица.Колонки.Добавить("Знак", Новый ОписаниеТипов("Число"));
    
    Таблица.ЗаполнитьЗначения(1, "Знак");
    
    Для Каждого Строка Из Таблица0 Цикл ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Строка) КонецЦикла;
	
	// колонка Счёт сверяет строки, которые не изменились
    Таблица.Колонки.Добавить("Счёт");
    Таблица.ЗаполнитьЗначения(1, "Счёт");
    
    Таблица.Свернуть(Измерения, "Знак, Счёт");
    Ответ = Таблица.Скопировать(Новый Структура("Счёт", 1), Измерения + ", Знак");
    
    Ответ.Сортировать(Измерения);
    
    Возврат Ответ;
    
КонецФункции
Функция _РазницаТаблицЗначенийСверткой(Таблица1, Таблица2, Измерения, Ресурсы="") Экспорт
	
	//СтрРазделить("Количество, фывфыв,   фыв", ",", Ложь);

	//НаборРесуры = СтрРазделить(Ресурсы, ",", Ложь);
	//Для Сч = 0 По НаборРесуры.Количество()-1 Цикл
	//	НаборРесуры[Сч] = СокрЛП(НаборРесуры[Сч]);
	//КонецЦикла;
	НаборРесуры = Новый Массив;
	
	ТаблицаИтг = Таблица2.Скопировать(, Измерения + "," + Ресурсы);

	Для Каждого Ресурс Из НаборРесуры Цикл
		
		ТекКолонка = ТаблицаИтг.Колонки[Ресурс];
		ТекКолонка.Имя = Ресурс + "_исх";
		
		ТаблицаИтг.Колонки.Добавить(Ресурс, 
				ОбщегоНазначения.ОписаниеТипаЧисло(ТекКолонка.ТипЗначения.КвалификаторыЧисла.Разрядность, 
													ТекКолонка.ТипЗначения.КвалификаторыЧисла.РазрядностьДробнойЧасти));
													
		ТаблицаИтг.ЗагрузитьКолонку(ТаблицаИтг.ВыгрузитьКолонку(Ресурс + "_исх"), Ресурс);
	КонецЦикла;
	
	
