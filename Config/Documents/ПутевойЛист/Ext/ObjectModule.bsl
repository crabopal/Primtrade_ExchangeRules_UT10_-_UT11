Функция ПолучитьСтруктуруПечатныхФорм() Экспорт
	
	Возврат Новый Структура("ПутевойЛист", "Путевой лист");

КонецФункции // ПолучитьСтруктуруПечатныхФорм()

Процедура ПриКопировании(ОбъектКопирования)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(кпкМаршрут.СреднийПробегКм) КАК СреднийПробегКм,
		|	МАКСИМУМ(кпкМаршрут.СуммаОплаты) КАК СуммаОплаты
		|ИЗ
		|	Справочник.кпкМаршрут КАК кпкМаршрут
		|ГДЕ
		|	кпкМаршрут.Ссылка В(&Маршрут)";
	
	Запрос.УстановитьПараметр("Маршрут", Маршруты.Выгрузить().ВыгрузитьКолонку("Маршрут"));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СуммаОплатыЗаМаршрут = Выборка.СуммаОплаты;
		СреднийПробегКм = Выборка.СреднийПробегКм;
	КонецЕсли;
	

	
КонецПроцедуры

