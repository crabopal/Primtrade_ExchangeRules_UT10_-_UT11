		|	ТабРеализации.Документ.Комментарий КАК Комментарий,
		|	ТабРеализации.Документ.Сделка.АдресДоставки КАК АдресДоставки,
		|	ЕСТЬNULL(ТабРеализации.Документ.кпкТорговаяТочка.ТипТочки.Код, 0) = 1 КАК ФактОплата,
		|	ТабРеализации.Документ.кпкТорговаяТочка.ВремяДоставки КАК ВремяДоставки,
		|	ТабРеализации.Документ.кпкТорговаяТочка.ОчередьДоставкиНаМаршруте КАК ОчередьДоставки
		|ИЗ
		|	Документ.ПутевойЛист.ТабРеализации КАК ТабРеализации
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			КонтактнаяИнформация.Объект КАК Объект,
		|			МАКСИМУМ(ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(500))) КАК Представление
		|		ИЗ
		|			РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|		ГДЕ
		|			КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента)
		|		
		|		СГРУППИРОВАТЬ ПО
		|			КонтактнаяИнформация.Объект) КАК КонтактнаяИнформация
		|		ПО ТабРеализации.Документ.Контрагент = КонтактнаяИнформация.Объект
		|ГДЕ
		|	ТабРеализации.Ссылка = &Ссылка
		|	И ТабРеализации.Документ <> ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяССылка)";
	
	ТабРеализаций = Запрос.Выполнить().Выгрузить();
	////ТабРеализаций = ПолучитьТабРеализаций(СсылкаНаОбъект);
	Сч = 0;
	Для Каждого Строка Из ТабРеализаций Цикл
		Сч = Сч+1;
		ОбластьСтрока.Параметры.Нпп	    		= Сч;
		//ОбластьСтрока.Параметры.ДокументСтр		= ОбщегоНазначения.ПолучитьНомерНаПечать(Строка.Документ) + " от " + Формат(Строка.Дата,  "ДФ=dd.MM.yyyy");
		//ОбластьСтрока.Параметры.Документ		= Строка.Документ;
		ОбластьСтрока.Параметры.КонтрагентСтр 	= СокрЛП(Строка.ТорговаяТочка);
		ОбластьСтрока.Параметры.Контрагент	 	= Строка.ТорговаяТочка;
		ОбластьСтрока.Параметры.Адрес			= Строка.АдресДоставки;
		//ОбластьСтрока.Параметры.Комментарий		= Строка.Комментарий;
		//ОбластьСтрока.Параметры.Сумма			= Строка.Сумма;
		
		//ОбластьСтрока.Параметры.Статус	    	= "Без оплаты";//Без оплаты","Оплата по факту+ПКО");
		 //?(Найти(Строчка.ДоговорКонтрагентаНаименование, "кредит")=0, Строчка.СуммаДокумента, 0);
		//ОбластьСтроки.Параметры.ФактОпл = ?(Строка.ФактОплата, "***", "");
		ОбластьСтрока.Параметры.ВремяДоставки	= Строка.ВремяДоставки;
		ОбластьСтрока.Параметры.ОчередьДоставки	= Строка.ОчередьДоставки;
        
		
		ТабДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;                       
	
	//ОбластьМакета = Макет.ПолучитьОбласть("Итого");
	//ОбластьМакета.Параметры.Сумма = ТабРеализаций.Итог("Сумма");
	//ТабДокумент.Вывести(ОбластьМакета);
	
	Возврат ТабДокумент;
	
КонецФункции
Функция ___ПечатьПутевойЛист(ИмяМакета) Экспорт
	
	СсылкаНаОбъект = Ссылка;
	
		
	Если Не СсылкаНаОбъект.Проведен Тогда
		Сообщить("Не удалось сформировать печатную форму к документу """ + СсылкаНаОбъект + """: документ не проведен!");
		Возврат Неопределено;
	КонецЕсли;
		
		
	ТабДокумент       = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПутевойЛист_ПутевойЛист";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", СсылкаНаОбъект);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПутевойЛист.Номер,
		|	ПутевойЛист.Дата,
		|	ПутевойЛист.Комментарий КАК Комментарий,
		|	ПутевойЛист.Водитель,
		|	ПутевойЛист.Водитель.НомерУдостоверения КАК НомерУдостоверения,
		|	ПутевойЛист.Маршрут,
		|	ПутевойЛист.Водитель.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ПутевойЛист.ДатаДоставки,
		|	ТабОрганизации.Организация,
		|	ТабОрганизации.Организация.Наименование,
		|	ТабОрганизации.Организация.НаименованиеПолное
		|ИЗ
		|	Документ.ПутевойЛист КАК ПутевойЛист
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПутевойЛист.Организации КАК ТабОрганизации
		|		ПО ПутевойЛист.Ссылка = ТабОрганизации.Ссылка
		|ГДЕ
		|	ПутевойЛист.Ссылка = &ТекущийДокумент";
	
	Шапка = Запрос.Выполнить().Выбрать();
	Шапка.Следующий();
	
	//ДанныеПоРасходуТС = ОбщегоНазначения_Dexcel.ПолучитьПоказанияТС(Шапка.ТранспортноеСредство, Шапка.ДатаДоставки);
	
	Макет             	= ПолучитьМакет("ПутевойЛист");
	ОбластьЗаголовка  	= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока 		= Макет.ПолучитьОбласть("Строка");
	
	
	ОтветственныеЛица = РегламентированнаяОтчетность.ОтветственныеЛицаОрганизации(Шапка.Организация, Шапка.Дата);
	СведенияОрганизация = УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(Шапка.Организация, Шапка.Дата);
	
	ЗаполнитьЗначенияСвойств(ОбластьЗаголовка.Параметры, Шапка.ТранспортноеСредство);
	
	Если Не ЗначениеЗаполнено(Шапка.ТранспортноеСредство.НормаРасходаЛето) Тогда
		ОбластьЗаголовка.Параметры.НормаРасходаЛето = "19/100( 3 т); 22/100(5т)";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Шапка.ТранспортноеСредство.НормаРасходаЗима) Тогда
		ОбластьЗаголовка.Параметры.НормаРасходаЗима = "22/100 (3 т); 27/100 (5т)";
	КонецЕсли;
	//ОбластьЗаголовка.Параметры.Показание1 = ДанныеПоРасходуТС.КоличествоНач;
	//ОбластьЗаголовка.Параметры.Показание2 = ДанныеПоРасходуТС.КоличествоКон;

	ОбластьЗаголовка.Параметры.Водитель 			= ОбщегоНазначения.ФамилияИнициалыФизЛица(Шапка.Водитель);
	ОбластьЗаголовка.Параметры.НомерУдостоверения	= Шапка.НомерУдостоверения;
	ОбластьЗаголовка.Параметры.ДокументНомерДата 	= ОбщегоНазначения.СформироватьЗаголовокДокумента(СсылкаНаОбъект, "Путевой лист");
	//ОбластьЗаголовка.Параметры.ОрганизацияСтр		= Шапка.ОрганизацияНаименованиеПолное;
	ОбластьЗаголовка.Параметры.ОрганизацияСтр		= Шапка.Организация.НаименованиеПлательщикаПриПеречисленииНалогов
		+ Символы.ПС + "Адрес: " + ?(ЗначениеЗаполнено(СведенияОрганизация.ФактическийАдрес), СведенияОрганизация.ФактическийАдрес, СведенияОрганизация.ЮридическийАдрес)
		+ ?(ЗначениеЗаполнено(СведенияОрганизация.Телефоны), Символы.ПС + "Телефоны: "  + СведенияОрганизация.Телефоны, "");
	
	ОбластьЗаголовка.Параметры.РуководительДолжность= ?(ЗначениеЗаполнено(ОтветственныеЛица.РуководительДолжность), ОтветственныеЛица.РуководительДолжность, "Директор");
	ОбластьЗаголовка.Параметры.РуководительФИО 		= ОтветственныеЛица.Руководитель;
	ОбластьЗаголовка.Параметры.БухгалтерФИО 		= ОтветственныеЛица.ГлавныйБухгалтер;
	
	//ОбщегоНазначения.ФамилияИнициалыФизЛица(СсылкаНаОбъект.Подразделение.БухгалтерПодразделения);//ОтветственныеЛица.ГлавныйБухгалтер;
	
	ОбластьЗаголовка.Параметры.ДатаРейса			= Формат(Шапка.ДатаДоставки, "ДФ=dd.MM.yyyy");
	//ОбластьЗаголовка.Параметры.ТорговыйПредставитель= Шапка.МенеджерыСписок;
	//ОбластьЗаголовка.Параметры.Экспедитор   		= Шапка.Экспедитор;
	ОбластьЗаголовка.Параметры.Маршрут				= Шапка.Маршрут;
	ОбластьЗаголовка.Параметры.Экспедитор   		= ОбщегоНазначения.ФамилияИнициалыФизЛица(Шапка.Водитель);
	ОбластьЗаголовка.Параметры.ОписаниеГруза 		= ОписаниеГруза;
	
	ТабДокумент.Вывести(ОбластьЗаголовка);
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	//Запрос.УстановитьПараметр("ТипЦенНал", Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("Факт"));
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТабРеализации.Документ,
		|	ТабРеализации.Вес,
		|	ТабРеализации.Документ.Контрагент КАК Контрагент,
		|	1 КАК НомерТч
		|ПОМЕСТИТЬ Вт
		|ИЗ
		|	Документ.ПутевойЛист.ТабРеализации КАК ТабРеализации
		|ГДЕ
		|	ТабРеализации.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПутевойЛистТабВозвраты.Документ,
		|	ПутевойЛистТабВозвраты.Вес,
		|	ПутевойЛистТабВозвраты.Документ.Контрагент,
		|	2
		|ИЗ
		|	Документ.ПутевойЛист.ТабВозвраты КАК ПутевойЛистТабВозвраты
		|ГДЕ
		|	ПутевойЛистТабВозвраты.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КонтактнаяИнформация.Объект КАК Контрагент,
		|	МАКСИМУМ(ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(500))) КАК Представление
		|ПОМЕСТИТЬ ВтАдресДоставки
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресДоставкиКонтрагента)
		|	И КонтактнаяИнформация.Объект В
		|			(ВЫБРАТЬ
		|				Вт.Контрагент
		|			ИЗ
		|				Вт)
		|
		|СГРУППИРОВАТЬ ПО
		|	КонтактнаяИнформация.Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КонтактнаяИнформация.Объект КАК Контрагент,
		|	МАКСИМУМ(ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(500))) КАК Представление
		|ПОМЕСТИТЬ ВтАдресФакт
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента)
		|	И КонтактнаяИнформация.Объект В
		|			(ВЫБРАТЬ
		|				Вт.Контрагент
		|			ИЗ
		|				Вт)
		|
		|СГРУППИРОВАТЬ ПО
		|	КонтактнаяИнформация.Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Вт.НомерТч КАК НомерТч,
		|	Вт.Документ.СуммаДокумента КАК Сумма,
		|	ВЫБОР
		|		КОГДА Вт.Документ.ТипЦен.ОплатаНаличными
		|			ТОГДА Вт.Документ.СуммаДокумента
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаНал,
		|	Вт.Документ.Дата КАК Дата,
		|	Вт.Документ.Номер КАК Номер,
		|	Вт.Контрагент КАК Контрагент,
		|	Вт.Контрагент.НаименованиеПолное КАК КонтрагентНаименованиеПолное,
		|	Вт.Контрагент.Наименование КАК КонтрагентНаименование,
		|	Вт.Документ.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	ЕСТЬNULL(Вт.Документ.ДоговорКонтрагента.Наименование, """") КАК ДоговорКонтрагентаНаименование,
		|	Вт.Документ КАК Документ,
		|	ВтАдресФакт.Представление КАК КонтрагентАдресФакт,
		|	ВтАдресДоставки.Представление КАК КонтрагентАдресДоставки,
		|	Вт.Документ.Комментарий КАК Комментарий,
		|	Вт.Документ.Сделка.АдресДоставки КАК АдресДоставки,
		|	Вт.Документ.ТипЦен.ОплатаНаличными КАК ОплатаНал
		|ИЗ
		|	Вт КАК Вт
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВтАдресФакт КАК ВтАдресФакт
		|		ПО Вт.Документ.Контрагент = ВтАдресФакт.Контрагент
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВтАдресДоставки КАК ВтАдресДоставки
		|		ПО Вт.Документ.Контрагент = ВтАдресДоставки.Контрагент";
	
	ТабРеализаций = Запрос.Выполнить().Выгрузить();
	//ТабРеализаций = ПолучитьТабРеализаций(СсылкаНаОбъект);
	Сч = 0; СуммаИтог = 0; СуммаНалИтог = 0; ТекНомерТч = 0;
	Для Каждого Строка Из ТабРеализаций Цикл
		
		Если Строка.НомерТч = 2 
			И ТекНомерТч <> Строка.НомерТч 
			И Сч > 0 Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("Итого");
			ОбластьМакета.Параметры.Сумма 	= СуммаИтог;
			ОбластьМакета.Параметры.СуммаНал= СуммаНалИтог;
	 		ТабДокумент.Вывести(ОбластьМакета);

			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаРазделитель");
			ТабДокумент.Вывести(ОбластьМакета);
			
			Сч = 0; СуммаИтог = 0; СуммаНалИтог = 0;
			ТекНомерТч = Строка.НомерТч;
		КонецЕсли;
	 
		Сч = Сч+1;
		СуммаИтог = СуммаИтог + Строка.Сумма;
		СуммаНалИтог = СуммаНалИтог + Строка.СуммаНал;
		
		ОбластьСтрока.Параметры.Нпп	    		= Сч;
		//ОбластьСтрока.Параметры.ДокументСтр		= ОбщегоНазначения.ПолучитьНомерНаПечать(Строка.Документ) + " от " + Формат(Строка.Дата,  "ДФ=dd.MM.yyyy");
		ОбластьСтрока.Параметры.ДокументСтр		= ОбщегоНазначения.ПолучитьНомерНаПечать(Строка.Документ);
		ОбластьСтрока.Параметры.Документ		= Строка.Документ;
		//ОбластьСтрока.Параметры.КонтрагентСтр 	= СокрЛП(Строка.ТорговаяТочка);
		//ОбластьСтрока.Параметры.Контрагент	 	= Строка.ТорговаяТочка;
		ОбластьСтрока.Параметры.КонтрагентСтр 	= СокрЛП(Строка.КонтрагентНаименованиеПолное);
		ОбластьСтрока.Параметры.Контрагент	 	= Строка.Контрагент;
		
		//ОбластьСтрока.Параметры.Адрес			= Строка.АдресДоставки;
		ОбластьСтрока.Параметры.Комментарий		= Строка.Комментарий;
		ОбластьСтрока.Параметры.Сумма			= Строка.Сумма;
		ОбластьСтрока.Параметры.СуммаНал		= Строка.СуммаНал;
		
		
		Если ЗначениеЗаполнено(Строка.АдресДоставки) Тогда
			ОбластьСтрока.Параметры.Адрес = Строка.АдресДоставки;
		ИначеЕсли ЗначениеЗаполнено(Строка.КонтрагентАдресДоставки) Тогда
			ОбластьСтрока.Параметры.Адрес = Строка.КонтрагентАдресДоставки;
		КонецЕсли;
		
		Если Строка.НомерТч = 1 Тогда
			НайдСтроки = ТабРеализаций.НайтиСтроки(Новый Структура("НомерТч, Контрагент", 2, Строка.Контрагент));
			Если НайдСтроки.Количество() > 0 Тогда
				ОбластьСтрока.Параметры.Комментарий = "ВОЗВРАТ" + ?(ЗначениеЗаполнено(ОбластьСтрока.Параметры.Комментарий), ", " + ОбластьСтрока.Параметры.Комментарий, "");
			КонецЕсли;
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;                       
	
	ОбластьМакета = Макет.ПолучитьОбласть("Итого");
	//ОбластьМакета.Параметры.Сумма 		= ТабРеализаций.Итог("Сумма");
	//ОбластьМакета.Параметры.СуммаНал 	= ТабРеализаций.Итог("СуммаНал");
	ОбластьМакета.Параметры.Сумма 	= СуммаИтог;
	ОбластьМакета.Параметры.СуммаНал= СуммаНалИтог;
	 		
	ТабДокумент.Вывести(ОбластьМакета);
	
	Возврат ТабДокумент;
	
КонецФункции
Функция ____ПечатьПутевойЛист(ИмяМакета) Экспорт
	
	СсылкаНаОбъект = Ссылка;
	
		
	Если Не СсылкаНаОбъект.Проведен Тогда
		Сообщить("Не удалось сформировать печатную форму к документу """ + СсылкаНаОбъект + """: документ не проведен!");
		Возврат Неопределено;
	КонецЕсли;
		
		
	ТабДокумент       = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПутевойЛист_ПутевойЛист";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПутевойЛист.Номер,
		|	ПутевойЛист.Дата,
		|	ПутевойЛист.Комментарий КАК Комментарий,
		|	ПутевойЛист.Водитель,
		|	ПутевойЛист.Водитель.НомерУдостоверения КАК НомерУдостоверения,
		|	ПутевойЛист.Маршрут,
		|	ПутевойЛист.Водитель.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ПутевойЛист.ДатаДоставки,
		|	ПутевойЛист.СуммаОплаты,
		|	ТабОрганизации.Организация,
		|	ТабОрганизации.Организация.Наименование,
		|	ТабОрганизации.Организация.НаименованиеПолное
		|ИЗ
		|	Документ.ПутевойЛист КАК ПутевойЛист
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПутевойЛист.Организации КАК ТабОрганизации
		|		ПО ПутевойЛист.Ссылка = ТабОрганизации.Ссылка
		|ГДЕ
		|	ПутевойЛист.Ссылка = &Ссылка";
	
	Шапка = Запрос.Выполнить().Выбрать();
	Шапка.Следующий();
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТабРеализации.Документ,
		|	ТабРеализации.Вес,
		|	ТабРеализации.Документ.Контрагент КАК Контрагент,
		|	1 КАК НомерТч
		|ПОМЕСТИТЬ Вт
		|ИЗ
		|	Документ.ПутевойЛист.ТабРеализации КАК ТабРеализации
		|ГДЕ
		|	ТабРеализации.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПутевойЛистТабВозвраты.Документ,
		|	ПутевойЛистТабВозвраты.Вес,
		|	ПутевойЛистТабВозвраты.Документ.Контрагент,
		|	2
		|ИЗ
		|	Документ.ПутевойЛист.ТабВозвраты КАК ПутевойЛистТабВозвраты
		|ГДЕ
		|	ПутевойЛистТабВозвраты.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КонтактнаяИнформация.Объект КАК Контрагент,
		|	МАКСИМУМ(ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(500))) КАК Представление
		|ПОМЕСТИТЬ ВтАдресДоставки
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресДоставкиКонтрагента)
		|	И КонтактнаяИнформация.Объект В
		|			(ВЫБРАТЬ
		|				Вт.Контрагент
		|			ИЗ
		|				Вт)
		|
		|СГРУППИРОВАТЬ ПО
		|	КонтактнаяИнформация.Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КонтактнаяИнформация.Объект КАК Контрагент,
		|	МАКСИМУМ(ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(500))) КАК Представление
		|ПОМЕСТИТЬ ВтАдресФакт
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента)
		|	И КонтактнаяИнформация.Объект В
		|			(ВЫБРАТЬ
		|				Вт.Контрагент
		|			ИЗ
		|				Вт)
		|
		|СГРУППИРОВАТЬ ПО
		|	КонтактнаяИнформация.Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Вт.Документ,
		|	СУММА(ЕСТЬNULL(РеализацияТоваровУслугТовары.КоличествоМестМолоко, 0)) КАК КоличествоМестМолоко,
		|   СУММА(ЕСТЬNULL(РеализацияТоваровУслугТовары.КоличествоМестРыба, 0)) КАК КоличествоМестРыба,
		|	СУММА(ЕСТЬNULL(РеализацияТоваровУслугТовары.КоличествоМестЗаморозка, 0)) КАК КоличествоМестЗаморозка
		|ПОМЕСТИТЬ ВтКоличество
		|ИЗ
		|	Вт КАК Вт
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|		ПО Вт.Документ = РеализацияТоваровУслугТовары.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	Вт.Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Вт.НомерТч КАК НомерТч,
		|	Вт.Документ.СуммаДокумента КАК Сумма,
		|	ВЫБОР
		|		КОГДА Вт.Документ.ТипЦен.ОплатаНаличными
		|			ТОГДА Вт.Документ.СуммаДокумента
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаНал,
		|	Вт.Документ.Дата КАК Дата,
		|	Вт.Документ.Номер КАК Номер,
		|	Вт.Контрагент КАК Контрагент,
		|	Вт.Контрагент.НаименованиеПолное КАК КонтрагентНаименованиеПолное,
		|	Вт.Контрагент.Наименование КАК КонтрагентНаименование,
		|	Вт.Документ.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	ЕСТЬNULL(Вт.Документ.ДоговорКонтрагента.Наименование, """") КАК ДоговорКонтрагентаНаименование,
		|	Вт.Документ КАК Документ,
		|	ВтАдресФакт.Представление КАК КонтрагентАдресФакт,
		|	ВтАдресДоставки.Представление КАК КонтрагентАдресДоставки,
		|	Вт.Документ.Комментарий КАК Комментарий,
		|	Вт.Документ.Сделка.АдресДоставки КАК АдресДоставки,
		|	Вт.Документ.ТипЦен.ОплатаНаличными КАК ОплатаНал,
		|	ЕСТЬNULL(ВтКоличество.КоличествоМестРыба, 0) КАК КоличествоМестРыба,
		|	ЕСТЬNULL(ВтКоличество.КоличествоМестМолоко, 0) КАК КоличествоМестМолоко,
		|	ЕСТЬNULL(ВтКоличество.КоличествоМестЗаморозка, 0) КАК КоличествоМестЗаморозка
		|ИЗ
		|	Вт КАК Вт
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВтАдресФакт КАК ВтАдресФакт
		|		ПО Вт.Документ.Контрагент = ВтАдресФакт.Контрагент
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВтАдресДоставки КАК ВтАдресДоставки
		|		ПО Вт.Документ.Контрагент = ВтАдресДоставки.Контрагент
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВтКоличество КАК ВтКоличество
		|		ПО Вт.Документ = ВтКоличество.Документ";
	
	ТабРеализаций = Запрос.Выполнить().Выгрузить();
	
	
	
	//ДанныеПоРасходуТС = ОбщегоНазначения_Dexcel.ПолучитьПоказанияТС(Шапка.ТранспортноеСредство, Шапка.ДатаДоставки);
	
	Макет             	= ПолучитьМакет("ПутевойЛист");
	ОбластьЗаголовка  	= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока 		= Макет.ПолучитьОбласть("Строка");
	
	
	ОтветственныеЛица = РегламентированнаяОтчетность.ОтветственныеЛицаОрганизации(Шапка.Организация, Шапка.Дата);
	СведенияОрганизация = УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(Шапка.Организация, Шапка.Дата);
	
	ОбластьЗаголовка.Параметры.Заполнить(Шапка);
	ОбластьЗаголовка.Параметры.Заполнить(Шапка.ТранспортноеСредство);
	
	//Если Не ЗначениеЗаполнено(Шапка.ТранспортноеСредство.НормаРасходаЛето) Тогда
	//	ОбластьЗаголовка.Параметры.НормаРасходаЛето = "19/100( 3 т); 22/100(5т)";
	//КонецЕсли;
	//Если Не ЗначениеЗаполнено(Шапка.ТранспортноеСредство.НормаРасходаЗима) Тогда
	//	ОбластьЗаголовка.Параметры.НормаРасходаЗима = "22/100 (3 т); 27/100 (5т)";
	//КонецЕсли;
	//ОбластьЗаголовка.Параметры.Показание1 = ДанныеПоРасходуТС.КоличествоНач;
	//ОбластьЗаголовка.Параметры.Показание2 = ДанныеПоРасходуТС.КоличествоКон;

	ОбластьЗаголовка.Параметры.Водитель 			= ОбщегоНазначения.ФамилияИнициалыФизЛица(Шапка.Водитель);
	ОбластьЗаголовка.Параметры.НомерУдостоверения	= Шапка.НомерУдостоверения;
	ОбластьЗаголовка.Параметры.ДокументНомерДата 	= ОбщегоНазначения.СформироватьЗаголовокДокумента(СсылкаНаОбъект, "Путевой лист");
	//ОбластьЗаголовка.Параметры.ОрганизацияСтр		= Шапка.ОрганизацияНаименованиеПолное;
	ОбластьЗаголовка.Параметры.ОрганизацияСтр		= Шапка.Организация.НаименованиеПлательщикаПриПеречисленииНалогов
		+ Символы.ПС + "Адрес: " + ?(ЗначениеЗаполнено(СведенияОрганизация.ФактическийАдрес), СведенияОрганизация.ФактическийАдрес, СведенияОрганизация.ЮридическийАдрес)
		+ ?(ЗначениеЗаполнено(СведенияОрганизация.Телефоны), Символы.ПС + "Телефоны: "  + СведенияОрганизация.Телефоны, "");
	
	ОбластьЗаголовка.Параметры.РуководительДолжность= ?(ЗначениеЗаполнено(ОтветственныеЛица.РуководительДолжность), ОтветственныеЛица.РуководительДолжность, "Директор");
	ОбластьЗаголовка.Параметры.РуководительФИО 		= ОтветственныеЛица.Руководитель;
	ОбластьЗаголовка.Параметры.БухгалтерФИО 		= ОтветственныеЛица.ГлавныйБухгалтер;
	
	//ОбщегоНазначения.ФамилияИнициалыФизЛица(СсылкаНаОбъект.Подразделение.БухгалтерПодразделения);//ОтветственныеЛица.ГлавныйБухгалтер;
	
	ОбластьЗаголовка.Параметры.ДатаРейса			= Формат(Шапка.ДатаДоставки, "ДФ=dd.MM.yyyy");
	//ОбластьЗаголовка.Параметры.ТорговыйПредставитель= Шапка.МенеджерыСписок;
	//ОбластьЗаголовка.Параметры.Экспедитор   		= Шапка.Экспедитор;
	ОбластьЗаголовка.Параметры.Маршрут				= Шапка.Маршрут;
	//ОбластьЗаголовка.Параметры.Экспедитор   		= ОбщегоНазначения.ФамилияИнициалыФизЛица(Шапка.Водитель);
	ОбластьЗаголовка.Параметры.ОписаниеГруза 		= ОписаниеГруза;
	
	
	ТабИтоги = ТабРеализаций.Скопировать(Новый Структура("НомерТч", 1), "СуммаНал");
	ТабИтоги.Свернуть(,"СуммаНал");
	Если ТабИтоги.Количество() > 0 Тогда
		ОбластьЗаголовка.Параметры.СуммаНал = ТабИтоги[0].СуммаНал;
	КонецЕсли;
	
	//ОбластьЗаголовка/СуммаОплаты			
	//ОбластьЗаголовка.Параметры
	ТабДокумент.Вывести(ОбластьЗаголовка);
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	//Запрос.УстановитьПараметр("ТипЦенНал", Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("Факт"));
	//ТабРеализаций = ПолучитьТабРеализаций(СсылкаНаОбъект);
	Сч = 0; СуммаИтог = 0; СуммаНалИтог = 0; ТекНомерТч = 0;
	Для Каждого Строка Из ТабРеализаций Цикл
		
		Если Строка.НомерТч = 2 
			И ТекНомерТч <> Строка.НомерТч Тогда
		//	ОбластьМакета = Макет.ПолучитьОбласть("Итого");
		//	ОбластьМакета.Параметры.Сумма 	= СуммаИтог;
		//	ОбластьМакета.Параметры.СуммаНал= СуммаНалИтог;
		//ТабДокумент.Вывести(ОбластьМакета);

			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаРазделитель");
			ТабДокумент.Вывести(ОбластьМакета);
			
			Сч = 0; 
			//СуммаИтог = 0; СуммаНалИтог = 0;
			ТекНомерТч = Строка.НомерТч;
		КонецЕсли;
	 
		Сч = Сч+1;
		//СуммаИтог = СуммаИтог + Строка.Сумма;
		//СуммаНалИтог = СуммаНалИтог + Строка.СуммаНал;
		
		ОбластьСтрока.Параметры.Заполнить(Строка);
		
		ОбластьСтрока.Параметры.Нпп	    		= Сч;
		ОбластьСтрока.Параметры.ДокументСтр		= ОбщегоНазначения.ПолучитьНомерНаПечать(Строка.Документ);
		ОбластьСтрока.Параметры.КонтрагентСтр 	= СокрЛП(Строка.Контрагент);
		
		//ОбластьСтрока.Параметры.ДокументСтр		= ОбщегоНазначения.ПолучитьНомерНаПечать(Строка.Документ) + " от " + Формат(Строка.Дата,  "ДФ=dd.MM.yyyy");
		//ОбластьСтрока.Параметры.Документ		= Строка.Документ;
		//ОбластьСтрока.Параметры.КонтрагентСтр 	= СокрЛП(Строка.ТорговаяТочка);
		//ОбластьСтрока.Параметры.Контрагент	 	= Строка.ТорговаяТочка;
		
		//ОбластьСтрока.Параметры.Контрагент	 	= Строка.Контрагент;
		
		//ОбластьСтрока.Параметры.Адрес			= Строка.АдресДоставки;
		//ОбластьСтрока.Параметры.Комментарий		= Строка.Комментарий;
		//ОбластьСтрока.Параметры.Сумма			= Строка.Сумма;
		//ОбластьСтрока.Параметры.СуммаНал		= Строка.СуммаНал;
		
		
		Если ЗначениеЗаполнено(Строка.АдресДоставки) Тогда
			ОбластьСтрока.Параметры.Адрес = Строка.АдресДоставки;
		ИначеЕсли ЗначениеЗаполнено(Строка.КонтрагентАдресДоставки) Тогда
			ОбластьСтрока.Параметры.Адрес = Строка.КонтрагентАдресДоставки;
		КонецЕсли;
		
		ОбластьСтрока.Параметры.КоличествоМест = "";
		
		Если Строка.НомерТч = 1 Тогда
			НайдСтроки = ТабРеализаций.НайтиСтроки(Новый Структура("НомерТч, Контрагент", 2, Строка.Контрагент));
			Если НайдСтроки.Количество() > 0 Тогда
				ОбластьСтрока.Параметры.Комментарий = "ВОЗВРАТ" + ?(ЗначениеЗаполнено(ОбластьСтрока.Параметры.Комментарий), ", " + ОбластьСтрока.Параметры.Комментарий, "");
			КонецЕсли;
			
	
			Если ЗначениеЗаполнено(Строка.КоличествоМестОхл) 
				Или ЗначениеЗаполнено(Строка.КоличествоМестЗаморозка)  Тогда
			
				ОбластьСтрока.Параметры.КоличествоМест = Формат(Строка.КоличествоМестОхл, "ЧГ=0") + "+" + Формат(Строка.КоличествоМестЗаморозка, "ЧГ=0");
			КонецЕсли;
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;                       
	
	//ОбластьМакета = Макет.ПолучитьОбласть("Итого");
	//ОбластьМакета.Параметры.Сумма 		= ТабРеализаций.Итог("Сумма");
	//ОбластьМакета.Параметры.СуммаНал 	= ТабРеализаций.Итог("СуммаНал");
	//ОбластьМакета.Параметры.Сумма 	= СуммаИтог;
	//ОбластьМакета.Параметры.СуммаНал= СуммаНалИтог;
	 		
	//ТабДокумент.Вывести(ОбластьМакета);
	
	Возврат ТабДокумент;
	
КонецФункции
Функция ПечатьПутевойЛист(ИмяМакета) Экспорт
	
	СсылкаНаОбъект = Ссылка;
	
		
	Если Не СсылкаНаОбъект.Проведен Тогда
		Сообщить("Не удалось сформировать печатную форму к документу """ + СсылкаНаОбъект + """: документ не проведен!");
		Возврат Неопределено;
	КонецЕсли;
		
		
	ТабДокумент       = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПутевойЛист_ПутевойЛист";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПутевойЛист.Номер,
		|	ПутевойЛист.МаршрутыСтр,
		|	ПутевойЛист.Дата,
		|	ПутевойЛист.Комментарий КАК Комментарий,
		|	ПутевойЛист.СреднийПробегКм,
		|	ПутевойЛист.Водитель,
		|	ПутевойЛист.Водитель.НомерУдостоверения КАК НомерУдостоверения,
		|	ПутевойЛист.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ПутевойЛист.ТранспортноеСредство.Тип КАК Тип,
		|	ПутевойЛист.ТранспортноеСредство.ГосНомер КАК ГосНомер,
		|	ПутевойЛист.ТранспортноеСредство.Марка КАК Марка,
		|	ПутевойЛист.ТранспортноеСредство.Грузоподъемность КАК Грузоподъемность,
		|	ПутевойЛист.ТранспортноеСредство.ОСАГО КАК ОСАГО,
		|	ПутевойЛист.ДатаДоставки,
		|	ПутевойЛист.СуммаОплатыЗаМаршрут,
		|	ПутевойЛист.ВесДополнительный,
		|	ТабОрганизации.Организация,
		|	ТабОрганизации.Организация.Наименование,
		|	ТабОрганизации.Организация.НаименованиеПолное,
		|	ЕстьNull(ЗапросРеализации.КоличествоКонтрагентов,0) КАК КоличествоКонтрагентов,
		|	ПутевойЛист.ТорговыеТочкиДоп
		|ИЗ
		|	Документ.ПутевойЛист КАК ПутевойЛист
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПутевойЛист.Организации КАК ТабОрганизации
		|		ПО ПутевойЛист.Ссылка = ТабОрганизации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СУММА(ПутевойЛистТабРеализации.Вес) КАК Вес,
		|			СУММА(ЕСТЬNULL(ПутевойЛистТабРеализации.Документ.СуммаДокумента, 0)) КАК СуммаРеализации,
		|			ПутевойЛистТабРеализации.Ссылка КАК Ссылка,
		|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПутевойЛистТабРеализации.Документ.Контрагент) КАК КоличествоКонтрагентов
		|		ИЗ
		|			Документ.ПутевойЛист.ТабРеализации КАК ПутевойЛистТабРеализации
		|		ГДЕ
		|			ПутевойЛистТабРеализации.Ссылка = &Ссылка
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ПутевойЛистТабРеализации.Ссылка) КАК ЗапросРеализации
		|		ПО ПутевойЛист.Ссылка = ЗапросРеализации.Ссылка
		|ГДЕ
		|	ПутевойЛист.Ссылка = &Ссылка";
		
		
	Шапка = Запрос.Выполнить().Выбрать();
	Шапка.Следующий();
	
	Запрос.Текст = ТекстЗапросаСуммаОплатыВодителю();
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Дата));
	ТабИтоги = Запрос.Выполнить().Выгрузить();
	ТекСуммаОплаты = ТабИтоги.Итог("Сумма");
	
	СуммаОплатыРасшифровка = "";
	Для Каждого Строка Из ТабИтоги Цикл
		Если ЗначениеЗаполнено(Строка.Сумма) Тогда
			СуммаОплатыРасшифровка = СуммаОплатыРасшифровка + Строка.Группа + ": " + Формат(Строка.Сумма, "ЧДЦ=2") + Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	СуммаОплатыРасшифровка = Лев(СуммаОплатыРасшифровка, СтрДлина(СуммаОплатыРасшифровка)-1);
	
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТабРеализации.Документ,
		|	ТабРеализации.Вес,
		|	ТабРеализации.Документ.Контрагент КАК Контрагент,
		|	1 КАК НомерТч
		|ПОМЕСТИТЬ Вт
		|ИЗ
		|	Документ.ПутевойЛист.ТабРеализации КАК ТабРеализации
		|ГДЕ
		|	ТабРеализации.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПутевойЛистТабВозвраты.Документ,
		|	ПутевойЛистТабВозвраты.Вес,
		|	ПутевойЛистТабВозвраты.Документ.Контрагент,
		|	2
		|ИЗ
		|	Документ.ПутевойЛист.ТабВозвраты КАК ПутевойЛистТабВозвраты
		|ГДЕ
		|	ПутевойЛистТабВозвраты.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КонтактнаяИнформация.Объект КАК Контрагент,
		|	МАКСИМУМ(ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(500))) КАК Представление
		|ПОМЕСТИТЬ ВтАдресДоставки
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресДоставкиКонтрагента)
		|	И КонтактнаяИнформация.Объект В
		|			(ВЫБРАТЬ
		|				Вт.Контрагент
		|			ИЗ
		|				Вт)
		|
		|СГРУППИРОВАТЬ ПО
		|	КонтактнаяИнформация.Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КонтактнаяИнформация.Объект КАК Контрагент,
		|	МАКСИМУМ(ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(500))) КАК Представление
		|ПОМЕСТИТЬ ВтАдресФакт
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента)
		|	И КонтактнаяИнформация.Объект В
		|			(ВЫБРАТЬ
		|				Вт.Контрагент
		|			ИЗ
		|				Вт)
		|
		|СГРУППИРОВАТЬ ПО
		|	КонтактнаяИнформация.Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Вт.Документ,
		|   СУММА(ЕСТЬNULL(РеализацияТоваровУслуг.КоличествоМестРыба, 0)) КАК КоличествоМестРыба,
		|	СУММА(ЕСТЬNULL(РеализацияТоваровУслуг.КоличествоМестМолоко, 0)) КАК КоличествоМестМолоко,
		|	СУММА(ЕСТЬNULL(РеализацияТоваровУслуг.КоличествоМестЗаморозка, 0)) КАК КоличествоМестЗаморозка
		|ПОМЕСТИТЬ ВтКоличество
		|ИЗ
		|	Вт КАК Вт
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ПО Вт.Документ = РеализацияТоваровУслуг.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	Вт.Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Вт.НомерТч КАК НомерТч,
		|	Вт.Документ.СуммаДокумента КАК Сумма,
		|	ВЫБОР
		|		КОГДА Вт.Документ.ТипЦен.ОплатаНаличными
		//>>Dexcel
		|   ИЛИ  Вт.Документ.ДоговорКонтрагента.ОплатаНаличными
		//<<Dexcel
		|			ТОГДА Вт.Документ.СуммаДокумента
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаНал,
		|	Вт.Документ.Дата КАК Дата,
		|	Вт.Документ.Номер КАК Номер,
		|	Вт.Контрагент КАК Контрагент,
		|	Вт.Контрагент.НаименованиеПолное КАК КонтрагентНаименованиеПолное,
		|	Вт.Контрагент.Наименование КАК КонтрагентНаименование,
		|	Вт.Документ.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	ЕСТЬNULL(Вт.Документ.ДоговорКонтрагента.Наименование, """") КАК ДоговорКонтрагентаНаименование,
		|	Вт.Документ КАК Документ,
		|	ВтАдресФакт.Представление КАК КонтрагентАдресФакт,
		|	ВтАдресДоставки.Представление КАК КонтрагентАдресДоставки,
		|	Вт.Документ.Комментарий КАК Комментарий,
		|	Вт.Документ.Сделка.АдресДоставки КАК АдресДоставки,
		|	Вт.Документ.ТипЦен.ОплатаНаличными КАК ОплатаНал,
		|	ЕСТЬNULL(ВтКоличество.КоличествоМестРыба, 0) КАК КоличествоМестРыба,
		|	ЕСТЬNULL(ВтКоличество.КоличествоМестМолоко, 0) КАК КоличествоМестМолоко,
		|	ЕСТЬNULL(ВтКоличество.КоличествоМестЗаморозка, 0) КАК КоличествоМестЗаморозка,
		|	Вт.Вес
		|ИЗ
		|	Вт КАК Вт
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВтАдресФакт КАК ВтАдресФакт
		|		ПО Вт.Документ.Контрагент = ВтАдресФакт.Контрагент
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВтАдресДоставки КАК ВтАдресДоставки
		|		ПО Вт.Документ.Контрагент = ВтАдресДоставки.Контрагент
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВтКоличество КАК ВтКоличество
		|		ПО Вт.Документ = ВтКоличество.Документ
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерТч,
		|	КонтрагентНаименование";
	
	ТабРеализаций = Запрос.Выполнить().Выгрузить();
	
		
		
	//ДанныеПоРасходуТС = ОбщегоНазначения_Dexcel.ПолучитьПоказанияТС(Шапка.ТранспортноеСредство, Шапка.ДатаДоставки);
	
	Макет             	= ПолучитьМакет("ПутевойЛист");
	ОбластьЗаголовка  	= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока 		= Макет.ПолучитьОбласть("Строка");
	
	
	ОтветственныеЛица = РегламентированнаяОтчетность.ОтветственныеЛицаОрганизации(Шапка.Организация, Шапка.Дата);
	СведенияОрганизация = УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(Шапка.Организация, Шапка.Дата);
	
	ОбластьЗаголовка.Параметры.Заполнить(Шапка);
	//ОбластьЗаголовка.Параметры.Заполнить(Шапка.ТранспортноеСредство);
	ОбластьЗаголовка.Параметры.СуммаОплаты = ТекСуммаОплаты;
	ОбластьЗаголовка.Параметры.СуммаОплатыРасшифровка = СуммаОплатыРасшифровка;
	
	//Если Не ЗначениеЗаполнено(Шапка.ТранспортноеСредство.НормаРасходаЛето) Тогда
	//	ОбластьЗаголовка.Параметры.НормаРасходаЛето = "19/100( 3 т); 22/100(5т)";
	//КонецЕсли;
	//Если Не ЗначениеЗаполнено(Шапка.ТранспортноеСредство.НормаРасходаЗима) Тогда
	//	ОбластьЗаголовка.Параметры.НормаРасходаЗима = "22/100 (3 т); 27/100 (5т)";
	//КонецЕсли;
	//ОбластьЗаголовка.Параметры.Показание1 = ДанныеПоРасходуТС.КоличествоНач;
	//ОбластьЗаголовка.Параметры.Показание2 = ДанныеПоРасходуТС.КоличествоКон;

	ОбластьЗаголовка.Параметры.Водитель 			= ОбщегоНазначения.ФамилияИнициалыФизЛица(Шапка.Водитель);
	ОбластьЗаголовка.Параметры.ДокументНомерДата 	= ОбщегоНазначения.СформироватьЗаголовокДокумента(СсылкаНаОбъект, "Путевой лист");
	//ОбластьЗаголовка.Параметры.НомерУдостоверения	= Шапка.НомерУдостоверения;
	//ОбластьЗаголовка.Параметры.ОрганизацияСтр		= Шапка.ОрганизацияНаименованиеПолное;
	ОбластьЗаголовка.Параметры.ОрганизацияСтр		= Шапка.Организация.НаименованиеПлательщикаПриПеречисленииНалогов
		+ Символы.ПС + "Адрес: " + ?(ЗначениеЗаполнено(СведенияОрганизация.ФактическийАдрес), СведенияОрганизация.ФактическийАдрес, СведенияОрганизация.ЮридическийАдрес)
		+ ?(ЗначениеЗаполнено(СведенияОрганизация.Телефоны), Символы.ПС + "Телефоны: "  + СведенияОрганизация.Телефоны, "");
	//>>Dexcel	
	//ОбластьЗаголовка.Параметры.РуководительДолжность= ?(ЗначениеЗаполнено(ОтветственныеЛица.РуководительДолжность), ОтветственныеЛица.РуководительДолжность, "Директор");
	//ОбластьЗаголовка.Параметры.РуководительФИО 		= ОтветственныеЛица.Руководитель;
	//ОбластьЗаголовка.Параметры.БухгалтерФИО 		= ОтветственныеЛица.ГлавныйБухгалтер;
	//<<Dexcel
	//ОбщегоНазначения.ФамилияИнициалыФизЛица(СсылкаНаОбъект.Подразделение.БухгалтерПодразделения);//ОтветственныеЛица.ГлавныйБухгалтер;
	
	ОбластьЗаголовка.Параметры.ДатаРейса			= Формат(Шапка.ДатаДоставки, "ДФ=dd.MM.yyyy");
	//ОбластьЗаголовка.Параметры.ТорговыйПредставитель= Шапка.МенеджерыСписок;
	//ОбластьЗаголовка.Параметры.Экспедитор   		= Шапка.Экспедитор;
	//ОбластьЗаголовка.Параметры.Маршрут				= Шапка.Маршрут;
	//ОбластьЗаголовка.Параметры.Экспедитор   		= ОбщегоНазначения.ФамилияИнициалыФизЛица(Шапка.Водитель);
	ОбластьЗаголовка.Параметры.ОписаниеГруза= ОписаниеГруза;
	
	
	
	ТабИтоги = ТабРеализаций.Скопировать(Новый Структура("НомерТч", 1), "Сумма, СуммаНал, Вес");
	ТабИтоги.Свернуть(,"Сумма, СуммаНал, Вес");
	Если ТабИтоги.Количество() > 0 Тогда
		ОбластьЗаголовка.Параметры.СуммаНал = ТабИтоги[0].СуммаНал;
		//ОбластьЗаголовка.Параметры.Вес 		= ТабИтоги[0].Вес;
		ОбластьЗаголовка.Параметры.Сумма	= ТабИтоги[0].Сумма;
		
		ВесСтр = Строка(ТабИтоги[0].Вес);
	Иначе
		ВесСтр = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Шапка.ВесДополнительный) Тогда
		ВесСтр = ВесСтр + " / " + Шапка.ВесДополнительный;
		ВесПредставление = "Вес заказов / дополнительный, кг";					
	Иначе
		ВесПредставление = "Вес заказов, кг";					
	КонецЕсли;
	
	ОбластьЗаголовка.Параметры.ВесПредставление = ВесПредставление;
	ОбластьЗаголовка.Параметры.ВесСтр = ВесСтр;
	ОбластьЗаголовка.Параметры.КоличествоТТ = ?(ЗначениеЗаполнено(Шапка.ТорговыеТочкиДоп), Шапка.КоличествоКонтрагентов + " + " + Шапка.ТорговыеТочкиДоп, Шапка.КоличествоКонтрагентов);
	
	//ОбластьЗаголовка/СуммаОплаты			
	//ОбластьЗаголовка.Параметры
	ТабДокумент.Вывести(ОбластьЗаголовка);
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	//Запрос.УстановитьПараметр("ТипЦенНал", Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("Факт"));
	//ТабРеализаций = ПолучитьТабРеализаций(СсылкаНаОбъект);
	Сч = 0; СуммаИтог = 0; СуммаНалИтог = 0; ТекНомерТч = 0;
	Для Каждого Строка Из ТабРеализаций Цикл
		
		Если Строка.НомерТч = 2 
