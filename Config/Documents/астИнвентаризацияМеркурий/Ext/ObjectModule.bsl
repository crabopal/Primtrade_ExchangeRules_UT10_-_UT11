
Процедура ПриКопировании(ОбъектКопирования)
	
	Комментарий = "";
	Статус = Перечисления.астСтатусыОбработкиДокументовМеркурий.Создан;
	ФайлЗапроса = "";
	ФайлОтвета = "";
	ИдентификаторМеркурий = "";
	ОтветСервера = "";
	ДатаИнвентаризации = "";
	
	Для Каждого Строка Из ПартииПродукции Цикл
		Строка.ВидПродукции = Строка.ПродукцияМеркурий.Владелец;
		Строка.ГруппаПродукции = Строка.ВидПродукции.Владелец;
		Строка.ТипПродукции = Строка.ГруппаПродукции.Владелец;
		
		Если ТипДокумента = "Оприходование" Тогда
			Строка.ПартияПродукции = "";
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	ВерсияПриложения = астОбщегоНазначенияМеркурий.ОпределитьВерсиюПриложения();
	Если ВерсияПриложения <> 81 Тогда
		Выполнить("Движения.астПартииПродукцииМеркурий.Записывать = Истина;");
	КонецЕсли;

	ОбработкаУдаленияПроведения(Отказ);
	Движения.астПартииПродукцииМеркурий.Очистить();	
	
	Если ТипДокумента = "Списание" Тогда
		// проверим остатки
		Отказ = астОбщегоНазначенияМеркурий.ПроверитьОстаткиПартийПоДокументу(Ссылка);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипДокумента = "Списание" Тогда
		Если Статус = Перечисления.астСтатусыОбработкиДокументовМеркурий.ПолученОтказ Тогда
			Возврат;
		КонецЕсли;
	Иначе
		Если НЕ Статус = Перечисления.астСтатусыОбработкиДокументовМеркурий.ПолученоПодтверждение Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Для Каждого ТекСтрокаТовары Из ПартииПродукции Цикл	
		Если НЕ ЗначениеЗаполнено(ТекСтрокаТовары.ПартияПродукции) Тогда
			Продолжить;
		КонецЕсли;
				
		Если ТипДокумента = "Оприходование" Тогда
			Количество = ТекСтрокаТовары.КоличествоФакт;
			ВидДвижения = "Приход";
		Иначе	
			Количество = ТекСтрокаТовары.Количество - ТекСтрокаТовары.КоличествоФакт;	
			Если Количество > 0 Тогда
				ВидДвижения = "Расход";
			ИначеЕсли Количество = 0 Тогда	
				Продолжить;
			Иначе	
				ВидДвижения = "Приход";
				
				Количество = -Количество;
			КонецЕсли;
		КонецЕсли;
		
		астОбщегоНазначенияМеркурий.ДвижениеПоРегиструПартийМеркурий(Движения, ТекСтрокаТовары, Ссылка, ВидДвижения, Количество);
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
		
	//Очистка движений документа
	Для Каждого Движение ИЗ ЭтотОбъект.Движения Цикл
		Движение.Очистить();
	КонецЦикла;
	
	//Запись пустых наборов движений в ИБ(очистка старых движений)	
	Набор = РегистрыНакопления.астПартииПродукцииМеркурий.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	Попытка
		Набор.Записать();
	Исключение
		// возможно «сработал» RLS или механизм даты запрета изменения
		Сообщить("Операция не выполнена: " + ОписаниеОшибки());
		Отказ = Истина;
	КонецПопытки;
			
КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	астОбщегоНазначенияМеркурий._ДобавитьПрефиксОрганизации(ЭтотОбъект, Префикс);
	мПрефикс = "";
	астОбщегоНазначенияМеркурий._ДобавитьПрефиксУзла(мПрефикс);
	Если Префикс <> мПрефикс Тогда
		Префикс = мПрефикс + Префикс;
	КонецЕсли;

КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Отказ = астОбщегоНазначенияМеркурий.ОбработкаУдаленияОбъектов(ЭтотОбъект);

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если астОбщегоНазначенияМеркурий.ПроверитьДокументПередРедактированием(ЭтотОбъект, Ссылка, РежимЗаписи, Неопределено) Тогда
	    Отказ = Истина;
		Возврат;
	КонецЕсли;

КонецПроцедуры
