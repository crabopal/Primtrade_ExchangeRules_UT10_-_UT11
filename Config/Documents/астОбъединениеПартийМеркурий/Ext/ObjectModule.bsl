// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ПолучитьНоменклатуруИзРегистраСоответствий(МассивДанных)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоответствиеНоменклатуры.ПродукцияМеркурий,
	|	СоответствиеНоменклатуры.Номенклатура,
	|	СоответствиеНоменклатуры.ХарактеристикаНоменклатуры,
	|	СоответствиеНоменклатуры.Коэффициент
	|ИЗ
	|	РегистрСведений.астСоответствиеНоменклатурыМеркурий КАК СоответствиеНоменклатуры
	|ГДЕ
	|	СоответствиеНоменклатуры.ПродукцияМеркурий В(&МассивДанных)";
	
	Запрос.УстановитьПараметр("МассивДанных", МассивДанных);
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Выгрузить();
	
КонецФункции

Процедура ПриКопировании(ОбъектКопирования)
	
	Статус = Перечисления.астСтатусыОбработкиДокументовМеркурий.Создан;
	ФайлЗапроса = "";
	ФайлОтвета = "";
	ИдентификаторМеркурий = "";
	ОтветСервера = "";	
	ИдЗапроса = "";
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если астОбщегоНазначенияМеркурий.ПроверитьДокументПередРедактированием(ЭтотОбъект, Ссылка, РежимЗаписи, Неопределено) Тогда
	    Отказ = Истина;
		Возврат;
	КонецЕсли;

КонецПроцедуры
