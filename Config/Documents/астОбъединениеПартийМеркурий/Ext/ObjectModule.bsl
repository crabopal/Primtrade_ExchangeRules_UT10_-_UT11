
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	астОбщегоНазначенияМеркурий._ДобавитьПрефиксОрганизации(ЭтотОбъект, Префикс);
	мПрефикс = "";
	астОбщегоНазначенияМеркурий._ДобавитьПрефиксУзла(мПрефикс);
	Если Префикс <> мПрефикс Тогда
		Префикс = мПрефикс + Префикс;
	КонецЕсли;

КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Отказ = астОбщегоНазначенияМеркурий.ОбработкаУдаленияОбъектов(ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ИмяРегистра = "астПартииПродукцииМеркурий";
		
	// регистр астПартииПродукцииМеркурий Приход
	ВерсияПриложения = астОбщегоНазначенияМеркурий.ОпределитьВерсиюПриложения();
	Если ВерсияПриложения <> 81 Тогда
		Выполнить("Движения.астПартииПродукцииМеркурий.Записывать = Истина;");
	КонецЕсли;	

	ОбработкаУдаленияПроведения(Отказ);
	
	Движения.астПартииПродукцииМеркурий.Записывать = Истина;
	Движения.астПартииПродукцииМеркурий.Очистить();
	
	Если Статус = Перечисления.астСтатусыОбработкиДокументовМеркурий.ПолученОтказ Тогда
		Возврат;
	КонецЕсли;
	
	// объединяемые партии
	Для Каждого ТекСтрокаПартииПродукции Из ОбъединяемыеПартии Цикл
		Если НЕ ЗначениеЗаполнено(ТекСтрокаПартииПродукции.ПартияПродукции) Тогда
			Продолжить;
		КонецЕсли;
		
		астОбщегоНазначенияМеркурий.ДвижениеПоРегиструПартийМеркурий(Движения, ТекСтрокаПартииПродукции, Ссылка, "Расход", ТекСтрокаПартииПродукции.ПартияПродукции.Количество);
	КонецЦикла;

	// объединенная партия
	Если ЗначениеЗаполнено(ОбъединеннаяПартия) Тогда
		Движение = Движения.астПартииПродукцииМеркурий.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.ХозяйствующийСубъект = ХозяйствующийСубъект;
		Движение.Предприятие = Предприятие;
		Движение.ПродукцияМеркурий = ОбъединеннаяПартия.ПродукцияМеркурий;
		Движение.ПартияПродукции = ОбъединеннаяПартия;
		Движение.Номенклатура = Номенклатура;
		
		Если ЗначениеЗаполнено(СерияНоменклатуры) И НастройкаМеркурий.ВестиУчетПоСериям Тогда
			Серия = СерияНоменклатуры;
		Иначе
			Серия = Неопределено;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ХарактеристикаНоменклатуры) И НастройкаМеркурий.ВестиУчетПоХарактеристикам Тогда
			Характеристика = ХарактеристикаНоменклатуры;
		Иначе
			Характеристика = Неопределено;
		КонецЕсли;
		
		Движение.СерияНоменклатуры = Серия;
		Движение.ХарактеристикаНоменклатуры = Характеристика;
		Движение.НастройкаМеркурий = НастройкаМеркурий;
		Движение.Количество = ?(ЗначениеЗаполнено(Количество), Количество, ОбъединеннаяПартия.Количество);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
		
	//Очистка движений документа
	Для Каждого Движение ИЗ ЭтотОбъект.Движения Цикл
		Движение.Очистить();
	КонецЦикла;
	
	//Запись пустых наборов движений в ИБ(очистка старых движений)
	СписокРегистровДляОчистки = Новый Массив;
	СписокРегистровДляОчистки.Добавить("астПартииПродукцииМеркурий");
	
	астОбщегоНазначенияМеркурий.ОчиститьСтарыеДвиженияДокумента(СписокРегистровДляОчистки, Ссылка);
			
КонецПроцедуры

Процедура ДобавитьЗаписьВРегистр(ИмяРегистра, ВидДвижения, СтрокаПартии, ТаблицаНоменклатуры)
	
	Движение = Движения[ИмяРегистра].Добавить(); 
	
	Движение.ВидДвижения = ВидДвиженияНакопления[ВидДвижения];
	
	Если ВидДвижения = "Приход" Тогда
		Количество = СтрокаПартии.Количество;
	Иначе
		Количество = -СтрокаПартии.Количество;
	КонецЕсли;	
	
	Поиск = ТаблицаНоменклатуры.НайтиСтроки(Новый Структура("ПродукцияМеркурий", СтрокаПартии.ПродукцияМеркурий));
	Если Поиск.Количество() > 0 Тогда
		Товар = Поиск[0].Номенклатура; 
		
		Если ЗначениеЗаполнено(Поиск[0].ХарактеристикаНоменклатуры) Тогда
			Характеристика = Поиск[0].ХарактеристикаНоменклатуры;
		Иначе
			Характеристика = Неопределено;
		КонецЕсли;	
	Иначе
		Товар = Неопределено;
		Характеристика = Неопределено;
	КонецЕсли;
	
	Движение.ПартияПродукции = СтрокаПартии;
	
	Движение.Организация = Организация;
	Движение.Период = Дата;
	Движение.ПродукцияМеркурий = СтрокаПартии.ПродукцияМеркурий;
	Движение.ХозяйствующийСубъект = ХозяйствующийСубъект;
	Движение.Предприятие = Предприятие;
	Движение.НастройкаМеркурий = НастройкаМеркурий;
	Движение.Номенклатура = Товар;
	Движение.СерияНоменклатуры = Неопределено;
	Движение.ХарактеристикаНоменклатуры = Характеристика;
	Движение.Количество = Количество;
	
КонецПроцедуры

