
Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	астОбщегоНазначенияМеркурий._ДобавитьПрефиксОрганизации(ЭтотОбъект, Префикс);
	мПрефикс = "";
	астОбщегоНазначенияМеркурий._ДобавитьПрефиксУзла(мПрефикс);
	Если Префикс <> мПрефикс Тогда
		Префикс = мПрефикс + Префикс;
	КонецЕсли;

КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Отказ = астОбщегоНазначенияМеркурий.ОбработкаУдаленияОбъектов(ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ОбработкаУдаленияПроведения(Отказ);
	
	ВерсияПриложения = астОбщегоНазначенияМеркурий.ОпределитьВерсиюПриложения();
	Если ВерсияПриложения <> 81 Тогда
		Выполнить("Движения.астПартииПродукцииМеркурий.Записывать = Истина;");
	КонецЕсли;

	// регистр астПартииПродукцииМеркурий Расход
	Движения.астПартииПродукцииМеркурий.Записывать = Истина;
	Движения.астПартииПродукцииМеркурий.Очистить();

	Если Статус = Перечисления.астСтатусыОбработкиДокументовМеркурий.ПолученОтказ ИЛИ ЗначениеЗаполнено(ДатаАннулирования) Тогда
		Возврат;
	КонецЕсли;
	
	// проверим остатки
	Если Сырье.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	астТранспортнаяПартияМеркурий.ПродукцияМеркурий,
		|	астТранспортнаяПартияМеркурий.ПартияПродукции,
		|	МИНИМУМ(астТранспортнаяПартияМеркурий.НомерСтроки) КАК НомерСтроки,
		|	СУММА(астТранспортнаяПартияМеркурий.Количество) КАК Количество
		|ПОМЕСТИТЬ Товары
		|ИЗ
		|	Документ.астПроизводственнаяПартияМеркурий.Сырье КАК астТранспортнаяПартияМеркурий
		|ГДЕ
		|	астТранспортнаяПартияМеркурий.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	астТранспортнаяПартияМеркурий.ПродукцияМеркурий,
		|	астТранспортнаяПартияМеркурий.ПартияПродукции
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Товары.ПродукцияМеркурий,
		|	Товары.ПартияПродукции
		|ПОМЕСТИТЬ ОстаткиВсего
		|ИЗ
		|	Товары КАК Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.астПартииПродукцииМеркурий.Остатки(
		|				&МоментВремени,
		|				Организация = &Организация
		|					И НастройкаМеркурий = &НастройкаМеркурий) КАК астПартииПродукцииМеркурий
		|		ПО Товары.ПартияПродукции = астПартииПродукцииМеркурий.ПартияПродукции
		//|			И Товары.ПродукцияМеркурий = астПартииПродукцииМеркурий.ПродукцияМеркурий
		|ГДЕ
		|	Товары.Количество > ЕСТЬNULL(астПартииПродукцииМеркурий.КоличествоОстаток, 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	астПартииПродукцииМеркурий.ПартияПродукции,
		|	астПартииПродукцииМеркурий.ПродукцияМеркурий,
		|	астПартииПродукцииМеркурий.КоличествоОстаток,
		|	астПартииПродукцииМеркурий.СерияНоменклатуры КАК СерияНоменклатуры
		|ПОМЕСТИТЬ ОстаткиОбщие
		|ИЗ
		|	РегистрНакопления.астПартииПродукцииМеркурий.Остатки(
		|			&МоментВремени,
		|			Организация = &Организация
		|				И НастройкаМеркурий = &НастройкаМеркурий) КАК астПартииПродукцииМеркурий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиОбщие.ПартияПродукции,
		|	ОстаткиОбщие.ПродукцияМеркурий,
		|	СУММА(ОстаткиОбщие.КоличествоОстаток) КАК КоличествоОстаток,
		|	ОстаткиОбщие.СерияНоменклатуры
		|ПОМЕСТИТЬ Остатки
		|ИЗ
		|	ОстаткиОбщие КАК ОстаткиОбщие
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиОбщие.ПартияПродукции,
		|	ОстаткиОбщие.ПродукцияМеркурий,
		|	ОстаткиОбщие.СерияНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Товары.ПродукцияМеркурий,
		|	Товары.ПартияПродукции,
		|	Товары.НомерСтроки КАК НомерСтроки,
		|	Товары.Количество,
		|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
		|	Товары.ПродукцияМеркурий.GUID КАК Код,
		|	Остатки.СерияНоменклатуры КАК СерияНоменклатуры
		|ИЗ
		|	Товары КАК Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
		|		ПО Товары.ПартияПродукции = Остатки.ПартияПродукции
		//|			И Товары.ПродукцияМеркурий = Остатки.ПродукцияМеркурий
		|ГДЕ
		|	Товары.Количество > ЕСТЬNULL(Остатки.КоличествоОстаток, 0)
		|	И Товары.ПартияПродукции В
		|			(ВЫБРАТЬ
		|				ОстаткиВсего.ПартияПродукции
		|			ИЗ
		|				ОстаткиВсего КАК ОстаткиВсего)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
		Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("НастройкаМеркурий", НастройкаМеркурий);
		
		Если НЕ НастройкаМеркурий.ВестиУчетПоСериям Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "астПартииПродукцииМеркурий.СерияНоменклатуры", "NULL");
		КонецЕсли;
		
		Если НЕ НастройкаМеркурий.ВестиУчетПоХарактеристикам Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "астПартииПродукцииМеркурий.ХарактеристикаНоменклатуры", "NULL");
		КонецЕсли;
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Сообщить("В " + Ссылка + " недостаточно остатков партий 
			|	Строка " + СтрЗаменить(Строка(Выборка.НомерСтроки), Символы.НПП, "") + ", """ + СокрЛП(Выборка.ПродукцияМеркурий) + " (" + Выборка.Код + ") 
			|	Партия " + Выборка.ПартияПродукции + ?(НастройкаМеркурий.ВестиУчетПоСериям, " / Серия " + Выборка.СерияНоменклатуры, "") + "
			|	Требуется " + Выборка.Количество + ", на остатках всего " + Выборка.КоличествоОстаток, СтатусСообщения.Важное);	
		КонецЦикла;
		
		Если Выборка.Количество() > 0 Тогда
			// нет остатков
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Для Каждого ТекСтрокаПартииПродукции Из Сырье Цикл
			Если НЕ ЗначениеЗаполнено(ТекСтрокаПартииПродукции.ПартияПродукции) Тогда
				Продолжить;
			КонецЕсли;
			
			астОбщегоНазначенияМеркурий.ДвижениеПоРегиструПартийМеркурий(Движения, ТекСтрокаПартииПродукции, Ссылка, "Расход", ТекСтрокаПартииПродукции.Количество, ТекСтрокаПартииПродукции.ПартияПродукции);
		КонецЦикла;
	КонецЕсли;

	Если НЕ Статус = Перечисления.астСтатусыОбработкиДокументовМеркурий.ПолученоПодтверждение Тогда
		Возврат;
	КонецЕсли;	
	
	Для Каждого ТекСтрокаПартииПродукции Из ПартииПродукции Цикл
		Если НЕ ЗначениеЗаполнено(ТекСтрокаПартииПродукции.ПартияПродукции) Тогда
			Продолжить;
		КонецЕсли;
		
		астОбщегоНазначенияМеркурий.ДвижениеПоРегиструПартийМеркурий(Движения, ТекСтрокаПартииПродукции, Ссылка, "Приход", ТекСтрокаПартииПродукции.Количество, ТекСтрокаПартииПродукции.ПартияПродукции);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
		
	//Очистка движений документа
	Для Каждого Движение ИЗ ЭтотОбъект.Движения Цикл
		Движение.Очистить();
	КонецЦикла;
	
	//Запись пустых наборов движений в ИБ(очистка старых движений)	
	Набор = РегистрыНакопления.астПартииПродукцииМеркурий.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	Попытка
		Набор.Записать();
	Исключение
		// возможно «сработал» RLS или механизм даты запрета изменения
		Сообщить("Операция не выполнена: " + ОписаниеОшибки());
		Отказ = Истина;
	КонецПопытки;
			
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Ответственный = "";
	Комментарий = "";
	ФайлЗапроса = "";
	ФайлОтвета = "";
	ИдентификаторМеркурий = "";
	ОтветСервера = "";
	Статус = Перечисления.астСтатусыОбработкиДокументовМеркурий.Создан;
	ИдТТН = "";
	ДатаАннулирования = "";
	ПричинаАннулирования = "";
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ ПЕЧАТИ

#Если Клиент Тогда
// Функция формирует табличный документ с печатной формой ТТН Меркурий,
//
// Возвращаемое значение:
//  Табличный документ - печатная форма акта ТТН
//
Функция ПечатьДокумента()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", ЭтотОбъект.Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	астПроизводственнаяПартияМеркурий.Организация,
	|	астПроизводственнаяПартияМеркурий.Номер,
	|	астПроизводственнаяПартияМеркурий.Дата,
	|	астПроизводственнаяПартияМеркурий.ИдТТН КАК НомерМеркурий,
	|	ВЫРАЗИТЬ(астПроизводственнаяПартияМеркурий.ХозяйствующийСубъект.Наименование КАК СТРОКА(1000)) КАК ХозяйствующийСубъект,
	|	астПроизводственнаяПартияМеркурий.ХозяйствующийСубъект.ИНН КАК ИНН,
	|	астПроизводственнаяПартияМеркурий.ХозяйствующийСубъект.КПП КАК КПП,
	|	ВЫРАЗИТЬ(астПроизводственнаяПартияМеркурий.ХозяйствующийСубъект.Адрес КАК СТРОКА(1000)) КАК Адрес
	|ИЗ
	|	Документ.астПроизводственнаяПартияМеркурий КАК астПроизводственнаяПартияМеркурий
	|ГДЕ
	|	астПроизводственнаяПартияМеркурий.Ссылка = &ТекущийДокумент";
	Шапка = Запрос.Выполнить().Выбрать();
	Шапка.Следующий();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", ЭтотОбъект.Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	астПроизводственнаяПартияМеркурийПартииПродукции.НомерСтроки,
	|	астПроизводственнаяПартияМеркурийПартииПродукции.ПартияПродукции,
	|	астПроизводственнаяПартияМеркурийПартииПродукции.Количество,
	|	астПроизводственнаяПартияМеркурийПартииПродукции.ЕдиницаИзмерения,
	|	астПроизводственнаяПартияМеркурийПартииПродукции.ДатаВыработкиС,
	|	астПроизводственнаяПартияМеркурийПартииПродукции.ДатаВыработкиПо,
	|	астПроизводственнаяПартияМеркурийПартииПродукции.СрокГодностиС,
	|	астПроизводственнаяПартияМеркурийПартииПродукции.СрокГодностиПо
	|ИЗ
	|	Документ.астПроизводственнаяПартияМеркурий.ПартииПродукции КАК астПроизводственнаяПартияМеркурийПартииПродукции
	|ГДЕ
	|	астПроизводственнаяПартияМеркурийПартииПродукции.Ссылка = &ТекущийДокумент
	|
	|УПОРЯДОЧИТЬ ПО
	|	астПроизводственнаяПартияМеркурийПартииПродукции.НомерСтроки";
	ЗапросТовары = Запрос.Выполнить().Выгрузить();

	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_астПроизводственнаяПартияМеркурий";

	Макет = ПолучитьМакет("ПроизводственнаяНакладная");

	// Выводим шапку 
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.Заполнить(Шапка);
	ОбластьМакета.Параметры.Дата = Формат(Шапка.Дата, "ДФ=dd.MM.yyyy");
	ОбластьМакета.Параметры.ХозяйствующийСубъект = СокрЛП(Шапка.ХозяйствующийСубъект) + ", ИНН: " + Шапка.ИНН + ?(ЗначениеЗаполнено(Шапка.КПП), ", КПП:" + Шапка.КПП, "") + ", " + Шапка.Адрес;
	ТабДокумент.Вывести(ОбластьМакета);
	
	//Выводим строки
	ОбластьМакета = Макет.ПолучитьОбласть("Строка");
	Для Каждого СтрокаТовара Из ЗапросТовары Цикл
		ОбластьМакета.Параметры.Заполнить(СтрокаТовара);
		ТабДокумент.Вывести(ОбластьМакета);
	КонецЦикла;	

	// Выводим итоги
	ОбластьМакета = Макет.ПолучитьОбласть("Итоги");
	ОбластьМакета.Параметры.Количество = ЗапросТовары.Итог("Количество");
	ТабДокумент.Вывести(ОбластьМакета);
	
	ТабДокумент.ОриентацияСтраницы  = ОриентацияСтраницы.Портрет;
	ТабДокумент.ОтображатьСетку     = Ложь;
	ТабДокумент.ОтображатьЗаголовки = Ложь;
	ТабДокумент.АвтоМасштаб         = Истина;
	ТабДокумент.ТолькоПросмотр      = Истина;
	
	Возврат ТабДокумент;

КонецФункции // ПечатьДокумента()

// Процедура осуществляет печать документа. Можно направить печать на 
// экран или принтер, а также распечатать необходимое количество копий.
//
//  Название макета печати передается в качестве параметра,
// по переданному названию находим имя макета в соответствии.
//
// Параметры:
//  НазваниеМакета - строка, название макета.
//
Процедура Печать(ИмяМакета, КоличествоЭкземпляров = 1, НаПринтер = Ложь, НепосредственнаяПечать = Ложь) Экспорт
	
	// Получить экземпляр документа на печать
	Если ИмяМакета = "ПроизводственнаяНакладная" Тогда
		ТабДокумент = ПечатьДокумента();		
	КонецЕсли;
	
	астОбщегоНазначенияМеркурий.ПечатьТабДокумента(ТабДокумент, астОбщегоНазначенияМеркурий._СформироватьЗаголовокДокумента(ЭтотОбъект), КоличествоЭкземпляров, НаПринтер);
	
КонецПроцедуры // Печать	
	
#КонецЕсли
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
			
	ЕстьСырье = Сырье.Количество() > 0;
		
	Если астОбщегоНазначенияМеркурий.ПроверитьДокументПередРедактированием(ЭтотОбъект, Ссылка, РежимЗаписи, Неопределено) Тогда
	    Отказ = Истина;
		Возврат;
	КонецЕсли;

КонецПроцедуры
