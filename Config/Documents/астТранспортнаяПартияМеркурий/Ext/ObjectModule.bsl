// ОБРАБОТЧИКИ ПЕЧАТИ

#Если Клиент Тогда
// Функция формирует табличный документ с печатной формой ТТН Меркурий,
//
// Возвращаемое значение:
//  Табличный документ - печатная форма акта ТТН
//
Функция ПечатьДокумента()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", ЭтотОбъект.Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	астТранспортнаяПартияМеркурий.Организация,
	|	астТранспортнаяПартияМеркурий.Номер,
	|	астТранспортнаяПартияМеркурий.Дата,
	|	ВЫРАЗИТЬ(астТранспортнаяПартияМеркурий.ОтправительХС.НаименованиеПолное КАК СТРОКА(1000)) КАК Отправитель,
	|	астТранспортнаяПартияМеркурий.ОтправительХС.ИНН КАК ОтправительИНН,
	|	астТранспортнаяПартияМеркурий.ОтправительХС.КПП КАК ОтправительКПП,
	|	ВЫРАЗИТЬ(астТранспортнаяПартияМеркурий.ОтправительХС.Адрес КАК СТРОКА(1000)) КАК ОтправительАдрес,
	|	ВЫРАЗИТЬ(астТранспортнаяПартияМеркурий.ОтправительПредприятие.Адрес КАК СТРОКА(1000)) КАК ГрузоотправительАдрес,
	|	астТранспортнаяПартияМеркурий.ПолучательХС.НаименованиеПолное,
	|	астТранспортнаяПартияМеркурий.ПолучательХС.ИНН,
	|	астТранспортнаяПартияМеркурий.ПолучательХС.КПП,
	|	астТранспортнаяПартияМеркурий.ПолучательХС.Адрес,
	|	ВЫРАЗИТЬ(астТранспортнаяПартияМеркурий.ПолучательХС.НаименованиеПолное КАК СТРОКА(1000)) КАК Получатель,
	|	астТранспортнаяПартияМеркурий.ПолучательХС.ИНН КАК ПолучательИНН,
	|	астТранспортнаяПартияМеркурий.ПолучательХС.КПП КАК ПолучательКПП,
	|	ВЫРАЗИТЬ(астТранспортнаяПартияМеркурий.ПолучательХС.Адрес КАК СТРОКА(1000)) КАК ПолучательАдрес,
	|	ВЫРАЗИТЬ(астТранспортнаяПартияМеркурий.ПолучательПредприятие.Адрес КАК СТРОКА(1000)) КАК ГрузополучательАдрес,
	|	астТранспортнаяПартияМеркурий.ИдТТН КАК НомерМеркурий,
	|	астТранспортнаяПартияМеркурий.ОтправительПредприятие,
	|	астТранспортнаяПартияМеркурий.ПолучательПредприятие
	|ИЗ
	|	Документ.астТранспортнаяПартияМеркурий КАК астТранспортнаяПартияМеркурий
	|ГДЕ
	|	астТранспортнаяПартияМеркурий.Ссылка = &ТекущийДокумент";
	Шапка = Запрос.Выполнить().Выбрать();
	Шапка.Следующий();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", ЭтотОбъект.Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	астТранспортнаяПартияМеркурийПартииПродукции.НомерСтроки,
	|	астТранспортнаяПартияМеркурийПартииПродукции.ПартияПродукции,
	|	астТранспортнаяПартияМеркурийПартииПродукции.Количество,
	|	астТранспортнаяПартияМеркурийПартииПродукции.ЕдиницаИзмерения,
	|	астТранспортнаяПартияМеркурийПартииПродукции.ДатаВыработкиС,
	|	астТранспортнаяПартияМеркурийПартииПродукции.ДатаВыработкиПо,
	|	астТранспортнаяПартияМеркурийПартииПродукции.СрокГодностиС,
	|	астТранспортнаяПартияМеркурийПартииПродукции.СрокГодностиПо,
	|	астТранспортнаяПартияМеркурийПартииПродукции.ПродукцияМеркурий
	|ИЗ
	|	Документ.астТранспортнаяПартияМеркурий.ПартииПродукции КАК астТранспортнаяПартияМеркурийПартииПродукции
	|ГДЕ
	|	астТранспортнаяПартияМеркурийПартииПродукции.Ссылка = &ТекущийДокумент
	|
	|УПОРЯДОЧИТЬ ПО
	|	астТранспортнаяПартияМеркурийПартииПродукции.НомерСтроки";
	ЗапросТовары = Запрос.Выполнить().Выгрузить();

	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_астТранспортнаяПартияМеркурий";

	Макет = ПолучитьМакет("ТТН");

	// Выводим шапку 
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.Заполнить(Шапка);
	ОбластьМакета.Параметры.Дата = Формат(Шапка.Дата, "ДФ=dd.MM.yyyy");
	ОбластьМакета.Параметры.Отправитель = СокрЛП(Шапка.Отправитель) + ", ИНН: " + Шапка.ОтправительИНН + ?(ЗначениеЗаполнено(Шапка.ОтправительКПП), ", КПП:" + Шапка.ОтправительКПП, "") + ", " + Шапка.ОтправительАдрес;
	ОбластьМакета.Параметры.Получатель  = СокрЛП(Шапка.Получатель) + ", ИНН: " + Шапка.ПолучательИНН + ?(ЗначениеЗаполнено(Шапка.ПолучательКПП), ", КПП:" + Шапка.ПолучательКПП, "") + ", " + Шапка.ПолучательАдрес;
	ОбластьМакета.Параметры.Грузоотправитель = СокрЛП(Шапка.ОтправительПредприятие) + ", " +  Шапка.ГрузоотправительАдрес;
	ОбластьМакета.Параметры.Грузополучатель = СокрЛП(Шапка.ПолучательПредприятие) + ", " +  Шапка.ГрузополучательАдрес;
	ТабДокумент.Вывести(ОбластьМакета);
	
	//Выводим строки
	ОбластьМакета = Макет.ПолучитьОбласть("Строка");
	Для Каждого СтрокаТовара Из ЗапросТовары Цикл
		ОбластьМакета.Параметры.Заполнить(СтрокаТовара);
		ТабДокумент.Вывести(ОбластьМакета);
	КонецЦикла;	

	// Выводим итоги
	ОбластьМакета = Макет.ПолучитьОбласть("Итоги");
	ОбластьМакета.Параметры.Количество = ЗапросТовары.Итог("Количество");
	ТабДокумент.Вывести(ОбластьМакета);
	
	ТабДокумент.ОриентацияСтраницы  = ОриентацияСтраницы.Портрет;
	ТабДокумент.ОтображатьСетку     = Ложь;
	ТабДокумент.ОтображатьЗаголовки = Ложь;
	ТабДокумент.АвтоМасштаб         = Истина;
	ТабДокумент.ТолькоПросмотр      = Истина;
	
	Возврат ТабДокумент;

КонецФункции // ПечатьДокумента()

// Процедура осуществляет печать документа. Можно направить печать на 
// экран или принтер, а также распечатать необходимое количество копий.
//
//  Название макета печати передается в качестве параметра,
// по переданному названию находим имя макета в соответствии.
//
// Параметры:
//  НазваниеМакета - строка, название макета.
//
Процедура Печать(ИмяМакета, КоличествоЭкземпляров = 1, НаПринтер = Ложь, НепосредственнаяПечать = Ложь) Экспорт
	
	// Получить экземпляр документа на печать
	Если ИмяМакета = "ТТН" Тогда
		ТабДокумент = ПечатьДокумента();		
	КонецЕсли;
	
	астОбщегоНазначенияМеркурий.ПечатьТабДокумента(ТабДокумент, астОбщегоНазначенияМеркурий._СформироватьЗаголовокДокумента(ЭтотОбъект), КоличествоЭкземпляров, НаПринтер);
	
КонецПроцедуры // Печать	
#КонецЕсли

// Возвращает доступные варианты печати документа
//
// Возвращаемое значение:
//  Структура, каждая строка которой соответствует одному из вариантов печати
//  
Функция ПолучитьСтруктуруПечатныхФорм() Экспорт
	
	Возврат Новый Структура("ТТН","ТТН");

КонецФункции // ПолучитьСтруктуруПечатныхФорм()

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если ТипДокумента = Перечисления.астТипыДокументовМеркурий.Входящий Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	астТранспортнаяПартияМеркурийПартииПродукции.ПартияПродукции,
		|	астТранспортнаяПартияМеркурийПартииПродукции.ВСД,
		|	астТранспортнаяПартияМеркурийПартииПродукции.ВСД.СтатусВСД как СтатусВСД
		|ИЗ
		|	Документ.астТранспортнаяПартияМеркурий.ПартииПродукции КАК астТранспортнаяПартияМеркурийПартииПродукции
		|ГДЕ
		|	астТранспортнаяПартияМеркурийПартииПродукции.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если Выборка.СтатусВСД = Перечисления.астСтатусыОбработкиДокументовМеркурий.ПолученоПодтверждение Тогда
				Статус = Выборка.СтатусВСД;
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.ПартияПродукции) И Выборка.СтатусВСД <> Перечисления.астСтатусыДокументовВСД.UTILIZED 
				И ЗначениеЗаполнено(Выборка.ВСД) Тогда
				Док = Выборка.ВСД.ПолучитьОбъект();
				Док.СтатусВСД = Перечисления.астСтатусыДокументовВСД.UTILIZED;	
				Попытка
					Док.Записать(РежимЗаписиДокумента.Запись);
				Исключение
					Сообщить("Ошибка перезаписи документа " + Выборка.ВСД + ": " + ОписаниеОшибки(), СтатусСообщения.Важное);
				КонецПопытки;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Если НЕ Ссылка.ПометкаУдаления И ПометкаУдаления Тогда
			Если Статус = Перечисления.астСтатусыОбработкиДокументовМеркурий.ПолученоПодтверждение Тогда
				Отказ = Истина;
				Сообщить("По документу " + Ссылка + " получено подтверждение сервера, удаление запрещено");
				Возврат;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтотОбъект.ТипДокумента = Перечисления.астТипыДокументовМеркурий.Исходящий Тогда
		ПроверяемыеРеквизиты.Добавить("ПартииПродукции.ПартияПродукции");
	КонецЕсли;
	
КонецПроцедуры
