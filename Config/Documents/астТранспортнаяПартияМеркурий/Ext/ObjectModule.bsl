
Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	астОбщегоНазначенияМеркурий._ДобавитьПрефиксОрганизации(ЭтотОбъект, Префикс);
	мПрефикс = "";
	астОбщегоНазначенияМеркурий._ДобавитьПрефиксУзла(мПрефикс);
	Если Префикс <> мПрефикс Тогда
		Префикс = мПрефикс + Префикс;
	КонецЕсли;

КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Отказ = астОбщегоНазначенияМеркурий.ОбработкаУдаленияОбъектов(ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ОбработкаУдаленияПроведения(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ВерсияПриложения = астОбщегоНазначенияМеркурий.ОпределитьВерсиюПриложения();
	Если ВерсияПриложения <> 81 Тогда
		Выполнить("Движения.астПартииПродукцииМеркурий.Записывать = Истина;");
	КонецЕсли;

	Движения.астПартииПродукцииМеркурий.Очистить();
	
	Если ТипДокумента = Перечисления.астТипыДокументовМеркурий.Исходящий Тогда
		Если Статус = Перечисления.астСтатусыОбработкиДокументовМеркурий.ПолученОтказ ИЛИ СтатусВСД = Перечисления.астСтатусыДокументовВСД.WITHDRAWN Тогда
			Возврат;
		КонецЕсли;	
		
		// проверим остатки
		Если РежимПроведения = РежимПроведенияДокумента.Оперативный Тогда 
			Отказ = астОбщегоНазначенияМеркурий.ПроверитьОстаткиПартийПоДокументу(Ссылка);
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		// регистр астПартииПродукцииМеркурий Расход
		Движения.астПартииПродукцииМеркурий.Записывать = Истина;
		Движения.астПартииПродукцииМеркурий.Очистить();
		Для Каждого ТекСтрокаПартииПродукции Из ПартииПродукции Цикл
			// пропускаем аннулированные ВСД
			Если ЗначениеЗаполнено(ТекСтрокаПартииПродукции.ВСД) Тогда
				Если ТекСтрокаПартииПродукции.ВСД.СтатусВСД = Перечисления.астСтатусыДокументовВСД.WITHDRAWN Тогда
					Продолжить;
				КонецЕсли;	
			КонецЕсли;
			
			астОбщегоНазначенияМеркурий.ДвижениеПоРегиструПартийМеркурий(Движения, ТекСтрокаПартииПродукции, Ссылка, "Расход", ТекСтрокаПартииПродукции.Количество);
		КонецЦикла;
	Иначе
		Если НастройкаМеркурий.ПроводитьВходящиеВСД Тогда
			
			Для Каждого Строка Из ПартииПродукции Цикл
				Если НЕ ЗначениеЗаполнено(Строка.ПартияПродукции) Тогда
					Продолжить;
				КонецЕсли;
				
				ДокВСД = Строка.ВСД.ПолучитьОбъект();
				Попытка
					ДокВСД.Записать(РежимЗаписиДокумента.Проведение);
				Исключение 
					Сообщить("Ошибка проведения " + Строка.ВСД + ": " + ОписаниеОшибки());	
				КонецПопытки;	
			КонецЦикла;	
			Возврат; // процедура перенесена в ВСД
		КонецЕсли;
		
		// регистр астПартииПродукцииМеркурий Расход
		Движения.астПартииПродукцииМеркурий.Записывать = Истина;
		Движения.астПартииПродукцииМеркурий.Очистить();
		Для Каждого ТекСтрокаПартииПродукции Из ПартииПродукции Цикл
			Если НЕ ЗначениеЗаполнено(ТекСтрокаПартииПродукции.ПартияПродукции) Тогда
				Продолжить;
			КонецЕсли;
			
			ПоискТоваров = ПартииТоваровФактические.НайтиСтроки(Новый Структура("КлючСтроки", ТекСтрокаПартииПродукции.НомерСтроки));
			Если ПоискТоваров.Количество() > 0 Тогда
				Для Каждого СтрокаТовара Из ПоискТоваров Цикл
					астОбщегоНазначенияМеркурий.ДвижениеПоРегиструПартийМеркурий(Движения, СтрокаТовара, Ссылка, "Приход", СтрокаТовара.Количество, ТекСтрокаПартииПродукции.ПартияПродукции);
				КонецЦикла;	
			Иначе
				Если ТекСтрокаПартииПродукции.РеальноеКоличество = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				астОбщегоНазначенияМеркурий.ДвижениеПоРегиструПартийМеркурий(Движения, ТекСтрокаПартииПродукции, Ссылка, "Приход", ТекСтрокаПартииПродукции.РеальноеКоличество);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
		
	//Очистка движений документа
	Для Каждого Движение ИЗ ЭтотОбъект.Движения Цикл
		Движение.Очистить();
	КонецЦикла;
	
	//Запись пустых наборов движений в ИБ(очистка старых движений)	
	Набор = РегистрыНакопления.астПартииПродукцииМеркурий.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	Попытка
		Набор.Записать();
	Исключение
		// возможно «сработал» RLS или механизм даты запрета изменения
		Сообщить("Операция не выполнена: " + ОписаниеОшибки());
		Отказ = Истина;
	КонецПопытки;
			
КонецПроцедуры

