Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если Не РольДоступна("МенеджерОператор")
		И Не РольДоступна("Директор")
		//>>Dexcel
		//И Ссылка.ПроцентВыполненияДеньги <> 0 
		И Ссылка.ДеньгиПроцентВыполнения <> 0
		//>>Dexcel
		И ДеньгиПроцентВыполнения <> Ссылка.ДеньгиПроцентВыполнения Тогда
		
		ОбщегоНазначения.СообщитьОбОшибке("Документ """ + ЭтотОбъект + """ уже рассчитан, изменение поля ""Деньги, % выполнения"" запрещено!", Отказ);
	КонецЕсли;

КонецПроцедуры
 
Функция РасчетПродаж(Д1,Д2) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(ВЫБОР
		|			КОГДА Продажи.Стоимость >= 0
		|				ТОГДА Продажи.Стоимость
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ПроданоСумма,
		|	СУММА(ВЫБОР
		|			КОГДА Продажи.Стоимость < 0
		|				ТОГДА -Продажи.Стоимость
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ВозвратСумма
		|ИЗ
		|	РегистрНакопления.Продажи КАК Продажи
		|ГДЕ
		|	Продажи.Период МЕЖДУ &Д1 И &Д2
		|	И Продажи.Контрагент.ОсновнойМенеджерПокупателя = &Менеджер";
	
	Запрос.УстановитьПараметр("Менеджер",Менеджер);
	Запрос.УстановитьПараметр("Д1",Д1);
	Запрос.УстановитьПараметр("Д2",Д2);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
Функция РасчетОплат(Д1,Д2) Экспорт
	
	Запрос = Новый Запрос;
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	РасчетыСКонтрагентамиОбороты.СуммаВзаиморасчетовПриход Как Приход,
	//               |	РасчетыСКонтрагентамиОбороты.СуммаВзаиморасчетовРасход Как Расход
	//               |ИЗ
	//               |	РегистрНакопления.РасчетыСКонтрагентами.Обороты(&Д1, &Д2, Период, Контрагент.ОсновнойМенеджерПокупателя = &Менеджер) КАК РасчетыСКонтрагентамиОбороты
	//               |ГДЕ
	//               |	РасчетыСКонтрагентамиОбороты.Контрагент.ОсновнойМенеджерПокупателя = &Менеджер";
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ДвиженияДенежныхСредствОбороты.ПриходРасход = &Приход
		|			ТОГДА ДвиженияДенежныхСредствОбороты.СуммаОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Приход,
		|	ВЫБОР
		|		КОГДА ДвиженияДенежныхСредствОбороты.ПриходРасход <> &Приход
		|			ТОГДА ДвиженияДенежныхСредствОбороты.СуммаОборот
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Расход
		|ИЗ
		|	РегистрНакопления.ДвиженияДенежныхСредств.Обороты(&Д1, &Д2, Период, Контрагент.ОсновнойМенеджерПокупателя = &Менеджер) КАК ДвиженияДенежныхСредствОбороты
		|ГДЕ
		|	ДвиженияДенежныхСредствОбороты.Контрагент.ОсновнойМенеджерПокупателя = &Менеджер";
	Запрос.УстановитьПараметр("Менеджер",Менеджер);
	Запрос.УстановитьПараметр("Приход",Перечисления.ВидыДвиженийПриходРасход.Приход);
	Запрос.УстановитьПараметр("Д1",Д1);
	Запрос.УстановитьПараметр("Д2",Д2);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция _ПолучитьПланПродаж(Дт = Неопределено) Экспорт
	Если Дт = Неопределено Тогда
		Дт = Дата;
	КонецЕсли; 
	ТЗ = РегистрыСведений.ПланПродаж.СрезПоследних(Дт-1,Новый Структура("Менеджер",Менеджер));
	План = 0;
	Если ТЗ.Количество()>0 Тогда
		План = ТЗ[0].Сумма;	
	КонецЕсли; 		
	Возврат План;	
КонецФункции
Функция ПолучитьПланПродаж(ВходящаяДата) Экспорт
	
	ТЗ = РегистрыСведений.ПланПродаж.СрезПоследних(ВходящаяДата-1,Новый Структура("Менеджер", Менеджер));
	Если ТЗ.Количество()>0 Тогда
		Возврат ТЗ[0].Сумма;
	Иначе
		Возврат 0;
	КонецЕсли; 		
	
КонецФункции


Процедура _Печать() Экспорт
	
	ТД = Новый ТабличныйДокумент();
	ТД.ИмяПараметровПечати = "РасчетЗП_ПечатнаяФорма";
	
	Макет = ПолучитьМакет("Макет");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Период = ПредставлениеПериода(ДатаНачала, КонецДня(Дата), "ФП=Истина");
	ОбластьШапка.Параметры.Заполнить(ЭтотОбъект);
	ТД.Вывести(ОбластьШапка);
	
	Для каждого Цель Из БизнесЦели Цикл
		ОбластьБЦ = Макет.ПолучитьОбласть("Строка");
		ОбластьБЦ.Параметры.Заполнить(Цель);		
		ТД.Вывести(ОбластьБЦ);
	КонецЦикла; 
	ОбластьБЦ = Макет.ПолучитьОбласть("Цели");
	ОбластьБЦ.Параметры.СуммаБизнесЦелиРасчет = СуммаБизнесЦелиРасчет;		
	ТД.Вывести(ОбластьБЦ);
	
	ОбластьШапка = Макет.ПолучитьОбласть("ШапкаМ");
	ТД.Вывести(ОбластьШапка);	
	Конец = Макс(Штрафы.Количество(),Мотивация.Количество())-1;
	Для А=0 по Конец Цикл
		ОбластьШапка = Макет.ПолучитьОбласть("СтрокаМ");
		
		Если А < Штрафы.Количество() Тогда
			ОбластьШапка.Параметры.К1 = А+1;
			ОбластьШапка.Параметры.К2 = Штрафы[А].ПроцентВозвратаДенег;
			ОбластьШапка.Параметры.К3 = Штрафы[А].Штраф;
			ОбластьШапка.Параметры.К4 = Штрафы[А].Бонус;
		КонецЕсли; 
		
		Если А < Мотивация.Количество() Тогда
			ОбластьШапка.Параметры.П1 = А+1;
			ОбластьШапка.Параметры.П2 = Мотивация[А].ПроцентВыполнения;
			ОбластьШапка.Параметры.П3 = Мотивация[А].ПроцентВыплаты;			
		КонецЕсли; 
		ТД.Вывести(ОбластьШапка);	
	КонецЦикла;
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.Заполнить(ЭтотОбъект);
	ОбластьПодвал.Параметры.ИтогоВыплата = ИтогоКВыплате;
	ОбластьПодвал.Параметры.Штраф = ШтрафОплаты;
	ОбластьПодвал.Параметры.ШтрафВ = ШтрафВозвраты;
	//ОбластьПодвал.Параметры.ПроцентВыполнения = ПродажиПроцентВыполнения;
	//ОбластьПодвал.Параметры.ПроцентВВозвраты = ПроцентВВозвраты;	
	ОбластьПодвал.Параметры.ПроцентВыполнения = ?(ПланП<>0, Окр(ФактП/ПланП*100,1), 0);
	ОбластьПодвал.Параметры.ПроцентВВозвраты = ?(ФактП<>0, Окр(ФактВ/ФактП*100,1), 0);
	
	ОбластьПодвал.Параметры.ПроцентВыполненияДеньги = ДеньгиПроцентВыполнения;	
	МотивД=0;
	Для каждого Мотив Из Мотивация Цикл	
		Если Мотив.ПроцентВыполнения <= (ФактП/ПланП*100) Тогда
			МотивД = Мотив.ПроцентВыплаты;
		КонецЕсли;	
	КонецЦикла;
	ОбластьПодвал.Параметры.П4 = МотивД;
	Бонус = Окр(ФактД*МотивД/100,0);
	МотивШ = 0;
	Для каждого Штраф Из Штрафы Цикл	
		Если ПланД<>0 тогда
			Если Штраф.ПроцентВозвратаДенег <= (ФактД/ПланД*100) Тогда
				МотивШ=Штраф.Штраф;
			Если НЕ Штраф.Бонус Тогда
				Бонус=0;
			КонецЕсли;	
			Прервать;
		КонецЕсли;	
		КонецЕсли;
	КонецЦикла;		
	
	ОбластьПодвал.Параметры.О4 = Бонус;
	ОбластьПодвал.Параметры.В1 = ПроцентВозврата;
	ОбластьПодвал.Параметры.В2 = ФактВ;
	ОбластьПодвал.Параметры.СледМесяц = Формат(ДобавитьМесяц(Дата,1),"ДФ=MMMM-yyyy");
	ОбластьПодвал.Параметры.ПланНМ = ПолучитьПланПродаж(ДобавитьМесяц(Дата,1));
	
	ОбластьПодвал.Параметры.К1 = КварталУсловие;
	ОбластьПодвал.Параметры.К2 = КварталПроцент;
	ОбластьПодвал.Параметры.К3 = КвартальнаяПремия;
	

	
	ТД.Вывести(ОбластьПодвал);	
	
	УниверсальныеМеханизмы.НапечататьДокумент(ТД, 1, Ложь, ОбщегоНазначения.СформироватьЗаголовокДокумента(ЭтотОбъект, ""), Ссылка);
	
КонецПроцедуры
