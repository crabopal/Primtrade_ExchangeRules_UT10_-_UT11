
Процедура ОбработкаПроведения(Отказ, Режим)

	ОбработкаУдаленияПроведения(Отказ);
	
	// регистр астПартииТоваровПоСправкамЕГАИС Приход
	ВерсияПриложения = астОбщегоНазначенияМеркурий.ОпределитьВерсиюПриложения();
	Если ВерсияПриложения <> 81 Тогда
		Выполнить("Движения.астПартииПродукцииМеркурий.Записывать = Истина;");
	КонецЕсли;

	Движения.астПартииПродукцииМеркурий.Очистить();
	Для Каждого ТекСтрокаПартииПродукции Из ПартииПродукции Цикл
		Если НЕ ЗначениеЗаполнено(ТекСтрокаПартииПродукции.ПартияПродукции) ИЛИ НЕ ЗначениеЗаполнено(ТекСтрокаПартииПродукции.Количество) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ТекСтрокаПартииПродукции.Количество > 0 Тогда
			ВидДвижения = "Приход";
			Количество = ТекСтрокаПартииПродукции.Количество;
		Иначе
			ВидДвижения = "Расход";
			Количество = -ТекСтрокаПартииПродукции.Количество;
		КонецЕсли;	
		
		ПоискТоваров = ПартииТоваровФактические.НайтиСтроки(Новый Структура("КлючСтроки", ТекСтрокаПартииПродукции.КлючСтроки));
		Если ПоискТоваров.Количество() > 0 Тогда
			Для Каждого СтрокаТовара Из ПоискТоваров Цикл
				астОбщегоНазначенияМеркурий.ДвижениеПоРегиструПартийМеркурий(Движения, СтрокаТовара, Ссылка, ВидДвижения, СтрокаТовара.Количество, ТекСтрокаПартииПродукции.ПартияПродукции);
			КонецЦикла;	
		Иначе
			астОбщегоНазначенияМеркурий.ДвижениеПоРегиструПартийМеркурий(Движения, ТекСтрокаПартииПродукции, Ссылка, ВидДвижения, Количество);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Комментарий = "";
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
		
	//Очистка движений документа
	Для Каждого Движение ИЗ ЭтотОбъект.Движения Цикл
		Движение.Очистить();
	КонецЦикла;
	
	//Запись пустых наборов движений в ИБ(очистка старых движений)
	СписокРегистровДляОчистки = Новый Массив;
	СписокРегистровДляОчистки.Добавить("астПартииПродукцииМеркурий");
	
	астОбщегоНазначенияМеркурий.ОчиститьСтарыеДвиженияДокумента(СписокРегистровДляОчистки, Ссылка);
			
КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	астОбщегоНазначенияМеркурий._ДобавитьПрефиксОрганизации(ЭтотОбъект, Префикс);
	мПрефикс = "";
	астОбщегоНазначенияМеркурий._ДобавитьПрефиксУзла(мПрефикс);
	Если Префикс <> мПрефикс Тогда
		Префикс = мПрефикс + Префикс;
	КонецЕсли;

КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Отказ = астОбщегоНазначенияМеркурий.ОбработкаУдаленияОбъектов(ЭтотОбъект);
	
КонецПроцедуры
