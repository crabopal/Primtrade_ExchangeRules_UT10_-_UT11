
Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	астОбщегоНазначенияМеркурий._ДобавитьПрефиксОрганизации(ЭтотОбъект, Префикс);
	мПрефикс = "";
	астОбщегоНазначенияМеркурий._ДобавитьПрефиксУзла(мПрефикс);
	Если Префикс <> мПрефикс Тогда
		Префикс = мПрефикс + Префикс;
	КонецЕсли;

КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Отказ = астОбщегоНазначенияМеркурий.ОбработкаУдаленияОбъектов(ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ВерсияПриложения = астОбщегоНазначенияМеркурий.ОпределитьВерсиюПриложения();
	Если ВерсияПриложения <> 81 Тогда
		Выполнить("Движения.астПартииПродукцииМеркурий.Записывать = Истина;");
	КонецЕсли;

	Движения.астПартииПродукцииМеркурий.Очистить();
	
	Если НЕ СтатусВСД = Перечисления.астСтатусыДокументовВСД.UTILIZED Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ВидВСД = Перечисления.астВидыВСД.PAPER Тогда
		Если НЕ НастройкаМеркурий.ПроводитьВходящиеВСД Тогда
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТранспортнаяПартия) Тогда
			Возврат;
		КонецЕсли;
		
		Если ТранспортнаяПартия.ТипДокумента = Перечисления.астТипыДокументовМеркурий.Исходящий Тогда
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	
	Если НЕ Статус = Перечисления.астСтатусыОбработкиДокументовМеркурий.ПолученоПодтверждение Тогда
		Возврат;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ПартияПродукции) Тогда
		Возврат;
	КонецЕсли;
	
	// регистр астПартииПродукцииМеркурий Расход
	Движения.астПартииПродукцииМеркурий.Записывать = Истина;
	Движения.астПартииПродукцииМеркурий.Очистить();
	
	Движение = Движения.астПартииПродукцииМеркурий.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
	Движение.Период = Дата;
	Движение.Организация = Организация;
	Движение.ХозяйствующийСубъект = ХозяйствующийСубъект;
	Движение.Предприятие = Предприятие;
	Движение.Склад = Склад;
	Движение.ПродукцияМеркурий = ПродукцияМеркурий;
	Движение.ПартияПродукции = ПартияПродукции;
	Движение.НастройкаМеркурий = НастройкаМеркурий;
	Движение.Количество = РеальноеКоличество;
	
	// получим данные из ТТН
	Если ЗначениеЗаполнено(ТранспортнаяПартия) Тогда
		ПоискСтрокиВСД = ТранспортнаяПартия.ПартииПродукции.Найти(Ссылка, "ВСД");
		Если ПоискСтрокиВСД <> Неопределено Тогда
			Движение.Номенклатура = ПоискСтрокиВСД.Номенклатура;
			Движение.СерияНоменклатуры = ПоискСтрокиВСД.СерияНоменклатуры;
			Движение.ХарактеристикаНоменклатуры = ПоискСтрокиВСД.ХарактеристикаНоменклатуры;
		КонецЕсли;
	Иначе	
		Движение.Номенклатура = Номенклатура;
		Движение.СерияНоменклатуры = СерияНоменклатуры;
		Движение.ХарактеристикаНоменклатуры = ХарактеристикаНоменклатуры;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
		
	//Очистка движений документа
	Для Каждого Движение ИЗ ЭтотОбъект.Движения Цикл
		Движение.Очистить();
	КонецЦикла;
	
	//Запись пустых наборов движений в ИБ(очистка старых движений)	
	Набор = РегистрыНакопления.астПартииПродукцииМеркурий.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	Попытка
		Набор.Записать();
	Исключение
		// возможно «сработал» RLS или механизм даты запрета изменения
		Сообщить("Операция не выполнена: " + ОписаниеОшибки());
		Отказ = Истина;
	КонецПопытки;
			
КонецПроцедуры
