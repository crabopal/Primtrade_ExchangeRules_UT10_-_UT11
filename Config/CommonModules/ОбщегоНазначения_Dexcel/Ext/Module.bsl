Процедура УстановитьСоединениеСОМ() Экспорт
	
	#Если Клиент Тогда
		
		Если ТипЗнч(глСоединениеКСтаройБазе) = Тип("Структура") 
			И глСоединениеКСтаройБазе.Свойство("Соединение") И глСоединениеКСтаройБазе.Свойство("КоличествоПодключений") Тогда
			Счетчик       = глСоединениеКСтаройБазе.СчетчикПодключений;		
			СоединениеСОМ = глСоединениеКСтаройБазе.Соединение;	
		//ИначеЕсли ТипЗнч(глСоединениеКСтаройБазе) = Тип("Структура") Тогда // Убрал на время, обновили версию платформы
		//	Возврат; 
		Иначе	
			глСоединениеКСтаройБазе = Новый Структура("Соединение, СчетчикПодключений", Неопределено, 0);
			Счетчик       = 0;		
			СоединениеСОМ = Неопределено;
		КонецЕсли;	
		
		Если ТипЗнч(СоединениеСОМ) = Тип("COMОбъект") Тогда 
			Если Счетчик > 1 Тогда
				глСоединениеКСтаройБазе.СчетчикПодключений = 1;
			КонецЕсли;	
		ИначеЕсли Счетчик > 5 Тогда			
			Если глСоединениеКСтаройБазе.Соединение <> Неопределено Тогда
				глСоединениеКСтаройБазе.Соединение = Неопределено;
			КонецЕсли;
		Иначе
			Параметры = "Srvr=""Server1C"";Ref=""UT_OLD"";Usr=""Программист"";Pwd=""9102"";";
			Попытка
				V83COMConnector= Новый COMОбъект("V83.COMConnector");	
				СоединениеСОМ = V83COMConnector.Connect(Параметры);
				Счетчик       = 1;
			Исключение 		
				СоединениеСОМ = Неопределено;
				Счетчик       = Счетчик + 1;
				Сообщить(ОписаниеОшибки());
			КонецПопытки; 		
			глСоединениеКСтаройБазе.Соединение         = СоединениеСОМ;
			глСоединениеКСтаройБазе.СчетчикПодключений = Счетчик; 		
		КонецЕсли;
		
	#КонецЕсли
	                   
КонецПроцедуры

Функция ВыполнитьЗапросСОМ(ТекстЗапроса, ПараметрыСтруктура, ДанныеСтрока, ВозвращатьМассивомСтрок = Истина, СообщатьНенайдено = Истина) Экспорт
	
	Если ВозвращатьМассивомСтрок Тогда
		Результат = Новый Массив;
	Иначе
		Результат = Новый ТаблицаЗначений;
		
		НаборКолонок = СтрРазделить(ДанныеСтрока, ",");

		Для Каждого ТекКолонка Из НаборКолонок Цикл
			Результат.Колонки.Добавить(СокрЛП(ТекКолонка));
		КонецЦикла;
	КонецЕсли;
	
	#Если Клиент Тогда
		
		Если глСоединениеКСтаройБазе = Неопределено 
			Или глСоединениеКСтаройБазе.Соединение = Неопределено Тогда
			УстановитьСоединениеСОМ();
		КонецЕсли;	
		
		Если глСоединениеКСтаройБазе = Неопределено 
			Или глСоединениеКСтаройБазе.Соединение = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;	
		
		СоединениеСОМ = глСоединениеКСтаройБазе.Соединение;
		
		Запрос = СоединениеСОМ.NewObject("Запрос");
		Запрос.Текст = ТекстЗапроса;
		
		Для Каждого ТекущийПараметр Из ПараметрыСтруктура Цикл
			
			Если ТипЗнч(ТекущийПараметр.Значение) = Тип("Дата") 
				Или ТекущийПараметр.Значение = Неопределено
				Или ТипЗнч(ТекущийПараметр.Значение) = Тип("Строка") 
				Или ТипЗнч(ТекущийПараметр.Значение) = Тип("Число") 
				Или ТипЗнч(ТекущийПараметр.Значение) = Тип("Булево") Тогда
				ЗначениеПараметра = ТекущийПараметр.Значение;
			ИначеЕсли ТипЗнч(ТекущийПараметр.Значение) = Тип("Массив") Тогда
				ЗначениеПараметра = СоединениеСОМ.NewObject("Массив");
				Для Каждого Элемент Из ТекущийПараметр.Значение Цикл
					Если ТипЗнч(Элемент) = Тип("Дата") 
						Или ТипЗнч(Элемент) = Тип("Строка") 
						Или ТипЗнч(Элемент) = Тип("Число") Тогда
						ЗначениеПараметра.Добавить(Элемент);
					Иначе
						ЗначениеЭлемента = ПолучитьЗначениеПоСом(Элемент, СоединениеСОМ);
						ЗначениеПараметра.Добавить(ЗначениеЭлемента);
					КонецЕсли;
				КонецЦикла;	
			Иначе
				ЗначениеПараметра = ПолучитьЗначениеПоСом(ТекущийПараметр.Значение, СоединениеСОМ);
			КонецЕсли;	
			
			Запрос.УстановитьПараметр(ТекущийПараметр.Ключ, ЗначениеПараметра);
			
		КонецЦикла;	
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		Если Не ЗначениеЗаполнено(ДанныеСтрока) Тогда
			ДанныеСтрока = "";
			Для Каждого ТекКолонка ИЗ РезультатЗапроса.Columns Цикл
				ДанныеСтрока = ДанныеСтрока + ТекКолонка.Name + ",";
				
				Если Не ВозвращатьМассивомСтрок Тогда
			    	Результат.Колонки.Добавить(ТекКолонка.Name);
				КонецЕсли;
			КонецЦикла;
			
			ДанныеСтрока = Лев(ДанныеСтрока, СтрДлина(ДанныеСтрока)-1);
		КонецЕсли;
		
		МассивПоказателей = ПолучитьМассивИзСтроки(ДанныеСтрока);
		
		Для Каждого ТекСтрока Из РезультатЗапроса Цикл
			НоваяСтрока = Новый Структура(ДанныеСтрока);
			Для Каждого Показатель Из МассивПоказателей Цикл
				НоваяСтрока[Показатель] = ПолучитьЗначениеИзСОМОбъекта(СоединениеСОМ, ТекСтрока[Показатель], СообщатьНенайдено);
				
				//СоединениеСОМ.NewObject(""Граница"", TypeOf(Строка[Показатель])	
				//XMLТипЗнч(Строка[Показатель]) 
			КонецЦикла;
			
			Если ВозвращатьМассивомСтрок Тогда
				Результат.Добавить(НоваяСтрока);
			Иначе
				ЗаполнитьЗначенияСвойств(Результат.Добавить(), НоваяСтрока);
			КонецЕсли;
		КонецЦикла;
		
	#КонецЕсли
	
	Возврат Результат;
	
КонецФункции	

Функция ПолучитьЗначениеИзСОМОбъекта(СоединениеСОМ, ВхЗначениеКом, СообщатьНенайдено = Истина)
	
	//Для каждого ИмяРеквизита Из КопируемыеРеквизиты Цикл
	ТипЗначения = ТипЗнч(ВхЗначениеКом);
	Если (ТипЗначения = Тип("Число"))
		ИЛИ (ТипЗначения = Тип("Строка"))
		ИЛИ (ТипЗначения = Тип("Дата"))
		ИЛИ (ТипЗначения = Тип("Булево"))
		ИЛИ (ТипЗначения = Тип("Null"))
		ИЛИ (ТипЗначения = Тип("Неопределено")) Тогда
		
		Возврат ВхЗначениеКом;
		
	//ИначеЕсли 
	//	ВхЗначениеКом.Свойство("Колонки")
	//	
	Иначе
		
		Попытка
			ЭтоТаблица = (ВхЗначениеКом.Колонки <> Неопределено);
		Исключение
			ЭтоТаблица = Ложь;
		КонецПопытки;
		
		Если ЭтоТаблица = Истина Тогда
			Результат = Новый ТаблицаЗначений;
			Для Каждого ТекКолонка Из ВхЗначениеКом.Колонки Цикл
				Результат.Колонки.Добавить(ТекКолонка.Имя);
			КонецЦикла;
			
			Для Каждого Строка Из ВхЗначениеКом Цикл
				НовСтрока = Результат.Добавить();
				Для Каждого ТекКолонка Из ВхЗначениеКом.Колонки Цикл
					НовСтрока[ТекКолонка.Имя] = ПолучитьЗначениеИзСОМОбъекта(СоединениеСОМ, Строка[ТекКолонка.Имя], СообщатьНенайдено); 
				КонецЦикла;	
			КонецЦикла;
			
			Возврат Результат;
		КонецЕсли;
		
			
		ТипЗначения = ВхЗначениеКом.Метаданные().ПолноеИмя();
		
		Если Лев(Строка(ТипЗначения),12) = "Перечисление" Тогда
			
			Если ЗначениеЗаполнено(СоединениеСОМ.XMLстрока(ВхЗначениеКом)) Тогда
				Результат = Перечисления[Сред(ТипЗначения,14)][СоединениеСОМ.XMLстрока(ВхЗначениеКом)];
			Иначе
				Результат = Перечисления[Сред(ТипЗначения,14)].ПустаяСсылка();
			КонецЕсли;
			
			//Результат = Перечисления[Сред(ТипЗначения,14)][СоединениеСОМ.XMLстрока(ВхЗначениеКом)];
			
		ИначеЕсли Лев(Строка(ТипЗначения),10) = "Справочник" Тогда
			
			ГуидСтр = СоединениеСОМ.String(ВхЗначениеКом.УникальныйИдентификатор());
			Результат = Справочники[Сред(ТипЗначения,12)].ПолучитьСсылку(Новый УникальныйИдентификатор(ГуидСтр));
			
			Если СообщатьНенайдено
				И Лев(Результат, 18) = "<Объект не найден>" Тогда
				Сообщить("Не найден элемент " + ГуидСтр + " (" + ТипЗначения + ")");
			КонецЕсли;
			
		ИначеЕсли Лев(Строка(ТипЗначения),8) = "Документ" Тогда
			ГуидСтр = СоединениеСОМ.String(ВхЗначениеКом.УникальныйИдентификатор());
			Результат = Документы[Сред(ТипЗначения,10)].ПолучитьСсылку(Новый УникальныйИдентификатор(ГуидСтр));
			
			Если СообщатьНенайдено
				И Лев(Результат, 18) = "<Объект не найден>" Тогда
				Сообщить("Не найден элемент " + ГуидСтр + " (" + ТипЗначения + ")");
			КонецЕсли;
			
		Иначе
			//Если Лев(Строка(ТипЗначения),10) = "Справочник" Тогда
			ТекстОшибки = "Ошибка при загрузке объекта <" + ТипЗначения + ">";
			Сообщить(ТекстОшибки);
			//Если СписокОшибокРеквизитов.НайтиПоЗначению(ТекстОшибки) = Неопределено Тогда
			//	СписокОшибокРеквизитов.Добавить(ТекстОшибки);
			//КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//КонецЦикла;
	
	
	
	//СоединениеСОМ.TypeOf(СомОбъект)
	//СомОбъект.Количество
	
	//СоединениеСОМСомОбъект	
	//
	//Результат = Неопределено;
	//
	//Выполнить("Результат = СомОбъект." + Имя + ";");
	//
	Возврат Результат;
	
КонецФункции	

Функция ПолучитьЗначениеПоСом(ЭлементСсылка, СоединениеСОМ)
	
	Если СоединениеСОМ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	Если ТипЗнч(ЭлементСсылка) = Тип("Граница") Тогда		
		ТекущийВидГраницы = ?(ЭлементСсылка.ВидГраницы = ВидГраницы.Включая, "ВидГраницы.Включая", "ВидГраницы.Исключая");
		Выполнить("Результат = СоединениеСОМ.NewObject(""Граница"", ЭлементСсылка.Значение, СоединениеСОМ." + ТекущийВидГраницы + ");"); 
		
	ИначеЕсли ТипЗнч(ЭлементСсылка) = Тип("ТаблицаЗначений") Тогда		
		
		//Если ЭлементСсылка.Колонки.Дата.ТипЗначения.СодержитТип(Тип("Дата")) = Новый ОписаниеТипов("Дата")
		//
		//ТабДанные = Новый ТаблицаЗначений;
		//ТабДанные.Колонки.Добавить(,
		
		//Описатель=СоединениеСОМ.NewObject("описаниетипов","Дата");
		//ТипДата=Описатель.Типы().Получить(0);

		Результат = СоединениеСОМ.NewObject("ТаблицаЗначений");
		Для Каждого ТекКолонка Из ЭлементСсылка.Колонки Цикл
			
			Если ТекКолонка.ТипЗначения.СодержитТип(Тип("Дата")) Тогда
				Результат.Колонки.Добавить(ТекКолонка.Имя, СоединениеСОМ.NewObject("ОписаниеТипов","Дата"));
			ИначеЕсли ТекКолонка.ТипЗначения.СодержитТип(Тип("Строка")) Тогда
					
				КС = СоединениеСОМ.NewObject("StringQualifiers", ТекКолонка.ТипЗначения.КвалификаторыСтроки.Длина);
				
				//Результат.Колонки.Добавить(ТекКолонка.Имя, СоединениеСОМ.NewObject("ОписаниеТипов","Строка",,,,15));
				Результат.Колонки.Добавить(ТекКолонка.Имя, СоединениеСОМ.NewObject("ОписаниеТипов","Строка", КС));
				
				//Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(20))
			    //NewObject("ОписаниеТипов","Строка")
			
			ИначеЕсли ТекКолонка.ТипЗначения.СодержитТип(Тип("Число")) Тогда
				Результат.Колонки.Добавить(ТекКолонка.Имя, СоединениеСОМ.NewObject("ОписаниеТипов","Число"));
			//добавить другие типы	
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Строка Из ЭлементСсылка Цикл
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), Строка);
		КонецЦикла;
		
				
	Иначе		
		МетаданныеЭлемента = ЭлементСсылка.Метаданные();		
		Если Метаданные.Перечисления.Содержит(МетаданныеЭлемента) Тогда
			Выполнить("Результат = СоединениеСОМ.Перечисления." + МетаданныеЭлемента.Имя + "." + ЭлементСсылка + ";");
		Иначе			
			УникальныйИдентификатор = ЭлементСсылка.УникальныйИдентификатор(); 		
			УидCOM = СоединениеСОМ.NewObject("УникальныйИдентификатор", Строка(УникальныйИдентификатор)); 		
			Если Метаданные.Справочники.Содержит(МетаданныеЭлемента) Тогда
				Выполнить("Результат = СоединениеСОМ.Справочники." + МетаданныеЭлемента.Имя + ".ПолучитьСсылку(УидCOM);");
			ИначеЕсли Метаданные.Документы.Содержит(МетаданныеЭлемента) Тогда
				Выполнить("Результат = СоединениеСОМ.Документы." + МетаданныеЭлемента.Имя + ".ПолучитьСсылку(УидCOM);");
			Иначе
				Результат = Неопределено;
			КонецЕсли; 	
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	 
КонецФункции	

Функция ПолучитьМассивИзСтроки(ЗначениеСтрока, Разделитель = Неопределено) Экспорт
	
	Результат = Новый Массив;
	
	Если ТипЗнч(ЗначениеСтрока) <> Тип("Строка") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Разделитель = Неопределено Тогда
		Разделитель = ",";
	КонецЕсли;	
	
	МассивСтрока = СокрЛП(ЗначениеСтрока);
	
	Пока МассивСтрока <> "" Цикл
		
		ПозицияРазделителя = СтрНайти(МассивСтрока, Разделитель);
		
		Если ПозицияРазделителя = 0 Тогда
			Значение = СокрЛП(МассивСтрока);
			МассивСтрока = "";
		Иначе
			Значение = СокрЛП(Лев(МассивСтрока, ПозицияРазделителя - 1));
			МассивСтрока = Прав(МассивСтрока, СтрДлина(МассивСтрока) - ПозицияРазделителя);
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(Значение) Тогда
			Результат.Добавить(Значение);
		КонецЕсли; 
		
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

Функция ДатаВводаОстатков() Экспорт
	
	Возврат Дата(2025,1,1);
	
КонецФункции

Процедура УправлениеЗапасамиПартионныйУчет_ДополнитьТекстЗапросаДляКорректировкиРеализации(Запрос) Экспорт
		
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	КорректировкаТовары.Номенклатура,
		|	ВЫБОР
		|		КОГДА КорректировкаТовары.Номенклатура.ВестиПартионныйУчетПоСериям
		|			ТОГДА КорректировкаТовары.СерияНоменклатуры
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
		|	КОНЕЦ КАК СерияНоменклатуры,
		|	КорректировкаТовары.Ссылка.Склад,
		|	КорректировкаТовары.Ссылка.Склад КАК ОсновнойСклад,
		|	СУММА(КорректировкаТовары.КоличествоДоИзменения + КорректировкаТовары.Количество) КАК Количество,
		|	СУММА(КорректировкаТовары.СуммаДоИзменения + КорректировкаТовары.Сумма) КАК Сумма
		|ПОМЕСТИТЬ ВтТоварыРеализации
		|ИЗ
		|	Документ.КорректировкаРеализации.Товары КАК КорректировкаТовары
		|ГДЕ
		|	КорректировкаТовары.Ссылка = &КорректировкаРеализации
		|	И (КорректировкаТовары.Количество <> КорректировкаТовары.КоличествоДоИзменения
		|			ИЛИ КорректировкаТовары.Сумма <> КорректировкаТовары.СуммаДоИзменения)
		|
		|СГРУППИРОВАТЬ ПО
		|	КорректировкаТовары.Номенклатура,
		|	КорректировкаТовары.Ссылка.Склад,
		|	ВЫБОР
		|		КОГДА КорректировкаТовары.Номенклатура.ВестиПартионныйУчетПоСериям
