		|ГДЕ
		|	Товары.Количество > ЕСТЬNULL(Остатки.КоличествоОстаток, 0)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("МоментВремени", Ссылка.МоментВремени());
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Организация", Ссылка.Организация);
	Запрос.УстановитьПараметр("Предприятие", Ссылка.Предприятие);
	
	Если НЕ Ссылка.НастройкаМеркурий.ВестиУчетПоСериям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "астПартииПродукцииМеркурий.СерияНоменклатуры", "NULL");
	КонецЕсли;
	Если НЕ Ссылка.НастройкаМеркурий.ВестиУчетПоХарактеристикам Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "астПартииПродукцииМеркурий.ХарактеристикаНоменклатуры", "NULL");
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "астТранспортнаяПартияМеркурий", ИмяДокумента);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Сообщить("В " + Ссылка + " недостаточно остатков товара Меркурий 
		|	Строка " + СтрЗаменить(Строка(Выборка.НомерСтроки), Символы.НПП, "") + ", """ + СокрЛП(Выборка.ПродукцияМеркурий) + " (" + Выборка.Код + ") 
		|	Партия " + Выборка.ПартияПродукции + ?(Ссылка.НастройкаМеркурий.ВестиУчетПоСериям, " / Серия " + Выборка.СерияНоменклатуры, "") + ?(Ссылка.НастройкаМеркурий.ВестиУчетПоХарактеристикам, " / Характеристика " + Выборка.ХарактеристикаНоменклатуры, "") + "
		|	Требуется " + Выборка.Количество + ", на остатках всего " + Выборка.КоличествоОстаток, СтатусСообщения.Важное);	
	КонецЦикла;
	
	Возврат Выборка.Количество() > 0;
	
КонецФункции	

// если разница приемки меньше 5% то возврат не делается 
Функция ПолучитьПроцентРасхожденияКоличества(мРеальноеКоличество, мКоличество) Экспорт
	
	Разница = мКоличество - мРеальноеКоличество; 

	Если Разница < 0 Тогда
		Разница = мРеальноеКоличество - мКоличество;
	КонецЕсли;
	
	Процент = 100 * (Разница / мКоличество);
	
	Возврат Процент;
	
КонецФункции	

// константа, размер допустимого процента расхождения
Функция ПолучитьПроцентДопустимогоРасхожденияВСД() Экспорт
	
	Возврат 5;
	
КонецФункции	

// возвращает вес номенклатуры из единицы или из соответствия
Функция ПолучитьВесНоменклатуры(Номенклатура, ПродукцияМеркурий) Экспорт
	
	ВесЕдИзм = 0;
	
	ИдКонфигурации = _ИДКонфигурации();
	
	Если ИДКонфигурации = "УТ" ИЛИ ИДКонфигурации = "КА" ИЛИ ИДКонфигурации = "УТАП" Тогда
		Если ЗначениеЗаполнено(Номенклатура) Тогда
			ВесЕдИзм = ПолучитьВесЕдиницыИзмерения(Номенклатура.ЕдиницаХраненияОстатков);
		КонецЕсли;	
	КонецЕсли;
	
	Если ВесЕдИзм = 0 Тогда
		// найдем в соответствии 
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	астСоответствиеНоменклатурыМеркурий.ВесНетто
		|ИЗ
		|	РегистрСведений.астСоответствиеНоменклатурыМеркурий КАК астСоответствиеНоменклатурыМеркурий
		|ГДЕ
		|	астСоответствиеНоменклатурыМеркурий.ПродукцияМеркурий = &ПродукцияМеркурий
		|	И астСоответствиеНоменклатурыМеркурий.Номенклатура = &Номенклатура";
		
		Запрос.УстановитьПараметр("ПродукцияМеркурий", ПродукцияМеркурий);
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			ВесЕдИзм = Выборка.ВесНетто;
		КонецЕсли;
	КонецЕсли;	
	
	Если ВесЕдИзм = 0 Тогда
		ВесЕдИзм = 1;
	КонецЕсли;	

	Возврат ВесЕдИзм;
	
КонецФункции	

Функция ПолучитьВесЕдиницыИзмерения(ЕдИзмерения) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЕдИзмерения) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ЕдИзмерения.Метаданные().Реквизиты.Найти("ВесНетто") <> Неопределено Тогда
		Возврат ЕдИзмерения.ВесНетто;
	Иначе
		Возврат ЕдИзмерения.Вес;
	КонецЕсли;	
	
КонецФункции

// ДОПОЛНИТЕЛЬНЫЕ ОБРАБОТЧИКИ

// вызов дополнительного обработчика из внешней обработки DevelopeMercury.epf, идущей в поставке модуля, выбранной в настройке Ветис
Процедура ВыполнитьДопОбработчик(ИмяСобытия, мПараметры) Экспорт 
	
	НастройкаМеркурий = мПараметры.НастройкаМеркурий;
	ОбъектВладелец = мПараметры.ОбъектВладелец;
	
	// обработка из кэша
	ДопВнешняяОбработка = мПараметры.ДопВнешняяОбработка;
	
	Если НЕ ЗначениеЗаполнено(НастройкаМеркурий.ДополнительныйОбработчик) Тогда
		Возврат;
	КонецЕсли;	
	
	Если ДопВнешняяОбработка = Неопределено Тогда
		Попытка 
			ДопВнешняяОбработка = ПолучитьОбъектОбработкиИзФайла(НастройкаМеркурий.ДополнительныйОбработчик);
			ДопВнешняяОбработка.ОбъектВладелец = ОбъектВладелец;
		Исключение
			Возврат;
		КонецПопытки; 
	КонецЕсли;
	
	Попытка
		ДопВнешняяОбработка.ВыполнитьДополнительнуюОбработкуМеркурий(ИмяСобытия, мПараметры);
	Исключение
		Сообщить("Ошибка дополнительного обработчика события " + ИмяСобытия + ": " + ОписаниеОшибки());
		Возврат;
	КонецПопытки; 

КонецПроцедуры	
	
// инициализация доп обработки
Функция ПолучитьОбъектОбработкиИзФайла(пИмяФайла)
			
	Попытка
		Возврат ВнешниеОбработки.Создать(пИмяФайла);
	Исключение           
		Сообщить("Ошибка инициализации файла дополнительного обработчика: " + ОписаниеОшибки());
		Возврат Неопределено
	КонецПопытки;
	
КонецФункции

// Проверяет, нужно ли блокировать документ от возможности установки пометки удаления или 
// отмены проведения в случае успешной отправки документа в ЕГАИС.
// Проверка не работает для роли астАдминистраторЕГАИС
Функция ПроверитьДокументПередРедактированием(ДокументОбъект, ДокументСсылка, Режим, Статус) Экспорт
	
	Отказ = Ложь;
	
	//Если Не РольДоступна(Метаданные.Роли.астАдминистраторЕГАИС) И ДокументОбъект.Проведен Тогда
	Если ДокументОбъект.Проведен Тогда
		
		Если ДокументОбъект.Статус = Перечисления.астСтатусыОбработкиДокументовМеркурий.ПолученоПодтверждение Тогда
			ПроверитьИВывестиСообщение(ДокументОбъект, ДокументСсылка, Режим, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Отказ;
	
КонецФункции
 
Процедура ПроверитьИВывестиСообщение(ДокументОбъект, ДокументСсылка, Режим, Отказ)
	
	Если ДокументСсылка.ПометкаУдаления Тогда
		Сообщить("" + ДокументСсылка + ": установка пометки удаления запрещена! Документ отправлен на сервер", СтатусСообщения.Внимание);
		Отказ = Истина;
	ИначеЕсли Режим = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Сообщить("" + ДокументСсылка + ": отмена проведения документа запрещена! Документ отправлен на сервер", СтатусСообщения.Внимание);
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьОтветственногоПользователя(ИДКонфигурации) Экспорт
	
	Если ИДКонфигурации = "SA" Тогда
		Выполнить("мОтветственный = глСотр;");
	ИначеЕсли ИДКонфигурации = "ШМ" Тогда	
		Попытка
			мОтветственный = ПараметрыСеанса.глТекущийПользователь;
		Исключение
		КонецПопытки;	
	Иначе	
		мОтветственный = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
	Возврат мОтветственный;
	
КонецФункции
