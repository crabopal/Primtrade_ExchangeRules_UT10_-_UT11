// ПРОЦЕДУРЫ И ФУНКЦИИ УПРАВЛЕНИЯ НОМЕРАМИ ДОКУМЕНТОВ

Процедура _ДобавитьПрефиксОрганизации(ДокументОбъект, Префикс) Экспорт
	
	Если Метаданные.Справочники.Найти("Организации") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Метаданные.Справочники.Организации.Реквизиты.Найти("Префикс") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДокументОбъект.Организация) <> Тип("СправочникСсылка.Организации") Тогда
		Возврат;
	КонецЕсли;
	                                    
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.Организация.Префикс)  Тогда
		Префикс = "0";
	Иначе                        
		Префикс = ДокументОбъект.Организация.Префикс;    		
	КонецЕсли;
	
Конецпроцедуры

Процедура _ДобавитьПрефиксУзла(Префикс) Экспорт
	
	Если Метаданные.ПараметрыСеанса.Найти("ПрефиксУзлаРаспределеннойИнформационнойБазы") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
	Если НЕ ПустаяСтрока(ПараметрыСеанса.ПрефиксУзлаРаспределеннойИнформационнойБазы) Тогда
		Префикс = ПараметрыСеанса.ПрефиксУзлаРаспределеннойИнформационнойБазы + Префикс;
	КонецЕсли;
	Исключение КонецПопытки;
	
КонецПроцедуры

// Функция формирует значение нового ключа строки табличной части.
//
// Параметры:
//  ДокументОбъект – объект редактируемого документа,
//  ИмяТЧ          – имя табличной части объекта.
//
Функция _ПолучитьНовыйКлючСтроки(Таблица) Экспорт

	Если Таблица.Количество() = 0 Тогда
		МаксКлюч = 1;
	Иначе
		// Если в табл. части уже присутствуют строки, то новое «свободное» значение ключа
		// рассчитывается от максимального существующего значения.
		СписокКлючей = Новый СписокЗначений;
		СписокКлючей.ЗагрузитьЗначения(Таблица.ВыгрузитьКолонку("КлючСтроки"));
		СписокКлючей.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
		МаксКлюч = СписокКлючей[0].Значение + 1;
	КонецЕсли;

	Возврат МаксКлюч;

КонецФункции // ПолучитьНовыйКлючСвязи()

// возвращает расшифровку статуса записи
Функция ПолучитьОписаниеСтатусаЗаписи(КодСтатуса) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КодСтатуса) Тогда
		Возврат "";
	КонецЕсли;
	
	ДанныеНСИ = Справочники.астНастройкиМеркурий.ПолучитьМакет("НСИ");
	
	// типы актов
	ОбластьДанных = ДанныеНСИ.ПолучитьОбласть("Статусы");
	ВысотаТаблицы = ОбластьДанных.ВысотаТаблицы;
	
	ПояснениеСтатуса = КодСтатуса;
	Для Инд = 1 По ВысотаТаблицы Цикл
		Статус = СокрЛП(ОбластьДанных.Область(Инд, 1, Инд, 1).Текст);
		ПояснениеСтатуса = СокрЛП(ОбластьДанных.Область(Инд, 3, Инд, 3).Текст);
		
		Если КодСтатуса = Статус Тогда
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат ПояснениеСтатуса + " (" + КодСтатуса + ")";

КонецФункции

Процедура УстановитьВидимостьСерииХарактеристикиНоменклатуры(ЭлементыФормы, ИмяТаблицы = "ПартииПродукции") Экспорт
	
	// серия
	ЕстьСерии = Метаданные.Справочники.Найти("СерииНоменклатуры") <> Неопределено;
	Если НЕ ЕстьСерии Тогда
		ЭлементыФормы[ИмяТаблицы].Колонки.СерияНоменклатуры.Видимость = Ложь;
	Иначе
		ЭлементыФормы[ИмяТаблицы].Колонки.СерияНоменклатуры.ЭлементУправления.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры");
	КонецЕсли;
	
	// характеристика
	
	ЕстьХарактеристика = Метаданные.Справочники.Найти("ХарактеристикиНоменклатуры") <> Неопределено;
	Если НЕ ЕстьХарактеристика Тогда
		ЭлементыФормы[ИмяТаблицы].Колонки.ХарактеристикаНоменклатуры.Видимость = Ложь;
	Иначе
		ЭлементыФормы[ИмяТаблицы].Колонки.ХарактеристикаНоменклатуры.ЭлементУправления.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры");
	КонецЕсли;
	
	ЭлементыФормы[ИмяТаблицы].Колонки.Номенклатура.ЭлементУправления.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
	
КонецПроцедуры	

Процедура УстановитьОграничениеТипаПоля(ИмяСправочника, Элемент) Экспорт
	
	Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТипСтр = "СправочникСсылка." + ИмяСправочника;
    Элемент.ОграничениеТипа = Новый ОписаниеТипов(ТипСтр);
    Значение = Элемент.Значение;
    Элемент.Значение = Элемент.ОграничениеТипа.ПривестиЗначение(Значение);
    Элемент.ВыбиратьТип = Ложь;
	Элемент.КнопкаВыбора = Истина;

КонецПроцедуры	

// Процедура блокирует для изменения реквизиты документа

// Процедура блокирует для изменения реквизиты документа
Процедура _УстановитьДоступностьЭлементовФормы(ДокументОбъект, ЭлементыФормы) Экспорт
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	// запрет изменения табличной части документа
	Для Каждого ТабЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл	
		Если ЭлементыФормы.Найти(ТабЧасть.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		Для Каждого Колонка Из ЭлементыФормы[ТабЧасть.Имя].Колонки Цикл
			Если Колонка.Имя = "Номенклатура" ИЛИ 
				Колонка.Имя = "СерияНоменклатуры" ИЛИ 
				Колонка.Имя = "ХарактеристикаНоменклатуры" Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЭлементыФормы[ТабЧасть.Имя].Колонки[Колонка.Имя].ЭлементУправления = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ТипЗнч(ЭлементыФормы[ТабЧасть.Имя].Колонки[Колонка.Имя].ЭлементУправления) = Тип("ПолеВвода") Тогда
				Продолжить;
			КонецЕсли;
			
			ЭлементыФормы[ТабЧасть.Имя].Колонки[Колонка.Имя].ЭлементУправления.ТолькоПросмотр = Истина;
			ЭлементыФормы[ТабЧасть.Имя].Колонки[Колонка.Имя].ЭлементУправления.РедактированиеТекста = Ложь;
		КонецЦикла;	
		
		ЭлементыФормы[ТабЧасть.Имя].ИзменятьСоставСтрок = Ложь;
		ЭлементыФормы[ТабЧасть.Имя].ИзменятьПорядокСтрок = Ложь;
	КонецЦикла;
	
	// реквизиты
	Для Каждого ЭлементФормы Из ЭлементыФормы Цикл
		Если ТипЗнч(ЭлементФормы) = Тип("ПолеВвода") Тогда
			Если ЭлементФормы.Имя = "ИдентификаторМеркурий" ИЛИ
				ЭлементФормы.Имя = "Статус" Тогда 
				Продолжить;
			КонецЕсли;	
			
			ЭлементФормы.ТолькоПросмотр = Истина;
		ИначеЕсли ТипЗнч(ЭлементФормы) = Тип("Флажок") Тогда
			ЭлементФормы.Доступность = Ложь;	
		ИначеЕсли ТипЗнч(ЭлементФормы) = Тип("КоманднаяПанель") Тогда
			// типовые панели пропускаем
			Если ЭлементФормы.Имя = "ОсновныеДействияФормы" ИЛИ 
				ЭлементФормы.Имя = "ДействияФормы" ИЛИ 
				ЭлементФормы.Имя = "КоманднаяПанельОтветXML" ИЛИ 
				ЭлементФормы.Имя = "КоманднаяПанельОтветXMLРегионализация" Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого Кнопка Из ЭлементФормы.Кнопки Цикл
				Если Кнопка.Имя = "СписокНоменклатуры" ИЛИ 
					Кнопка.Имя = "ЗаполнитьНоменклатуру" Тогда
					Продолжить;	
				КонецЕсли;
				
				Кнопка.Доступность = Ложь;
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;	
		
КонецПроцедуры

// установка типа значения организации
Процедура УстановитьТипЗначенияОрганизации(Элемент) Экспорт
	
	ИДКонфигурации = _ИДКонфигурации();
	Если ИДКонфигурации = "КУТ" ИЛИ ИДКонфигурации = "ДЛН" Тогда
		УстановитьОграничениеТипаПоля("Фирмы", Элемент);	
	ИначеЕсли ИДКонфигурации = "SA" Тогда
		УстановитьОграничениеТипаПоля("СобствРекв", Элемент);	
	Иначе
		УстановитьОграничениеТипаПоля("Организации", Элемент);	
	КонецЕсли;
	
КонецПроцедуры	

Процедура ПечатьТабДокумента(ТабДок,  НазваниеОтчета = "", КоличествоКопий = 1, НаПечать = Ложь) Экспорт
	
	Если Метаданные.ОбщиеМодули.Найти("УниверсальныеМеханизмы") = Неопределено Тогда
		ТабДок.ОтображатьЗаголовки = Ложь;
		ТабДок.ОтображатьСетку = Ложь;
		ТабДок.Показать(НазваниеОтчета);
	Иначе	
		Выполнить("УниверсальныеМеханизмы.НапечататьДокумент(ТабДок, КоличествоКопий, НаПечать, НазваниеОтчета);");
	КонецЕсли;
	
КонецПроцедуры	

// Функция формирует представление заголовка документа
//
// Возвращаемое значение:
//  Строка - представление номера документа
//
Функция _СформироватьЗаголовокДокумента(ДокументОбъект, НазваниеДокумента = "") Экспорт

	Если ДокументОбъект = Неопределено Тогда
		Возврат "";
	Иначе
		Возврат ?(НЕ ЗначениеЗаполнено(НазваниеДокумента), ДокументОбъект.Метаданные().Синоним, НазваниеДокумента) + " № " + СокрЛП(ДокументОбъект.Номер)
		                          + " от " + Формат(ДокументОбъект.Дата, "ДФ='дд ММММ гггг'") + " г.";
	КонецЕсли;

КонецФункции // СформироватьЗаголовокДокумента()

Функция ОбработкаУдаленияОбъектов(ЭтотОбъект) Экспорт
	
	Если ЭтотОбъект.ПометкаУдаления Тогда
		Возврат Ложь;
	Иначе	
		Сообщить("Запрещено удалять не помеченные на удаление объекты", СтатусСообщения.Важное);
		Возврат Истина;	
	КонецЕсли;
	
КонецФункции

// Процедура вызова структуры подчиненности документа
//
Процедура _ПоказатьСтруктуруПодчиненностиДокумента(Ссылка) Экспорт
	
	ИдКонф = _ИДКонфигурации();
	
	ТекстОшибки = "Для данной конфигурации """ + ИдКонф + """ функционал не поддерживается";
	
	Если Метаданные.ОбщиеМодули.Найти("РаботаСДиалогами") <> Неопределено Тогда
		Попытка
			Если Метаданные.ОбщиеМодули.РаботаСДиалогами.Глобальный Тогда
            	Выполнить("ПоказатьСтруктуруПодчиненностиДокумента(Ссылка);");
			Иначе
				Выполнить("РаботаСДиалогами.ПоказатьСтруктуруПодчиненностиДокумента(Ссылка);");
			КонецЕсли;	
		Исключение
			Сообщить(ТекстОшибки + ": " + Символы.ПС + ОписаниеОшибки());
		КонецПопытки;	
	Иначе
		Сообщить(ТекстОшибки);
	КонецЕсли;	
	
КонецПроцедуры

// возвращает идентификатор конфигурации
Функция _ИДКонфигурации() Экспорт
	
	МетаданныеИмя = Метаданные.Имя;
	Если МетаданныеИмя = "БухгалтерияПредприятия" ИЛИ 
		МетаданныеИмя = "БухгалтерияПредприятияБазовая" ИЛИ 
		МетаданныеИмя = "Общепит1С" ИЛИ 
		МетаданныеИмя = "БухАЛКО" ИЛИ 
		МетаданныеИмя = "БухгалтерияСельскохозяйственногоПредприятия" ИЛИ 
		МетаданныеИмя = "HRS_Back_Office" ИЛИ
		МетаданныеИмя = "ТрактиръBackOfficeProf" Тогда
		Возврат "БП";
	ИначеЕсли МетаданныеИмя = "ЗарплатаИУправлениеПерсоналом" ИЛИ МетаданныеИмя = "ЗарплатаИУправлениеПерсоналомБазовая" ИЛИ МетаданныеИмя = "ЗарплатаИУправлениеПерсоналомКОРП" Тогда
		Возврат "ЗУП";
	ИначеЕсли Лев(МетаданныеИмя, 19) = "УправлениеТорговлей" ИЛИ МетаданныеИмя = "АгентПлюсУправлениеТорговлей" ИЛИ МетаданныеИмя = "УТКредо" ИЛИ МетаданныеИмя = "УправлениеТорговымПредприятиемДляУкраины" Тогда
		Возврат "УТ";
	ИначеЕсли МетаданныеИмя = "СКАТ" Тогда
		Возврат "СКАТ";
	ИначеЕсли МетаданныеИмя = "KT2000_Alcohol_Trade" ИЛИ МетаданныеИмя = "KT2000_Alcohol_Complex" ИЛИ МетаданныеИмя = "KT2000_Alcohol_PBK" ИЛИ МетаданныеИмя = "KT2000_Alcohol_Mnfc" Тогда	
		Возврат "УТАП";	
	ИначеЕсли Лев(МетаданныеИмя, 7) = "Розница" Тогда
		Возврат "Р";
	ИначеЕсли МетаданныеИмя = "КомплекснаяАвтоматизация" ИЛИ МетаданныеИмя = "УправлениеПроизводственнымПредприятием" 
		ИЛИ МетаданныеИмя = "КомплексныйУчетСельхозПредприятия" ИЛИ МетаданныеИмя = "УправлениеСельскохозяйственнымПредприятием"
		ИЛИ МетаданныеИмя = "Молокозавод" ИЛИ МетаданныеИмя = "Мясокомбинат" Тогда
		Возврат "КА";
	ИначеЕсли МетаданныеИмя = "БухгалтерияБюджетногоУчреждения" ИЛИ МетаданныеИмя = "БухгалтерияБюджетногоУчрежденияБазовая" Тогда
		Возврат "ББУ";
	ИначеЕсли МетаданныеИмя = "БухгалтерияГосударственногоУчреждения" ИЛИ МетаданныеИмя = "БухгалтерияГосударственногоУчрежденияБазовая" Тогда
		Возврат "БГУ";
	ИначеЕсли МетаданныеИмя = "ЗарплатаИКадрыБюджетногоУчреждения" ИЛИ МетаданныеИмя = "БазоваяФункциональностьКадрыЗарплата" Тогда
		Возврат "ЗБУ";
	ИначеЕсли МетаданныеИмя = "БухгалтерияПредприятияКОРП" Тогда
		Возврат "БПКОРП";
	ИначеЕсли МетаданныеИмя = "БухгалтерияАвтономногоУчрежденияКОРП" Тогда
		Возврат "БАУКОРП";
	ИначеЕсли МетаданныеИмя = "БухгалтерияАвтономногоУчреждения" ИЛИ МетаданныеИмя = "БухгалтерияАвтономногоУчрежденияБазовая" Тогда
		Возврат "БАУ";
	ИначеЕсли Лев(МетаданныеИмя, 8) = "Трактиръ" Тогда
		Возврат "ТЪ"; 
	ИначеЕсли МетаданныеИмя = "ВашМагазин" ИЛИ МетаданныеИмя = "ТорговыйДом" ИЛИ МетаданныеИмя = "Ресторан" Тогда
		Возврат "АВМ"; 	
	ИначеЕсли Найти(МетаданныеИмя, "ДАЛИОНУправлениеМагазином") > 0 Тогда
		Возврат "ДЛН";
	ИначеЕсли Найти(МетаданныеИмя, "УправлениеНебольшойФирмой") > 0 Тогда
		Возврат "УНФ";	
	ИначеЕсли Найти(МетаданныеИмя, "ККСКомплексУправленияТорговлей") > 0 Тогда
		Возврат "КУТ";
	ИначеЕсли Найти(МетаданныеИмя, "Штрих") > 0 Тогда
		Возврат "ШМ";	
	Иначе
		Возврат МетаданныеИмя;
	КонецЕсли;
	
КонецФункции // ИДКонфигурации()

// возвращает версию конфигурации
Функция ОпределитьВерсиюКонфигурации() Экспорт
	
	ИДКонфигурации = _ИДКонфигурации();
	
	ВерсияКонфигурации = "";
	
	Если Метаданные.Синоним = "Управление торговлей, редакция 10.2" Тогда
		ВерсияКонфигурации = "10.2";
	ИначеЕсли ИДКонфигурации = "УТ" И Метаданные.Документы.Найти("БИТ_СборочныйЛист") <> Неопределено Тогда		
		ВерсияКонфигурации = "БИТ";	
	ИначеЕсли ИДКонфигурации = "УТ" И (Метаданные.РегистрыСведений.Найти("ЛицензииПоставщиковАлкогольнойПродукции") = Неопределено ИЛИ Метаданные.Имя = "УправлениеТорговлейБазовая") Тогда
		ВерсияКонфигурации = "Базовая";
	ИначеЕсли ИДКонфигурации = "КА" И Метаданные.Справочники.Найти("СигмаЦАУЛицензииАлкогольнойПродукции") <> Неопределено Тогда
		ВерсияКонфигурации = "ЦАУ";
	ИначеЕсли ИДКонфигурации = "КА" И Метаданные.Перечисления.Найти("ДоработкаВидыОприходованияТоваров") <> Неопределено Тогда	
		ВерсияКонфигурации = "ДСД";	
	ИначеЕсли Метаданные.Имя = "УправлениеТорговымПредприятиемДляУкраины" Тогда
		ВерсияКонфигурации = "УТПУ";
	КонецЕсли;	
	
	Возврат ВерсияКонфигурации;
	
КонецФункции

// возвращает версию приложения 1С
Функция ОпределитьВерсиюПриложения() Экспорт
	
	СисИнфо = Новый СистемнаяИнформация;	
	Версия = СисИнфо.ВерсияПриложения;
	
	НомерПлатформы = СтрЗаменить(Лев(Версия, 3), ".", "");
	
	Если Лев(Версия, 6) = "8.2.19" Тогда
		НомерПлатформы = "83";	
	КонецЕсли;	
	
	ВерсияПриложения = 81;
	Попытка
		ВерсияПриложения = Число(НомерПлатформы);	
	Исключение КонецПопытки;

	Возврат ВерсияПриложения;
	
КонецФункции

// Процедура изменения доступности "ручного" изменения кода/номера объекта
//
// Параметры
//  МетаданныеОбъекта  - метаданные объекта.
//  ФормаОбъекта      - форма объекта.
//  ПодменюДействия - меню "Действия" командной панели формы. В этот меню должен присутствовать пункт "Редактировать код/номер"
//  ПолеВводаНомера - поле вводе, связанное с кодом/номером объекта
//	ПолеВводаНомераДубль - необязательный параметр, необходим в случаях, когда код/номер одновременно связан с двумя элементами формы
//	КодНомерСтрокой - необязательный параметр, позволяет задать переназначить имя кода/номера при выводе запроса на подтверждение
//
Процедура _ИзменениеВозможностиРедактированияНомера(МетаданныеОбъекта, ФормаОбъекта, ПодменюДействия, ПолеВводаНомера, ПолеВводаНомераДубль = Неопределено, ТекстВопроса = "") Экспорт
	
	Кнопка = ПодменюДействия.Кнопки.РедактироватьКодНомер;
	Если НЕ Кнопка.Пометка Тогда
		
		Если ПустаяСтрока(ТекстВопроса) Тогда			
			Если ВРЕГ(ПолеВводаНомера.Данные) = ВРЕГ("Код") Тогда
				ТекстВопроса = "Код присваивается автоматически при записи элемента, самостоятельное его редактирование может привести к нарушению в нумерации в системе. Вы действительно хотите установить код вручную?"
			ИначеЕсли ВРЕГ(ПолеВводаНомера.Данные) = ВРЕГ("ВерсияФормата") Тогда
				ТекстВопроса = "Версия формата присваивается автоматически при запросе данных по контрагенту в ЕГАИС, самостоятельное его редактирование может привести к расхождению данных в ЕГАИС и 1С. Вы действительно хотите установить версию формата вручную?"	
			Иначе
				ТекстВопроса = "Номер документу присваивается автоматически при записи, самостоятельное его редактирование может привести к нарушению в нумерации в системе. Вы действительно хотите установить номер вручную?"
			КонецЕсли;
		КонецЕсли;		
		
		#Если Клиент Тогда
		Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;	
		#КонецЕсли
	КонецЕсли;
	Кнопка.Пометка = Не Кнопка.Пометка;
	ПолеВводаНомера.ТолькоПросмотр = НЕ Кнопка.Пометка;
	ПолеВводаНомера.РедактированиеТекста = Кнопка.Пометка;
	ПолеВводаНомера.ПропускатьПриВводе = ПолеВводаНомера.ТолькоПросмотр;	
	_ОбновитьПодсказкуКодНомерОбъекта(МетаданныеОбъекта, ПодменюДействия, ПолеВводаНомера);
	
	Если ПолеВводаНомераДубль <> Неопределено Тогда
		ПолеВводаНомераДубль.ТолькоПросмотр = ПолеВводаНомера.ТолькоПросмотр;
		ПолеВводаНомераДубль.ПропускатьПриВводе = ПолеВводаНомераДубль.ТолькоПросмотр;
		_ОбновитьПодсказкуКодНомерОбъекта(МетаданныеОбъекта, ПодменюДействия, ПолеВводаНомераДубль);
	КонецЕсли;	
	
КонецПроцедуры // ИзменениеВозможностиРедактированияНомера()

//	Процедура обновления текста подсказки для поля ввода кода/номера
//
// Параметры
//	МетаданныеОбъекта - метаданные объекта
//  ПолеВводаНомера - поле вводе, связанное с кодом/номером объекта
//  ПодменюДействия - меню "Действия" командной панели формы. В этот меню должен присутствовать пункт "Редактировать код/номер"
//
Процедура _ОбновитьПодсказкуКодНомерОбъекта(МетаданныеОбъекта, ПодменюДействия, ПолеВводаНомера) Экспорт
	УстановитьПодсказкуПоляВводаКодаНомера(ПолеВводаНомера, ПодменюДействия);
КонецПроцедуры // ОбновитьПодсказкуКодНомерОбъекта()

//	Процедура установки текста подсказки для поля ввода кода/номера в зависимости от стратегии редактирования
//	и введенного значения
//
// Параметры
//  ПолеВводаНомера - поле вводе, связанное с кодом/номером объекта
//  ПодменюДействия - меню "Действия" командной панели формы. В этот меню должен присутствовать пункт "Редактировать код/номер"
//	СтратегияРедактирования - стратегия автонумерации объекта
//
Процедура УстановитьПодсказкуПоляВводаКодаНомера(ПолеВводаНомера, ПодменюДействия)
		
	КодНомерСтрокой = ПолеВводаНомера.Данные;		
	
	Если ТипЗнч(ПолеВводаНомера) = Тип("ПолеВвода") Тогда
		ПолеВвода = ПолеВводаНомера;
	Иначе
		ПолеВвода = ПолеВводаНомера.ЭлементУправления;
	КонецЕсли;	
	
	Если ПустаяСтрока(ПолеВвода.Значение) Тогда
		ПолеВвода.Подсказка =  КодНомерСтрокой + " будет присвоен при записи объекта.";
	Иначе
		ПолеВвода.Подсказка =  "";
	КонецЕсли;
	
	Если ПустаяСтрока(ПолеВвода.Подсказка) Тогда
		Если КодНомерСтрокой = "Номер" Тогда
			ПолеВвода.Подсказка = "Номер документа";
		Иначе
			ПолеВвода.Подсказка = "Код справочника";
		КонецЕсли;			
	КонецЕсли;
	
КонецПроцедуры // УстановитьПодсказкуПоляВводаКодаНомера()

// установка заголовка документа
Процедура астУстановитьЗаголовокФормыДокумента(ОбработкаОбъект, ФормаДокумента) Экспорт

	ФормаДокумента.АвтоЗаголовок = Ложь; // заголовок будем писать сами
	
	Заголовок = Строка(ОбработкаОбъект);
	
	Если ОбработкаОбъект.ЭтоНовый() Тогда  
		Заголовок = Заголовок + ": Новый";
	Иначе
		Если ОбработкаОбъект.Проведен Тогда
			Заголовок = Заголовок + ": Проведен";
		ИначеЕсли ОбработкаОбъект.Метаданные().Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
			Заголовок = Заголовок + ": Не проведен";
		Иначе
			Заголовок = Заголовок + ": Записан";
		КонецЕсли;
	КонецЕсли;
	
	ФормаДокумента.Заголовок = Заголовок;

КонецПроцедуры 

// Процедура заполняет колонку Номенклатура в документе по соответствию товаров в регистре
Процедура ЗаполнитьНоменклатуру1С_ВДокументеПоСоответствию(ТаблицаТоваров) Экспорт
	
	//Серия не заполняется, поскольку подразумевается, что она будет почти всегда новая при каждом проступлении
	Запрос = Новый Запрос;	
	Запрос.Текст =	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	астСоответствиеНоменклатурыМеркурий.ПродукцияМеркурий,
	|	астСоответствиеНоменклатурыМеркурий.Номенклатура,
	|	астСоответствиеНоменклатурыМеркурий.ХарактеристикаНоменклатуры
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрСведений.астСоответствиеНоменклатурыМеркурий КАК астСоответствиеНоменклатурыМеркурий
	|ГДЕ
	|	астСоответствиеНоменклатурыМеркурий.ПродукцияМеркурий В(&ПродукцияМеркурий)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	астСоответствиеНоменклатурыМеркурий.ПродукцияМеркурий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ПродукцияМеркурий,
	|	ВТ.Номенклатура,
	|	ВТ.ХарактеристикаНоменклатуры
	|ИЗ
	|	ВТ КАК ВТ";
	Запрос.УстановитьПараметр("ПродукцияМеркурий", ТаблицаТоваров.ВыгрузитьКолонку("ПродукцияМеркурий"));
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выгрузить();
	
	Для Каждого СтрокаТовары Из ТаблицаТоваров Цикл
		Если ЗначениеЗаполнено(СтрокаТовары.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		Поиск = Выборка.Найти(СтрокаТовары.ПродукцияМеркурий, "ПродукцияМеркурий");
		Если Поиск <> Неопределено Тогда
			СтрокаТовары.Номенклатура = Поиск.Номенклатура;
			СтрокаТовары.ХарактеристикаНоменклатуры = Поиск.ХарактеристикаНоменклатуры;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	

// Процедура записывает в регистр сделанные соответствия в документе
Процедура ЗаписатьСоответствияТоваровИзДокумента(ТаблицаТоваров) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	астСоответствиеНоменклатурыМеркурий.ПродукцияМеркурий,
	|	астСоответствиеНоменклатурыМеркурий.Номенклатура,
	|	астСоответствиеНоменклатурыМеркурий.ХарактеристикаНоменклатуры
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрСведений.астСоответствиеНоменклатурыМеркурий КАК астСоответствиеНоменклатурыМеркурий
	|ГДЕ
	|	астСоответствиеНоменклатурыМеркурий.Номенклатура В(&Номенклатура)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	астСоответствиеНоменклатурыМеркурий.Номенклатура,
	|	астСоответствиеНоменклатурыМеркурий.ХарактеристикаНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ПродукцияМеркурий,
	|	ВТ.ПродукцияМеркурий.GUID КАК ПродукцияМеркурийКод,
	|	ВТ.Номенклатура,
	|	ВТ.ХарактеристикаНоменклатуры
	|ИЗ
	|	ВТ КАК ВТ";
	Запрос.УстановитьПараметр("Номенклатура", ТаблицаТоваров.ВыгрузитьКолонку("Номенклатура"));
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выгрузить();
	
	Для каждого СтрокаТовары Из ТаблицаТоваров Цикл	
		НеУстанавливать = Ложь;
		
		Поиск = Выборка.НайтиСтроки(Новый Структура("Номенклатура, ХарактеристикаНоменклатуры", СтрокаТовары.Номенклатура, СтрокаТовары.ХарактеристикаНоменклатуры));
		Если Поиск.Количество() > 0 Тогда
			Для Каждого СтрокаПоиска Из Поиск Цикл
				Если НЕ СтрокаПоиска.ПродукцияМеркурий = СтрокаТовары.ПродукцияМеркурий Тогда
					#Если Клиент Тогда
						Если Вопрос("Для строки "+СтрокаТовары.НомерСтроки + " уже установлено соответствие с продукцией Меркурий: " + СтрокаПоиска.ПродукцияМеркурий + " (" + СтрокаПоиска.ПродукцияМеркурийКод + ")
							|Установить новое соответствие с товаром " + СтрокаТовары.ПродукцияМеркурий + " (" + СтрокаТовары.ПродукцияМеркурий.GUID + ")", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
							Сообщить("Для строки "+СтрокаТовары.НомерСтроки + " уже установлено соответствие с продукцией Меркурий: " + СтрокаПоиска.ПродукцияМеркурий + " (" + СтрокаПоиска.ПродукцияМеркурийКод + ")");
							НеУстанавливать = Истина;
							Продолжить;
						КонецЕсли;
					#Иначе
						Сообщить("Для строки "+СтрокаТовары.НомерСтроки + " уже установлено соответствие с продукцией Меркурий: " + СтрокаПоиска.ПродукцияМеркурий + " (" + СтрокаПоиска.ПродукцияМеркурийКод + ")");
						НеУстанавливать = Истина;
						Продолжить;
					#КонецЕсли
				Иначе
					Сообщить("Для строки "+СтрокаТовары.НомерСтроки + " уже установлено соответствие с продукцией Меркурий: " + СтрокаПоиска.ПродукцияМеркурий + " (" + СтрокаПоиска.ПродукцияМеркурийКод + ")");
					НеУстанавливать = Истина;
					Продолжить;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если НеУстанавливать Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТовары.Номенклатура) Тогда
			Номенклатура = СтрокаТовары.Номенклатура;
		Иначе
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаТовары.ХарактеристикаНоменклатуры) Тогда
			Характеристика = СтрокаТовары.ХарактеристикаНоменклатуры;
		Иначе
			Характеристика = Неопределено;
		КонецЕсли;
		
		мЗапись = РегистрыСведений.астСоответствиеНоменклатурыМеркурий.СоздатьМенеджерЗаписи();
		мЗапись.ПродукцияМеркурий = СтрокаТовары.ПродукцияМеркурий;
		мЗапись.Номенклатура = Номенклатура;
		мЗапись.ХарактеристикаНоменклатуры = Характеристика;
		
		мЗапись.Записать(Истина);
		
		Сообщить("Установлено соответствие " + СтрокаТовары.ПродукцияМеркурий + " -> " + Номенклатура);
	КонецЦикла;

КонецПроцедуры

// возвращает уникальный идентификатор
Функция астПолучитьУИД() Экспорт
	
	ТекДата = ТекущаяДата();
	
	УИД = Новый УникальныйИдентификатор;
	УИД = СтрЗаменить(УИД, "-", "");
	УИД = СтрЗаменить(УИД, "0", "");
	УИД = СтрЗаменить(УИД, "a", "");
	УИД = СтрЗаменить(УИД, "b", "");
	УИД = СтрЗаменить(УИД, "c", "");
	УИД = СтрЗаменить(УИД, "d", "");
	УИД = СтрЗаменить(УИД, "e", "");
	УИД = СтрЗаменить(УИД, "f", "");
	УИД = астЭтоЧисло(Лев(УИД, 10));
	
	Если УИД = 0 Тогда // есть буквы в УИД
		ГСЧ = Новый ГенераторСлучайныхЧисел();
		УИД = ГСЧ.СлучайноеЧисло(1111111111, 9999999999);	
	КонецЕсли;	
	
	УИДДата = Год(ТекДата) + Месяц(ТекДата) + День(ТекДата) + Час(ТекДата) + Минута(ТекДата) + Секунда(ТекДата);
	
	УИДИтог = УИД + УИДДата;
	
	Возврат Формат(УИДИтог, "ЧГ=");
	
КонецФункции

// проверка параметра на число
Функция астЭтоЧисло(Знач Строка) Экспорт
	
	Попытка
		Число = Число(Строка);
	Исключение
		Число = 0;
	КонецПопытки;
	
	Возврат Число;
	
КонецФункции

// движение по регистру партий
Процедура ДвижениеПоРегиструПартийМеркурий(Движения, СтрокаТЧ, мДокумент, ВидДвижения, мКоличество, мПартия = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
		Товар = СтрокаТЧ.Номенклатура;
	Иначе
		Товар = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТЧ.СерияНоменклатуры) И мДокумент.НастройкаМеркурий.ВестиУчетПоСериям Тогда
		Серия = СтрокаТЧ.СерияНоменклатуры;
	Иначе
		Серия = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТЧ.ХарактеристикаНоменклатуры) И мДокумент.НастройкаМеркурий.ВестиУчетПоХарактеристикам Тогда
		Характеристика = СтрокаТЧ.ХарактеристикаНоменклатуры;
	Иначе
		Характеристика = Неопределено;
	КонецЕсли;		
	
	Движение = Движения.астПартииПродукцииМеркурий.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления[ВидДвижения];
	Движение.Период = мДокумент.Дата;
	Движение.Организация = мДокумент.Организация;
	Движение.ХозяйствующийСубъект = мДокумент.ХозяйствующийСубъект;
	Движение.Предприятие = мДокумент.Предприятие;
	//Если мДокумент.Метаданные().Реквизиты.Найти("Склад") <> Неопределено Тогда
	//	Движение.Склад = мДокумент.Склад;
	//КонецЕсли;
	Движение.НастройкаМеркурий = мДокумент.НастройкаМеркурий;
	Если мПартия = Неопределено Тогда
		Движение.ПартияПродукции = СтрокаТЧ.ПартияПродукции;
	Иначе
		Движение.ПартияПродукции = мПартия;
	КонецЕсли;
	Если СтрокаТЧ.ПродукцияМеркурий <> Движение.ПартияПродукции.ПродукцияМеркурий 
		И мДокумент.Ссылка.Метаданные().Имя <> "астКорректировкаОстатковПартийМеркурий" Тогда
		Движение.ПродукцияМеркурий = Движение.ПартияПродукции.ПродукцияМеркурий;
	Иначе	
		Движение.ПродукцияМеркурий = СтрокаТЧ.ПродукцияМеркурий;
	КонецЕсли;	
	Движение.Номенклатура = Товар;
	Движение.СерияНоменклатуры = Серия;
	Движение.ХарактеристикаНоменклатуры = Характеристика;
	Движение.Количество = мКоличество;
	
КонецПроцедуры	

// ПРЕОБРАЗОВАНИЕ XML В ФОРМАТ ДЕРЕВА

// если текст XML пришел в одну строку, либо не структурирован - преобразуется к стандартному удобному виду
Функция ПреобразоватьТекстXMLВСтандартныйВид(Знач ИмяФайла = Неопределено, ТекстXML = "") Экспорт
	
	Если ИмяФайла = Неопределено Тогда
		ИмяФайла = ПолучитьИмяВременногоФайла("xml");
		
		// запишем текст в файл
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст(ТекстXML);
		Текст.Записать(ИмяФайла, КодировкаТекста.UTF8);
	КонецЕсли;
	
	Попытка
		// сначала читаем исходный XML
		ЧтениеXML = Новый ЧтениеXML();
		ЧтениеXML.ОткрытьФайл(ИмяФайла);
		СтруктураФайла = РазобратьXML(ЧтениеXML);
		ЧтениеXML.Закрыть();
		
		// записываем преобразованный
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку(СтруктураФайла.Кодировка);
		СобратьXML(СтруктураФайла, ЗаписьXML);
		
		Возврат ЗаписьXML.Закрыть();
	Исключение
		Возврат ТекстXML;
	КонецПопытки;
	
КонецФункции	

Функция РазобратьXML(ЧтениеXML)
	
	ДеревоXML = Новый ДеревоЗначений();
	ДеревоXML.Колонки.Добавить("Имя");
	ДеревоXML.Колонки.Добавить("Значение");
	ДеревоXML.Колонки.Добавить("Атрибуты");
	ДеревоXML.Колонки.Добавить("Тип");
	
	СтруктураФайла = Новый Структура();
	СтруктураФайла.Вставить("Кодировка", 	ЧтениеXML.КодировкаИсточника);
	СтруктураФайла.Вставить("СтруктураXML", ДеревоXML);
	
	РазобратьXMLРекурсия(ЧтениеXML, ДеревоXML.Строки);	
	
	Возврат СтруктураФайла;
	
КонецФункции

Процедура РазобратьXMLРекурсия(ЧтениеXML, СтрокиДерева, Знач ТекСтрока = Неопределено)
	
	Попытка
		Пока ЧтениеXML.Прочитать() Цикл
			Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				ТекСтрока = СтрокиДерева.Добавить();
				ТекСтрока.Имя = ЧтениеXML.Имя;
				
				ТекСтрока.Атрибуты = Новый Соответствие();
				Если ЧтениеXML.КоличествоАтрибутов() > 0 Тогда
					Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
						ТекСтрока.Атрибуты.Вставить(ЧтениеXML.Имя, ЧтениеXML.Значение);
					КонецЦикла
				КонецЕсли;
				РазобратьXMLРекурсия(ЧтениеXML, ТекСтрока.Строки, ТекСтрока);
			ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
				ТекСтрока.Значение = ЧтениеXML.Значение;
			ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.ОбъявлениеXML Тогда
				ТекСтрока = СтрокиДерева.Добавить();
				ТекСтрока.Имя = ЧтениеXML.Имя;
				ТекСтрока.Тип = ТипУзлаXML.ОбъявлениеXML;
			ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.ИнструкцияОбработки Тогда
				ТекСтрока.Значение = ЧтениеXML.Значение;
			ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
				Возврат;	
			КонецЕсли;	
		КонецЦикла;
	Исключение 
		Возврат;	
	КонецПопытки;
	
КонецПроцедуры

Функция СобратьXML(СтруктураФайла, ЗаписьXML)
	
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	СобратьXMLРекурсия(СтруктураФайла.СтруктураXML, ЗаписьXML, СтруктураФайла.СтруктураXML.Строки);	
	
КонецФункции

Процедура СобратьXMLРекурсия(СтруктураXML, ЗаписьXML, СтрокиДерева)
	
	Для Каждого Строка Из СтрокиДерева Цикл
		Если Строка.Тип = Неопределено Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента(Строка.Имя);
			Для Каждого СтрАтрибут ИЗ Строка.Атрибуты Цикл
				ЗаписьXML.ЗаписатьАтрибут(СтрАтрибут.Ключ, СтрАтрибут.Значение);
			КонецЦикла;
			Если Строка.Значение <> Неопределено Тогда
				ЗаписьXML.ЗаписатьТекст(Строка.Значение);
			КонецЕсли;
			СобратьXMLРекурсия(СтруктураXML, ЗаписьXML, Строка.Строки);
			
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Меркурий

// заполнение вида, группы, типа продукции в документах
Процедура ЗаполнитьДанныеПродукцииМеркурий(СтрокаПродукции) Экспорт
	
	СтрокаПродукции.ВидПродукции 	= СтрокаПродукции.ПродукцияМеркурий.Владелец;
	СтрокаПродукции.ГруппаПродукции = СтрокаПродукции.ВидПродукции.Владелец;
	СтрокаПродукции.ТипПродукции 	= СтрокаПродукции.ГруппаПродукции.Владелец;
	
КонецПроцедуры	

Процедура ОчиститьСтарыеДвиженияДокумента(СписокРегистров, Ссылка) Экспорт
	
	Для Каждого Сч Из СписокРегистров Цикл
		Если Метаданные.РегистрыНакопления.Найти(Сч) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Набор = РегистрыНакопления[Сч].СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Ссылка);
		Попытка
			Набор.Записать();
		Исключение
			// возможно «сработал» RLS или механизм даты запрета изменения
			Сообщить("Операция не выполнена: " + ОписаниеОшибки());
			Отказ = Истина;
		КонецПопытки;		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОткрытьФормуПодбораПартий(ТекДанные, Организация, Предприятие, НастройкаМеркурий, Дата, ПродукцияМеркурий = Неопределено, ЕстьСерия = Истина, ТаблицаПартий = Неопределено, БылВыборЗначения = Ложь) Экспорт
	
	МножественныйПодбор = ТаблицаПартий <> Неопределено;
	
	Форма = Документы.астТранспортнаяПартияМеркурий.ПолучитьФорму("ФормаПодбораПартии");
	Если ПродукцияМеркурий = Неопределено Тогда
		Форма.ПродукцияМеркурий = ТекДанные.ПродукцияМеркурий;
	Иначе
		Если ТипЗнч(ПродукцияМеркурий) = Тип("СправочникСсылка.астПродукцияМеркурий") Тогда
			Форма.ПродукцияМеркурий = ПродукцияМеркурий;
		ИначеЕсли ТипЗнч(ПродукцияМеркурий) = Тип("СправочникСсылка.астВидыПродукцииМеркурий") Тогда
			Форма.ВидПродукции = ПродукцияМеркурий;
			Форма.ПродукцияМеркурий = Справочники.астПродукцияМеркурий.ПустаяСсылка();
		ИначеЕсли ТипЗнч(ПродукцияМеркурий) = Тип("СправочникСсылка.астГруппыПродукцииМеркурий") Тогда
			Форма.ГруппаПродукции = ПродукцияМеркурий;
			Форма.ПродукцияМеркурий = Справочники.астПродукцияМеркурий.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;	
	Если ЕстьСерия Тогда
		Форма.СерияНоменклатуры = ТекДанные.СерияНоменклатуры;
		Форма.ХарактеристикаНоменклатуры = ТекДанные.ХарактеристикаНоменклатуры;
	КонецЕсли;	
	Форма.Организация = Организация;
	Форма.Предприятие = Предприятие;
	Форма.ДатаОстатков = Дата;
	Форма.НастройкаМеркурий = НастройкаМеркурий;
	Форма.МножественныйПодбор = МножественныйПодбор;
	
	Форма.ТекущаяСтрока = ТекДанные;
	
	Значение = Форма.ОткрытьМодально();
	Если Значение <> Неопределено Тогда
		БылВыборЗначения = Истина;
		Если МножественныйПодбор Тогда
			Для Каждого Строка Из Значение Цикл
				Если ТаблицаПартий.Найти(Строка.ПартияПродукции, "ПартияПродукции") <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Запись = ТаблицаПартий.Добавить();
				Запись.ПартияПродукции = Строка.ПартияПродукции;
				ЗаполнитьЗначенияСвойств(Запись, Запись.ПартияПродукции);			
			КонецЦикла;
		Иначе	
			ТекДанные.ПартияПродукции = Значение.ПартияПродукции;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

// заполнение упаковки в документах
Процедура ЗаполнитьТаблицуУпаковокДокумента(НастройкаМеркурий, Запись, ИмяТаблицы, Док, БратьМаркировкуИзСтроки = Ложь, ТаблицаМаркировки = Неопределено, КоличествоШт = 0) Экспорт
		
	Если ТипЗнч(Док) = Тип("ДокументОбъект.астОбъединениеПартийМеркурий") Тогда
		ИмяРеквизитаПродукции = "ПродукцияОбъединение";	
	Иначе
		Если НастройкаМеркурий.НеЗаполнятьУпаковкиВИсходящихТТН Тогда
			Возврат;	
		КонецЕсли;

		ИмяРеквизитаПродукции = "ПродукцияМеркурий";	
	КонецЕсли;

	Для Каждого Строка Из ИмяТаблицы Цикл 
		Если НЕ ЗначениеЗаполнено(Строка.Уровень) Тогда
			Продолжить;
		КонецЕсли;
		
		// если есть штуки, берем только их
		Если КоличествоШт > 0 Тогда
			Если Строка.ВидУпаковки <> "Штука" Тогда
				Продолжить;
			КонецЕсли;	
			
			ЗаписьУпаковки = Док.Упаковки.Добавить();
			ЗаписьУпаковки.ВидУпаковки = Строка.ВидУпаковки;			
			ЗаписьУпаковки.Уровень = Строка.Уровень;
			ЗаписьУпаковки.Количество = КоличествоШт;
			ЗаписьУпаковки.КлючСтроки = Запись.КлючСтроки;
		Иначе	
			Количество = 0;
			Если ЗначениеЗаполнено(Строка.КоличествоПоУмолчанию) Тогда
				Количество = Строка.КоличествоПоУмолчанию;
			ИначеЕсли ЗначениеЗаполнено(Строка.КоэффициентУпаковки) Тогда
				Количество = Запись.Количество / Строка.КоэффициентУпаковки;
				Если Цел(Количество) <> Количество Тогда
					Количество = Цел(Количество) + 1;
				КонецЕсли;	
			КонецЕсли;
			
			Если Количество = 0 Тогда
				Продолжить;
			КонецЕсли;	
			
			ЗаписьУпаковки = Док.Упаковки.Добавить();
			ЗаписьУпаковки.ВидУпаковки = Строка.ВидУпаковки;			
			ЗаписьУпаковки.Уровень = Строка.Уровень;
			ЗаписьУпаковки.Количество = Количество;
			ЗаписьУпаковки.КлючСтроки = Запись.КлючСтроки;
		КонецЕсли;
		
		// маркировка
		МаркировкаЗаполнена = Ложь;
		Если ТаблицаМаркировки <> Неопределено Тогда
			ПоискМаркировки = ТаблицаМаркировки.НайтиСтроки(Новый Структура("Уровень", Строка.Уровень));
			Если ПоискМаркировки.Количество() > 0 Тогда
				Для Каждого СтрокаМаркировки Из ПоискМаркировки Цикл
					ЗаписьМаркировка = Док.Маркировка.Добавить();
					ЗаписьМаркировка.Уровень = Строка.Уровень;
					ЗаписьМаркировка.КлючСтроки = Запись.КлючСтроки;
					ЗаписьМаркировка.ТипМаркировки = СтрокаМаркировки.ТипМаркировки;
					ЗаписьМаркировка.Маркировка = СтрокаМаркировки.Маркировка;
					
					МаркировкаЗаполнена = Истина;
				КонецЦикла;	
			КонецЕсли;	
		КонецЕсли;
		
		ТекстМаркировки = "";
		Если БратьМаркировкуИзСтроки Тогда		
			Если НЕ МаркировкаЗаполнена Тогда
				ТекстМаркировки = Строка.МаркировкаПродукции;
				Если НЕ ЗначениеЗаполнено(ТекстМаркировки) Тогда
					ТекстМаркировки = ПолучитьМаркировкуПродукцииПоУмолчанию(Док.Предприятие, НастройкаМеркурий, Запись[ИмяРеквизитаПродукции]);
				КонецЕсли;	
			КонецЕсли;
		Иначе	
			ТекстМаркировки = ПолучитьМаркировкуПродукцииПоУмолчанию(Док.Предприятие, НастройкаМеркурий, Запись[ИмяРеквизитаПродукции]);
		КонецЕсли;
		
		Если НЕ МаркировкаЗаполнена И ЗначениеЗаполнено(ТекстМаркировки) Тогда  
			ЗаписьМаркировка = Док.Маркировка.Добавить();
			ЗаписьМаркировка.Уровень = Строка.Уровень;
			ЗаписьМаркировка.КлючСтроки = Запись.КлючСтроки;
			ЗаписьМаркировка.ТипМаркировки = Перечисления.астТипыМаркировкиУпаковокМеркурий.UNDEFINED;
			ЗаписьМаркировка.Маркировка = СокрЛП(ТекстМаркировки);	
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьМаркировкуПродукцииПоУмолчанию(ПредприятиеМеркурий, НастройкаМеркурий, мПродукцияМеркурий)
	
	мМаркировкаПродукцииПоУмолчанию = "";	
	Если ЗначениеЗаполнено(мПродукцияМеркурий.МаркировкаПоУмолчанию) Тогда
		мМаркировкаПродукцииПоУмолчанию = мПродукцияМеркурий.МаркировкаПоУмолчанию;
	ИначеЕсли ЗначениеЗаполнено(мПродукцияМеркурий.Владелец.МаркировкаПоУмолчанию) Тогда
		мМаркировкаПродукцииПоУмолчанию = мПродукцияМеркурий.Владелец.МаркировкаПоУмолчанию;
	ИначеЕсли ЗначениеЗаполнено(мПродукцияМеркурий.Владелец.Владелец.МаркировкаПоУмолчанию) Тогда
		мМаркировкаПродукцииПоУмолчанию = мПродукцияМеркурий.Владелец.Владелец.МаркировкаПоУмолчанию;
	ИначеЕсли ЗначениеЗаполнено(мПродукцияМеркурий.Владелец.Владелец.Владелец.МаркировкаПоУмолчанию) Тогда
		мМаркировкаПродукцииПоУмолчанию = мПродукцияМеркурий.Владелец.Владелец.Владелец.МаркировкаПоУмолчанию;
	Иначе
		мМаркировкаПродукцииПоУмолчанию = НастройкаМеркурий.МаркировкаПоУмолчанию;
	КонецЕсли;
	
	ЕстьПроизводство = Метаданные.Документы.Найти("астПроизводственнаяПартияМеркурий") <> Неопределено;
	Если НЕ ЗначениеЗаполнено(мМаркировкаПродукцииПоУмолчанию) И ЕстьПроизводство И НастройкаМеркурий.ВыгружатьПроизводителяВМаркировкуПоУмолчаниюПредприятиеОрганизации Тогда
		// ставим по умолчанию самого производителя
		мМаркировкаПродукцииПоУмолчанию = СокрЛП(ПредприятиеМеркурий.НаименованиеКраткое);
	КонецЕсли;	
	
	Возврат СокрЛП(мМаркировкаПродукцииПоУмолчанию);
	
КонецФункции

// открывает для выбора и просмотра ХС и предприятие
Процедура ОткрытьФормуНастройкиХСиПредприятия(мХозяйствующийСубъект, мПредприятие, ЭлементФормы, ТолькоПросмотр = Ложь) Экспорт
	
	Форма = ПолучитьОбщуюФорму("астФормаВыбораХСиПредприятияМеркурий");
	Форма.ХозяйствующийСубъект = мХозяйствующийСубъект;
	Форма.Предприятие = мПредприятие;
	Форма.ТолькоПросмотр = ТолькоПросмотр;
	Значение = Форма.ОткрытьМодально();
	Если Значение <> Неопределено Тогда
		ЕстьИзменения = Ложь;
		Если мХозяйствующийСубъект <> Значение.ХозяйствующийСубъект Тогда
			мХозяйствующийСубъект = Значение.ХозяйствующийСубъект;
			ЕстьИзменения = Истина;
		КонецЕсли;
		Если мПредприятие <> Значение.Предприятие Тогда
			мПредприятие = Значение.Предприятие;
			ЕстьИзменения = Истина;
		КонецЕсли;	
		
		Если ЕстьИзменения Тогда
			УстановитьЗаголовокХСиПредприятия(мХозяйствующийСубъект, мПредприятие, ЭлементФормы);
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры	

// устанавливает в надписи данные по ХС и предприятию на форме
Процедура УстановитьЗаголовокХСиПредприятия(мХозяйствующийСубъект, мПредприятие, ЭлементФормы) Экспорт
	
	ИмяЭФ = ЭлементФормы.Имя;
	ИмяЭФ = СтрЗаменить(ИмяЭФ, "ХСП", "");
	ИмяЭФ = СтрЗаменить(ИмяЭФ, "_", "");
	ИмяЭФ = ВРег(Лев(ИмяЭФ, 1)) + Сред(ИмяЭФ, 2);
	
	ЭлементФормы.Заголовок = ?(ЗначениеЗаполнено(ИмяЭФ), ИмяЭФ + ": ", "") + ?(ЗначениеЗаполнено(мХозяйствующийСубъект), СокрЛП(мХозяйствующийСубъект), "<...>") + ", " + ?(ЗначениеЗаполнено(мПредприятие), СокрЛП(мПредприятие), "<...>");
	Если НЕ ЗначениеЗаполнено(мХозяйствующийСубъект) ИЛИ НЕ ЗначениеЗаполнено(мПредприятие) Тогда
		ЭлементФормы.ЦветТекста = Новый Цвет(255, 0, 0);
		ЭлементФормы.ЦветФона = WebЦвета.ТусклоРозовый;
	Иначе
		ЭлементФормы.ЦветТекста = Новый Цвет(65, 48, 3);
		ЭлементФормы.ЦветФона = Новый Цвет(255, 255, 255);
	КонецЕсли;	
	
КонецПроцедуры

// возвращает список предприятий по ХС
Функция ПолучитьСписокПредприятийХС(ХозяйствующийСубъектМеркурий, Знач ПредприятиеМеркурий) Экспорт
	
	// найдем предприятия ХС
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	астПредприятияМеркурийХозяйствующиеСубъекты.Ссылка
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Справочник.астПредприятияМеркурий.ХозяйствующиеСубъекты КАК астПредприятияМеркурийХозяйствующиеСубъекты
	|ГДЕ
	|	астПредприятияМеркурийХозяйствующиеСубъекты.ХозяйствующийСубъект = &ХозяйствующийСубъект
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	астПредприятияМеркурий.Ссылка
	|ИЗ
	|	Справочник.астПредприятияМеркурий КАК астПредприятияМеркурий
	|ГДЕ
	|	астПредприятияМеркурий.ХозяйствующийСубъект = &ХозяйствующийСубъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ.Ссылка
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	НЕ ПОДСТРОКА(ВТ.Ссылка.Статус,1,1) = ""4""
	|	И НЕ ВТ.Ссылка.СтатусЦербер = ЗНАЧЕНИЕ(Перечисление.астСтатусыПредприятийЦерберМеркурий.CANCELED)
	|	И НЕ ВТ.Ссылка.СтатусЦербер = ЗНАЧЕНИЕ(Перечисление.астСтатусыПредприятийЦерберМеркурий.DELETED)
	|	И НЕ ВТ.Ссылка.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ.Ссылка.Наименование
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ХозяйствующийСубъект", ХозяйствующийСубъектМеркурий);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	// заполним реквизит формы
	Если ЗначениеЗаполнено(ПредприятиеМеркурий) Тогда
		Если ПредприятиеМеркурий.ХозяйствующийСубъект <> ХозяйствующийСубъектМеркурий Тогда
			ПредприятиеМеркурий = "";
		КонецЕсли;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПредприятиеМеркурий) Тогда
		Если Выборка.Количество() > 0 Тогда
			ПредприятиеМеркурий = Выборка.Получить(0);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Выборка;
	
КонецФункции	

// находим или создаем серию
Процедура ПолучитьСериюНоменклатуры(ИДКонфигурации, НастройкаМеркурий, СтрокаТовара, ЕстьИзменения = Ложь) Экспорт
	
	Если Метаданные.Справочники.Найти("СерииНоменклатуры") = Неопределено Тогда
		Сообщить("Для данной конфигурации заполнение не поддерживается");
		Возврат;
	КонецЕсли;

	Если НЕ НастройкаМеркурий.СоздаватьСерииВоВходящихТТН Тогда
		Сообщить("Не установлена настройка ""СоздаватьСерииВоВходящихТТН""");
		Возврат;
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
		Сообщить("В строке " + СтрокаТовара.НомерСтроки + " не заполнена номенклатура"); 
		Возврат;
	КонецЕсли;	
	Если ЗначениеЗаполнено(СтрокаТовара.СерияНоменклатуры) Тогда
		Сообщить("В строке " + СтрокаТовара.НомерСтроки + " уже заполнена серия номенклатуры");
		Возврат;
	КонецЕсли;	
	
	Если ИДКонфигурации = "УТ" ИЛИ ИДКонфигурации = "КА" Тогда
		Если НЕ СтрокаТовара.Номенклатура.ВестиУчетПоСериям Тогда
			Сообщить("Для номенклатуры " + СтрокаТовара.Номенклатура + " не ведется партионный учет по сериям", СтатусСообщения.Важное);
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(СтрокаТовара.ДатаВыработкиС) Тогда
		Сообщить("В строке " + СтрокаТовара.НомерСтроки + " не заполнена дата выработки с"); 
		Возврат;
	КонецЕсли;
	
	ДатаВыработки = НачалоДня(СтрокаТовара.ДатаВыработкиС);
	ДатаВыработкиПо = НачалоДня(СтрокаТовара.ДатаВыработкиПо);
	СрокГодности = НачалоДня(СтрокаТовара.СрокГодностиС);
	СрокГодностиПо = НачалоДня(СтрокаТовара.СрокГодностиПо);
	
	Если НастройкаМеркурий.ПриСозданииСерииНаименованиеБратьИзДатыВыработки Тогда
		СрокГодностиПоиск = ?(ЗначениеЗаполнено(ДатаВыработкиПо), НачалоДня(ДатаВыработкиПо), НачалоДня(ДатаВыработки));
	Иначе	
		СрокГодностиПоиск = ?(ЗначениеЗаполнено(СрокГодностиПо), НачалоДня(СрокГодностиПо), НачалоДня(СрокГодности));
	КонецЕсли;	
	
	Если Метаданные.Справочники.СерииНоменклатуры.Реквизиты.Найти("швв_ДатаВыработкиС") <> Неопределено И ЗначениеЗаполнено(СтрокаТовара.ПартияПродукции) Тогда
		НаименованиеСерии = СтрокаТовара.ПартияПродукции.НомерЗаписи + ", " + Формат(СрокГодностиПоиск, "ДФ=dd.MM.yy");
	Иначе
		НаименованиеСерии = Формат(СрокГодностиПоиск, "ДФ=dd.MM.yy");
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(НаименованиеСерии) Тогда
		Сообщить("Не заполнено наименование серии для " + СтрокаТовара.Номенклатура);
		Возврат;
	КонецЕсли;	
	
	//попробуем найти уже созданную серию
	Выборка = Справочники.СерииНоменклатуры.НайтиПоНаименованию(НаименованиеСерии, Истина, , СтрокаТовара.Номенклатура);
	Если Выборка.Пустая() Тогда
		НовСерия = Справочники.СерииНоменклатуры.СоздатьЭлемент();
		НовСерия.Наименование = НаименованиеСерии;
		НовСерия.Владелец = СтрокаТовара.Номенклатура;
		Если Метаданные.Справочники.СерииНоменклатуры.Реквизиты.Найти("СрокГодности") <> Неопределено Тогда
			НовСерия.СрокГодности = СрокГодности;
		КонецЕсли;
		Если Метаданные.Справочники.СерииНоменклатуры.Реквизиты.Найти("_ДатаИзготовления") <> Неопределено Тогда
			НовСерия._ДатаИзготовления = ДатаВыработки;
		КонецЕсли;
		Если Метаданные.Справочники.СерииНоменклатуры.Реквизиты.Найти("ДатаПроизводства") <> Неопределено Тогда
			НовСерия.ДатаПроизводства = ДатаВыработки;
		КонецЕсли;
		Если Метаданные.Справочники.СерииНоменклатуры.Реквизиты.Найти("СтранаПроисхождения") <> Неопределено Тогда
			Если СтрокаТовара.ПартияПродукции.СтранаПроисхожденияПродукции.КодАльфа2 = "RU" Тогда
				НовСерия.СтранаПроисхождения = Справочники.КлассификаторСтранМира.Россия;
			КонецЕсли;
		КонецЕсли;
		
		Если Метаданные.Справочники.СерииНоменклатуры.Реквизиты.Найти("швв_ДатаВыработкиС") <> Неопределено Тогда 
			НовСерия.СерийныйНомер = СтрокаТовара.ПартияПродукции.НомерЗаписи;
			НовСерия.швв_ДатаВыработкиС = ДатаВыработки;
			НовСерия.швв_ДатаВыработкиПо = ДатаВыработкиПо;
			Если ЗначениеЗаполнено(СрокГодностиПо) Тогда
				НовСерия.швв_СрокГодностиС = СрокГодности;
				НовСерия.СрокГодности = СрокГодностиПо;
			Иначе
				НовСерия.СрокГодности = СрокГодности;
			КонецЕсли;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(НастройкаМеркурий.ДатаВыработкиСерии) Тогда
			Если НЕ ЗначениеЗаполнено(НовСерия[НастройкаМеркурий.ДатаВыработкиСерии]) Тогда
				НовСерия[НастройкаМеркурий.ДатаВыработкиСерии] = ДатаВыработки;
			КонецЕсли;	
		КонецЕсли;	
		Если ЗначениеЗаполнено(НастройкаМеркурий.СрокГодностиСерии) Тогда
			Если НЕ ЗначениеЗаполнено(НовСерия[НастройкаМеркурий.СрокГодностиСерии]) Тогда
				НовСерия[НастройкаМеркурий.СрокГодностиСерии] = СрокГодности;
			КонецЕсли;	
		КонецЕсли;		

		// доп обработчик
		мПараметры = Новый Структура;
		мПараметры.Вставить("НастройкаМеркурий", НастройкаМеркурий);
		мПараметры.Вставить("ДопВнешняяОбработка", Неопределено);
		мПараметры.Вставить("ОбъектВладелец", Неопределено);
		мПараметры.Вставить("СерияНоменклатуры", НовСерия);
		мПараметры.Вставить("СтрокаТовараМеркурий", СтрокаТовара);
		ВыполнитьДопОбработчик("ПередЗаписьюСерииНоменклатуры", мПараметры);
		
		Попытка
			НовСерия.Записать();
			Сообщить("Создана серия " + НаименованиеСерии + " для " + СтрокаТовара.Номенклатура, СтатусСообщения.Информация);
		Исключение
			Сообщить("Ошибка создания серии для "  + СтрокаТовара.Номенклатура + ": " + ОписаниеОшибки(), СтатусСообщения.Важное);
			Возврат;
		КонецПопытки;
		
		СтрокаТовара.СерияНоменклатуры = НовСерия.Ссылка;
	Иначе
		СтрокаТовара.СерияНоменклатуры = Выборка.Ссылка;
	КонецЕсли;
	
	ЕстьИзменения = Истина;

КонецПроцедуры	

// возвращает найденное соответствие номенклатуры по guid продукции Меркурий
Функция НайтиНоменклатуруПоПродукцииМеркурий(КодПродукцииМеркурий, ЭтоПоискПоСсылке = Ложь) Экспорт
	
	мНоменклатура1С = Неопределено;
	
	Если ЭтоПоискПоСсылке Тогда
		Спр = КодПродукцииМеркурий.Ссылка;
	Иначе	
		Спр = Справочники.астПродукцияМеркурий.НайтиПоРеквизиту("GUID", КодПродукцииМеркурий);
	КонецЕсли;	
	Если Не Спр.Пустая() Тогда
		РС = РегистрыСведений.астСоответствиеНоменклатурыМеркурий.СоздатьНаборЗаписей();
		РС.Отбор.ПродукцияМеркурий.Установить(Спр);
		РС.Прочитать();
		
		Если РС.Количество() > 0 Тогда
			СтрокаРС = РС.Получить(0);
			мНоменклатура1С = СтрокаРС.Номенклатура;
		КонецЕсли;
	КонецЕсли;
	
	Возврат мНоменклатура1С;
	
КонецФункции	

// открытие формы списка номенклатуры
Процедура ОткрытьФормуЗаполненияСпискаНоменклатуры(ТекДанные, ИмяКлюча = "НомерСтроки", ПартииТоваровФактические, НастройкаМеркурий, Количество = Неопределено) Экспорт
	
	СтрокаКоличество = ?(Количество = Неопределено, ТекДанные.Количество, Количество);
	
	Форма = Документы.астТранспортнаяПартияМеркурий.ПолучитьФорму("ФормаЗаполненияНоменклатуры");
	Форма.ПродукцияМеркурий = ТекДанные.ПродукцияМеркурий;
	Форма.Номенклатура = ТекДанные.Номенклатура;
	Форма.СерияНоменклатуры = ТекДанные.СерияНоменклатуры;
	Форма.ХарактеристикаНоменклатуры = ТекДанные.ХарактеристикаНоменклатуры;
	Форма.Количество = СтрокаКоличество;
	Форма.ЕдиницаИзмерения = ТекДанные.ЕдиницаИзмерения;
	Форма.НастройкаМеркурий = НастройкаМеркурий;
	
	ОтборПартий = ПартииТоваровФактические.НайтиСтроки(Новый Структура("КлючСтроки", ТекДанные[ИмяКлюча])); 
	Если ОтборПартий.Количество() > 0 Тогда
		Для Каждого Строка Из ОтборПартий Цикл
			Запись = Форма.СписокНоменклатуры.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, Строка);
		КонецЦикла;
	Иначе
		Запись = Форма.СписокНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, ТекДанные);
		Запись.Количество = СтрокаКоличество;
	КонецЕсли;
	
	Значение = Форма.ОткрытьМодально();
	Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
		// удаляем старые записи
		Для Каждого Строка Из ОтборПартий Цикл
			ПартииТоваровФактические.Удалить(Строка);
		КонецЦикла;
		
		// добавляем новые
		Для Каждого Строка Из Значение Цикл
			Запись = ПартииТоваровФактические.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, Строка);
			Запись.КлючСтроки = ТекДанные[ИмяКлюча];
			Запись.ПродукцияМеркурий = ТекДанные.ПродукцияМеркурий;
		КонецЦикла;	
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ОткрытьФормуЗаполненияУпаковок(ТекДанные, Количество, Упаковки, Маркировка, НастройкаМеркурий) Экспорт
	
	Форма = Документы.астТранспортнаяПартияМеркурий.ПолучитьФорму("ФормаУпаковок");
	Форма.ПродукцияМеркурий = ТекДанные.ПродукцияМеркурий;
	Форма.Номенклатура = ТекДанные.Номенклатура;
	Форма.СерияНоменклатуры = ТекДанные.СерияНоменклатуры;
	Форма.ХарактеристикаНоменклатуры = ТекДанные.ХарактеристикаНоменклатуры;
	Форма.Количество = Количество;
	Форма.ЕдиницаИзмерения = ТекДанные.ЕдиницаИзмерения;
	Форма.НастройкаМеркурий = НастройкаМеркурий;
	
	ОтборСтрок = Упаковки.НайтиСтроки(Новый Структура("КлючСтроки", ТекДанные.КлючСтроки)); 
	Если ОтборСтрок.Количество() > 0 Тогда
		Для Каждого Строка Из ОтборСтрок Цикл
			Запись = Форма.ТаблицаУпаковок.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, Строка);
		КонецЦикла;
	КонецЕсли;
	
	Значение = Форма.ОткрытьМодально();
	Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
		// удаляем старые записи
		Для Каждого Строка Из ОтборСтрок Цикл
			Упаковки.Удалить(Строка);
		КонецЦикла;
		
		// добавляем новые
		Для Каждого Строка Из Значение Цикл
			Запись = Упаковки.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, Строка);
			Запись.КлючСтроки = ТекДанные.КлючСтроки;
		КонецЦикла;	
	КонецЕсли;	
	
КонецПроцедуры

Процедура ЗаполнитьСтрокуУпаковок(ОформлениеСтроки, ТаблицаУпаковок, БратьУровеньСсылка = Ложь) Экспорт
	
	ОформлениеСтроки.Ячейки.Упаковки.ОтображатьКартинку = Истина;
	ОформлениеСтроки.Ячейки.Упаковки.Картинка = БиблиотекаКартинок.Справочник;
	
	ИмяУровня = ?(БратьУровеньСсылка, "УровеньСсылка", "Уровень");
	
	ТекстУпаковок = "";
	Для Каждого СтрокаУпаковки Из ТаблицаУпаковок Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаУпаковки[ИмяУровня]) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстУпаковок = ТекстУпаковок + (Перечисления.астВидыУровнейУпаковокМеркурий.Индекс(СтрокаУпаковки[ИмяУровня]) + 1)
		+ "." + Лев(СтрокаУпаковки[ИмяУровня], 2) + СтрокаУпаковки.Количество + ?(ЗначениеЗаполнено(СтрокаУпаковки.МаркировкаПродукции), " " + СтрокаУпаковки.МаркировкаПродукции, "") + Символы.ПС;
	КонецЦикла;
	ТекстУпаковок = Лев(ТекстУпаковок, СтрДлина(ТекстУпаковок) - 1);
	
	ОформлениеСтроки.Ячейки.Упаковки.ОтображатьТекст = Истина;
	ОформлениеСтроки.Ячейки.Упаковки.Текст = ТекстУпаковок;
	
КонецПроцедуры

Процедура ОткрытьФормуУпаковок(ТекДанные, ЭтаФорма, Упаковки, Маркировка, ДанныеИзВСД = Ложь) Экспорт
	
	Форма = Документы.астТранспортнаяПартияМеркурий.ПолучитьФорму("ФормаУпаковок", ЭтаФорма);
	Если ДанныеИзВСД Тогда
		// берем данные из ВСД, не ТТН
		ЗаполнитьЗначенияСвойств(Форма, ТекДанные.ВСД);
		
		Для Каждого Строка Из ТекДанные.ВСД.Упаковки Цикл
			Запись = Форма.ТаблицаУпаковок.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, Строка);
		КонецЦикла;		
		
		Для Каждого СтрокаМаркировки Из ТекДанные.ВСД.Маркировка Цикл
			Запись = Форма.ТаблицаМаркировки.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, СтрокаМаркировки);
		КонецЦикла;
	Иначе	
		ЗаполнитьЗначенияСвойств(Форма, ТекДанные);
		
		ПоискУпаковок = Упаковки.НайтиСтроки(Новый Структура("КлючСтроки", ТекДанные.КлючСтроки));
		Для Каждого Строка Из ПоискУпаковок Цикл
			Запись = Форма.ТаблицаУпаковок.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, Строка);
		КонецЦикла;		
		
		ПоискМаркировки = Маркировка.НайтиСтроки(Новый Структура("КлючСтроки", ТекДанные.КлючСтроки));
		Для Каждого СтрокаМаркировки Из ПоискМаркировки Цикл
			Запись = Форма.ТаблицаМаркировки.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, СтрокаМаркировки);
		КонецЦикла;
	КонецЕсли;

	Значение = Форма.ОткрытьМодально();
	
	Если ТипЗнч(Значение) = Тип("Структура") И НЕ ДанныеИзВСД Тогда
		// удаляем старые записи
		Для Каждого Строка Из ПоискУпаковок Цикл
			Упаковки.Удалить(Строка);
		КонецЦикла;
		
		Для Каждого Строка Из ПоискМаркировки Цикл
			Маркировка.Удалить(Строка);
		КонецЦикла;
		
		// добавляем новые
		Для Каждого Строка Из Значение.ТаблицаУпаковок Цикл
			Запись = Упаковки.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, Строка);
			Запись.КлючСтроки = ТекДанные.КлючСтроки;
		КонецЦикла;	
		
		Для Каждого Строка Из Значение.ТаблицаМаркировки Цикл
			Запись = Маркировка.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, Строка);
			Запись.КлючСтроки = ТекДанные.КлючСтроки;
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры	

// получение имени сервера для доступа к нему
Функция ПолучитьИмяСервераМеркурий(НастройкаМеркурий) Экспорт
	
	Если НастройкаМеркурий.ЭтоТестовыйКонтур Тогда
		Возврат "https://t2-mercury.vetrf.ru";
	Иначе
		Возврат "https://mercury.vetrf.ru";
	КонецЕсли;
	
КонецФункции

// проверка остатков для документа
Функция ПроверитьОстаткиПартийПоДокументу(Ссылка) Экспорт
	
	ИмяДокумента = Ссылка.Метаданные().Имя;
	
	// проверим остатки
	Запрос = Новый Запрос;
	Если ИмяДокумента = "астИнвентаризацияМеркурий" Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	астТранспортнаяПартияМеркурий.ПродукцияМеркурий,
		|	астТранспортнаяПартияМеркурий.ПартияПродукции КАК ПартияПродукции,
		|	МИНИМУМ(астТранспортнаяПартияМеркурий.НомерСтроки) КАК НомерСтроки,
		|	СУММА(астТранспортнаяПартияМеркурий.Количество - астТранспортнаяПартияМеркурий.КоличествоФакт) КАК Количество
		|ПОМЕСТИТЬ Товары
		|ИЗ
		|	Документ.астИнвентаризацияМеркурий.ПартииПродукции КАК астТранспортнаяПартияМеркурий
		|ГДЕ
		|	астТранспортнаяПартияМеркурий.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	астТранспортнаяПартияМеркурий.ПродукцияМеркурий,
		|	астТранспортнаяПартияМеркурий.ПартияПродукции
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	астТранспортнаяПартияМеркурий.ПартияПродукции
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	астПартииПродукцииМеркурий.ПартияПродукции,
		|	астПартииПродукцииМеркурий.ПродукцияМеркурий,
		|	астПартииПродукцииМеркурий.КоличествоОстаток,
		|	астПартииПродукцииМеркурий.СерияНоменклатуры КАК СерияНоменклатуры,
		|	астПартииПродукцииМеркурий.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры
		|ПОМЕСТИТЬ ОстаткиОбщие
		|ИЗ
		|	РегистрНакопления.астПартииПродукцииМеркурий.Остатки(
		|			&МоментВремени,
		|			Организация = &Организация
		|				И Предприятие = &Предприятие
		|				И ПартияПродукции В
		|					(ВЫБРАТЬ
		|						Товары.ПартияПродукции
		|					ИЗ
		|						Товары КАК Товары)) КАК астПартииПродукцииМеркурий
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	астПартииПродукцииМеркурий.ПартияПродукции
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиОбщие.ПартияПродукции,
		|	ОстаткиОбщие.ПродукцияМеркурий,
		|	СУММА(ОстаткиОбщие.КоличествоОстаток) КАК КоличествоОстаток,
		|	ОстаткиОбщие.СерияНоменклатуры,
		|	ОстаткиОбщие.ХарактеристикаНоменклатуры
		|ПОМЕСТИТЬ Остатки
		|ИЗ
		|	ОстаткиОбщие КАК ОстаткиОбщие
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиОбщие.ПартияПродукции,
		|	ОстаткиОбщие.ПродукцияМеркурий,
		|	ОстаткиОбщие.СерияНоменклатуры,
		|	ОстаткиОбщие.ХарактеристикаНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиОбщие.ПартияПродукции,
		|	ОстаткиОбщие.ПродукцияМеркурий,
		|	СУММА(ОстаткиОбщие.КоличествоОстаток) КАК КоличествоОстаток
		|ПОМЕСТИТЬ ОстаткиБезСерии
		|ИЗ
		|	ОстаткиОбщие КАК ОстаткиОбщие
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиОбщие.ПартияПродукции,
		|	ОстаткиОбщие.ПродукцияМеркурий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Товары.ПродукцияМеркурий,
		|	Товары.ПартияПродукции,
		|	Товары.НомерСтроки,
		|	Товары.Количество
		|ПОМЕСТИТЬ ТоварыВсего
		|ИЗ
		|	Товары КАК Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиБезСерии КАК астПартииПродукцииМеркурий
		|		ПО Товары.ПартияПродукции = астПартииПродукцииМеркурий.ПартияПродукции
		|ГДЕ
		|	Товары.Количество > ЕСТЬNULL(астПартииПродукцииМеркурий.КоличествоОстаток, 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Товары.ПродукцияМеркурий,
		|	Товары.ПартияПродукции,
		|	Товары.НомерСтроки КАК НомерСтроки,
		|	Товары.Количество,
		|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
		|	Товары.ПродукцияМеркурий.GUID КАК Код,
		|	Остатки.СерияНоменклатуры КАК СерияНоменклатуры,
		|	Остатки.ХарактеристикаНоменклатуры
		|ИЗ
		|	ТоварыВсего КАК Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
		|		ПО Товары.ПартияПродукции = Остатки.ПартияПродукции
		|ГДЕ
		|	Товары.Количество > ЕСТЬNULL(Остатки.КоличествоОстаток, 0)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
	Иначе	
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	астТранспортнаяПартияМеркурий.ПродукцияМеркурий,
		|	астТранспортнаяПартияМеркурий.ПартияПродукции КАК ПартияПродукции,
		|	МИНИМУМ(астТранспортнаяПартияМеркурий.НомерСтроки) КАК НомерСтроки,
		|	СУММА(астТранспортнаяПартияМеркурий.Количество) КАК Количество
		|ПОМЕСТИТЬ Товары
		|ИЗ
		|	Документ.астТранспортнаяПартияМеркурий.ПартииПродукции КАК астТранспортнаяПартияМеркурий
		|ГДЕ
		|	астТранспортнаяПартияМеркурий.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	астТранспортнаяПартияМеркурий.ПродукцияМеркурий,
		|	астТранспортнаяПартияМеркурий.ПартияПродукции
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	астТранспортнаяПартияМеркурий.ПартияПродукции
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	астПартииПродукцииМеркурий.ПартияПродукции,
		|	астПартииПродукцииМеркурий.ПродукцияМеркурий,
		|	астПартииПродукцииМеркурий.КоличествоОстаток,
		|	астПартииПродукцииМеркурий.СерияНоменклатуры КАК СерияНоменклатуры,
		|	астПартииПродукцииМеркурий.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры
		|ПОМЕСТИТЬ ОстаткиОбщие
		|ИЗ
		|	РегистрНакопления.астПартииПродукцииМеркурий.Остатки(
		|			&МоментВремени,
		|			Организация = &Организация
		|				И Предприятие = &Предприятие
		|				И ПартияПродукции В
		|					(ВЫБРАТЬ
		|						Товары.ПартияПродукции
		|					ИЗ
		|						Товары КАК Товары)) КАК астПартииПродукцииМеркурий
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	астПартииПродукцииМеркурий.ПартияПродукции
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиОбщие.ПартияПродукции,
		|	ОстаткиОбщие.ПродукцияМеркурий,
		|	СУММА(ОстаткиОбщие.КоличествоОстаток) КАК КоличествоОстаток,
		|	ОстаткиОбщие.СерияНоменклатуры,
		|	ОстаткиОбщие.ХарактеристикаНоменклатуры
		|ПОМЕСТИТЬ Остатки
		|ИЗ
		|	ОстаткиОбщие КАК ОстаткиОбщие
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиОбщие.ПартияПродукции,
		|	ОстаткиОбщие.ПродукцияМеркурий,
		|	ОстаткиОбщие.СерияНоменклатуры,
		|	ОстаткиОбщие.ХарактеристикаНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиОбщие.ПартияПродукции,
		|	ОстаткиОбщие.ПродукцияМеркурий,
		|	СУММА(ОстаткиОбщие.КоличествоОстаток) КАК КоличествоОстаток
		|ПОМЕСТИТЬ ОстаткиБезСерии
		|ИЗ
		|	ОстаткиОбщие КАК ОстаткиОбщие
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиОбщие.ПартияПродукции,
		|	ОстаткиОбщие.ПродукцияМеркурий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Товары.ПродукцияМеркурий,
		|	Товары.ПартияПродукции,
		|	Товары.НомерСтроки,
		|	Товары.Количество
		|ПОМЕСТИТЬ ТоварыВсего
		|ИЗ
		|	Товары КАК Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиБезСерии КАК астПартииПродукцииМеркурий
		|		ПО Товары.ПартияПродукции = астПартииПродукцииМеркурий.ПартияПродукции
		|ГДЕ
		|	Товары.Количество > ЕСТЬNULL(астПартииПродукцииМеркурий.КоличествоОстаток, 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Товары.ПродукцияМеркурий,
		|	Товары.ПартияПродукции,
		|	Товары.НомерСтроки КАК НомерСтроки,
		|	Товары.Количество,
		|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
		|	Товары.ПродукцияМеркурий.GUID КАК Код,
		|	Остатки.СерияНоменклатуры КАК СерияНоменклатуры,
		|	Остатки.ХарактеристикаНоменклатуры
