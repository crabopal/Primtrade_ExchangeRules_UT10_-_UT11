Процедура ОткрытьВнешнююОбработкуПоНаим(Наименование)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВнешниеОбработки.Ссылка,
		|	ВнешниеОбработки.ЭтоГруппа,
		|	ВнешниеОбработки.ВидОбработки,
		|	ВнешниеОбработки.ХранилищеВнешнейОбработки
		|ИЗ
		|	Справочник.ВнешниеОбработки КАК ВнешниеОбработки
		|ГДЕ
		|	ВнешниеОбработки.Наименование ПОДОБНО &Наименование
		|	И НЕ ВнешниеОбработки.ПометкаУдаления
		|	И ВнешниеОбработки.ВидОбработки = ЗНАЧЕНИЕ(Перечисление.ВидыДополнительныхВнешнихОбработок.Обработка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВнешниеОбработки.Наименование УБЫВ";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	//KonturEDI_4_03_025_02	
	Если Выборка.Следующий() Тогда
		ОткрытьВнешнююОбработку(Выборка);
	Иначе	
		Сообщить("Не удалось открыть внешнюю обработку """ + СтрЗаменить(Наименование, "%", " ") + """: файл не найден во внешних обработках!");	
	КонецЕсли;

КонецПроцедуры
Процедура ОткрытьВнешнююОбработку(ВыбраннаяСтрока) Экспорт
	
	Если Не ВыбраннаяСтрока.ЭтоГруппа Тогда
		
		ЭтоОбработка = ?(ВыбраннаяСтрока.ВидОбработки = Перечисления.ВидыДополнительныхВнешнихОбработок.Обработка, Истина, Ложь);
		ЭтоОтчет = ?(ВыбраннаяСтрока.ВидОбработки = Перечисления.ВидыДополнительныхВнешнихОбработок.Отчет, Истина, Ложь);
		
		Если НЕ (ЭтоОбработка ИЛИ ЭтоОтчет) Тогда
			Возврат;
		КонецЕсли;
		
		
		//И ВыбраннаяСтрока.ВидОбработки = Перечисления.ВидыДополнительныхВнешнихОбработок.Обработка Тогда
		
		Попытка
			
			ИмяФайла = ПолучитьИмяВременногоФайла();
			ДвоичныеДанные = ВыбраннаяСтрока.ХранилищеВнешнейОбработки.Получить();
			ДвоичныеДанные.Записать(ИмяФайла);
			
			Если ЭтоОбработка Тогда
				
				Форма = ВнешниеОбработки.ПолучитьФорму(ИмяФайла);
				
			Иначе
				
				Форма = ВнешниеОтчеты.ПолучитьФорму(ИмяФайла);
				
			КонецЕсли;
			
			Если Не Форма = Неопределено Тогда
				
				Форма.Открыть();
				
			Иначе
				
				Если ЭтоОбработка Тогда
					ВнешняяОбработка = ВнешниеОбработки.Создать(ИмяФайла);
				Иначе
					ВнешнийОтчет = ВнешниеОтчеты.Создать(ИмяФайла);
				КонецЕсли;
				
			КонецЕсли;
			
			УдалитьФайлы(ИмяФайла);
			
		Исключение
			#Если Клиент Тогда
			Если ЭтоОбработка Тогда
				
				Предупреждение("Выбранный файл не является внешней обработкой.
							   |Либо, данная обработка не предназначена для
							   |запуска в этой конфигурации.");
			Иначе
				Предупреждение("Выбранный файл не является внешним отчетом.
							   |Либо, данный отчет не предназначена для
							   |запуска в этой конфигурации.");
			КонецЕсли;
			#КонецЕсли
		КонецПопытки;
		
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры


Процедура _АвтовыгрузкаNaknet() Экспорт
	
	//// Запрос для построителя отчета
	ТекстЗапроса = 1;
	//"ВЫБРАТЬ
	//|	Номенклатура.Ссылка КАК Номенклатура,
	//|	Склады.Ссылка КАК Склад
	//|ИЗ
	//|	Справочник.Номенклатура КАК Номенклатура,
	//|	Справочник.Склады КАК Склады"
	//;
	//
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СохраненныеНастройки.СохраненнаяНастройка КАК СохраненнаяНастройка,
		|	СохраненныеНастройки.НаименованиеНастройки
		|ИЗ
		|	РегистрСведений.СохраненныеНастройки КАК СохраненныеНастройки
		|ГДЕ
		|	СохраненныеНастройки.НаименованиеНастройки = &НаименованиеНастройки
		|	И СохраненныеНастройки.ИмяОбъекта = &ИмяОбъекта";
	
	Запрос.УстановитьПараметр("ИмяОбъекта", "ВыгрузкаNaknet");
	Запрос.УстановитьПараметр("НаименованиеНастройки", "Автовыгрузка");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		СохраненнаяНастройка = ВыборкаДетальныеЗаписи.СохраненнаяНастройка.Получить();
	Иначе
		Возврат;		
	КонецЕсли;  	
	
	ОбработкиВыгрузкаNaknet = Обработки.ВыгрузкаNaknet.Создать();
	
	ОбработкиВыгрузкаNaknet.Организация = Справочники.Организации.НайтиПоРеквизиту("ИНН","2543004160");
	ОбработкиВыгрузкаNaknet.КодОрганизации = "FORWARD_TRADE";
	ОбработкиВыгрузкаNaknet.КодПроизводителя = "EZHK";
		
	ОбработкиВыгрузкаNaknet.ВыбКаталог = "C:\Program Files (x86)\Naknet Sender\Outbound"; 	
	//ОбработкиВыгрузкаNaknet.ВыбКаталог = "C:\Naknet Sender\Outbound"; 	
	
	
	КолвоДней = 60*60*24*44;
	ПредшествующийДень = НачалоДня(ТекущаяДата())-1; 
	
	ОбработкиВыгрузкаNaknet.НачПериода = НачалоДня(ПредшествующийДень - КолвоДней); 
	ОбработкиВыгрузкаNaknet.КонПериода = НачалоДня(ТекущаяДата())-1;  
	
	
	ОбработкиВыгрузкаNaknet.ПостроительОтчета.Текст = ТекстЗапроса;
	ОбработкиВыгрузкаNaknet.ПостроительОтчета.ЗаполнитьНастройки();  
	
	
	ОбработкиВыгрузкаNaknet.ПостроительОтчета.УстановитьНастройки(СохраненнаяНастройка.НастройкиПостроителя, Истина);
	
	ОбработкиВыгрузкаNaknet.ВыполнитьВыгрузкуДанных();   	
	
КонецПроцедуры
