Процедура ЗаполнитьГрузоотправителя(Объект) Экспорт
	Если ЗначениеЗаполнено(Объект.Организация) и НЕ ЗначениеЗаполнено(Объект.Грузоотправитель) тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Организация",Объект.Организация);
		Запрос.Текст ="ВЫБРАТЬ
		              |	ЗначенияСвойствОбъектов.Свойство,
		              |	ЗначенияСвойствОбъектов.Значение
		              |ИЗ
		              |	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		              |ГДЕ
		              |	ЗначенияСвойствОбъектов.Объект = &Организация";
		Результат = Запрос.Выполнить().Выгрузить();
		Для каждого Р из Результат Цикл
			Если Р.Свойство.Наименование = "Грузоотправитель" тогда	
				Объект.Грузоотправитель = Р.Значение;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры	

Процедура ЗаполнитьГрузополучателя(Объект) Экспорт
	Если ЗначениеЗаполнено(Объект.Контрагент)
		//И НЕ ЗначениеЗаполнено(Объект.Покупатель) 
		тогда
		Объект.Покупатель = Объект.Контрагент;
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Объект",Объект.Контрагент);
		Запрос.Текст ="ВЫБРАТЬ
		              |	ЗначенияСвойствОбъектов.Свойство,
		              |	ЗначенияСвойствОбъектов.Значение
		              |ИЗ
		              |	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		              |ГДЕ
		              |	ЗначенияСвойствОбъектов.Объект = &Объект";
		Результат = Запрос.Выполнить().Выгрузить();
		Для каждого Р из Результат Цикл
			Если Р.Свойство.Наименование = "Плательщик" тогда	
				Объект.Грузополучатель = Объект.Контрагент;
				Объект.Покупатель = Р.Значение;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры	


Процедура ПриУстановкеНовогоНомераДокумента(Источник, СтандартнаяОбработка, Префикс) Экспорт
	
	//отключено 
	Возврат;

	Если ТипЗнч(Источник) <> Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
		
	//ДлинаНомера = 11 // вернуть по умолчанию?
	//ШаблонНомера = Префикс + СтрЗаменить(СтрЗаменить(Формат(1, ФорматнаяСтрока), "0", "_"), "1", "_");
	ДлинаНомера = СтрДлина(Источник.Номер)-1;//Метаданные.Документы.РеализацияТоваровУслуг.ДлинаНомера;
	ФорматнаяСтрока = СтрЗаменить("ЧЦ=9; ЧВН=; ЧГ=0", "9", ДлинаНомера - СтрДлина(Префикс));
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	РеализацияТоваровУслуг.Номер КАК Номер
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.Дата МЕЖДУ &ДатаНач И &ДатаКон
		//|	И НЕ РеализацияТоваровУслуг.Организация.ОсобаяНумерацияДокументов
		|	И РеализацияТоваровУслуг.Номер ПОДОБНО &Номер
		//|	И (ВЫРАЗИТЬ(РеализацияТоваровУслуг.Номер КАК СТРОКА(13))) <> РеализацияТоваровУслуг.Номер
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номер УБЫВ";
	
	Запрос.УстановитьПараметр("ДатаНач", НачалоГода(Источник.Дата));
	Запрос.УстановитьПараметр("ДатаКон", КонецГода(Источник.Дата));
	//Запрос.УстановитьПараметр("Организация", Источник.Организация);
	Запрос.УстановитьПараметр("Номер", Префикс + "%");
	
	//Запрос.Текст = СтрЗаменить(Запрос.Текст, "13", ДлинаНомера-1);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Попытка
			ТекНомер = Число(Сред(Выборка.Номер, СтрДлина(Префикс)+1)) + 1;
		Исключение
			Сообщить("Особая нумерация документа реализации невозможна: Не удалось преобразовать предыдущий номер " + Выборка.Номер);
			Возврат;
		КонецПопытки;
	Иначе
		ТекНомер = 1;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	//ФорматнаяСтрока = СтрЗаменить("ЧЦ=9; ЧВН=; ЧГ=0", "9", ДлинаНомера - СтрДлина(Префикс));
	
	Источник.Номер = Префикс + Формат(ТекНомер, ФорматнаяСтрока);
	Префикс = "";
	
КонецПроцедуры


