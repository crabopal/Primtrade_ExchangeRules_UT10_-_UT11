Функция ПрименяемаяСтавкаНДС(СтруктураШапкиДокумента)
	
	Если СтруктураШапкиДокумента.ЭтоПлательщикНДСПрименяющийУСН Тогда
		Если СтруктураШапкиДокумента.ПрименяетсяОбщаяСтавкаНДС Тогда
			Если УчетНДС.ПрименяетсяПриказФНС000(СтруктураШапкиДокумента.Дата) Тогда
				СтавкаНДС = Перечисления.СтавкиНДС.НДС22;
			Иначе
				СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
			КонецЕсли;
		ИначеЕсли СтруктураШапкиДокумента.ПрименяетсяПониженнаяСтавкаНДС Тогда
			СтавкаНДС = Перечисления.СтавкиНДС.НДС5;
		Иначе
			СтавкаНДС = Перечисления.СтавкиНДС.НДС7;
		КонецЕсли;
	Иначе
		СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
	КонецЕсли;
	
	Возврат УчетНДС.ПолучитьСтавкуНДС(СтавкаНДС);
	
КонецФункции   
