 Функция ПлательщикНДСПрименяющийУСН(Организация, Период) Экспорт
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	УчетнаяПолитикаОрганизацийСрезПоследних.ДатаПримененияНДСприУСН
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаНалоговыйУчет.СрезПоследних(&Дата, Организация = &Организация) КАК УчетнаяПолитикаОрганизацийСрезПоследних
	|");

	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата"  , Период);

	Выборка = Запрос.Выполнить().Выбрать();
	ДатаИзменения = ?(Выборка.Следующий(), Выборка.ДатаПримененияНДСприУСН, Ложь);
	
	Если ДатаИзменения = Дата(1, 1, 1) ИЛИ ДатаИзменения = Ложь Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НачалоМесяца(Период) >= ДатаИзменения;
	
КонецФункции 

Функция СтавкаНалогообложенияПриУСН(Организация, Период) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиУчетаНДССрезПоследних.СтавкаНалогообложенияПриУСН КАК СтавкаНалогообложенияПриУСН,
	|	НастройкиУчетаНДССрезПоследних.ДатаПримененияНДСприУСН КАК ДатаПримененияНДСприУСН
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаНалоговыйУчет.СрезПоследних(&Дата, Организация = &Организация) КАК НастройкиУчетаНДССрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата",        Период);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ДатаИзменения = ?(Результат.Количество() > 0, Результат[0].ДатаПримененияНДСприУСН, Дата(1, 1, 1));
	
	Если ДатаИзменения = Дата(1, 1, 1) Тогда
		Возврат Перечисления.ВидыСтавокНДС.ПустаяСсылка();
	КонецЕсли;
	
	Если Результат.Количество() > 0
		И НачалоМесяца(Период) >= ДатаИзменения Тогда
		Возврат Результат[0].СтавкаНалогообложенияПриУСН;
	Иначе
		Возврат Перечисления.ВидыСтавокНДС.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции  

//Определяет вид счета с точки зрения применения ЕНВД
//
Функция ОтноситсяКДеятельностиЕНВД(Счет, Распределение = "") Экспорт //~
	
	ВыборкаПоСчету = РегистрыСведений.СчетаУчетаПоДеятельностиЕНВД.Выбрать(новый структура("Счет",Счет));
	
	Если ВыборкаПоСчету.Следующий() тогда
		
		Если НЕ ЗначениеЗаполнено(Распределение) Тогда
			
			Возврат Истина;
			
		ИначеЕсли ВыборкаПоСчету.ПодлежитРаспределению Тогда
			
			Возврат Распределение;
			
		Иначе
			
			Возврат НЕ Распределение;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

