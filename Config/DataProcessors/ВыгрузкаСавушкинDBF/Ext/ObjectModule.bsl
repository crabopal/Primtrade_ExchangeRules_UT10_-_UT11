		|		ВтПродажи.Номенклатура
		|	ИЗ
		|		ВтПродажи КАК ВтПродажи) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
		|		ПО ВложенныйЗапрос.Номенклатура = Штрихкоды.Владелец
		|			И (Штрихкоды.ТипШтрихкода = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ТипыШтрихкодов.EAN13))
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ЗаказыПоставщикамОстатки.ЗаказПоставщику.Дата, ДЕНЬ) КАК Период,
		|	ЗаказыПоставщикамОстатки.Номенклатура,
		|	ЗаказыПоставщикамОстатки.ДоговорКонтрагента.Владелец КАК Контрагент,
		|	СУММА(ЗаказыПоставщикамОстатки.КоличествоОстаток) КАК Количество,
		|	ВтТовары.Штрихкод
		|ПОМЕСТИТЬ ВтЗаказы
		|ИЗ
		|	РегистрНакопления.ЗаказыПоставщикам.Остатки(
		|			&КонецПериодаГраница,
		|			Номенклатура В
		|					(ВЫБРАТЬ
		|						ВтТовары.Номенклатура
		|					ИЗ
		|						ВтТовары)
		|				И (НЕ &ЕстьОтборСклад
		|					ИЛИ ЗаказПоставщику.Склад В (&Склады))) КАК ЗаказыПоставщикамОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтТовары КАК ВтТовары
		|		ПО ЗаказыПоставщикамОстатки.Номенклатура = ВтТовары.Номенклатура
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказыПоставщикамОстатки.Номенклатура,
		|	ВтТовары.Штрихкод,
		|	НАЧАЛОПЕРИОДА(ЗаказыПоставщикамОстатки.ЗаказПоставщику.Дата, ДЕНЬ),
		|	ЗаказыПоставщикамОстатки.ДоговорКонтрагента.Владелец
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""1 файл SALES_A.DBF"" КАК ИмяТаблицы,
		|	ВтПродажи.ПериодДень КАК Период,
		|	ВтПродажи.КонтрагентКод КАК КонтрагентКод,
		|	ВтПродажи.НоменклатураКод КАК НоменклатураКод,
		|	СУММА(ВтПродажи.Количество) КАК Количество,
		|	СУММА(ВтПродажи.Стоимость) КАК Стоимость,
		|	МАКСИМУМ(ВтТовары.Штрихкод) КАК Штрихкод,
		|	ВтПродажи.Номенклатура
		|ИЗ
		|	ВтПродажи КАК ВтПродажи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтТовары КАК ВтТовары
		|		ПО ВтПродажи.Номенклатура = ВтТовары.Номенклатура
		|
		|СГРУППИРОВАТЬ ПО
		|	ВтПродажи.ПериодДень,
		|	ВтПродажи.КонтрагентКод,
		|	ВтПродажи.НоменклатураКод,
		|	ВтПродажи.Номенклатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период,
		|	КонтрагентКод,
		|	НоменклатураКод
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""2 файл TOVAR_A.DBF"" КАК ИмяТаблицы,
		|	ВтТовары.Номенклатура,
		|	ВтТовары.Номенклатура.Код КАК НоменклатураКод,
		|	ВтТовары.Номенклатура.Наименование,
		|	ВтТовары.Штрихкод,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВтТовары.Номенклатура.ЕдиницаХраненияОстатков.Вес, 0) = 0
		|			ТОГДА 1
		|		ИНАЧЕ ВтТовары.Номенклатура.ЕдиницаХраненияОстатков.Вес
		|	КОНЕЦ КАК Вес
		|ИЗ
		|	ВтТовары КАК ВтТовары
		|
		|УПОРЯДОЧИТЬ ПО
		|	НоменклатураКод
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""3 файл KLIENT_A.DBF"" КАК ИмяТаблицы,
		|	ВложенныйЗапрос.Контрагент.Код КАК КонтрагентКод,
		|	ВложенныйЗапрос.Контрагент.Наименование,
		|	ВложенныйЗапрос.Контрагент.Родитель.Наименование КАК Родитель,
		|	ВложенныйЗапрос.Контрагент.Регион КАК Регион,
		|	ВложенныйЗапрос.Контрагент,
		|	МАКСИМУМ(ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(250))) КАК АдресФакт
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ВтПродажи.Контрагент КАК Контрагент
		|	ИЗ
		|		ВтПродажи КАК ВтПродажи
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ВтЗаказы.Контрагент
		|	ИЗ
		|		ВтЗаказы КАК ВтЗаказы) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|		ПО ВложенныйЗапрос.Контрагент = КонтактнаяИнформация.Объект
		|			И (КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента))
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.Контрагент,
		|	ВложенныйЗапрос.Контрагент.Код,
		|	ВложенныйЗапрос.Контрагент.Наименование,
		|	ВложенныйЗапрос.Контрагент.Родитель.Наименование,
		|	ВложенныйЗапрос.Контрагент.Регион
		|
		|УПОРЯДОЧИТЬ ПО
		|	КонтрагентКод
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""4 файл OST_A.DBF"" КАК ИмяТаблицы,
		|	ТоварыНаСкладахОстатки.Номенклатура,
		|	ТоварыНаСкладахОстатки.Номенклатура.Код КАК НоменклатураКод,
		|	ТоварыНаСкладахОстатки.КоличествоОстаток КАК Количество,
		|	ВтТовары.Штрихкод,
		|	ВтТовары.Номенклатура КАК фыв
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|			&КонецПериодаГраница,
		|			Номенклатура В
		|					(ВЫБРАТЬ
		|						ВтТовары.Номенклатура
		|					ИЗ
		|						ВтТовары)
		|				И (НЕ &ЕстьОтборСклад
		|					ИЛИ Склад В (&Склады))) КАК ТоварыНаСкладахОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВтТовары КАК ВтТовары
		|		ПО ТоварыНаСкладахОстатки.Номенклатура = ВтТовары.Номенклатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	НоменклатураКод
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""5 й файл ZAJAVK_A.DBF"" КАК ИмяТаблицы,
		|	ВтЗаказы.Период КАК Период,
		|	ВтЗаказы.Номенклатура,
		|	ВтЗаказы.Контрагент,
		|	ВтЗаказы.Штрихкод,
		|	ВтЗаказы.Номенклатура.Код КАК НоменклатураКод,
		|	ВтЗаказы.Контрагент.Код КАК КонтрагентКод,
		|	ВтЗаказы.Количество
		|ИЗ
		|	ВтЗаказы КАК ВтЗаказы
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период,
		|	КонтрагентКод,
		|	НоменклатураКод";
		
	ОтборСклады = Склады.ВыгрузитьКолонку("Склад");
	Запрос.УстановитьПараметр("Склады", ОтборСклады);
	Запрос.УстановитьПараметр("ЕстьОтборСклад", ОтборСклады.Количество() > 0);
	Запрос.УстановитьПараметр("Номенклатура", Товары.ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("КонецПериодаГраница", Новый Граница(КонецДня(КонецПериода), ВидГраницы.Включая));
	
	ПакетЗапроса = Запрос.ВыполнитьПакет();
	ВыгружаемыеФайлы = Новый Соответствие;
	
	ВыгрузитьТаблицуДБФ(ПакетЗапроса, "SALES_A.DBF", ВыгружаемыеФайлы);
	ВыгрузитьТаблицуДБФ(ПакетЗапроса, "TOVAR_A.DBF", ВыгружаемыеФайлы);
	ВыгрузитьТаблицуДБФ(ПакетЗапроса, "KLIENT_A.DBF", ВыгружаемыеФайлы);
	ВыгрузитьТаблицуДБФ(ПакетЗапроса, "OST_A.DBF", ВыгружаемыеФайлы);
	ВыгрузитьТаблицуДБФ(ПакетЗапроса, "ZAJAVK_A.DBF", ВыгружаемыеФайлы);
	
	
	Если ТестоваяВыгрузка Тогда
		ЗапуститьПриложение("explorer " + ТекКаталог); 		
		Для Каждого ТекФайл Из ВыгружаемыеФайлы Цикл  		
			Сообщить(ТекФайл.Значение);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	/////////////////////////////////////////
	//ПользовательFTPСоединения = "";
	//ПарольFTPСоединения = "";
	СерверАдрес = СтрЗаменить(ФтпКаталог, "ftp://", "");
	СерверАдресРазд = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СерверАдрес, "/");
	СерверКаталог = "";
	Для Сч = 1 По СерверАдресРазд.ВГраница() Цикл
		Если ЗначениеЗаполнено(СерверАдресРазд[Сч]) Тогда
			СерверКаталог = СерверКаталог + "/" + СерверАдресРазд[Сч];
		КонецЕсли;
	КонецЦикла;
	
	Попытка 			
		FTPСоединение = Новый FTPСоединение(СерверАдресРазд[0], Порт, Логин, Пароль,,,,, УровеньИспользованияЗащищенногоСоединенияFTP.НеИспользовать);
		FTPСоединение.УстановитьТекущийКаталог(СерверКаталог);
		
		//КаталогСФайлом = FTPСоединение.НайтиФайлы(FTPСоединение.ТекущийКаталог(), "obmen_1C/Primorye-Trade");
		//
		//Если КаталогСФайлом.Количество() > 0 Тогда  			
		//	FTPСоединение.УстановитьТекущийКаталог("Import");
		//КонецЕсли;
	Исключение
		СообщитьЖурнал("Ошибка создания соединения: Не удалось подключится к ФТП, " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	

	
	ОшибкаВыгрузки = ВыгружаемыеФайлы.Количество() <> 5;
	
	Для Каждого ТекФайл Из ВыгружаемыеФайлы Цикл  		
		Попытка
			FTPСоединение.Записать(ТекФайл.Значение, ТекФайл.Ключ);
		Исключение
			ОшибкаВыгрузки = Истина;
			СообщитьЖурнал("Ошибка передачи файла " + ТекФайл.Ключ + ": " + ОписаниеОшибки());
			//Если мЭтоАвтоОбмен Тогда
			//	ЗаписьЖурналаРегистрации("Выгрузка Uniliever", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка передачи файла " + Строка.Ш_ОбъектПредставление + ".dbf, " + ОписаниеОшибки());
			//КонецЕсли;
	
		КонецПопытки;
	КонецЦикла;
	
	Если ОшибкаВыгрузки Тогда
		СообщитьЖурнал("Выгрузка файлов произведена с ошибками!");
	Иначе
		СообщитьЖурнал("Выгрузка файлов выполнена успешно!", УровеньЖурналаРегистрации.Информация);
	КонецЕсли;

КонецПроцедуры
Процедура ВыгрузитьТаблицуДБФ(ПакетЗапроса, ИмяФайла, ВыгружаемыеФайлы);
	
		
	ДБФ = Новый XBase;
	ДБФ.Кодировка = КодировкаXBase.OEM;
	
	//Добавить(<Имя>, <Тип>, <Длина>, <Точность>)
	//Доступны следующие типы:
	//
	//«N» – число;
	//«S» – строка;
	//«D» – дата;
	//«L» – булево;
	//«F» – аналогично «N» – число.

	
	Если ИмяФайла = "SALES_A.DBF" Тогда
		//1 файл SALES_A.DBF Поля [DATA], [ID_KLIENT], [ID_TOVAR], [KOL], [SUMMA], [EAN13]
		//В выгрузку должны попадать продажи грузополучателям (далее клиентам) и возвраты от клиентов, 
		//всей продукции поставляемой производителем, Возвраты в выгрузке выделяются знаком «-» (минус) в полях [KOL] и [SUMMA].
		Выборка = ПакетЗапроса[ПакетЗапроса.Количество()-5].Выбрать();
	
		ДБФ.Поля.Добавить("DATA", "D");
		ДБФ.Поля.Добавить("ID_KLIENT", "S", 9);
		ДБФ.Поля.Добавить("ID_TOVAR", "S", 11);
		ДБФ.Поля.Добавить("KOL", "N", 13,3);
		ДБФ.Поля.Добавить("SUMMA", "N", 13,2);
		ДБФ.Поля.Добавить("EAN13", "S", 13);
		 
		ДБФ.СоздатьФайл(ТекКаталог+ИмяФайла);		
		
		Пока Выборка.Следующий() Цикл
			ДБФ.Добавить();
			ДБФ.DATA = Выборка.Период;
			ДБФ.ID_KLIENT = Выборка.КонтрагентКод;
			ДБФ.ID_TOVAR = Выборка.НоменклатураКод;
			ДБФ.KOL = Выборка.Количество;
			ДБФ.SUMMA = Выборка.Стоимость;
			ДБФ.EAN13 = СокрЛП(Выборка.Штрихкод);
		    ДБФ.Записать();
		КонецЦикла;
		
	ИначеЕсли ИмяФайла = "TOVAR_A.DBF" Тогда
		//2 файл TOVAR_A.DBF Поля [ID_TOVAR], [NAME], [NETTO], [EAN13]
		//В выгрузку должны попадать все товары, поставляемые производителем
		Выборка = ПакетЗапроса[ПакетЗапроса.Количество()-4].Выбрать();
	
		ДБФ.Поля.Добавить("ID_TOVAR", "S", 11);
		ДБФ.Поля.Добавить("NAME", "S", 100);
		ДБФ.Поля.Добавить("NETTO", "N", 13,3);
		ДБФ.Поля.Добавить("EAN13", "S", 13);
		 
		ДБФ.СоздатьФайл(ТекКаталог+ИмяФайла);		
		
		Пока Выборка.Следующий() Цикл
			ДБФ.Добавить();
			ДБФ.ID_TOVAR = Выборка.НоменклатураКод;
			ДБФ.NAME = Выборка.НоменклатураНаименование;
			ДБФ.NETTO = Выборка.Вес;
			ДБФ.EAN13 = СокрЛП(Выборка.Штрихкод);
		    ДБФ.Записать();
		КонецЦикла;
	
	ИначеЕсли ИмяФайла = "KLIENT_A.DBF" Тогда
		//3 файл KLIENT_A.DBF Поля [ID_KLIENT],[NAME],[MENAGER],[RAION],[TT],[FORM],[GRKL],[ADDRESS]
		//В выгрузку должны попадать все клиенты, [ID_KLIENT] которых перечислены в таблице SALES.
		//TT – код типа торговой точки; формат – числовой, целочисленный. (список допустимых значений в Таблице 1)
		//FORM – код формата торговой точки клиента; формат – числовой, целочисленный; (Список допустимых значений в Таблице 2)
		//Тип ТТ
		//Наименование	код
		//Гипермаркет	1
		//Супермаркет	2
		//Магазин "У дома"	3
		//Рынок	4
		
		//Формат ТТ
		//Наименование	код
		//Традиционная торговля	1
		//Сеть	2

		
		Выборка = ПакетЗапроса[ПакетЗапроса.Количество()-3].Выбрать();
	
		ДБФ.Поля.Добавить("ID_KLIENT", "S", 9);
		ДБФ.Поля.Добавить("NAME", "S", 100);
		ДБФ.Поля.Добавить("MENAGER", "S", 100);
		ДБФ.Поля.Добавить("RAION", "S", 32);
		ДБФ.Поля.Добавить("TT", "N", 1);
		ДБФ.Поля.Добавить("FORM", "N", 1);
		ДБФ.Поля.Добавить("GRKL", "S", 30);
		ДБФ.Поля.Добавить("ADDRESS", "S", 250);
		
		ДБФ.СоздатьФайл(ТекКаталог+ИмяФайла);		
		
		 
		
		Пока Выборка.Следующий() Цикл
			ДБФ.Добавить();
			ДБФ.ID_KLIENT 	= Выборка.КонтрагентКод;
			ДБФ.NAME 		= Выборка.КонтрагентНаименование;
		    ДБФ.MENAGER 	= "";
			ДБФ.RAION 		= Лев(Выборка.Регион, 32);
			ДБФ.TT 			= 3;
			ДБФ.FORM 		= 1;
			ДБФ.GRKL 		= Лев(Выборка.Родитель, 30);
			ДБФ.ADDRESS 	= СокрЛП(Выборка.АдресФакт);
			ДБФ.Записать();
		КонецЦикла;
		
	ИначеЕсли ИмяФайла = "OST_A.DBF" Тогда
		//4 файл OST_A.DBF Поля [DATA], [ID_TOVAR], [KOL], [EAN13]
