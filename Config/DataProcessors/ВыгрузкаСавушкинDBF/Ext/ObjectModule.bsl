Процедура ЗаполнитьДокументыДляВыгрузки(ОтборРозница = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПоступлениеТоваровУслуг.Ссылка КАК Документ,
		|	ПоступлениеТоваровУслуг.СуммаДокумента КАК Сумма,
		|	ПоступлениеТоваровУслуг.Контрагент
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
		|		ПО ПоступлениеТоваровУслуг.Ссылка = ПоступлениеТоваровУслугТовары.Ссылка
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ПоступлениеТоваровУслуг.Проведен
		|	И ПоступлениеТоваровУслугТовары.Номенклатура В ИЕРАРХИИ(&Номенклатура)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РеализацияТоваровУслуг.Ссылка,
		|	РеализацияТоваровУслуг.СуммаДокумента,
		|	РеализацияТоваровУслуг.Контрагент
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|		ПО РеализацияТоваровУслуг.Ссылка = РеализацияТоваровУслугТовары.Ссылка
		|ГДЕ
		|	РеализацияТоваровУслуг.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		//|	И РеализацияТоваровУслуг.Контрагент.ИНН = """"
		|	И РеализацияТоваровУслуг.Проведен
		|	И РеализацияТоваровУслугТовары.Номенклатура В ИЕРАРХИИ(&Номенклатура)";
	    //|	И РеализацияТоваровУслуг.Номенклатура В ИЕРАРХИИ(&Номенклатура)";
		
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("Номенклатура", Товары.ВыгрузитьКолонку("Номенклатура"));
	
	Если ТестоваяВыгрузка Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВЫБРАТЬ РАЗЛИЧНЫЕ", "ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1");
	КонецЕсли;
	
	Если ОтборРозница Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг.Дата МЕЖДУ &НачалоПериода И &КонецПериода", "РеализацияТоваровУслуг.Дата МЕЖДУ &НачалоПериода И &КонецПериода И РеализацияТоваровУслуг.Контрагент.ИНН = """" ");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПоступлениеТоваровУслуг.Дата МЕЖДУ &НачалоПериода И &КонецПериода", "ПоступлениеТоваровУслуг.Дата МЕЖДУ &НачалоПериода И &КонецПериода И ПоступлениеТоваровУслуг.Контрагент.ИНН = """" ");
	КонецЕсли;
	
	//ВыгружаемыеДокументы.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

Процедура ВыполнитьВыгрузкуВнешнийВызов() Экспорт
	
	ВосстановитьНастройки();
	
	ТекДата = ТекущаяДата();
	Если День(ТекДата) = 2 Тогда
		//второго числа выгружается предыдущий месяц
		НачалоПериода = ДобавитьМесяц(НачалоМесяца(ТекДата), -1);
		КонецПериода = КонецМесяца(НачалоПериода);
	ИначеЕсли ДеньНедели(ТекДата) = 1 Тогда
		КонецПериода = НачалоДня(ТекДата)-1;//вчера
		НачалоПериода = КонецПериода - 60*60*24*7;//-7 дней
	КонецЕсли;
	
	////
	//КонецПериода = НачалоДня(ТекДата)-1;//вчера
	//НачалоПериода = НачалоМесяца('20250601');

	ВыполнитьВыгрузку();
	
КонецПроцедуры

