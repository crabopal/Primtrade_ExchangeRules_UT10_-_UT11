
// #Область СлужебныеПеременныеИМетодыФормы

&НаСервере
Перем КэшМодуляОбъекта;

&НаКлиенте
Перем КэшМодуляКлиента;

&НаСервере
Функция МодульОбъекта()
	
	Если КэшМодуляОбъекта <> Неопределено Тогда
		Возврат КэшМодуляОбъекта;
	КонецЕсли;
	
	КэшМодуляОбъекта = ВзаимодействиеКонтурМаркировка.МодульМаркировки(Истина);
	
	Возврат КэшМодуляОбъекта;
	
КонецФункции

&НаКлиенте
Функция МодульКлиента()
	
	Если КэшМодуляКлиента <> Неопределено Тогда
		Возврат КэшМодуляКлиента;
	КонецЕсли;
	
	КэшМодуляКлиента = ВзаимодействиеКонтурМаркировкаКлиент.МодульМаркировкиКлиент(Истина);
	
	Возврат КэшМодуляКлиента;
	
КонецФункции

// КонецОбласти // СлужебныеПеременныеИМетодыФормы

// #Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастроитьЭлементыФормыДля82();
	ЗаполнитьКонтекстФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗафиксироватьИмяФормыВладельца();
	СформироватьЗаголовокСпискаТоваров();
	СформироватьЗаголовокСпискаНомеровПартий();
	
	Если ЗначениеЗаполнено(Организация) Тогда
		СформироватьОтчет();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если МодульКлиента().ЭтоЗавершениеРаботыПрограммы(ЗавершениеРаботы) Тогда
		Возврат; // При завершении работы программы серверный вызов недоступен
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТабличныйДокумент.ВысотаТаблицы) Тогда
		ПровестиОпросПользователяИЗакрыть(Отказ);
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьОтчет();
	
КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиСобытийРеквизитовФормы

&НаКлиенте
Процедура СписокТоваровГиперссылкаНажатие(Элемент)
	
	Обработчик = МодульКлиента().ОписаниеОбработчикаОповещения("СписокТоваровПослеРедактирования", ЭтаФорма);
	
	ПараметрыСписка = МодульКлиента().Новый_ПараметрыФормыРедактированияСписка();
	ПараметрыСписка.Список = СписокТоваров;
	ПараметрыСписка.РазрешитьРедактирование = Истина;
	ПараметрыСписка.ТипЗначений = Тип("СправочникСсылка.КонтурМаркировка_Товары");
	ПараметрыСписка.Заголовок = НСтр("ru = 'Список товаров для отчета по виртуальному остатку'");
	
	МодульКлиента().ОткрытьФормуПросмотраСписка(ЭтаФорма, ПараметрыСписка, Обработчик);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНомеровПартийГиперссылкаНажатие(Элемент)
	
	Обработчик = МодульКлиента().ОписаниеОбработчикаОповещения("СписокНомеровПартийПослеРедактирования", ЭтаФорма);
	
	ПараметрыСписка = МодульКлиента().Новый_ПараметрыФормыРедактированияСписка();
	ПараметрыСписка.Список = СписокПартий;
	ПараметрыСписка.РазрешитьРедактирование = Истина;
	ПараметрыСписка.ТипЗначений = Тип("Строка");
	ПараметрыСписка.Заголовок = НСтр("ru = 'Список номеров партий для отчета по виртуальному остатку'");
	
	МодульКлиента().ОткрытьФормуПросмотраСписка(ЭтаФорма, ПараметрыСписка, Обработчик);
	
КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиСобытий

&НаКлиенте
Процедура СписокТоваровПослеРедактирования(Результат, ДопПараметры = Неопределено) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокТоваров = Результат;
	
	СформироватьЗаголовокСпискаТоваров();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНомеровПартийПослеРедактирования(Результат, ДопПараметры = Неопределено) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокПартий = Результат;
	
	СформироватьЗаголовокСпискаНомеровПартий();
	
КонецПроцедуры

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьКонтекстФормы()
	
	Параметры.Свойство("Организация", Организация);
	
	Если Параметры.Свойство("Товары") Тогда
		СписокТоваров.ЗагрузитьЗначения(Параметры.Товары);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет()
	
	Если Не МодульКлиента().ВыполнитьАвторизацию(Организация, ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьОтчетНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчетНаСервере()
	
	ТабличныйДокумент.Очистить();
	
	МодульОбъекта().ОтчетПоВиртуальномуСкладу_Сформировать(Организация, СписокТоваров, СписокПартий, ТабличныйДокумент);
	
	СформироватьМетрикиОтчета();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьМетрикиОтчета()
	
	Если Не ЗначениеЗаполнено(ИмяФормыВладельца) Тогда
		Возврат;
	КонецЕсли;
	
	Функциональность = МодульОбъекта().Перечисление_ФункциональностьМодуля();
	ФормыМодуля = МодульОбъекта().Метаданные().Формы;
	
	ФункциональностьФорм = Новый Соответствие;
	ФункциональностьФорм.Вставить(ФормыМодуля.РабочийСтол.Имя, Функциональность.ФормированиеОтчетаПоВиртуальномуСкладуИзМенюОтчеты);
	ФункциональностьФорм.Вставить(ФормыМодуля.ФормаМодуля.Имя, Функциональность.ФормированиеОтчетаПоВиртуальномуСкладуИзМенюОтчеты);
	ФункциональностьФорм.Вставить(ФормыМодуля.Форма_Товар.Имя, Функциональность.ФормированиеОтчетаПоВиртуальномуСкладуИзКарточкиТовара);
	ФункциональностьФорм.Вставить(ФормыМодуля.Форма_Товары_Список.Имя, Функциональность.ФормированиеОтчетаПоВиртуальномуСкладуИзСпискаТоваров);
	ФункциональностьФорм.Вставить(ФормыМодуля.Форма_ДокументУчета.Имя, Функциональность.ФормированиеОтчетаПоВиртуальномуСкладуИзДокументаУчета);
	
	ФункциональностьФормы = ФункциональностьФорм[ИмяФормыВладельца];
	Если ФункциональностьФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МодульОбъекта().СтекМетрик_ДобавитьФункциональность(ФункциональностьФормы, Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЗаголовокСпискаТоваров()
	
	ЗаголовокСписка = НСтр("ru = '<все товары>'");
	Если ЗначениеЗаполнено(СписокТоваров) Тогда
		ЗаголовокСписка = ПредставлениеСпискаЗначений(СписокТоваров);
	КонецЕсли;
	
	Элементы.СписокТоваровГиперссылка.Заголовок = ЗаголовокСписка;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЗаголовокСпискаНомеровПартий()
	
	ЗаголовокСписка = НСтр("ru = '<все партии>'");
	Если ЗначениеЗаполнено(СписокПартий) Тогда
		ЗаголовокСписка = ПредставлениеСпискаЗначений(СписокПартий);
	КонецЕсли;
	
	Элементы.СписокНомеровПартийГиперссылка.Заголовок = ЗаголовокСписка;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗафиксироватьИмяФормыВладельца()
	
	Если ВладелецФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЧастиИмени = МодульКлиента().РазделитьСтроку(ВладелецФормы.ИмяФормы, ".");
	
	ИмяФормыВладельца = ЧастиИмени[ЧастиИмени.ВГраница()];
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормыДля82()
	
	Если Не МодульОбъекта().ВерсияРежимаСовместимостиНиже("8.3") Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаОтборы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
КонецПроцедуры

&НаКлиенте
Функция ПредставлениеСпискаЗначений(СписокЗначений)
	
	ПредставленияЭлементов = Новый СписокЗначений;
	
	Для Каждого Элемент Из СписокЗначений Цикл
		Если ЗначениеЗаполнено(Элемент.Значение) Тогда
			ПредставленияЭлементов.Добавить(Элемент.Значение);
		Иначе
			ПредставленияЭлементов.Добавить(Элемент.Значение, НСтр("ru = '<пустое значение>'"));
		КонецЕсли;
	КонецЦикла;
	
	Возврат СокрЛП(ПредставленияЭлементов);
	
КонецФункции

// #КонецОбласти

// #Область ОпросыПользователей

&НаКлиенте
Процедура ПровестиОпросПользователяИЗакрыть(Отказ)
	
	КлючиСценариев = МодульКлиента().Перечисление_КлючиСценариевДляОпросов();
	ОписаниеОпроса = МодульКлиента().ОпросПользователяПоСценарию(КлючиСценариев.ОтчетПоВиртуальномуСкладу);
	
	Если ЗначениеЗаполнено(ОписаниеОпроса) Тогда
		Отказ = Истина;
		ОписаниеОбработчика = МодульКлиента().ОписаниеОбработчикаОповещения("ПослеОпросаПользователя", ЭтаФорма);
		МодульКлиента().ОткрытьФормуОпросаПользователя(ОписаниеОпроса, ЭтаФорма, ОписаниеОбработчика);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОпросаПользователя(РезультатВыбора, ДопПараметры = Неопределено) Экспорт
	
	Закрыть();
	
КонецПроцедуры

// #КонецОбласти
