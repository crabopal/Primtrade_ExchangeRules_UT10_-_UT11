
// #Область СлужебныеПеременныеИМетодыФормы

&НаСервере
Перем КэшМодуляОбъекта;

&НаКлиенте
Перем КэшМодуляКлиента;

&НаСервере
Функция МодульОбъекта()
	
	Если КэшМодуляОбъекта <> Неопределено Тогда
		Возврат КэшМодуляОбъекта;
	КонецЕсли;
	
	КэшМодуляОбъекта = ВзаимодействиеКонтурМаркировка.МодульМаркировки(Истина);
	
	Возврат КэшМодуляОбъекта;
	
КонецФункции

&НаКлиенте
Функция МодульКлиента()
	
	Если КэшМодуляКлиента <> Неопределено Тогда
		Возврат КэшМодуляКлиента;
	КонецЕсли;
	
	КэшМодуляКлиента = ВзаимодействиеКонтурМаркировкаКлиент.МодульМаркировкиКлиент(Истина);
	
	Возврат КэшМодуляКлиента;
	
КонецФункции

// КонецОбласти // СлужебныеПеременныеИМетодыФормы

// #Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьКонтекстФормы();
	НастроитьЭлементыФормы();
	
КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокЗначенийПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если ОтменаРедактирования Или ЭтоСписокСПометками Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РазделитьЗначение(ТекущиеДанные.Значение) Тогда
		Элемент.АвтоВводНовойСтроки = Ложь;
	Иначе
		Элемент.АвтоВводНовойСтроки = ЗначениеЗаполнено(ТекущиеДанные.Значение);
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗавершитьРедактирование(Команда)
	
	Если ЭтоСписокЗначений Тогда
		ЭтаФорма.ОповеститьОВыборе(СписокЗначений);
	Иначе
		ЭтаФорма.ОповеститьОВыборе(СписокЗначений.ВыгрузитьЗначения());
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьКонтекстФормы()
	
	РазрешитьРедактирование = Параметры.РазрешитьРедактирование;
	
	Если ТипЗнч(Параметры.Список) = Тип("СписокЗначений") Тогда
		ЭтоСписокЗначений = Истина;
	КонецЕсли;
	
	Если ЭтоСписокЗначений Тогда
		СписокЗначений = Параметры.Список;
	Иначе
		СписокЗначений.ЗагрузитьЗначения(Параметры.Список);
	КонецЕсли;
	
	Если Параметры.Свойство("ТипЗначений")
		И ЗначениеЗаполнено(Параметры.ТипЗначений)
		И Не ЗначениеЗаполнено(СписокЗначений.ТипЗначения) Тогда
		СписокЗначений.ТипЗначения = Новый ОписаниеТипов(МодульОбъекта().ЗначениеВМассиве(Параметры.ТипЗначений));
	КонецЕсли;
	
	Если Параметры.Свойство("Заголовок") Тогда
		Заголовок = Параметры.Заголовок;
	КонецЕсли;
	
	Если Параметры.Свойство("ИспользоватьПометки") Тогда
		ЭтоСписокСПометками = Параметры.ИспользоватьПометки;
	КонецЕсли;
	
	Если СписокЗначений.ТипЗначения.Типы().Количество() = 1
		И СписокЗначений.ТипЗначения.СодержитТип(Тип("Строка")) Тогда
		ЭтоСписокСтрок = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы()
	
	Если РазрешитьРедактирование Тогда
		Элементы.ФормаЗавершитьРедактирование.Видимость = Истина;
	Иначе
		Элементы.ФормаЗавершитьРедактирование.Видимость = Ложь;
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	МодульОбъекта().УстановитьСвойствоОбъекта(Элементы.СписокЗначенийЗначение, "КнопкаСоздания", Ложь);
	МодульОбъекта().УстановитьСвойствоОбъекта(Элементы.СписокЗначенийЗначение, "КнопкаОткрытия", Ложь);
	
	Если ЗначениеЗаполнено(Параметры.ДоступныеЗначения) Тогда
		Элементы.СписокЗначенийЗначение.СписокВыбора.ЗагрузитьЗначения(Параметры.ДоступныеЗначения);
		Элементы.СписокЗначенийЗначение.РежимВыбораИзСписка = Истина;
		Элементы.СписокЗначенийЗначение.КнопкаСпискаВыбора = Истина;
	Иначе
		
		Элементы.СписокЗначенийЗначение.КнопкаВыбора = Не ЭтоСписокСтрок;
		Элементы.СписокЗначенийЗначение.КнопкаСпискаВыбора = Ложь;
		
		МодульОбъекта().УстановитьСвойствоОбъекта(Элементы.СписокЗначенийЗначение, "КнопкаВыпадающегоСписка", Ложь);
		
	КонецЕсли;
	
	Если ЭтоСписокСПометками Тогда
		Элементы.СписокЗначенийПометка.Видимость = Истина;
		Элементы.СписокЗначений.ИзменятьСоставСтрок = Ложь;
		Элементы.СписокЗначений.ГоризонтальныеЛинии = Ложь;
	Иначе
		Элементы.СписокЗначенийПометка.Видимость = Ложь;
		Элементы.СписокЗначений.ИзменятьСоставСтрок = Истина;
		Элементы.СписокЗначений.ГоризонтальныеЛинии = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция РазделитьЗначение(Значение)
	
	Если Не ЭтоСписокСтрок
		Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КонецБлока = 182;
	МинимумЧастей = 2;
	
	Разделители = Новый Массив;
	Разделители.Добавить(Символ(КонецБлока));
	Разделители.Добавить(Символы.ПС);
	
	Для Каждого Разделитель Из Разделители Цикл
		
		Если Найти(Значение, Разделитель) = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЧастиЗначения = МодульКлиента().РазделитьСтроку(Значение, Разделитель, Истина);
		Если ЧастиЗначения.Количество() < МинимумЧастей Тогда
			Продолжить;
		КонецЕсли;
		
		МодульКлиента().СвернутьМассивЛок(ЧастиЗначения, Истина);
		СписокЗначений.Удалить(СписокЗначений.НайтиПоЗначению(Значение));
		
		Для Каждого ЧастьЗначения Из ЧастиЗначения Цикл
			СписокЗначений.Добавить(ЧастьЗначения);
		КонецЦикла;
		
		Возврат Истина;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// #КонецОбласти
