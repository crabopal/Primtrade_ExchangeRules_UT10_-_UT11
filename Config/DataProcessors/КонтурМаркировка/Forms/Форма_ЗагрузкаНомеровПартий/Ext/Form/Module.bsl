
// #Область СлужебныеПеременныеИМетодыФормы

&НаСервере
Перем КэшМодуляОбъекта;

&НаКлиенте
Перем КэшМодуляКлиента;

&НаСервере
Функция МодульОбъекта()
	
	Если КэшМодуляОбъекта <> Неопределено Тогда
		Возврат КэшМодуляОбъекта;
	КонецЕсли;
	
	КэшМодуляОбъекта = ВзаимодействиеКонтурМаркировка.МодульМаркировки(Истина);
	
	Возврат КэшМодуляОбъекта;
	
КонецФункции

&НаКлиенте
Функция МодульКлиента()
	
	Если КэшМодуляКлиента <> Неопределено Тогда
		Возврат КэшМодуляКлиента;
	КонецЕсли;
	
	КэшМодуляКлиента = ВзаимодействиеКонтурМаркировкаКлиент.МодульМаркировкиКлиент(Истина);
	
	Возврат КэшМодуляКлиента;
	
КонецФункции

// КонецОбласти // СлужебныеПеременныеИМетодыФормы

// #Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗагрузитьНомераПартий = МодульОбъекта().СвойствоСтруктуры(Параметры, "ЗагрузитьНомераПартий");
	
	ЗаполнитьТабличныйДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьЭлементы();
	
КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьНомераПартий(Команда)
	
	НомераПартий = НомераПартийИзТабличногоДокумента();
	
	Закрыть(НомераПартий);
	
КонецПроцедуры

// #КонецОбласти

// #Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТабличныйДокументПриАктивизации(Элемент)
	
	Если Элемент.ТекущаяОбласть = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ТабличныйДокумент.Редактирование = (Элемент.ТекущаяОбласть.Имя <> "R1C1")
											И (Элемент.ТекущаяОбласть.Имя <> "R1C2")
											И (Элемент.ТекущаяОбласть.Имя <> "R1C3");
	
КонецПроцедуры

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура НастроитьЭлементы()
	
	Элементы.ТабличныйДокумент.ТекущаяОбласть = ТабличныйДокумент.Область(ПерваяСтрокаСПартией(), ПерваяКолонка());
	ТекущийЭлемент = Элементы.ТабличныйДокумент;
	
	Элементы.ГруппаТекстПодсказки.Видимость = Не ЗагрузитьНомераПартий;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличныйДокумент()
	
	ТабличныйДокумент.Очистить();
	Если ЗагрузитьНомераПартий Тогда
		
		СтрокаШапки = 1;
		КолонкаШапки = 1;
		
		Шапка = ТабличныйДокумент.ПолучитьОбласть(СтрокаШапки, КолонкаШапки);
		ТекущаяОбласть = Шапка.Область();
		ТекущаяОбласть.ШиринаКолонки = 48;
		ТекущаяОбласть.Текст = НСтр("ru = 'Номер партии'");
		ТекущаяОбласть.ЦветФона = WebЦвета.СветлоЖелтыйЗолотистый;
		ТекущаяОбласть.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
		
		ТабличныйДокумент.Вывести(Шапка);
		ТабличныйДокумент.ФиксацияСверху = СтрокаШапки;
		
	Иначе
		
		СтрокаШапки = 1;
		Колонка1 = 1;
		Колонка2 = 2;
		Колонка3 = 3;
		
		ТабличныйДокумент.Область(, Колонка1,, Колонка1).ШиринаКолонки = 18;
		ТабличныйДокумент.Область(, Колонка2,, Колонка2).ШиринаКолонки = 20;
		ТабличныйДокумент.Область(, Колонка3,, Колонка3).ШиринаКолонки = 25;
		
		ТабличныйДокумент.Область(СтрокаШапки, Колонка1).Текст = НСтр("ru = 'GTIN'");
		ТабличныйДокумент.Область(СтрокаШапки, Колонка2).Текст = НСтр("ru = 'Дата производства'");
		ТабличныйДокумент.Область(СтрокаШапки, Колонка3).Текст = НСтр("ru = 'Серийный номер'");
		
		Шапка = ТабличныйДокумент.Область(СтрокаШапки, Колонка1, СтрокаШапки, Колонка3);
		Шапка.ЦветФона = WebЦвета.СветлоЖелтыйЗолотистый;
		Шапка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
		
		ТабличныйДокумент.ФиксацияСверху = СтрокаШапки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НомераПартийИзТабличногоДокумента()
	
	ПерваяКолонка = 1;
	ВтораяКолонка = 2;
	ТретьяКолонка = 3;
	
	Результат = Новый Массив;
	
	Для Сч = ПерваяСтрокаСПартией() По ТабличныйДокумент.ВысотаТаблицы Цикл
		
		СоставНомераПартии = Новый Структура("НомерПартии, GTIN, ДатаПроизводства, СерийныйНомер");
		
		Если ЗагрузитьНомераПартий Тогда
			
			НомерПартии = СокрЛП(ТабличныйДокумент.Область(Сч, ПерваяКолонка).Текст);
			Если Не ЗначениеЗаполнено(НомерПартии) Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураНомераПартии = МодульОбъекта().СтруктураНомераПартии(НомерПартии);
			ЗаполнитьЗначенияСвойств(СоставНомераПартии, СтруктураНомераПартии);
			
		Иначе
			
			GTIN = СокрЛП(ТабличныйДокумент.Область(Сч, ПерваяКолонка).Текст);
			ДатаПроизводства = МодульОбъекта().СтрокаВДату(СокрЛП(ТабличныйДокумент.Область(Сч, ВтораяКолонка).Текст));
			СерийныйНомер = СокрЛП(ТабличныйДокумент.Область(Сч, ТретьяКолонка).Текст);
			
			Если Не ЗначениеЗаполнено(GTIN)
				И Не ЗначениеЗаполнено(ДатаПроизводства)
				И Не ЗначениеЗаполнено(СерийныйНомер) Тогда
				Продолжить;
			КонецЕсли;
			
			СоставНомераПартии.GTIN = GTIN;
			СоставНомераПартии.ДатаПроизводства = ДатаПроизводства;
			СоставНомераПартии.СерийныйНомер = СерийныйНомер;
			СоставНомераПартии.НомерПартии = МодульОбъекта().СтрокаНомераПартии(GTIN, ДатаПроизводства, СерийныйНомер);
			
		КонецЕсли;
		
		Результат.Добавить(СоставНомераПартии);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПерваяКолонка()
	
	Возврат 1;
	
КонецФункции

&НаСервере
Функция ПерваяСтрокаСПартией()
	
	Возврат 2;
	
КонецФункции

// #КонецОбласти
