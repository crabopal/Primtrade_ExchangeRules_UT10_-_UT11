		НовыйКод.ВидУпаковки = Перечисления.КонтурМаркировка_ВидыУпаковок.Потребительская;
		НовыйКод.ТипУпаковки = Перечисления.КонтурМаркировка_ТипыУпаковок.МаркированныйТовар;
		НовыйКод.ТипШтрихкода = Перечисления.КонтурМаркировка_ТипыШтрихкодов.GS1_DataMatrix;
		
		НовыйКод.АналитикаНоменклатуры.Номенклатура = Стр.Номенклатура;
