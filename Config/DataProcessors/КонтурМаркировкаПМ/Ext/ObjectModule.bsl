Функция КодыМаркировкиИзДокумента1С(Документ1С)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СпрКодов.ЗначениеШтрихкода КАК ЗначениеШтрихкода,
	|	СпрКодов.Номенклатура КАК Номенклатура,
	|	СпрКодов.Характеристика КАК Характеристика,
	|	СпрКодов.Упаковка КАК Упаковка,
	|	СпрКодов.Серия КАК Серия
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ШтрихкодыУпаковок КАК ТЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШтрихкодыУпаковокТоваров КАК СпрКодов
	|		ПО ТЧ.ШтрихкодУпаковки = СпрКодов.Ссылка
	|ГДЕ
	|	ТЧ.Ссылка = &Документ1С");
	
	Запрос.УстановитьПараметр("Документ1С", Документ1С);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Процедура ПримерКакЗаполнитьФайлВыгрузкиКодов(ОписанияФайлов, ТаблицаКодов, ФорматФайла, ДокументУчета)
	
	ОписаниеФайла = Новый_ОписаниеФайлаДляВыгрузкиКодов();
	
	Если ФорматФайла = Перечисление_ФорматыФайловСКодами().xlsx Тогда
		ОписаниеФайла.ДобавитьЗаголовкиКолонок = Истина;
	КонецЕсли;
	
	КодДата = ЗначенияРеквизитовОбъекта(ДокументУчета, "Код, Дата");
	ИмяФайла = ПараметрыВСтроку("Mark_%1_%2", КодДата.Код, Формат(КодДата.Дата, "ДФ=dd-MM-yyyy"));
	
	ОписаниеФайла.ИмяФайлаБезРасширения = ИмяФайла;
	ОписаниеФайла.ТаблицаСтрок.Колонки.Добавить("GTIN", , "GTIN");
	ОписаниеФайла.ТаблицаСтрок.Колонки.Добавить("Наименование", , "Наименование");
	ОписаниеФайла.ТаблицаСтрок.Колонки.Добавить("КодМаркировки", , "Код маркировки");
	
	Для каждого Стр Из ТаблицаКодов Цикл
		
		Если ЗначениеЗаполнено(Стр.ПолныйКод) Тогда
			КодМаркировки = Стр.ПолныйКод;
		ИначеЕсли ЗначениеЗаполнено(Стр.КодМаркировки) Тогда
			КодМаркировки = Стр.КодМаркировки;
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.ПредставлениеНоменклатуры) Тогда
			Наименование = Стр.ПредставлениеНоменклатуры;
		ИначеЕсли ЗначениеЗаполнено(Стр.Наименование) Тогда
			Наименование = Стр.Наименование;
		Иначе
			Продолжить;
		КонецЕсли;
		
		СтрокаФайла = ОписаниеФайла.ТаблицаСтрок.Добавить();
		СтрокаФайла.GTIN = Стр.GTIN;
		СтрокаФайла.Наименование = Наименование;
		СтрокаФайла.КодМаркировки = КодМаркировки;
		
	КонецЦикла;
	
	ОписанияФайлов.Добавить(ОписаниеФайла);
	
КонецПроцедуры

Процедура ПримерКакЗаполнитьВидыДокументовДляВыбора(ВидыДокументовДляВыбора, Документ1С)
	
	Организация1С = ЗначениеРеквизитаОбъекта(Документ1С, "Организация");
	
	// РТУ
	МетаданныеДокумента = Метаданные.Документы.РеализацияТоваровУслуг;
	ОписаниеВида = Новый_ОписаниеВидаДокументаДляВыбора();
	ОписаниеВида.Представление = МетаданныеДокумента.Синоним;
	ОписаниеВида.ПолноеИмяОбъекта = МетаданныеДокумента.ПолноеИмя();
	ОписаниеВида.ПараметрыФормы.Отбор.Вставить("Организация", Организация1С);
	ВидыДокументовДляВыбора.Добавить(ОписаниеВида);
	
	// ПТУ
	МетаданныеДокумента = Метаданные.Документы.ПриобретениеТоваровУслуг;
	ОписаниеВида = Новый_ОписаниеВидаДокументаДляВыбора();
	ОписаниеВида.Представление = МетаданныеДокумента.Синоним;
	ОписаниеВида.ИмяФормыВыбора = МетаданныеДокумента.Формы.ФормаВыбора.Имя;
	ОписаниеВида.ПолноеИмяОбъекта = МетаданныеДокумента.ПолноеИмя();
	ОписаниеВида.ПараметрыФормы.Отбор.Вставить("Организация", Организация1С);
	ВидыДокументовДляВыбора.Добавить(ОписаниеВида);
	
КонецПроцедуры

Процедура ПримерКакИзменитьРеквизитыОперации(Операция, Документ1С)
	
	Если Операция.ТипОперации = Перечисление_ТипыОпераций().ВыводИзОборота
		И ТипЗнч(Документ1С) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		
		Реквизиты = ЗначенияРеквизитовОбъекта(Документ1С, "Номер, Дата");
		
		Операция.ДопРеквизиты.НомерДокумента = Реквизиты.Номер;
		Операция.ДопРеквизиты.ДатаДокумента = Реквизиты.Дата;
		Операция.ДопРеквизиты.НаименованиеПервичногоДокумента = "Заказ наряд";
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПримерКакПолучитьАртикулНоменклатуры(ПараметрыНоменклатуры, Номенклатура)
	
	ПараметрыНоменклатуры.Артикул = ЗначениеРеквизитаОбъекта(Номенклатура, "Артикул");
	
КонецПроцедуры

Процедура ПримерКакПроверитьНаличиеНезавершенныхОпераций(ДокументУчетаСсылка, СтатусыДокумента)
	
	Если СтатусыДокумента.ОсновнойСтатус <> Перечисление_СтатусыДокументовУчета().Завершен Тогда
		Возврат;
	КонецЕсли;
	
	ПодходящиеТипы = Новый Массив;
	ПодходящиеТипы.Добавить(Перечисление_ТипыОпераций().ВыводИзОборота);
	СписокОпераций = ДокументУчета_СписокОпераций(ДокументУчетаСсылка, ПодходящиеТипы, Неопределено);
	
	Для каждого Стр Из СписокОпераций Цикл
		Если Стр.Статус <> Перечисление_СтатусыОпераций().ОперацияЗавершена Тогда
			ВызватьИсключение ПараметрыВСтроку(НСтр(
			"ru = 'По документу учета есть незавершенная операция: %1'"), Стр.ОперацияСсылка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПримерДозаполненияСпискаДокументовНужнымДопСвойством(СписокДокументовУчета, НужноеСвойство, ИмяДопКолонки)
	
	Если Не ЗначениеЗаполнено(СписокДокументовУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ЗАпрос.Текст = 
	"ВЫБРАТЬ
	|	ТабДок.Документ1С КАК Документ1С,
	|	ТабДок.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ТабДок
	|ИЗ
	|	&СписокДокументовУчета КАК ТабДок
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Документ1С
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДок.Документ1С КАК Документ1С,
	|	ТабДок.НомерСтроки КАК НомерСтроки,
	|	ДопСведения.Значение КАК Значение
	|ИЗ
	|	ТабДок КАК ТабДок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДопСведения
	|		ПО ТабДок.Документ1С = ДопСведения.Объект
	|			И (ДопСведения.Свойство = &НужноеСвойство)";
	Запрос.УстановитьПараметр("СписокДокументовУчета", СписокДокументовУчета);
	Запрос.УстановитьПараметр("НужноеСвойство", НужноеСвойство);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокДокументовУчета[Выборка.НомерСтроки - 1][ИмяДопКолонки] = Выборка.Значение;
	КонецЦикла;
	
КонецПроцедуры

// Выбирает из базы документы Реализация товаров и услуг по сопоставленным организациям
// 
// Возвращаемое значение:
//  Массив из ДокументСсылка.РеализацияТоваровУслуг - документы реализации
//
Функция ПримерКакПолучитьДокументы1С()
	
	Результат = Новый Массив;
	
	НачалоПериода = НачалоДня(ТекущаяДатаСеанса());
	КонецПериода = КонецДня(НачалоПериода);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурМаркировка_Организации КАК КонтурМаркировка_Организации
	|		ПО Т.Организация = КонтурМаркировка_Организации.Организация1С
	|ГДЕ
	|	Т.Дата МЕЖДУ &НачалоПериода И &КонецПериода");
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Создает по документу 1С документ учета и начинает по нему работу
// Если документ учета уже был создан - вернет ссылку на него
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С
// 
// Возвращаемое значение:
//  СправочникСсылка.КонтурМаркировка_ДокументыУчета - документ учета
//
Функция ПримерКакСоздатьДокументУчета(Документ1С)
	
	ДокументУчета = ДокументУчета_Найти(Документ1С);
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		// по переданному документу 1С уже создан документ учета
		Возврат ДокументУчета;
	КонецЕсли;
	
	НачатьРаботуСДокументом = Истина;
	ДокументУчета = ДокументУчета_Создать(Документ1С, НачатьРаботуСДокументом);
	
	Возврат ДокументУчета;
	
КонецФункции

// Создает по документу 1С операцию заказа кодов.
// Если по документу существуют операции заказа кодов - вернет первую
//
// Параметры:
//  Документ1С - ДокументСсылка - документ 1С
// 
