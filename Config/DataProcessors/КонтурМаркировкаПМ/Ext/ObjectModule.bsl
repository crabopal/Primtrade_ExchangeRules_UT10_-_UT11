	КонецЕсли;
	
	ТипОперации = Перечисление_ТипыОпераций().ОтчетОНанесении;
	МассивОпераций = ОперацииПоДокументу(Документ1С, ТипОперации);
	Если ЗначениеЗаполнено(МассивОпераций) Тогда
		// операция отчет о нанесении создана
