// Получает значение дополнительного реквизита "Размер" одной из связанных с товаром номенклатуры
//
// Параметры:
//  ИмяПараметра - Строка - имя параметра
//  ПараметрыЭтикетки - Структура - параметры этикетки
//  КэшДопПараметраПМ - Соответствие - кэш
// 
// Возвращаемое значение:
//  Произвольное - значение дополнительного реквизита "Размер" или Неопределено
//
Функция ПримерКакЗаполнитьДополнительныйПараметрЭтикеткиРазмер(ИмяПараметра, ПараметрыЭтикетки, КэшДопПараметраПМ)
	
	Результат = Неопределено;
	
	Если Не ИмяПараметра = "Размер" Тогда
		Возврат Результат;
	КонецЕсли;
	
	Товар = ПараметрыЭтикетки.GTIN.Ссылка;
	Результат = КэшДопПараметраПМ[Товар];
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СвязиНоменклатуры = СвязиНоменклатуры_Прочитать(Товар);
	Для Каждого СтрокаТЗ Из СвязиНоменклатуры Цикл
		
		Результат = ЗначениеДопРеквизитаОбъекта(СтрокаТЗ.Номенклатура, ИмяПараметра);
		Если ЗначениеЗаполнено(Результат) Тогда
			КэшДопПараметраПМ.Вставить(Товар, Результат);
			Возврат Результат;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Пример загрузки кодов маркировки из csv файла.
// Файл имеет следующую структуру:
// <КодМаркировки>Табуляция<GTIN>Табуляция<Наименование>
//
// Параметры:
//  КодыМаркировки - Массив - содержит структуры, см. Новый_ОписаниеНовогоКодаМаркировки();
//  Расширение - Строка - расширение файла;
//  ДвоичныеДанные - ДвоичныеДанные - данные файла;
//
Процедура ПримерКакЗагрузитьКодыИзCsvФайла(КодыМаркировки, Расширение, ДвоичныеДанные)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	КоличествоКолонок = 3;
	Чтение = Новый ЧтениеТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
	Пока Истина Цикл
		
		СтрокаТекста = Чтение.ПрочитатьСтроку();
		Если СтрокаТекста = Неопределено Тогда
			// дошли до конца файла
			Прервать;
		КонецЕсли;
		
		ЧастиТекста = РазделитьСтроку(СтрокаТекста, Символы.Таб);
		Если ЧастиТекста.Количество() <> КоличествоКолонок Тогда
			// строка имеет неверный формат
			// можно вызвать исключение или продолжить загрузку без этой строки
			Продолжить;
		КонецЕсли;
		
		ОписаниеКода = Новый_ОписаниеНовогоКодаМаркировки();
		ОписаниеКода.КодМаркировки = ЧастиТекста[0];
		ОписаниеКода.ВидПродукции = Перечисления.КонтурМаркировка_ВидыПродукции.Молоко;
		КодыМаркировки.Добавить(ОписаниеКода);
		
	КонецЦикла;
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
КонецПроцедуры

// Пример по настройке дополнительных кнопок в модуле
