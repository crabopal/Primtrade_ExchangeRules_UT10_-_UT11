	Возврат Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты));

КонецФункции // ПолучитьОписаниеТиповДаты()

Процедура ИнициализацияОбработки()
	
	мЭтоАвтоОбмен = Истина;
	
	мИмяОбработки = СтрЗаменить(Строка(ЭтотОбъект), "ВнешняяОбработкаОбъект.", "");
	мИмяОбработки = СтрЗаменить(мИмяОбработки, "ОбработкаОбъект.", "");
	
	мРазделитель = ";";

КонецПроцедуры

ИнициализацияОбработки();
