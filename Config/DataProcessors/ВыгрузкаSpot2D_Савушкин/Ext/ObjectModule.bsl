			ОбластьСтрока.Параметры.Заполнить(Строка);
			ОбластьСтрока.Параметры.Заполнить(ПараметрыМакета);			
			ТабДок.Вывести(ОбластьСтрока);	
		КонецЕсли;
	КонецЦикла;
	
	Если ТестоваяВыгрузка Тогда
		ТабДанные.Свернуть(,"Количество, Стоимость,СтоимостьБезНДС");//,СуммаЗакупаБезНДС,СуммаЗакупаСНДС");
