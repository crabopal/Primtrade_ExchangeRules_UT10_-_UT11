Процедура ВыполнитьВыгрузку() Экспорт
	
	Если мЭтоАвтоОбмен Тогда
		ЗаписьЖурналаРегистрации(мИмяОбработки, УровеньЖурналаРегистрации.Информация, , , "Начало выгрузки файлов");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала= НачалоДня(ТекущаяДата() - 86400 * 45);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = КонецДня(ТекущаяДата() - 86400);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Логин) Тогда 
		ВосстановитьНастройки();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Логин) Тогда 
		Сообщить("Ошибка формирования: не заполнены настройки!");
		ЗаписьЖурналаРегистрации(мИмяОбработки, УровеньЖурналаРегистрации.Информация, , , "Ошибка формирования: не заполнены настройки!");
		Возврат;
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПродажиОбороты.Номенклатура,
		|	ПродажиОбороты.Период
		|ПОМЕСТИТЬ ВтТовары
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(&ДатаНачала, &ДатаОкончания, День, &ОтборНоменклатура) КАК ПродажиОбороты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗакупкиОбороты.Номенклатура,
		|	ЗакупкиОбороты.Период
		|ИЗ
		|	РегистрНакопления.Закупки.Обороты(&ДатаНачала, &ДатаОкончания, День, &ОтборНоменклатура) КАК ЗакупкиОбороты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТоварыНаСкладахОстаткиИОбороты.Номенклатура,
		|	ТоварыНаСкладахОстаткиИОбороты.Период
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(&ДатаНачала, &ДатаОкончания, День, , &ОтборНоменклатура) КАК ТоварыНаСкладахОстаткиИОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВтТовары.Номенклатура
		|ИЗ
		|	ВтТовары КАК ВтТовары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТоварыНаСкладахОбороты.Период) КАК Период,
		|	ТоварыНаСкладахОбороты.Склад
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Обороты(&ДатаНачала, &ДатаОкончания, День, &ОтборНоменклатура) КАК ТоварыНаСкладахОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыНаСкладахОбороты.Склад";
	
	//Лакталис Восток АО
	//УТ000003912
	Если ЗначениеЗаполнено(ОсновнойПоставщик) Тогда
		ТекстОтбор = "Номенклатура.ОсновнойПоставщик = &ОсновнойПоставщик";
	Иначе
		ТекстОтбор = "";
	КонецЕсли;
	Если Товары.Количество() > 0 Тогда
