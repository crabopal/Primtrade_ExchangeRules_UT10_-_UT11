Функция ВыгрузитьДанные_receive()
	
	ИмяФайла = "receive.csv";	//закупки
	 
	Если ТестоваяВыгрузка Тогда
		Макет = ПолучитьМакет("Макет");
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка_receive");
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка_receive");
		
		ТабДок = Новый ТабличныйДокумент;
		ТабДок.Вывести(ОбластьШапка);
	КонецЕсли;


	//Колонки
	Текст = 
	"ID дистрибьютора"			    + мРазделитель +
	"Дата"					        + мРазделитель + 
	"Код продукта дистрибьютора"	+ мРазделитель +		 
	"Количество"				    + мРазделитель + 
	
	//"Сумма в закупочных ценах"      + мРазделитель +
	//"Сумма в закупочных ценах с НДС"+ мРазделитель +
	"Номер накладной"				+ мРазделитель +
	"Годен до"                      + мРазделитель +
	"Дата производства"             + мРазделитель +
	"Номер партии"					+ Символы.ПС;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТабДней.Дата
		|ПОМЕСТИТЬ ВтДаты
		|ИЗ
		|	&ТабДней КАК ТабДней
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВтДаты.Дата КАК Дата,
		|	ЕСТЬNULL(ЗакупкиОбороты.ДокументЗакупки.Номер, """") КАК ДокументНомер,
		|	ЕСТЬNULL(ЗакупкиОбороты.Номенклатура.Код, &НоменклатураКод) КАК НоменклатураКод,
		|	СУММА(ЕСТЬNULL(ЗакупкиОбороты.КоличествоОборот, 0)) КАК Количество,
		|	СУММА(ЕСТЬNULL(ЗакупкиОбороты.СтоимостьОборот, 0)) КАК Стоимость,
		|	СУММА(ЕСТЬNULL(ЗакупкиОбороты.НДСОборот, 0)) КАК СуммаНДС
		|ИЗ
		|	ВтДаты КАК ВтДаты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Закупки.Обороты(&ДатаНачала, &ДатаОкончания, Регистратор, Номенклатура В (&Номенклатура)) КАК ЗакупкиОбороты
		|		ПО (ВтДаты.Дата = НАЧАЛОПЕРИОДА(ЗакупкиОбороты.Период, ДЕНЬ))
		|			И (ЗакупкиОбороты.Регистратор ССЫЛКА Документ.ПоступлениеТоваровУслуг
		|				ИЛИ ЗакупкиОбороты.Регистратор ССЫЛКА Документ.ВозвратТоваровПоставщику)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕСТЬNULL(ЗакупкиОбороты.ДокументЗакупки.Номер, """"),
		|	ВтДаты.Дата,
		|	ЕСТЬNULL(ЗакупкиОбороты.Номенклатура.Код, &НоменклатураКод)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	
	//Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборНоменклатура", ?(Товары.Количество() > 0, "Номенклатура В (&Номенклатура)", ""));
	
	
	Запрос.УстановитьПараметр("ДатаНачала",    ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));		
	Запрос.УстановитьПараметр("Номенклатура",  МассивТоваров);
	Запрос.УстановитьПараметр("ТабДней",  ТабДней);
	Запрос.УстановитьПараметр("НоменклатураКод",  ?(МассивТоваров.Количество() > 0, ОбработатьСтроку(МассивТоваров[0].Код), ""));
	//Запрос.УстановитьПараметр("СкладКод",  ?(МассивСкладов.Количество() > 0, ОбработатьСтроку(МассивСкладов[0].Код), ""));
	

	
	//Настройка.Номенклатура.ВыгрузитьКолонку("Ссылка"));
	//Запрос.Выполнить().ВЫгрузить()
	Выборка = Запрос.Выполнить().Выбрать();
		
	ВсегоСтрок = Выборка.Количество();
	Счетчик = 0;
	
	ПараметрыМакета = Новый Структура;
	ПараметрыМакета.Вставить("КодДистрибьютора", КодДистрибьютора);
	    
	Пока Выборка.Следующий() Цикл
		//Если МассивТоваров.Найти(Выборка.Номенклатура) = Неопределено Тогда
		//	МассивТоваров.Добавить(Выборка.Номенклатура);
		//КонецЕсли;
		
		ПараметрыМакета.Вставить("Дата", Формат(Выборка.Дата, "ДФ=dd.MM.yyyy"));
	    ПараметрыМакета.Вставить("НоменклатураКод", ОбработатьСтроку(Выборка.НоменклатураКод));
		ПараметрыМакета.Вставить("СуммаЗакупаБезНДС", ФорматСумм(Выборка.Стоимость - Выборка.СуммаНДС));
		ПараметрыМакета.Вставить("СуммаЗакупаСНДС", ФорматСумм(Выборка.Стоимость)	);

		Счетчик = Счетчик + 1;
		#Если Клиент Тогда 				
			Состояние("Выгружено (" + ИмяФайла + ") " + Цел(Счетчик / ВсегоСтрок * 100) + "%");
			ОбработкаПрерыванияПользователя();
		#КонецЕсли
		
		Текст = Текст + КодДистрибьютора			+ мРазделитель
				+ ПараметрыМакета.Дата				+ мРазделитель
				+ ПараметрыМакета.НоменклатураКод	+ мРазделитель
				+ Формат(Выборка.Количество, "ЧН=0; ЧГ=")	+ мРазделитель
				
				//+ ПараметрыМакета.СуммаЗакупаБезНДС	+ мРазделитель //"Сумма в закупочных ценах"
				//+ ПараметрыМакета.СуммаЗакупаСНДС	+ мРазделитель //"Сумма в закупочных ценах с НДС"
				+ СокрЛП(Выборка.ДокументНомер)		+ мРазделитель
				
				+ мРазделитель //"Годен до"
				+ мРазделитель //"Дата производства"
				+ Символы.ПС; //"Номер партии"	
				
		Если ТестоваяВыгрузка Тогда
			ОбластьСтрока.Параметры.Заполнить(Выборка);			
			ОбластьСтрока.Параметры.Заполнить(ПараметрыМакета);			
			ТабДок.Вывести(ОбластьСтрока);	
		КонецЕсли;
			
	КонецЦикла;
	
	Если ТестоваяВыгрузка Тогда
		
		ТабДанные = Запрос.Выполнить().Выгрузить();
		ТабДанные.Свернуть(,"Количество,Стоимость,СуммаНДС");
		Выборка = ТабДанные[0];
		
		ПараметрыМакета.Вставить("СуммаЗакупаБезНДС", ФорматСумм(Выборка.Стоимость - Выборка.СуммаНДС));
		ПараметрыМакета.Вставить("СуммаЗакупаСНДС", ФорматСумм(Выборка.Стоимость));
		ПараметрыМакета.Вставить("Количество", Формат(Выборка.Количество, "ЧН=0; ЧГ="));

		ОбластьСтрока = Макет.ПолучитьОбласть("Итог_receive");
		ОбластьСтрока.Параметры.Заполнить(ПараметрыМакета);			
		ТабДок.Вывести(ОбластьСтрока);
		
		УниверсальныеМеханизмы.НапечататьДокумент(ТабДок, 1, Ложь, ИмяФайла);
	КонецЕсли;
	
	//#Если Клиент Тогда
	//	Сообщить(" ");
