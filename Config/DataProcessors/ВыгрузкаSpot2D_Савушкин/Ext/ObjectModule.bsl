#Область РаботаСНастройкамиВыгрузки

Процедура ВосстановитьНастройки() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СохраненныеНастройки.СохраненнаяНастройка КАК ПараметрыВыгрузки 
		|ИЗ
		|	РегистрСведений.СохраненныеНастройки КАК СохраненныеНастройки
		|ГДЕ
		|	СохраненныеНастройки.ИмяОбъекта = &ИмяОбъекта
		|	И СохраненныеНастройки.НаименованиеНастройки = &НаименованиеНастройки";
	
	Запрос.УстановитьПараметр("ИмяОбъекта","ВнешняяОбработкаОбъект." + мИмяОбработки);
	Запрос.УстановитьПараметр("НаименованиеНастройки","Основная");
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		НастройкиИзХранилища = Результат.ПараметрыВыгрузки.Получить();	
	Иначе
		Возврат;
	КонецЕсли;
	
	ИсключаемыеСв = "";
	Если НастройкиИзХранилища.Свойство("Товары") Тогда
		ИсключаемыеСв = ИсключаемыеСв + "Товары,";
		Товары.Загрузить(НастройкиИзХранилища.Товары);
	КонецЕсли;
	
	Если НастройкиИзХранилища.Свойство("Склады") Тогда
		ИсключаемыеСв = ИсключаемыеСв + "Склады,";
		Склады.Загрузить(НастройкиИзХранилища.Склады);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиИзХранилища,, ИсключаемыеСв);
		
КонецПроцедуры

Процедура СохранитьНастройки() Экспорт
		
	ПараметрыВыгрузки = Новый Структура;
	ПараметрыВыгрузки.Вставить("АдресСайта", АдресСайта);
	ПараметрыВыгрузки.Вставить("Логин", Логин);
	ПараметрыВыгрузки.Вставить("Пароль", Пароль);
	ПараметрыВыгрузки.Вставить("Каталог", Каталог);
	ПараметрыВыгрузки.Вставить("КодДистрибьютора", КодДистрибьютора);
	ПараметрыВыгрузки.Вставить("ОсновнойПоставщик", ОсновнойПоставщик);
	                 
	ПараметрыВыгрузки.Вставить("Товары", Товары.Выгрузить());
	ПараметрыВыгрузки.Вставить("Склады", Склады.Выгрузить());
	
	СохраненнаяНастройка = Новый ХранилищеЗначения(ПараметрыВыгрузки);
			
	РегистрНастроек = РегистрыСведений.СохраненныеНастройки.СоздатьМенеджерЗаписи();
	РегистрНастроек.ИмяОбъекта   			= "ВнешняяОбработкаОбъект." + мИмяОбработки;
	РегистрНастроек.НаименованиеНастройки 	= "Основная";
	
	РегистрНастроек.СохраненнаяНастройка	= СохраненнаяНастройка;
	РегистрНастроек.ИспользоватьПриОткрытии = Ложь;
	РегистрНастроек.СохранятьАвтоматически  = Ложь;
	
	Попытка
		РегистрНастроек.Записать(Истина);
	Исключение
		ОбщегоНазначения.СообщитьОбОшибке("Настройка не была записана по причине: " + ОписаниеОшибки());
	КонецПопытки;
		
КонецПроцедуры
#КонецОбласти

