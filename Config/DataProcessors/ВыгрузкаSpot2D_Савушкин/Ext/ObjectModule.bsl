		//"Код клиента ERP"  + мРазделитель + 
		//"Название клиента"	+ мРазделитель + 
		//"Адрес клиента"		+ мРазделитель +	   
		//"Название ТТ"		+ мРазделитель +
		//"Адрес ТТ"			+ мРазделитель +
		//"Код ИНН"
		КонтрагентКод = СокрЛП(Выборка.КонтрагентКод) + "#" + СокрЛП(Выборка.ТорговаяТочкаКод);
		//+ СокрЛП(?(ЗначениеЗаполнено(Выборка.ТорговаяТочкаКод), Выборка.ТорговаяТочкаКод, Выборка.КонтрагентКод));

		Текст = Текст + КодДистрибьютора						+ мРазделитель
			+ КонтрагентКод	+ мРазделитель
			+ ОбработатьСтроку(Выборка.КонтрагентПредставление)	+ мРазделитель
			+ ОбработатьСтроку(Выборка.КонтрагентЮрАдрес)		+ мРазделитель
			+ ОбработатьСтроку(Выборка.КонтрагентПредставление) + " " + ОбработатьСтроку(Выборка.ТорговаяТочкаАдрес) + мРазделитель
			//+ ОбработатьСтроку(?(ЗначениеЗаполнено(Выборка.ТорговаяТочкаАдрес), Выборка.ТорговаяТочкаАдрес, Выборка.КонтрагентФактАдрес)) + мРазделитель
			+ ОбработатьСтроку(Выборка.ТорговаяТочкаАдрес) + мРазделитель
			+ СокрЛП(Выборка.Инн)+ мРазделитель 
			+ "Покупатели" + Символы.ПС;
				
	КонецЦикла;
	
	Возврат СохранитьДанныеВФайл(Текст, Каталог + "\" + ИмяФайла);

КонецФункции


Функция СохранитьДанныеВФайл(Текст, ПолныйПуть)
	
	Файл = Новый ТекстовыйДокумент;
	
	ФайлЗаписан = Ложь;

	//Если КоличествоВыгруженныхОбъектов > 0 Тогда

	Файл.ДобавитьСтроку(Текст);

	//ПолныйПуть = Каталог + "\" + ИмяФайла;

	Попытка  	
		
		//Ошибка
		Файл.Записать(ПолныйПуть, КодировкаТекста.UTF8);
		ФайлЗаписан = Истина;
	Исключение 
		ТекстОшибки = ОписаниеОшибки();
		#Если Клиент Тогда
			Сообщить(ТекстОшибки);
		#КонецЕсли
		Если мЭтоАвтоОбмен Тогда
			ЗаписьЖурналаРегистрации(мИмяОбработки, УровеньЖурналаРегистрации.Ошибка,,, 
				"Ошибка формирования файла " + ПолныйПуть + ". Текст ошибки: " + ТекстОшибки);
		КонецЕсли;
	КонецПопытки;

	//Сообщить("Файл сохранен: " + ПолныйПуть + """");
	Возврат ФайлЗаписан;
	
КонецФункции		
		
Функция ОбработатьСтроку(ВхСтрока)

	//Если значения ячеек содержат зарезервированные символы 
	//(двойная кавычка, точка с запятой, переход на новую строку),
	//то данные ячеек этого типа следует взять в двойные кавычки (“).
	//Если в значениях ячеек встречаются кавычки — они представляются в файле в виде двух кавычек подряд (“”). 
	//Строки разделяются парой символов CR LF (0x0D 0x0A) (в DOS и Windows эта пара генерируется нажатием клавиши Enter) 
	//и LF (0x0A) в системах UNIX.		
	
	ТекСтрока = СтрЗаменить(СокрЛП(ВхСтрока), мРазделитель, " ");
	ТекСтрока = СтрЗаменить(ТекСтрока, Символы.ПС, " ");
	ТекСтрока = СтрЗаменить(ТекСтрока, "¶", " ");
	Возврат СокрЛП(ТекСтрока);	
		
	//Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(СокрЛП(ВхСтрока),
	//	мРазделитель, " "),
	//	Символы.ПС, " "),
	//	"¶", " ");
	
	
КонецФункции
	
Функция ФорматСумм(ВхЗнач)
	
	Возврат Формат(ВхЗнач, "ЧДЦ=2; ЧРД=,; ЧН=0; ЧГ=");
	
КонецФункции

