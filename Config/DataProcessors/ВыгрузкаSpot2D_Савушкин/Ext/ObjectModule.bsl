	КонецЕсли;
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборНоменклатура", ?(ЗначениеЗаполнено(ТекстОтбор), "(" + ТекстОтбор + ")", ""));
	
	//ДатаНачала    = '20250601';
	//ДатаОкончания = НачалоДня(ТекущаяДата())-1;
	
