Функция ВыгрузитьДанные_cancellations()
	
	ИмяФайла = "cancellations.csv";	//операции перемещения между филиалами/складами дистрибьютора, списание продукции, оприходование излишков.
	
	//Колонки
	Текст = 
	"ID дистрибьютора"			    + мРазделитель +
	"Дата"					        + мРазделитель + 
	"Код продукта дистрибьютора"	+ мРазделитель +		 
	"Количество"				    + мРазделитель + 
	"Номер документа"				+ мРазделитель +
	"Годен до"                      + мРазделитель +
	"Дата производства"             + мРазделитель +
	"Номер партии"					+ Символы.ПС;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТабДней.Дата
		|ПОМЕСТИТЬ ВтДаты
		|ИЗ
		|	&ТабДней КАК ТабДней
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ТоварыНаСкладахОбороты.Номенклатура.Код, &НоменклатураКод) КАК НоменклатураКод,
		|	СУММА(ЕСТЬNULL(ТоварыНаСкладахОбороты.КоличествоПриход, 0)) - СУММА(ЕСТЬNULL(ТоварыНаСкладахОбороты.КоличествоРасход, 0)) КАК Количество,
		|	ТоварыНаСкладахОбороты.Регистратор.Номер КАК ДокументНомер,
		|	ВтДаты.Дата КАК Дата
		|ИЗ
		|	ВтДаты КАК ВтДаты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Обороты(&ДатаНачала, &ДатаОкончания, Регистратор, Номенклатура В (&Номенклатура)) КАК ТоварыНаСкладахОбороты
		|		ПО (ВтДаты.Дата = НАЧАЛОПЕРИОДА(ТоварыНаСкладахОбороты.Период, ДЕНЬ))
		|			И (НЕ ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.ВозвратТоваровОтПокупателя)
		|			И (НЕ ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.КорректировкаРеализации)
		|			И (НЕ ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.ОтчетОРозничныхПродажах)
		|			И (НЕ ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг)
		|			И (НЕ ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.ВозвратТоваровПоставщику)
		|			И (НЕ ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.КорректировкаПоступления)
		|			И (НЕ ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.ПоступлениеТоваровУслуг)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕСТЬNULL(ТоварыНаСкладахОбороты.Номенклатура.Код, &НоменклатураКод),
		|	ВтДаты.Дата,
		|	ТоварыНаСкладахОбороты.Регистратор.Номер
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	
	//Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборНоменклатура", ?(Товары.Количество() > 0, "Номенклатура В (&Номенклатура)", ""));
	
	
	Запрос.УстановитьПараметр("ДатаНачала",    ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));		
	Запрос.УстановитьПараметр("Номенклатура",  МассивТоваров);
	Запрос.УстановитьПараметр("ТабДней",  ТабДней);
	Запрос.УстановитьПараметр("НоменклатураКод",  ?(МассивТоваров.Количество() > 0, ОбработатьСтроку(МассивТоваров[0].Код), ""));
	
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	ВсегоСтрок = Выборка.Количество();
	Счетчик = 0;
	
	Пока Выборка.Следующий() Цикл
	
		Счетчик = Счетчик + 1;
		#Если Клиент Тогда 				
			Состояние("Выгружено (" + ИмяФайла + ") " + Цел(Счетчик / ВсегоСтрок * 100) + "%");
			ОбработкаПрерыванияПользователя();
		#КонецЕсли
		Текст = Текст + КодДистрибьютора					+ мРазделитель
				+ Формат(Выборка.Дата, "ДФ=dd.MM.yyyy")			+ мРазделитель
				+ ОбработатьСтроку(Выборка.НоменклатураКод)		+ мРазделитель
				+ Формат(Выборка.Количество, "ЧН=0; ЧГ=")		+ мРазделитель
				
				+ СокрЛП(Выборка.ДокументНомер)					+ мРазделитель
				+ мРазделитель //"Годен до"
				+ мРазделитель //"Дата производства"
				+ Символы.ПС; //"Номер партии"
			
	КонецЦикла;
	
	Возврат СохранитьДанныеВФайл(Текст, Каталог + "\" + ИмяФайла);
	
КонецФункции
