		ТабДней.Добавить().Дата = ТекДата;
		ТекДата = ТекДата + 60*60*24;
	КонецЦикла;		
	
	//ВыгрузитьДанные(Строка.Ш_ОбъектПредставление, Строка.Статус, мЭтоАвтоОбмен); 		
	ВыгруженныеФайлы = Новый Структура();
	ВыгруженныеФайлы.Вставить("delivery", 	ВыгрузитьДанные_delivery());
	ВыгруженныеФайлы.Вставить("stocks", 	ВыгрузитьДанные_stocks());
	//ВыгруженныеФайлы.Вставить("warehouses", ВыгрузитьДанные_warehouses());
	ВыгруженныеФайлы.Вставить("receive", 	ВыгрузитьДанные_receive());
	ВыгруженныеФайлы.Вставить("cancellations",ВыгрузитьДанные_cancellations());
	//ВыгруженныеФайлы.Вставить("clients", 	ВыгрузитьДанные_clients());
	ВыгруженныеФайлы.Вставить("ttoptions",	ВыгрузитьДанные_ttoptions());
	
	ВыгруженныеФайлы.Вставить("ta", 		ВыгрузитьДанные_ta());
	ВыгруженныеФайлы.Вставить("sku", 		ВыгрузитьДанные_sku());
	
	//Для Каждого КлючЗнач Из ВыгруженныеФайлы Цикл
	//	
	//КонецЦикла;
	
	Если мЭтоАвтоОбмен Тогда
		ЗаписьЖурналаРегистрации(мИмяОбработки, УровеньЖурналаРегистрации.Информация, , , "Отправка файлов Spot2D на сайт.");
	КонецЕсли;
	
	Попытка
		УдалитьФайлы(Каталог + "\" + "Date.txt");
	Исключение
	КонецПопытки;
	
	ФайлРегистрации = Новый ЗаписьТекста(Каталог + "\" + "Date.txt", КодировкаТекста.ANSI, , Истина);	
	ФайлРегистрации.Записать(Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy") + " (" + Строка(ТекущаяДата()) + ")");	
	ФайлРегистрации.Закрыть();
	
	//Выгружен = Ложь;
	
	//#Если Клиент Тогда
	//Если ТестоваяВыгрузка Тогда
	//	ЗапуститьПриложение("explorer " + Каталог); 		
	// 	Возврат;
	//КонецЕсли;	
	//#КонецЕсли
	
	Если ТестоваяВыгрузка Тогда
	 	Возврат;
	КонецЕсли;
	
	Попытка  		
		WshShell = Новый COMОбъект("WScript.Shell");
		WshShell.Run(Каталог + "\Exchange.cmd" ,7,-1);		
		#Если Клиент Тогда
			Сообщить("Выгрузка на сайт успешно выполнена!");
		#КонецЕсли
		Если мЭтоАвтоОбмен Тогда
			ЗаписьЖурналаРегистрации(мИмяОбработки, УровеньЖурналаРегистрации.Информация, , , "Выгрузка файлов Spot2D выполнена успешно!");
		КонецЕсли;
		//Выгружен = Истина;
	Исключение
		Сообщить(ОписаниеОшибки());
		Если мЭтоАвтоОбмен Тогда
			ЗаписьЖурналаРегистрации(мИмяОбработки, УровеньЖурналаРегистрации.Ошибка, , , "Выгрузка файлов Spot2D завершена с ошибками! Текст ошибки: " + ОписаниеОшибки());
		КонецЕсли;
	КонецПопытки;
	
	
	//Если Не Выгружен И Выгружать Тогда
	//	Попытка
	//		КомандаСистемы("C:\Hochland\Exchange.cmd");
	//		Если мЭтоАвтоОбмен Тогда
	//			ЗаписьЖурналаРегистрации(мИмяОбработки, УровеньЖурналаРегистрации.Информация, , , "Выгрузка файлов Spot2D выполнена успешно!");
	//		КонецЕсли;	
	//	Исключение
	//		Сообщить(ОписаниеОшибки());
	//		Если мЭтоАвтоОбмен Тогда
	//			ЗаписьЖурналаРегистрации(мИмяОбработки, УровеньЖурналаРегистрации.Ошибка, , , "Выгрузка файлов Spot2D завершена с ошибками! Текст ошибки: " + ОписаниеОшибки());
