		Счетчик = Счетчик + 1;
		#Если Клиент Тогда
			Состояние("Выгружено (" + ИмяФайла + ") " + Цел(Счетчик / ВсегоСтрок * 100) + "%");
			ОбработкаПрерыванияПользователя();	
		#КонецЕсли
		
		//СведенияОКонтрагенте = УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(Контрагент, КонецДня(ДатаОкончания));
		
		//Если Не ЗначениеЗаполнено(СведенияОКонтрагенте.ФактическийАдрес) Тогда
		//	
		//	#Если Клиент Тогда
		//		Сообщить("У контрагента " + """" + Контрагент + """" + " не заполнен фактический адрес!", СтатусСообщения.ОченьВажное);
		//	#КонецЕсли
		//	
		//	Ошибка = Истина;
		//	
		//КонецЕсли;	
		
		Текст = Текст + КодДистрибьютора		+ мРазделитель
			+ СокрЛП(Выборка.Код)				+ мРазделитель
			+ СокрЛП(Выборка.НаименованиеПолное)+ мРазделитель
			+ СокрЛП(Выборка.ФактическийАдрес) 	+ Символы.ПС;
		
	КонецЦикла;
	
	Возврат СохранитьДанныеВФайл(Текст, Каталог + "\" + ИмяФайла);

КонецФункции
Функция ВыгрузитьДанные_ta()
	
	ИмяФайла = "ta.csv";		
	
	// Колонки
	Текст = 
	"ID дистрибьютора" + мРазделитель +
	"Код ТА"  + мРазделитель + 
	"Имя ТА" + Символы.ПС;
	
	ВсегоСтрок = МассивАгентов.Количество();
	Счетчик = 0;
	
	Для Каждого Агент Из МассивАгентов Цикл
		
		Если Не ЗначениеЗаполнено(Агент.Код) Тогда
			Продолжить;
		КонецЕсли;
			
		//ЕстьФизЛицо = Ложь;
		//СокрЛП(Агент.Код)
		
		
		Счетчик = Счетчик + 1;
		#Если Клиент Тогда
			Состояние("Выгружено (" + ИмяФайла + ") " + Цел(Счетчик / ВсегоСтрок * 100) + "%");
			ОбработкаПрерыванияПользователя();	
		#КонецЕсли
		
		Текст = Текст + КодДистрибьютора													+ мРазделитель
			//+ ?(ЕстьФизЛицо, СокрЛП(Агент.ФизЛицо.Код), СокрЛП(Агент.Код))					+ мРазделитель
			//+ ?(ЕстьФизЛицо, СокрЛП(Агент.ФизЛицо.Наименование), СокрЛП(Агент.Наименование))+ Символы.ПС;
			+ Лев(СокрЛП(Агент.Код), 64)			+ мРазделитель
			+ ОбработатьСтроку(Агент.Наименование)	+ Символы.ПС;
		

	КонецЦикла;
		
	Возврат СохранитьДанныеВФайл(Текст, Каталог + "\" + ИмяФайла);
		
КонецФункции
Функция ВыгрузитьДанные_sku()		
	
	ИмяФайла = "sku.csv";

	// Колонки
	Текст = 
	"ID дистрибьютора"              + мРазделитель +
	"Код продукта дистрибьютора"    + мРазделитель + 
	"Название продукта"             + мРазделитель +
	"Штрихкод"             			+ мРазделитель +
	"Код продукта производителя"	+ мРазделитель +
	"ID единицы измерения продукта" + Символы.ПС;
	
	//ВсегоСтрок = МассивТоваров.Количество();
	Счетчик = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка,
		|	Номенклатура.Код,
		|	Номенклатура.Артикул,
		|	Номенклатура.Наименование,
		|	ВЫРАЗИТЬ(Номенклатура.НаименованиеПолное КАК СТРОКА(250)) КАК НаименованиеПолное,
		|	МАКСИМУМ(ЕСТЬNULL(Штрихкоды.Штрихкод, """")) КАК Штрихкод,
		|	Номенклатура.БазоваяЕдиницаИзмерения.Код КАК ЕдИзмКод
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
		|		ПО Номенклатура.Ссылка = Штрихкоды.Владелец
		|ГДЕ
		|	Номенклатура.Ссылка В(&МассивТоваров)
		|
		|СГРУППИРОВАТЬ ПО
		|	Номенклатура.Ссылка,
		|	Номенклатура.Код,
		|	Номенклатура.Наименование,
		|	ВЫРАЗИТЬ(Номенклатура.НаименованиеПолное КАК СТРОКА(250)),
		|	Номенклатура.БазоваяЕдиницаИзмерения.Код,
		|	Номенклатура.Артикул";
	
	
	Запрос.УстановитьПараметр("МассивТоваров", МассивТоваров);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ВсегоСтрок = Выборка.Количество();
	
	
	Пока Выборка.Следующий() Цикл
		
		Счетчик = Счетчик + 1;
		#Если Клиент Тогда
			Состояние("Выгружено (" + ИмяФайла + ") " + Цел(Счетчик / ВсегоСтрок * 100) + "%");
			ОбработкаПрерыванияПользователя();	
		#КонецЕсли
	
		Если Не ЗначениеЗаполнено(Выборка.ЕдИзмКод) Тогда
			ЕдИзмКод = "";
		ИначеЕсли СокрЛП(Выборка.ЕдИзмКод) = "796" Тогда
			ЕдИзмКод = 1;
		ИначеЕсли СокрЛП(Выборка.ЕдИзмКод) = "812" Тогда
			ЕдИзмКод = 2;
		ИначеЕсли СокрЛП(Выборка.ЕдИзмКод) = "166" Тогда
			ЕдИзмКод = 3;
		Иначе
			ЕдИзмКод = "";
		КонецЕсли;
		
		
		
		//Если Не ЗначениеЗаполнено(Товар.БазоваяЕдиницаИзмерения) Тогда
		//	
		//	#Если Клиент Тогда
		//		Сообщить("У товара " + """" + Товар + """" + " не заполнена единица измерения!", СтатусСообщения.ОченьВажное);
		//	#КонецЕсли
		//	
		//	Ошибка = Истина;
		//	
		//Коне
		Текст = Текст + КодДистрибьютора		+ мРазделитель
			+ ОбработатьСтроку(Выборка.Код)		+ мРазделитель
			+ ОбработатьСтроку(Выборка.НаименованиеПолное)+ мРазделитель
			+ СокрЛП(Выборка.Штрихкод)			+ мРазделитель		//"Штрихкод производитля"
			+ СокрЛП(Выборка.Артикул)			+ мРазделитель		//"Код продукта производителя"
			+ ЕдИзмКод							+ Символы.ПС;
			
	КонецЦикла;
	
	Возврат СохранитьДанныеВФайл(Текст, Каталог + "\" + ИмяФайла);
	
КонецФункции

