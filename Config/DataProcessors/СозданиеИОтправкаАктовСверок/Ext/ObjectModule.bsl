Перем ИмяОбъекта;
Перем НаименованиеНастройки;

Процедура ОтправитьПисьмоПоПолучателю(Вложения, Получатель, ТекстПисьма = "", ДопТекстТемыПисьмаНачало ="", РезультатОтправки = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(Получатель) Тогда
		Сообщить("Ошибка отправки эл. письма: Не указан эл.адрес получателя письма!");
		Возврат;
	КонецЕсли;
	
	УчетнаяЗапись = ПолучитьУчетнуюЗапись();
	Если УчетнаяЗапись = Неопределено Тогда
		Сообщить("Ошибка отправки эл. письма: Не найден почтовый профиль рассылки из 1с. Обратитесь к администратору!");
		Возврат;
	КонецЕсли;
	
	Профиль = УправлениеЭлектроннойПочтой.ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗапись);
	Письмо = Новый ИнтернетПочтовоеСообщение; 
	Письмо.Отправитель = УчетнаяЗапись.АдресЭлектроннойПочты;
	//Письмо.ИмяОтправителя =;
	// >>> Dexcel
	ТемаПисьма = Тема;	
	Если ТипЗнч(ДопТекстТемыПисьмаНачало) = Тип("ДокументСсылка.АктСверкиВзаиморасчетов")
		ИЛИ ТипЗнч(ДопТекстТемыПисьмаНачало) = Тип("ДокументСсылка.АктСверкиВзаиморасчетовГр") Тогда
		ТемаПисьма = СтрЗаменить(ТемаПисьма, "[АктСверки]", Строка(ДопТекстТемыПисьмаНачало));
		Если СтрНайти(Тема, "[ИННКПП]") <> 0 Тогда  
			ИНН = ?(ЗначениеЗаполнено(ДопТекстТемыПисьмаНачало.Организация.ИНН), "ИНН: " + ДопТекстТемыПисьмаНачало.Организация.ИНН, "");  
			КПП = ?(ЗначениеЗаполнено(ДопТекстТемыПисьмаНачало.Организация.КПП), "КПП: " + ДопТекстТемыПисьмаНачало.Организация.КПП, "");
			СтрокаОрганизации = ИНН + ?(ЗначениеЗаполнено(ИНН) И ЗначениеЗаполнено(КПП), ", ", "") + КПП;
			Если ЗначениеЗаполнено(СтрокаОрганизации) Тогда
				СтрокаОрганизации = "(" + СтрокаОрганизации + ")";	
			КонецЕсли;
			
			ТемаПисьма = СтрЗаменить(ТемаПисьма, "[ИННКПП]", СтрокаОрганизации);
		КонецЕсли;
	    ТемаПисьма = СтрЗаменить(ТемаПисьма, "[Организация]", Строка(ДопТекстТемыПисьмаНачало.Организация));
		ТекстПисьма = СтрЗаменить(ТекстПисьма, "[Организация]", Строка(ДопТекстТемыПисьмаНачало.Организация));
	Иначе
		ТемаПисьма = СтрЗаменить(ТемаПисьма, "[АктСверки]", "");
		ТемаПисьма = СтрЗаменить(ТемаПисьма, "[ИННКПП]", "");
		ТемаПисьма = СтрЗаменить(ТемаПисьма, "[Организация]", Строка(ДопТекстТемыПисьмаНачало.Организация));
		Письмо.ИмяОтправителя 	= Строка(ДопТекстТемыПисьмаНачало.Организация);
	КонецЕсли; 
	
	Если ТипЗнч(ДопТекстТемыПисьмаНачало) = Тип("ДокументСсылка.АктСверкиВзаиморасчетов") Тогда
		ТемаПисьма = СтрЗаменить(ТемаПисьма, "[Контрагент]", ДопТекстТемыПисьмаНачало.Контрагент);
	ИначеЕсли ТипЗнч(ДопТекстТемыПисьмаНачало) = Тип("ДокументСсылка.АктСверкиВзаиморасчетовГр") Тогда
		ТемаПисьма = СтрЗаменить(ТемаПисьма, "[Контрагент]", ДопТекстТемыПисьмаНачало.ИмяКонтрагента);	
	Иначе
		ТемаПисьма = СтрЗаменить(ТемаПисьма, "[Контрагент]", "");
	КонецЕсли;

	Письмо.Тема = ТемаПисьма; 
	// <<< Dexcel
	

	
	//Письмо.Тема = ДопТекстТемыПисьмаНачало;
	Письмо.Получатели.Добавить(Получатель);
	Письмо.Тексты.Добавить(ТекстПисьма);
	//Письмо.Тексты.Добавить(ОбщегоНазначения_Dexcel.ПодписьУчетнойЗаписиЭлектроннойПочтыПростойТекст(УчетнаяЗапись));
	Для Каждого ТекВложение Из Вложения Цикл
		Письмо.Вложения.Добавить(ТекВложение);
	КонецЦикла;

	Попытка
		УправлениеЭлектроннойПочтой.ОтправитьПисьмо(Профиль, Письмо);
		РезультатОтправки = Истина;
	Исключение
		РезультатОтправки = Ложь;
	КонецПопытки;
	
КонецПроцедуры   

Функция ПолучитьУчетнуюЗапись()
	
	Если ЗначениеЗаполнено(ПочтаДляОтправки) Тогда
		Возврат ПочтаДляОтправки;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции  

Процедура ОтправитьАктыСверкиИзТЧ(ИмяТаблицы) Экспорт
	
	Если Не ЗначениеЗаполнено(ПечатнаяФорма) Тогда
		Сообщить("Не заполнена печатная форма!");
		Возврат;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ПочтаДляОтправки) Тогда
		Сообщить("Не заполнена почта отправки!");
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из ЭтотОбъект[ИмяТаблицы] Цикл
		
		Если Строка.Загрузить 
			И ЗначениеЗаполнено(Строка.Email) 
			И ЗначениеЗаполнено(Строка.Ссылка)
			И Не Строка.Ссылка.ПометкаУдаления Тогда	
			
			ТабДокАктСверки = ПечатьАктаСверки(Строка.Ссылка);  
			Каталог = КаталогВременныхФайлов();
			ИмяФайла = Каталог + "Акт сверки с " + Формат(Строка.Ссылка.ДатаНачала,"ДЛФ=Д")+ " по " 
			+  Формат(Строка.Ссылка.ДатаОкончания,"ДЛФ=Д") + ".pdf"; 
			ТабДокАктСверки.Записать(ИмяФайла,ТипФайлаТабличногоДокумента.PDF);
			
			ИмяФайла2 = Каталог + "Акт сверки с " + Формат(Строка.Ссылка.ДатаНачала,"ДЛФ=Д")+ " по " 
			+  Формат(Строка.Ссылка.ДатаОкончания,"ДЛФ=Д") + ".xls"; 
			ТабДокАктСверки.Записать(ИмяФайла2,ТипФайлаТабличногоДокумента.XLS);
			
			Вложения = Новый Массив;
			Вложения.Добавить(ИмяФайла);
			Вложения.Добавить(ИмяФайла2);                 
			
			РезультатОтправки = Ложь;
			
			Сообщить("Отправка акта сверки: " +Строка(Строка.Контрагент) + " на адрес " + Строка.Email); 

			//ТемаПисьма = "Акт сверки " + Строка(Строка.Контрагент) + ". " + Строка.Номер + Формат(Строка.Дата,"ДЛФ=DD");
			ОтправитьПисьмоПоПолучателю(Вложения, Строка.Email, "Добрый день. Просим сверить и предоставить акт сверки", Строка.Ссылка,РезультатОтправки);
			
			Строка.Загрузить = Не РезультатОтправки;
			
			Для Каждого ТекВложение Из Вложения Цикл
				Попытка 
					УдалитьФайлы(ТекВложение);
				Исключение
				КонецПопытки;
			КонецЦикла;
			
		КонецЕсли;   
		
	КонецЦикла;	          
	
КонецПроцедуры  

Функция ПечатьАктаСверки(Ссылка) Экспорт
	ВнешняяФорма = ПечатнаяФорма;
	Если Не ЗначениеЗаполнено(ВнешняяФорма) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДвоичныеДанные = ВнешняяФорма.ХранилищеВнешнейОбработки.Получить();
	
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТабДокумент = Неопределено;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("epf");	
	Попытка
		ДвоичныеДанные.Записать(ИмяФайла);
		Обработка = ВнешниеОбработки.Создать(ИмяФайла);
		Обработка.СсылкаНаОбъект = Ссылка;
		
		ТабДокумент = Обработка.Печать();
		УдалитьФайлы(ИмяФайла);
		
		Если ТипЗнч(ТабДокумент) = Тип("ТабличныйДокумент") И (ПустаяСтрока(ТабДокумент.ИмяПараметровПечати)) Тогда
			Попытка
				ИдентификаторОбработки = Строка(ВнешняяФорма.УникальныйИдентификатор());
				ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_" + СтрЗаменить(ИдентификаторОбработки, "-", "_");
				ТабДокумент.ИмяПараметровПечати = ТабДокумент.ИмяПараметровПечати + "_" + Ссылка.Метаданные().Имя;
			Исключение
				
			КонецПопытки;
		КонецЕсли;
	Исключение
		ОбщегоНазначения.СообщитьОбОшибке(ОписаниеОшибки(),, "Не удалось сформировать внешнюю печатную форму!");
	КонецПопытки;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПолучитьРезультатЗапросаАктыСверкиГрупповые(ИспользоватьОтбор) Экспорт
	
	
	//СписокИсключаемыхИНН = СоответствиеИННКонтрагент.ВыгрузитьКолонку("ИНН");
	СписокИсключаемыхИНН = Новый Массив;
	Для каждого Строка Из СоответствиеИННКонтрагент Цикл
	
		Если Строка.Заменять Тогда
			Продолжить;
		КонецЕсли;
	    СписокИсключаемыхИНН.Добавить(Строка.ИНН);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Контрагенты.ИНН КАК ИНН,
	|	КОЛИЧЕСТВО(Контрагенты.ИНН) КАК КоличествоИНН
	|ПОМЕСТИТЬ втГрупповыеИНН
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН <> """"";
	Если ИспользоватьОтбор Тогда
		
		Запрос.Текст = Запрос.Текст +
		"
		| И Контрагенты.Ссылка В ИЕРАРХИИ(&ОтборПоГруппамКонтрагентов)";
		Запрос.УстановитьПараметр("ОтборПоГруппамКонтрагентов", ОтборПоГруппамКонтрагентов);
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + "
	|СГРУППИРОВАТЬ ПО
	|	Контрагенты.ИНН
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(Контрагенты.ИНН) > 1
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИНН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВзаиморасчетыСКонтрагентами.Контрагент.ИНН КАК КонтрагентИНН,
	|	ВзаиморасчетыСКонтрагентами.Организация
	|ПОМЕСТИТЬ втКонтрагентыВзаиморасчетов
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами КАК ВзаиморасчетыСКонтрагентами
	|ГДЕ
	|	ВзаиморасчетыСКонтрагентами.Регистратор.ОтражатьВБухгалтерскомУчете
	|	И ВзаиморасчетыСКонтрагентами.Период МЕЖДУ " + 
	?(СНачалаГода,"НАЧАЛОПЕРИОДА(&ДатаНачала, ГОД)", "&ДатаНачала") + 
	" И &ДатаОкончания
	|	И ВзаиморасчетыСКонтрагентами.Организация В(&Организация)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КонтрагентИНН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Контрагенты.ИНН КАК ИНН,
	|	втКонтрагентыВзаиморасчетов.Организация КАК Организация,
	|	Контрагенты.НаименованиеПолное КАК Контрагент,
	|	КонтактнаяИнформация.Представление КАК Email
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втГрупповыеИНН КАК втГрупповыеИНН
	|		ПО Контрагенты.ИНН = втГрупповыеИНН.ИНН
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ПО (КонтактнаяИнформация.Объект = Контрагенты.Ссылка)
	|			И (КонтактнаяИнформация.Вид = &ВидКИ)
	|			И (КонтактнаяИнформация.Тип = &ТипКИ)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втКонтрагентыВзаиморасчетов КАК втКонтрагентыВзаиморасчетов
	|		ПО Контрагенты.ИНН = втКонтрагентыВзаиморасчетов.КонтрагентИНН
	|ИТОГИ ПО
	|	ИНН,
	|	Организация";     
	
	Запрос.УстановитьПараметр("ВидКИ",Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Акты сверки"));
	Запрос.УстановитьПараметр("ТипКИ", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", Организация);	
	
	ВыборкаИНН = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТаблицаИНН = ДокументыАктыСверокГрупповые.Выгрузить().СкопироватьКолонки();
	
	Пока ВыборкаИНН.Следующий() Цикл
		
		ВыборкаОрганизации = ВыборкаИНН.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		НоваяСтрока = ТаблицаИНН.Добавить();  
		НоваяСтрока.ИНН = ВыборкаИНН.ИНН;
		
		Пока ВыборкаОрганизации.Следующий() Цикл
			ВыборкаДетальныеЗаписиИНН = ВыборкаОрганизации.Выбрать();		       	
			
			НоваяСтрока.Организация = ВыборкаОрганизации.Организация;
			Пока ВыборкаДетальныеЗаписиИНН.Следующий() Цикл
				
				Если ЗначениеЗаполнено(НоваяСтрока.Контрагент) И ЗначениеЗаполнено(НоваяСтрока.Email) Тогда
					Прервать;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписиИНН.Контрагент)
					И Не ЗначениеЗаполнено(НоваяСтрока.Контрагент) Тогда
					НоваяСтрока.Контрагент = ВыборкаДетальныеЗаписиИНН.Контрагент; 							
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписиИНН.Email)
					И Не ЗначениеЗаполнено(НоваяСтрока.Email) Тогда
					НоваяСтрока.Email = ВыборкаДетальныеЗаписиИНН.Email; 							
				КонецЕсли;			
				
			КонецЦикла;	
		КонецЦикла;
		
	КонецЦикла; 
	
	
	ЗапросИтог = Новый Запрос;
	ЗапросИтог.Текст = "ВЫБРАТЬ
	|	СоответствиеИННКонтрагент.ИНН,
	|	СоответствиеИННКонтрагент.Организация,
	|	СоответствиеИННКонтрагент.Контрагент,
	// >>> Dexcel
	|	СоответствиеИННКонтрагент.Заменять,
	// <<< Dexcel
	|	СоответствиеИННКонтрагент.Email
	|ПОМЕСТИТЬ СоответствиеИННКонтрагент
	|ИЗ
	|	&СоответствиеИННКонтрагент КАК СоответствиеИННКонтрагент
	// >>> Dexcel
	|ГДЕ
	|	Не СоответствиеИННКонтрагент.Заменять
	// <<< Dexcel

	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АктСверкиВзаиморасчетовГрПереченьКонтрагентов.Контрагент.ИНН,
	|	АктСверкиВзаиморасчетовГрПереченьКонтрагентов.Ссылка,
	|	ВЫБОР
	|		КОГДА АктСверкиВзаиморасчетовГрПереченьКонтрагентов.Ссылка ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Совпадение,
	|	СоответствиеИННКонтрагент.Контрагент КАК Контрагент,
	|	СоответствиеИННКонтрагент.Организация,
	|	СоответствиеИННКонтрагент.Email,
	|	АктСверкиВзаиморасчетовГрПереченьКонтрагентов.Контрагент КАК Контрагент1,
	|	СоответствиеИННКонтрагент.ИНН
	|ПОМЕСТИТЬ втСовпавшиеАкты
	|ИЗ
	|	СоответствиеИННКонтрагент КАК СоответствиеИННКонтрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктСверкиВзаиморасчетовГр.ПереченьКонтрагентов КАК АктСверкиВзаиморасчетовГрПереченьКонтрагентов
	|		ПО (АктСверкиВзаиморасчетовГрПереченьКонтрагентов.Контрагент.ИНН = СоответствиеИННКонтрагент.ИНН)
	|			И (АктСверкиВзаиморасчетовГрПереченьКонтрагентов.Ссылка.ДатаНачала = &ДатаНачала)
