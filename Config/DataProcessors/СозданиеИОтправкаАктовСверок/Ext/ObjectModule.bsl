Процедура ПроверитьДублиИННДляЗамены()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	СоответствиеИННКонтрагент.ИНН,
	               |	СоответствиеИННКонтрагент.Организация,
	               |	СоответствиеИННКонтрагент.Контрагент,
	               |	СоответствиеИННКонтрагент.Заменять,
	               |	СоответствиеИННКонтрагент.Номер,
	               |	СоответствиеИННКонтрагент.Email
	               |ПОМЕСТИТЬ СоответствиеИННКонтрагент
	               |ИЗ
	               |	&СоответствиеИННКонтрагент КАК СоответствиеИННКонтрагент
	               |ГДЕ
	               |	СоответствиеИННКонтрагент.Заменять
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.ИНН,
	               |	КОЛИЧЕСТВО(ВложенныйЗапрос.Email) КАК Email,
	               |	ВложенныйЗапрос.Организация
	               |ПОМЕСТИТЬ втДублирующиесяИНН
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		СоответствиеИННКонтрагент.ИНН КАК ИНН,
	               |		СоответствиеИННКонтрагент.Номер КАК Номер,
	               |		СоответствиеИННКонтрагент.Email КАК Email,
	               |		СоответствиеИННКонтрагент.Организация КАК Организация
	               |	ИЗ
	               |		СоответствиеИННКонтрагент КАК СоответствиеИННКонтрагент
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		СоответствиеИННКонтрагент.ИНН,
	               |		СоответствиеИННКонтрагент.Номер,
	               |		СоответствиеИННКонтрагент.Email,
	               |		СоответствиеИННКонтрагент.Организация) КАК ВложенныйЗапрос
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВложенныйЗапрос.ИНН,
	               |	ВложенныйЗапрос.Организация
	               |
	               |ИМЕЮЩИЕ
	               |	КОЛИЧЕСТВО(ВложенныйЗапрос.Email) > 1
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СоответствиеИННКонтрагент.ИНН КАК ИНН,
	               |	СоответствиеИННКонтрагент.Email КАК Email,
	               |	СоответствиеИННКонтрагент.Номер
	               |ИЗ
	               |	СоответствиеИННКонтрагент КАК СоответствиеИННКонтрагент
	               |ГДЕ
	               |	СоответствиеИННКонтрагент.ИНН В
	               |			(ВЫБРАТЬ
	               |				втДублирующиесяИНН.ИНН
	               |			ИЗ
	               |				втДублирующиесяИНН КАК втДублирующиесяИНН)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СоответствиеИННКонтрагент.ИНН,
	               |	СоответствиеИННКонтрагент.Email,
	               |	СоответствиеИННКонтрагент.Номер
	               |ИТОГИ
	               |	КОЛИЧЕСТВО(Email)
	               |ПО
	               |	ИНН";
	
	Запрос.УстановитьПараметр("СоответствиеИННКонтрагент", СоответствиеИННКонтрагент.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить();
	Выгрузка = РезультатЗапроса.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Для Каждого СтрокаИНН Из Выгрузка.Строки Цикл
		ТекстСообщения = "ИНН " + СтрокаИНН.ИНН + " указан в нескольких настройках";
		Для Каждого ДетальныеЗаписи  Из СтрокаИНН.Строки Цикл
			
			ТекстСообщения = ТекстСообщения + Символы.ПС +
				"	В строке " + ДетальныеЗаписи.Номер + " указан e-mail " + ДетальныеЗаписи.Email;
			
		КонецЦикла;
		Сообщить(ТекстСообщения);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВосстановитьНастройки() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СохраненныеНастройки.СохраненнаяНастройка КАК ПараметрыВыгрузки 
	|ИЗ
	|	РегистрСведений.СохраненныеНастройки КАК СохраненныеНастройки
	|ГДЕ
	|	СохраненныеНастройки.ИмяОбъекта = &ИмяОбъекта
	|	И СохраненныеНастройки.НаименованиеНастройки = &НаименованиеНастройки";
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	Запрос.УстановитьПараметр("НаименованиеНастройки", НаименованиеНастройки);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		СохраненнаяНастройка = Результат.ПараметрыВыгрузки.Получить();	
	Иначе
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, СохраненнаяНастройка);
	Если СохраненнаяНастройка.Свойство("ДокументыАктыСверок") Тогда
		ЭтотОбъект.ДокументыАктыСверок.Загрузить(СохраненнаяНастройка.ДокументыАктыСверок);
	КонецЕсли;
	Если СохраненнаяНастройка.Свойство("ДокументыАктыСверокГрупповые") Тогда
		ЭтотОбъект.ДокументыАктыСверокГрупповые.Загрузить(СохраненнаяНастройка.ДокументыАктыСверокГрупповые);
	КонецЕсли;
	Если СохраненнаяНастройка.Свойство("СоответствиеИННКонтрагент") Тогда
		ЭтотОбъект.СоответствиеИННКонтрагент.Загрузить(СохраненнаяНастройка.СоответствиеИННКонтрагент);
	КонецЕсли;
	
КонецПроцедуры

Процедура СохранитьНастройки() Экспорт
	ПараметрыВыгрузки = Новый Структура;
	ПараметрыВыгрузки.Вставить("ДатаНачала", ДатаНачала);
	ПараметрыВыгрузки.Вставить("ДатаОкончания", ДатаОкончания);
	ПараметрыВыгрузки.Вставить("Организация", Организация);
	ПараметрыВыгрузки.Вставить("ПечатнаяФорма", ПечатнаяФорма);
	ПараметрыВыгрузки.Вставить("ДокументыАктыСверок", ДокументыАктыСверок.Выгрузить());
	ПараметрыВыгрузки.Вставить("ДокументыАктыСверокГрупповые", ДокументыАктыСверокГрупповые.Выгрузить());
	ПараметрыВыгрузки.Вставить("СоответствиеИННКонтрагент", СоответствиеИННКонтрагент.Выгрузить());
	ПараметрыВыгрузки.Вставить("ОтборПоГруппамКонтрагентов", ОтборПоГруппамКонтрагентов);
	ПараметрыВыгрузки.Вставить("ПочтаДляОтправки", ПочтаДляОтправки);
	ПараметрыВыгрузки.Вставить("СНачалаГода", СНачалаГода);
	ПараметрыВыгрузки.Вставить("ТекстПисьма", ТекстПисьма);
	ПараметрыВыгрузки.Вставить("Тема", Тема);
	
	РегистрНастроек = РегистрыСведений.СохраненныеНастройки.СоздатьМенеджерЗаписи();
	РегистрНастроек.ИмяОбъекта   			= ИмяОбъекта;
	РегистрНастроек.НаименованиеНастройки 	= НаименованиеНастройки;
	
	РегистрНастроек.СохраненнаяНастройка	= Новый ХранилищеЗначения(ПараметрыВыгрузки);
	РегистрНастроек.ИспользоватьПриОткрытии = Истина;
	РегистрНастроек.СохранятьАвтоматически  = Ложь;
	
	Попытка
		РегистрНастроек.Записать(Истина);
	Исключение
		ОбщегоНазначения.СообщитьОбОшибке("Настройка не была записана по причине: " + ОписаниеОшибки());
	КонецПопытки;	
	
КонецПроцедуры    

ИмяОбъекта   			= "ОбработкаОбъект.СозданиеИОтправкаАктовСверок";
НаименованиеНастройки 	= "Основная";