Процедура ЗаменитьПочтуВОбычныхАктахСверки()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДокументАктовСверки.Контрагент
	               |ПОМЕСТИТЬ втАктыСверок
	               |ИЗ
	               |	&ДокументАктовСверки КАК ДокументАктовСверки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втАктыСверок.Контрагент
	               |ИЗ
	               |	втАктыСверок КАК втАктыСверок
	               |ГДЕ
	               |	втАктыСверок.Контрагент.ИНН В (&СписокИНН)";
	
	
	Запрос.УстановитьПараметр("ДокументАктовСверки", ДокументыАктыСверок.Выгрузить());
	
