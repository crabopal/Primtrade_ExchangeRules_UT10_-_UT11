		Выгрузка = Запрос.Выполнить().Выгрузить();
		
		Для Каждого СтрокаВыгрузки Из Выгрузка Цикл
			
			НайденныеСтроки = ДокументыАктыСверок.НайтиСтроки(Новый Структура("Контрагент", СтрокаВыгрузки.Контрагент));
			
