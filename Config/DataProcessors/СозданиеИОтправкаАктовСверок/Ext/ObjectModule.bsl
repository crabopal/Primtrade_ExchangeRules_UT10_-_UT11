	|	ВложенныйЗапрос.Email,
	|	ВложенныйЗапрос.Контрагент,
	|	ВложенныйЗапрос.СтарыйАкт КАК Ссылка
	|ИЗ
	|	(ВЫБРАТЬ
	|		МАКСИМУМ(втСовпавшиеАкты.Ссылка) КАК Ссылка,
	|		МАКСИМУМ(втСовпавшиеАкты.Совпадение) КАК Совпадение,
	|		ЕСТЬNULL(втСовпавшиеАкты.Ссылка.ИмяКонтрагента, втСовпавшиеАкты.Контрагент) КАК Контрагент,
	|		втСовпавшиеАкты.Организация КАК Организация,
	|		втСовпавшиеАкты.Email КАК Email,
	|		втСовпавшиеАкты.СтарыйАкт КАК СтарыйАкт
	|	ИЗ
	|		втСовпавшиеАкты КАК втСовпавшиеАкты
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ЕСТЬNULL(втСовпавшиеАкты.Ссылка.ИмяКонтрагента, втСовпавшиеАкты.Контрагент),
	|		втСовпавшиеАкты.Организация,
	|		втСовпавшиеАкты.Email,
	|		втСовпавшиеАкты.СтарыйАкт) КАК ВложенныйЗапрос
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблицаИНН.Email КАК Email,
	|	втСуществующиеАкты.Ссылка.Дата КАК Дата,
	|	втСуществующиеАкты.Ссылка.Номер КАК Номер,
	|	втСуществующиеАкты.Ссылка КАК НайденныйАкт,
	|	втТаблицаИНН.Загрузить,
	|	ВЫБОР
	|		КОГДА втСуществующиеАкты.Ссылка ЕСТЬ NULL
	|			ТОГДА 4
	|		ИНАЧЕ ВЫБОР
	|				КОГДА втСуществующиеАкты.Ссылка.ПометкаУдаления
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ
	|	КОНЕЦ КАК Картинка,
	|	втТаблицаИНН.ИНН,                   
	// >>> Dexcel
	|	РеестрНекорректныхДокументов.НекорректныйДокумент,
	//|	втСуществующиеАкты.Ссылка.НеКорректныйДокумент КАК НеКорректныйДокумент,
	// <<< Dexcel
	|	втТаблицаИНН.Организация КАК Организация,
	|	втТаблицаИНН.Контрагент КАК Контрагент,
	|	ЛОЖЬ КАК ИзНастроек,
	|	втСуществующиеАкты.Ссылка.ДатаНачала,
	|	втСуществующиеАкты.Ссылка.ДатаОкончания,
	|	втТаблицаИНН.СтарыйАкт КАК Ссылка
	|ИЗ
	|	втТаблицаИНН КАК втТаблицаИНН
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСуществующиеАкты КАК втСуществующиеАкты   
	// >>> Dexcel
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеестрНекорректныхДокументов КАК РеестрНекорректныхДокументов
	|			ПО втСуществующиеАкты.Ссылка = РеестрНекорректныхДокументов.Документ                          
	// <<< Dexcel
	|		ПО втТаблицаИНН.ИНН = втСуществующиеАкты.ИНН
	|			И втТаблицаИНН.Организация = втСуществующиеАкты.Ссылка.Организация
	|			И втТаблицаИНН.ДатаНачала = втСуществующиеАкты.Ссылка.ДатаНачала
	|			И втТаблицаИНН.ДатаОкончания = втСуществующиеАкты.Ссылка.ДатаОкончания
	|ГДЕ
	|	НЕ втТаблицаИНН.ИНН В (&СписокИсключаемыхИНН)";  
	
	Запрос.УстановитьПараметр("СписокИсключаемыхИНН", СписокИсключаемыхИНН); 
	Запрос.УстановитьПараметр("СоответствиеИННКонтрагент", ТЗИзНастроек); 
	Запрос.УстановитьПараметр("ТаблицаИНН", ДокументыАктыСверокГрупповые.Выгрузить());
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Возврат Запрос.ВыполнитьПакет(); 
	
КонецФункции

