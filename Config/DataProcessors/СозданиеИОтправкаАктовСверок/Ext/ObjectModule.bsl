Функция ПолучитьПакетЗапросаАктыСверокГрупповыеЗагружаемые() Экспорт
	
	//СписокИсключаемыхИНН = СоответствиеИННКонтрагент.ВыгрузитьКолонку("ИНН");
	СписокИсключаемыхИНН = Новый Массив;
	
	Для Каждого Строка Из СоответствиеИННКонтрагент Цикл
		// >>> Dexcel
		Если Строка.Заменять Тогда
			Продолжить;
		КонецЕсли;
		// <<< Dexcel
		СписокИсключаемыхИНН.Добавить(Строка.ИНН);
		
	КонецЦикла;
	
	ТЗГрупповыеАкты = ДокументыАктыСверокГрупповые.Выгрузить();
	
	МассивСтрокИзНастроек = ТЗГрупповыеАкты.НайтиСтроки(Новый Структура("ИзНастроек, Загрузить", Истина, Истина));
	
	ТЗИзНастроек = ТЗГрупповыеАкты.СкопироватьКолонки();
	
	Для Каждого Строка Из МассивСтрокИзНастроек Цикл
		
		НайденныеСтроки = СоответствиеИННКонтрагент.НайтиСтроки(Новый Структура("Контрагент, Организация", Строка.Контрагент, Строка.Организация));	
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Сообщить("Настройки по контрагенту " + Строка.Контрагент + " не найдены!");
			Возврат Неопределено;
		КонецЕсли;
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НоваяСтрока = ТЗИзНастроек.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.ИНН = НайденнаяСтрока.ИНН;	
		КонецЦикла;		
		
	КонецЦикла;    
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СоответствиеИННКонтрагент.ИНН,
	|	СоответствиеИННКонтрагент.Организация,
	|	СоответствиеИННКонтрагент.Контрагент,
	|	СоответствиеИННКонтрагент.Загрузить,
