Процедура СоздатьАктыГрупповые(Команда)
	
	Если Не ПродолжитьНеобратимоеДействие() Тогда
		Возврат;
	КонецЕсли;
	СоздатьАктыГрНаСервере();
КонецПроцедуры     

Процедура СоздатьАктыГрНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ПакетЗапросовАктыСверок = ОбработкаОбъект.ПолучитьПакетЗапросаАктыСверокГрупповыеЗагружаемые();	
	
	Если ПакетЗапросовАктыСверок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = ПакетЗапросовАктыСверок[6].Выбрать();
	ВыборкаИзНастроек = ПакетЗапросовАктыСверок[5].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ОтборСтрок = Новый Структура;
		ОтборСтрок.Вставить("Контрагент", Выборка.Контрагент);
		ОтборСтрок.Вставить("ИНН", Выборка.ИНН);
		ОтборСтрок.Вставить("Ссылка", ?(Не ЗначениеЗаполнено(Выборка.Ссылка),Документы.АктСверкиВзаиморасчетовГр.ПустаяСсылка(),Выборка.Ссылка));
		
		НайденныеСтроки = Объект.ДокументыАктыСверокГрупповые.НайтиСтроки(ОтборСтрок); 
		
		Для Каждого Строка Из НайденныеСтроки Цикл
			Если Не ЗначениеЗаполнено(Выборка.НайденныйАкт) Тогда
				СоздатьАктСверкиГр(Строка);				
			Иначе
				Сообщить("Для контрагента " + Выборка.Контрагент + " был найден более ранний документ " + Выборка.НайденныйАкт);	
			КонецЕсли;				
			ОтредактироватьСтрокуПослеСоздания(Строка);
		КонецЦикла;
		
	КонецЦикла;	
	
	Пока ВыборкаИзНастроек.Следующий() Цикл
		
		ОтборСтрок = Новый Структура;
		ОтборСтрок.Вставить("Контрагент", ВыборкаИзНастроек.Контрагент);
		ОтборСтрок.Вставить("Ссылка", ВыборкаИзНастроек.Ссылка);
		ОтборСтрок.Вставить("ИзНастроек", Истина);
		
		НайденныеСтроки = Объект.ДокументыАктыСверокГрупповые.НайтиСтроки(ОтборСтрок); 
		
		Для Каждого Строка Из НайденныеСтроки Цикл
			Если Не ЗначениеЗаполнено(ВыборкаИзНастроек.НайденныйАкт) Тогда
				СоздатьАктСверкиГр(Строка);				
			Иначе
				Сообщить("Для контрагента " + ВыборкаИзНастроек.Контрагент + " был найден более ранний документ " + ВыборкаИзНастроек.НайденныйАкт);	
			КонецЕсли;				
			ОтредактироватьСтрокуПослеСоздания(Строка);
		КонецЦикла;			
		
	КонецЦикла;
	
КонецПроцедуры

