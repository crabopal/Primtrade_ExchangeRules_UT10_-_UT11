&НаКлиенте
Процедура Отправить(Команда)
	Если Не ПродолжитьНеобратимоеДействие() Тогда
		Возврат;
	КонецЕсли;
	ОтправитьНаСервере("ДокументыАктыСверок");
КонецПроцедуры

&НаСервере
Процедура ОтправитьНаСервере(ИмяТаблицы)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Если Не ЗначениеЗаполнено(Объект.ПечатнаяФорма) Тогда
		Сообщить("Не заполнена печатная форма!");
		Возврат;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(Объект.ПочтаДляОтправки) Тогда
		Сообщить("Не заполнена почта отправки!");
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из Объект[ИмяТаблицы] Цикл
		
		Если Строка.Загрузить 
			И ЗначениеЗаполнено(Строка.Email) 
			И ЗначениеЗаполнено(Строка.Ссылка)
			И Не Строка.Ссылка.ПометкаУдаления Тогда	
			
			ТабДокАктСверки = ОбработкаОбъект.ПечатьАктаСверки(Строка.Ссылка);  
			Каталог = КаталогВременныхФайлов();
			ИмяФайла = Каталог + "Акт сверки с " + Формат(Строка.Ссылка.ДатаНачала,"ДЛФ=Д")+ " по " 
			+  Формат(Строка.Ссылка.ДатаОкончания,"ДЛФ=Д") + ".pdf"; 
			ТабДокАктСверки.Записать(ИмяФайла,ТипФайлаТабличногоДокумента.PDF);
			
			ИмяФайла2 = Каталог + "Акт сверки с " + Формат(Строка.Ссылка.ДатаНачала,"ДЛФ=Д")+ " по " 
			+  Формат(Строка.Ссылка.ДатаОкончания,"ДЛФ=Д") + ".xls"; 
			ТабДокАктСверки.Записать(ИмяФайла2,ТипФайлаТабличногоДокумента.XLS);
			
			Вложения = Новый Массив;
			Вложения.Добавить(ИмяФайла);
			Вложения.Добавить(ИмяФайла2);                 
			
			РезультатОтправки = Ложь;
			
			Сообщить("Отправка акта сверки: " +Строка(Строка.Контрагент) + " на адрес " + Строка.Email); 
			ОбработкаОбъект.ОтправитьПисьмоПоПолучателю(Вложения, Строка.Email, ОбработкаОбъект.ТекстПисьма, Строка.Ссылка,РезультатОтправки);
		
			Строка.Загрузить = Не РезультатОтправки;
			
			Для Каждого ТекВложение Из Вложения Цикл
				Попытка 
					УдалитьФайлы(ТекВложение);
				Исключение
				КонецПопытки;
			КонецЦикла;
			
		КонецЕсли;   
		
	КонецЦикла;	          
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАктыСверкиГрупповые(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Предупреждение("Не выбрана организация!");
		Возврат;
	КонецЕсли;
	
	Если Объект.ДокументыАктыСверокГрупповые.Количество() > 0 Тогда
		Ответ = Вопрос("Таблица актов сверок будет перезаполнена! Продолжить?", РежимДиалогаВопрос.ДаНет);
		
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;		
	КонецЕсли; 
	
	ЗаполнитьАктыСверкиГрупповыеНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьАктыСверкиГрупповыеНаСервере(ИспользоватьОтбор = Ложь)	
	
	ТаблицуНастроекФормыВТабличнуюЧасть();                         
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	РезультатЗапроса = ОбработкаОбъект.ПолучитьРезультатЗапросаАктыСверкиГрупповые(ИспользоватьОтбор); 
	
	Если РезультатЗапроса.Пустой() Тогда
		Сообщить("Нет данных за выбранный период!");		
		Возврат;
	КонецЕсли;
	
	Объект.ДокументыАктыСверокГрупповые.Загрузить(РезультатЗапроса.Выгрузить());
	// >>> Dexcel
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ЗаменитьПочтуИзНастроек();
