Процедура ДокументыАктыСверокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	// >>> Dexcel 04_02_22
	Если Поле = Элементы.ДокументыАктыСверок1Email Тогда
	
		//СтандартнаяОбработка = Ложь;
		//
		//ТекущиеДанные = Элементы.ДокументыАктыСверок.ТекущиеДанные;
		//ФормаСменыПочты = ПолучитьФорму("Обработка.СозданиеИОтправкаАктовСверок.Форма.ФормаСменыПочтовогоАдреса");
		//ФормаСменыПочты.ОткрытьМодально();
	
	ИначеЕсли Поле <> Элементы.ДокументыАктыСверокЗагрузить Тогда
	//Если Поле <> Элементы.ДокументыАктыСверокЗагрузить Тогда
	// <<< Dexcel 04_02_22
		СтандартнаяОбработка = Ложь;
		
		ТекущиеДанные = Элементы.ДокументыАктыСверок.ТекущиеДанные;		
		СсылкаНаДок = ТекущиеДанные.Ссылка;  		
		
		Если ФормаОткрыта Тогда
			Предупреждение("Открыта форма актов сверок! Закройте и откройте занаво");	
			Возврат;
		КонецЕсли;
		ИндексИзменяемойСтроки = ВыбраннаяСтрока;	
		Если ЗначениеЗаполнено(СсылкаНаДок) Тогда 
			Ключ = Новый Структура;
			Ключ.Вставить("Ключ", СсылкаНаДок);
			ОткрытьФорму("Документ.АктСверкиВзаиморасчетов.ФормаОбъекта",Ключ,ЭтаФорма);			
		Иначе 		
			НовыйДокумент = Документы.АктСверкиВзаиморасчетов.СоздатьДокумент();
			ЗаполнитьДокументДляФормы(НовыйДокумент, ИндексИзменяемойСтроки);
			НовыйДокумент.ПолучитьФорму(,ЭтаФорма).Открыть();
		КонецЕсли;			
		ФормаОткрыта = Истина;
	КонецЕсли; 
	
КонецПроцедуры   

