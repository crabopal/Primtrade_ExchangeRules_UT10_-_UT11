Процедура СоздатьАктСверкиГр(Строка)
	
	НовыйДокумент = Документы.АктСверкиВзаиморасчетовГр.СоздатьДокумент();
	ЗаполнитьНовыйДокумент(НовыйДокумент, Строка);
	
	Попытка
		НовыйДокумент.Записать(); 
		Строка.Ссылка = НовыйДокумент.Ссылка;
		// >>> Dexcel
		ОбщегоНазначения_Dexcel.ИзменитьНекорректностьДокумента(Строка.Ссылка);
