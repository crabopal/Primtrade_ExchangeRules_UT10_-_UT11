&НаКлиенте
Процедура ЗаполнитьИзАктаСверкиГр(Команда)
	ТекДанные = Элементы.СоответствиеИННКонтрагент.ТекущиеДанные;
	
	ФормаВыбора = Документы.АктСверкиВзаиморасчетовГр.ПолучитьФормуВыбора();
	ВыбранноеЗначение = ФормаВыбора.ОткрытьМодально();
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные = Неопределено Тогда
		ТекДанные = СоответствиеИННКонтрагент.Добавить();
	КонецЕсли;
	
	ТекДанные.ИНН.Очистить(); 
	
	ТаблицаКонтрагентов = ВыбранноеЗначение.ПереченьКонтрагентов.Выгрузить();
	ТаблицаКонтрагентов.Колонки.Добавить("ИНН", Новый ОписаниеТипов("Строка"));	
	
	Для каждого Строка Из ТаблицаКонтрагентов Цикл
		Строка.ИНН = Строка.Контрагент.ИНН; 		
	КонецЦикла;   
	
	ТаблицаКонтрагентов.Свернуть("ИНН"); 
	
	Для Каждого Строка Из ТаблицаКонтрагентов Цикл	
		Если Не ЗначениеЗаполнено(Строка.ИНН) Тогда
			Продолжить;
		КонецЕсли;
		ЭлементСписка = ТекДанные.ИНН.Добавить();
		ЭлементСписка.Значение = Строка.ИНН;			
	КонецЦикла;
	
	ТекДанные.Контрагент = ВыбранноеЗначение.ИмяКонтрагента;
	ТекДанные.Организация = ВыбранноеЗначение.Организация;
КонецПроцедуры

