&НаСервере
Процедура ЗаполнитьНовыйДокумент(Документ, Строка)
	
	Документ.Дата = ТекущаяДата();  
	Документ.ДатаНачала = Строка.ДатаНачала;
	Документ.ДатаОкончания = Строка.ДатаОкончания; 
	//Документ.НекорректныйДокумент = Истина;         
	Документ.Организация = Строка.Организация;
	Документ.Комментарий = "Документ создан автоматически";
	
	Если ТипЗнч(Документ) =  Тип("ДокументОбъект.АктСверкиВзаиморасчетов") Тогда
		Документ.Контрагент = Строка.Контрагент;              
		ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(Документ, глЗначениеПеременной("глТекущийПользователь"));
	ИначеЕсли ТипЗнч(Документ) =  Тип("ДокументОбъект.АктСверкиВзаиморасчетовГр") Тогда 
		Если Строка.ИзНастроек Тогда
			НайденныеСтроки = Объект.СоответствиеИННКонтрагент.НайтиСтроки(Новый Структура("Контрагент, Организация", Строка.Контрагент, Строка.Организация));	
			Если НайденныеСтроки.Количество() = 0 Тогда
				Сообщить("Контрагент не найден в настройках");
				Возврат;
			КонецЕсли;     
			СписокИНН = Новый Массив;
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				СписокИНН.Добавить(НайденнаяСтрока.ИНН);
			КонецЦикла;
			
			Документ.ЗаполнитьКонтрагентовПоИНН(СписокИНН, Объект.ОтборПоГруппамКонтрагентов);
		Иначе
			Документ.ЗаполнитьКонтрагентовПоИНН(Строка.ИНН, Объект.ОтборПоГруппамКонтрагентов);	
		КонецЕсли;		
		Документ.ИмяКонтрагента = Строка.Контрагент;     
		ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(Документ, глЗначениеПеременной("глТекущийПользователь"), глЗначениеПеременной("ВалютаУправленческогоУчета"), "Продажа");  
	КонецЕсли;                   
	
	Документ.ЗаполнитьПоДаннымУправленческогоУчета();
	
КонецПроцедуры

