Процедура ДокументыАктыСверокГрупповыеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле =  Элементы.ДокументыАктыСверокГрупповыеEmail ТОгда 
	
	
	ИначеЕсли Поле <> Элементы.ДокументыАктыСверокГрупповыеЗагрузить Тогда
		СтандартнаяОбработка = Ложь;
		
		ТекущиеДанные = Элементы.ДокументыАктыСверокГрупповые.ТекущиеДанные;		
		СсылкаНаДок = ТекущиеДанные.Ссылка;  		
		
		Если ФормаОткрыта Тогда
			Предупреждение("Открыта форма актов сверок! Закройте и откройте занаво");	
			Возврат;
		КонецЕсли;
		ИндексИзменяемойСтрокГрупповой = ВыбраннаяСтрока;	
		Если ЗначениеЗаполнено(СсылкаНаДок) Тогда 
			Ключ = Новый Структура;
			Ключ.Вставить("Ключ", СсылкаНаДок);
			ОткрытьФорму("Документ.АктСверкиВзаиморасчетовГр.ФормаОбъекта",Ключ,ЭтаФорма);			
		Иначе 		
			НовыйДокумент = Документы.АктСверкиВзаиморасчетовГр.СоздатьДокумент();
			ЗаполнитьДокументДляФормы(НовыйДокумент, ИндексИзменяемойСтрокГрупповой);
			НовыйДокумент.ПолучитьФорму(,ЭтаФорма).Открыть();
		КонецЕсли;			
		ФормаОткрыта = Истина;
	КонецЕсли;
КонецПроцедуры       

