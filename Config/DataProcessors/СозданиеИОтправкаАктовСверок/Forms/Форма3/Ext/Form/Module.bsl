Процедура ЗаполнитьПоОтборуГр(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Предупреждение("Не выбрана организация!");
		Возврат;
	КонецЕсли;
	
	Если Объект.ДокументыАктыСверокГрупповые.Количество() > 0 Тогда
		Ответ = Вопрос("Таблица актов сверок будет перезаполнена! Продолжить?", РежимДиалогаВопрос.ДаНет);
		
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;		
	КонецЕсли; 
	
	ЗаполнитьАктыСверкиГрупповыеНаСервере(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзКонтрагентов(Команда)
	
	Форма = ПолучитьФорму("Справочник.Контрагенты.ФормаВыбора",, Элементы.СоответствиеИННКонтрагентИНН, ЭтаФорма);
	Форма.ЗакрыватьПриВыборе			= ЗакрыватьПриВыборе;
	Форма.ПараметрВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.ГруппыИЭлементы;
	Форма.МножественныйВыбор = Истина;
	Форма.Заголовок = "Подбор контрагентов:";
	ЗначениеВыбора = Форма.ОткрытьМодально();
	Если ЗначениеВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	СписокИННПоГруппам = ПолучитьСписокИННПоГруппам(ЗначениеВыбора);
	
	Для Каждого ИНН Из СписокИННПоГруппам Цикл
		НоваСтрока = СоответствиеИННКонтрагент.Добавить();
		НоваСтрока.ИНН         = ИНН.ИНН;
		НоваСтрока.Контрагент  = ИНН.Контрагент;
		//Элементы.СоответствиеИННКонтрагент.ТекущиеДанные.ИНН.Добавить(ИНН);
	КонецЦикла;
	//Элементы.СоответствиеИННКонтрагент.ТекущиеДанные.ИНН.ЗагрузитьЗначения(СписокИННПоГруппам);
КонецПроцедуры

Функция ПолучитьСписокИННПоГруппам(МассивГрупп)
	
	Запрос = НОвый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Контрагенты.ИНН,
	               |	Контрагенты.Ссылка
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |ГДЕ
	               |	Контрагенты.ИНН <> """"
	               |	И Контрагенты.Ссылка В ИЕРАРХИИ(&МассивГрупп)";
	Запрос.УстановитьПараметр("МассивГрупп", МассивГрупп);
	Возврат Запрос.Выполнить().Выгрузить();;
	
КонецФункции

