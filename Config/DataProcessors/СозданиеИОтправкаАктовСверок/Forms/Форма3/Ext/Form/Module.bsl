Процедура ДокументыАктыСверокГрупповыеEmailНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элемент.Родитель.ТекущиеДанные;
	
	Если ТекущиеДанные.ИзНастроек Тогда
		Предупреждение("Редактирование Email недоступно. Перейдите на страницу настроек");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ИНН) Тогда
		Предупреждение("ИНН не заполнен");
		Возврат;
	КонецЕсли;
	
	СписокИНН = Новый СписокЗначений;
	СписокИНН.Добавить(ТекущиеДанные.ИНН);
	
	СписокКонтрагентов = ПолучитьКонтрагентовПоИНН(СписокИНН);
	
	ПараметрыФормы = Новый Структура("СписокКонтрагентов", СписокКонтрагентов);
	
	ОткрытьФорму("Обработка.СозданиеИОтправкаАктовСверок.Форма.ФормаСменыПочтовогоАдреса", ПараметрыФормы,,,,, Новый ОписаниеОповещения("ДокументыАктыСверокГрупповыеEmailНачалоВыбораЗавершение", ЭтаФорма), );	
	
