&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник <> ЭтаФорма Тогда
		Возврат;
	КонецЕсли;    	
	
	АктСверки = Параметр;	
	
	Если ИмяСобытия = "ОбновитьСтрокуАктаСверки" Тогда 
		
		Если ТипЗнч(АктСверки) = Тип("ДокументСсылка.АктСверкиВзаиморасчетов") Тогда
			ТекущаяТаблица = "ДокументыАктыСверок"; 
			Индекс = ИндексИзменяемойСтроки;
		ИначеЕсли ТипЗнч(АктСверки) = Тип("ДокументСсылка.АктСверкиВзаиморасчетовГр") Тогда 
			ТекущаяТаблица = "ДокументыАктыСверокГрупповые";
			Индекс = ИндексИзменяемойСтрокГрупповой;
		КонецЕсли;
		
		Строка = Объект[ТекущаяТаблица].НайтиПоИдентификатору(Индекс); 
		
		Отказ = Ложь;      	
		СтрокаОтказа = "";                                                         
		УдалитьСтроку = Ложь;
		ПроверитьРеквизитыДокументаИСтроки(Строка, АктСверки, СтрокаОтказа, Отказ, УдалитьСтроку);
		
		Если Отказ Тогда
			Сообщить(СтрокаОтказа);
			Возврат;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Строка.Ссылка) Тогда
			Строка.Ссылка = АктСверки;
		КонецЕсли;    
		
		ОтредактироватьСтрокуПоИндексу(Индекс, ТекущаяТаблица); 	
		
	ИначеЕсли ИмяСобытия = "АктСверкиЗакрыт" Тогда
		ФормаОткрыта = Ложь;		
	КонецЕсли;        
	
	
КонецПроцедуры        

&НаКлиенте
Процедура ПроверитьРеквизитыДокументаИСтроки(Строка, АктСверки, СтрокаОтказа, Отказ,УдалитьСтроку)
	
	СтрокаОтказа = "Реквизиты:
	|";	
	СтавитьЗапятую = Ложь;  
	
	Если ТипЗнч(АктСверки) = Тип("ДокументСсылка.АктСверкиВзаиморасчетов") Тогда  
		
		Если Строка.Контрагент <> АктСверки.Контрагент Тогда
			СтрокаОтказа = СтрокаОтказа + "'контрагент'";
			СтавитьЗапятую = Истина;
			Отказ = Истина;  		
		КонецЕсли;        
		
	ИначеЕсли ТипЗнч(АктСверки) = Тип("ДокументСсылка.АктСверкиВзаиморасчетовГр") И
		Не Строка.ИзНастроек Тогда
		
		Для Каждого СтрокаКонтрагент Из АктСверки.ПереченьКонтрагентов Цикл	
			
			Если СтрокаКонтрагент.Контрагент.ИНН <> Строка.ИНН Тогда
				СтрокаОтказа = СтрокаОтказа + "'ИНН контрагентов'";
				СтавитьЗапятую = Истина;
				Отказ = Истина;
				Прервать;				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли;
	
	Если Строка.Организация <> АктСверки.Организация Тогда			
		СтрокаОтказа = СтрокаОтказа + ?(СтавитьЗапятую, ", ", "") + "'организация'";
		СтавитьЗапятую = Истина;
		Отказ = Истина;
		УдалитьСтроку = Истина;
	КонецЕсли;         
	
	Если Строка.ДатаНачала <> АктСверки.ДатаНачала
		ИЛИ Строка.ДатаОкончания <> АктСверки.ДатаОкончания Тогда
		СтрокаОтказа = СтрокаОтказа + ?(СтавитьЗапятую, ", ", "") + "'период'";
		СтавитьЗапятую = Истина;
		Отказ = Истина;        
		УдалитьСтроку = Истина;
	КонецЕсли;
	
	СтрокаОтказа = СтрокаОтказа + "
	|различаются в строке и в документе!"
	
КонецПроцедуры

