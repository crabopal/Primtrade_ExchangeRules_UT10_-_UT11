		МассивСтрок = Объект.СоответствиеИННКонтрагент.НайтиСтроки(Новый Структура("Номер", СтрокаНомера.Номер));
		
		НоваяСтрока = СоответствиеИННКонтрагент.Добавить();
		НоваяСтрока.Email = СтрокаНомера.Email; 
		НоваяСтрока.Организация = СтрокаНомера.Организация;
		НоваяСтрока.Контрагент = СтрокаНомера.Контрагент;
		// >>> Dexcel
		НоваяСтрока.Заменять = СтрокаНомера.Заменять;
		НоваяСтрока.НомерСтроки = СтрокаНомера.Номер;
		// <<< Dexcel
		Для Каждого Строка Из МассивСтрок Цикл
			НоваяСтрока.ИНН.Добавить(Строка.ИНН);	
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

