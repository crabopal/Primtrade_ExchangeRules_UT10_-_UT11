
&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Предупреждение("Не выбрана организация!");
		Возврат;
	КонецЕсли;
	
	Если Объект.ДокументыАктыСверок.Количество() > 0 Тогда
		Ответ = Вопрос("Таблица актов сверок будет перезаполнена! Продолжить?", РежимДиалогаВопрос.ДаНет);
		
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли; 	      
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере(ИспользоватьОтбор = Ложь) 	
	
	// >>> Dexcel
	ТаблицуНастроекФормыВТабличнуюЧасть();
	// <<< Dexcel
	
	СписокИсключаемыхИНН = Новый Массив;
	
	Для Каждого Строка Из СоответствиеИННКонтрагент Цикл
		// >>> Dexcel
		Если Строка.Заменять Тогда
			Продолжить;
		КонецЕсли;
		// <<< Dexcel
		Для Каждого ЭлементСписка Из Строка.ИНН Цикл
			СписокИсключаемыхИНН.Добавить(ЭлементСписка.Значение);
		КонецЦикла;
		
	КонецЦикла;
	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Контрагенты.ИНН КАК ИНН,
	|	КОЛИЧЕСТВО(Контрагенты.ИНН) КАК КоличествоИНН
	|ПОМЕСТИТЬ втУникальныеИННКПП
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН <> """"";
	Если ИспользоватьОтбор Тогда
		
		Запрос.Текст = Запрос.Текст +
		"
		| И Контрагенты.Ссылка В ИЕРАРХИИ(&ОтборПоГруппамКонтрагентов)";
		Запрос.УстановитьПараметр("ОтборПоГруппамКонтрагентов", Объект.ОтборПоГруппамКонтрагентов);
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст +				   
	"
	|СГРУППИРОВАТЬ ПО
	|	Контрагенты.ИНН
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(Контрагенты.ИНН) = 1
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИНН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка
	|ПОМЕСТИТЬ втУникальныеКонтрагенты
	|ИЗ
	|	втУникальныеИННКПП КАК втУникальныеИННКПП
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО (Контрагенты.ИНН = втУникальныеИННКПП.ИНН)
	|ГДЕ
	|	НЕ Контрагенты.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВзаиморасчетыСКонтрагентами.Контрагент,
	|	ВзаиморасчетыСКонтрагентами.Организация
	|ПОМЕСТИТЬ втКонтрагентыВзаиморасчетов
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами КАК ВзаиморасчетыСКонтрагентами
	|ГДЕ
	|	ВзаиморасчетыСКонтрагентами.Регистратор.ОтражатьВБухгалтерскомУчете
	|	И ВзаиморасчетыСКонтрагентами.Период МЕЖДУ " + 
	?(Объект.СНачалаГода,"НАЧАЛОПЕРИОДА(&ДатаНачала, ГОД)", "&ДатаНачала") + 
	" И &ДатаОкончания
	|	И ВзаиморасчетыСКонтрагентами.Организация В(&Организация)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ                     
	|	втКонтрагентыВзаиморасчетов.Контрагент.Наименование КАК НаименованиеКонтрагента,
	|	втКонтрагентыВзаиморасчетов.Контрагент,
	|	АктСверкиВзаиморасчетов.Дата,
	|	АктСверкиВзаиморасчетов.Номер,
	|	&ДатаНачала,
	|	&ДатаОкончания,
	|	АктСверкиВзаиморасчетов.Ссылка,
	|	втКонтрагентыВзаиморасчетов.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА АктСверкиВзаиморасчетов.Ссылка ЕСТЬ NULL
	|			ТОГДА 4
	|		ИНАЧЕ ВЫБОР
	|				КОГДА АктСверкиВзаиморасчетов.ПометкаУдаления
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ
	|	КОНЕЦ КАК Картинка,
	|	КонтактнаяИнформация.Представление КАК Email
	|ИЗ
	|	втУникальныеКонтрагенты КАК втУникальныеКонтрагенты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втКонтрагентыВзаиморасчетов КАК втКонтрагентыВзаиморасчетов
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктСверкиВзаиморасчетов КАК АктСверкиВзаиморасчетов
	|			ПО втКонтрагентыВзаиморасчетов.Контрагент = АктСверкиВзаиморасчетов.Контрагент
	|				И (АктСверкиВзаиморасчетов.ДатаНачала = &ДатаНачала)
	|				И (АктСверкиВзаиморасчетов.ДатаОкончания = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ))
	|				И (АктСверкиВзаиморасчетов.Организация = втКонтрагентыВзаиморасчетов.Организация)
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|			ПО втКонтрагентыВзаиморасчетов.Контрагент = КонтактнаяИнформация.Объект
	|				И (КонтактнаяИнформация.Тип = &ТипКонтакнойИнформации)
	//|				И (КонтактнаяИнформация.Вид = &ВидКонтакнойИнформации)
	|		ПО втУникальныеКонтрагенты.Ссылка = втКонтрагентыВзаиморасчетов.Контрагент
	|ГДЕ
	|	НЕ втКонтрагентыВзаиморасчетов.Контрагент.ИНН В (&СписокИсключаемыхИНН)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация,НаименованиеКонтрагента";
	
	Запрос.УстановитьПараметр("СписокИсключаемыхИНН", СписокИсключаемыхИНН);
	Запрос.УстановитьПараметр("ДатаНачала", Объект.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Объект.ДатаОкончания); 
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ТипКонтакнойИнформации", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	Запрос.УстановитьПараметр("ВидКонтакнойИнформации", Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Акт сверки"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Сообщить("Нет данных за выбранный период!");		
		Возврат;
	КонецЕсли;
	
	Объект.ДокументыАктыСверок.Загрузить(РезультатЗапроса.Выгрузить()); 
	
	// >>> Dexcel
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ЗаменитьПочтуИзНастроек();
	ЗначениеВРеквизитФормы(ОбработкаОбъект,"Объект");
	// <<< Dexcel 
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Элементы.СоответствиеИННКонтрагентИНН.ВыбиратьТип=Ложь;
	Элементы.СоответствиеИННКонтрагентИНН.ОграничениеТипа=Новый ОписаниеТипов("Строка");
	
	Объект.ДатаОкончания = НачалоКвартала(ТекущаяДата())-1;
	Объект.ДатаНачала = НачалоКвартала(Объект.ДатаОкончания);
	//Объект.Организация = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"),"ОсновнаяОрганизация");
	
	ВосстановитьНастройкиВФорме();
	// >>> Dexcel
	ИННКПП = "[ИННКПП]";
	ОрганизацияПараметр = "[Организация]";
	АктСверкиПараметр = "[АктСверки]";
	// <<< Dexcel
КонецПроцедуры

Процедура ВосстановитьНастройкиВФорме()
	ИмяОбъекта   			= "ОбработкаОбъект.СозданиеИОтправкаАктовСверок";
	НаименованиеНастройки 	= "Основная";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СохраненныеНастройки.СохраненнаяНастройка КАК ПараметрыВыгрузки 
	|ИЗ
	|	РегистрСведений.СохраненныеНастройки КАК СохраненныеНастройки
	|ГДЕ
	|	СохраненныеНастройки.ИмяОбъекта = &ИмяОбъекта
	|	И СохраненныеНастройки.НаименованиеНастройки = &НаименованиеНастройки";
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	Запрос.УстановитьПараметр("НаименованиеНастройки", НаименованиеНастройки);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		СохраненнаяНастройка = Результат.ПараметрыВыгрузки.Получить();	
	Иначе
		Возврат;
	КонецЕсли;
	
	Если СохраненнаяНастройка.Свойство("СоответствиеИННКонтрагент") Тогда
		Объект.СоответствиеИННКонтрагент.Загрузить(СохраненнаяНастройка.СоответствиеИННКонтрагент);
		ТабличнуюЧастьНастроекВТаблицуФормы();
	КонецЕсли;             
	
	
	Если СохраненнаяНастройка.Свойство("ПочтаДляОтправки") Тогда
		Объект.ПочтаДляОтправки = СохраненнаяНастройка.ПочтаДляОтправки;
	КонецЕсли;
	
	Если СохраненнаяНастройка.Свойство("СНачалаГода") Тогда
		Объект.СНачалаГода = СохраненнаяНастройка.СНачалаГода;
	КонецЕсли;
	
	Если СохраненнаяНастройка.Свойство("ОтборПоГруппамКонтрагентов") Тогда
		Объект.ОтборПоГруппамКонтрагентов = СохраненнаяНастройка.ОтборПоГруппамКонтрагентов;
	КонецЕсли;
	
	Если СохраненнаяНастройка.Свойство("ПечатнаяФорма") Тогда
		Объект.ПечатнаяФорма = СохраненнаяНастройка.ПечатнаяФорма;
	КонецЕсли;
	
	Если СохраненнаяНастройка.Свойство("Организация") Тогда
		Объект.Организация = СохраненнаяНастройка.Организация;
	КонецЕсли; 
	
	Если СохраненнаяНастройка.Свойство("ТекстПисьма") Тогда
		Объект.ТекстПисьма = СохраненнаяНастройка.ТекстПисьма;
	КонецЕсли;
	
	// >>> Dexcel
	Если СохраненнаяНастройка.Свойство("Тема") Тогда
		Объект.Тема = СохраненнаяНастройка.Тема;
	КонецЕсли;
	// <<< Dexcel
	
	Если Объект.ДатаНачала <> СохраненнаяНастройка.ДатаНачала 
		Или Объект.ДатаОкончания <> СохраненнаяНастройка.ДатаОкончания Тогда
		Возврат;
	КонецЕсли;
	
	//Если СохраненнаяНастройка.Свойство("ДокументыАктыСверок") Тогда
	//	Объект.ДокументыАктыСверок.Загрузить(СохраненнаяНастройка.ДокументыАктыСверок);
	//КонецЕсли;
	//Если СохраненнаяНастройка.Свойство("ДокументыАктыСверокГрупповые") Тогда
	//	Объект.ДокументыАктыСверокГрупповые.Загрузить(СохраненнаяНастройка.ДокументыАктыСверокГрупповые);
	//КонецЕсли;
	
КонецПроцедуры 


&НаКлиенте
Процедура СоздатьАкты(Команда)
	
	Если Не ПродолжитьНеобратимоеДействие() Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьАктыНаСервере();	
	
КонецПроцедуры

&НаКлиенте
Функция ПродолжитьНеобратимоеДействие()
	
	Ответ = Вопрос("Действие нельзя будет отменить! Продолжить?", РежимДиалогаВопрос.ДаНет);
	
	Возврат Ответ = КодВозвратаДиалога.Да;	
КонецФункции

Процедура СоздатьАктыНаСервере()
	
	РезультатЗапросаАктыСверок = ПолучитьРезультатЗапросаАктыСверок();	
	
	Выборка = РезультатЗапросаАктыСверок.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ОтборСтрок = Новый Структура;
		ОтборСтрок.Вставить("Контрагент", Выборка.Контрагент);
		ОтборСтрок.Вставить("Ссылка", Выборка.Ссылка);
		ОтборСтрок.Вставить("Дата", Выборка.Дата);
		ОтборСтрок.Вставить("Номер", Выборка.Номер);
		
		НайденныеСтроки = Объект.ДокументыАктыСверок.НайтиСтроки(ОтборСтрок); 
		
		Для Каждого Строка Из НайденныеСтроки Цикл
			Если Не ЗначениеЗаполнено(Выборка.НайденныйАкт) Тогда
				СоздатьАктСверки(Строка);				
			Иначе
				Сообщить("Для контрагента " + Выборка.Контрагент + " был найден более ранний документ " + Выборка.НайденныйАкт);	
			КонецЕсли;				
			ОтредактироватьСтрокуПослеСоздания(Строка);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры 

Функция ПолучитьРезультатЗапросаАктыСверок()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ * 
	|ПОМЕСТИТЬ втДокументыАктыСверок
	|ИЗ &Таблица КАК ДокументыАктыСверок";
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Таблица", Объект.ДокументыАктыСверок.Выгрузить());
	Запрос.Выполнить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	втДокументыАктыСверок.Номер,
	|	втДокументыАктыСверок.Дата,
	|	втДокументыАктыСверок.ДатаНачала,
	|	втДокументыАктыСверок.ДатаОкончания,
	|	втДокументыАктыСверок.Ссылка,
	|	втДокументыАктыСверок.Контрагент,
	|	втДокументыАктыСверок.Загрузить,
	|	втДокументыАктыСверок.Картинка,
	|	втДокументыАктыСверок.Организация,
	|	АктСверкиВзаиморасчетов.Ссылка КАК НайденныйАкт,
	|	КонтактнаяИнформация.Представление КАК Email
	|ИЗ
	|	втДокументыАктыСверок КАК втДокументыАктыСверок
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктСверкиВзаиморасчетов КАК АктСверкиВзаиморасчетов
	|		ПО втДокументыАктыСверок.ДатаНачала = АктСверкиВзаиморасчетов.ДатаНачала
	|			И втДокументыАктыСверок.ДатаОкончания = АктСверкиВзаиморасчетов.ДатаОкончания
	|			И втДокументыАктыСверок.Организация = АктСверкиВзаиморасчетов.Организация
	|			И втДокументыАктыСверок.Контрагент = АктСверкиВзаиморасчетов.Контрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ПО втДокументыАктыСверок.Контрагент = КонтактнаяИнформация.Объект
	|			И (КонтактнаяИнформация.Тип = &ТипКонтакнойИнформации)
	|			И (КонтактнаяИнформация.Вид = &ВидКонтакнойИнформации)
	|ГДЕ
	|	втДокументыАктыСверок.Загрузить";  
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ТипКонтакнойИнформации", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	Запрос.УстановитьПараметр("ВидКонтакнойИнформации", Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Акты сверки"));
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса; 
	
КонецФункции

Процедура ОтредактироватьСтрокуПослеСоздания(Строка)
	
	СсылкаНаДок = Строка.Ссылка;
	
	Если Не ЗначениеЗаполнено(СсылкаНаДок) Тогда
		Строка.Картинка = 4;
	Иначе		
		Если Строка.Ссылка.ПометкаУдаления Тогда
			Строка.Картинка = 1
		Иначе
			Строка.Картинка = 0;
		КонецЕсли;	
		
	КонецЕсли;	 
	
	ЗаполнитьЗначенияСвойств(Строка,СсылкаНаДок,"Номер, Дата");
	//
	//Строка.НекорректныйДокумент = ОбщегоНазначения_Dexcel.НекорректностьДокумента(СсылкаНаДок);
	//
	Если ТипЗнч(Строка.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Строка.Email = АдресЭлектроннойПочтыКонтрагента(Строка.Контрагент);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОтредактироватьСтрокуПослеСозданияНаКлиенте(Строка)
	
	СсылкаНаДок = Строка.Ссылка;
	
	Если Не ЗначениеЗаполнено(СсылкаНаДок) Тогда
		Строка.Картинка = 4;
	Иначе		
		Если Строка.Ссылка.ПометкаУдаления Тогда
			Строка.Картинка = 1
		Иначе
			Строка.Картинка = 0;
		КонецЕсли;	
		
	КонецЕсли;	 
	
	ЗаполнитьЗначенияСвойств(Строка,СсылкаНаДок,"Номер, Дата");
	//
	Строка.НекорректныйДокумент = ОбщегоНазначения_Dexcel.НекорректностьДокумента(СсылкаНаДок);
	//
	Если ТипЗнч(Строка.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Строка.Email = АдресЭлектроннойПочтыКонтрагента(Строка.Контрагент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция АдресЭлектроннойПочтыКонтрагента(Контрагент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Представление КАК Email
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект
	|	И КонтактнаяИнформация.Тип = &Тип
	|	И КонтактнаяИнформация.Вид = &Вид";
	
	Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Акты сверки"));
	Запрос.УстановитьПараметр("Объект", Контрагент);
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Email;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура СоздатьАктСверки(Строка)
	
	НовыйДокумент = Документы.АктСверкиВзаиморасчетов.СоздатьДокумент();
	ЗаполнитьНовыйДокумент(НовыйДокумент, Строка);
	
	Попытка
		НовыйДокумент.Записать(); 
		Строка.Ссылка = НовыйДокумент.Ссылка;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры  

