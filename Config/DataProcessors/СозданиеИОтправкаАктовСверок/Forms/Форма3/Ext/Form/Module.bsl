&НаКлиенте
Процедура ГрупповаяПечатьАктов(ИмяТаблицы)
	
	МассивТабДоков = Новый Массив;
	
	Для Каждого Строка Из Объект[ИмяТаблицы] Цикл
		Если Строка.Загрузить
			И ЗначениеЗаполнено(Строка.Ссылка) Тогда			
			
			МассивТабДоков.Добавить(Строка.Ссылка.ПолучитьОбъект().ПечатьАктаСверки());	
			
		КонецЕсли;		
	КонецЦикла;
	
	Если МассивТабДоков.Количество() = 0 Тогда
		Сообщить("Не удалось сформировать ни один документ");	
		Возврат;
	КонецЕсли;
	
	ТабДокГрупповой = Новый ТабличныйДокумент;
	ТабДокГрупповой.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_АктСверкиВзаиморасчетов_АктСверки";
	
	ИндексПоследнего = МассивТабДоков.Количество()-1;
	Для Сч = 0 По ИндексПоследнего Цикл
		ТабДокГрупповой.Вывести(МассивТабДоков[Сч]);
		Если ИндексПоследнего <> Сч Тогда
			ТабДокГрупповой.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
	КонецЦикла;
	
	НаПринтер = Ложь;     
	КоличествоЭкземпляров = 1;
	УниверсальныеМеханизмы.НапечататьДокумент(ТабДокГрупповой, КоличествоЭкземпляров, НаПринтер, , Неопределено);
	
	
КонецПроцедуры


