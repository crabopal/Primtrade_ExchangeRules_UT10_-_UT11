
&НаКлиенте
Процедура ОтборПоГруппамКонтрагентовЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПодборГруппКонтрагентов(Элемент);	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоГруппамКонтрагентовЗначениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		Для Каждого Группа Из ВыбранноеЗначение Цикл
			Если Объект.ОтборПоГруппамКонтрагентов.НайтиПоЗначению(Группа) = Неопределено Тогда
				Объект.ОтборПоГруппамКонтрагентов.Добавить(Группа, Группа.Наименование + " (" + Группа.Код+")");
				//Объект.ОтборПоГруппамКонтрагентов.Добавить(Группа, Группа.Код + " |" + Символы.Таб + Группа.Наименование); 
			КонецЕсли;
		КонецЦикла;			
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоГруппамКонтрагентовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	ПодборГруппКонтрагентов(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПодборГруппКонтрагентов(Элемент)
	Форма = ПолучитьФорму("Справочник.Контрагенты.ФормаВыбора",, Элемент, ЭтаФорма);
	Форма.ЗакрыватьПриВыборе			= Ложь;// ЗакрыватьПриВыборе;   
	Форма.ПараметрВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.Группы;
	Форма.МножественныйВыбор = Истина;
	Форма.Заголовок = "Подбор контрагентов:";
	Элементы.ОтборПоГруппамКонтрагентовКоманднаяПанель.ПодчиненныеЭлементы.Добавить.Доступность = Ложь;
	Форма.Открыть(); 
	
КонецПроцедуры


&НаКлиенте
Процедура ОтборПоГруппамКонтрагентовПриИзменении(Элемент)
	
	Пока Истина Цикл
		СтрокаСписка = Объект.ОтборПоГруппамКонтрагентов.НайтиПоЗначению(Неопределено);
		Если СтрокаСписка = Неопределено Тогда
			Прервать;
		Иначе
			Объект.ОтборПоГруппамКонтрагентов.Удалить(СтрокаСписка);
		КонецЕсли;
	КонецЦикла;
	ВладелецФормы.Объект.ОтборПоГруппамКонтрагентов = Объект.ОтборПоГруппамКонтрагентов.Скопировать();
	
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("ОтборПоГруппамКонтрагентов") Тогда
		Объект.ОтборПоГруппамКонтрагентов = Параметры.ОтборПоГруппамКонтрагентов.Скопировать();	
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ФормаВыбораКонтрагентовЗакрыта" Тогда
		Элементы.ОтборПоГруппамКонтрагентовКоманднаяПанель.ПодчиненныеЭлементы.Добавить.Доступность = Истина;		
	КонецЕсли;
	ОтборПоГруппамКонтрагентовПриИзменении(Неопределено);
КонецПроцедуры


&НаСервере
Процедура ПриЗакрытииНаСервере()
	а=1;
КонецПроцедуры


&НаКлиенте
Процедура ПриЗакрытии()
	ПриЗакрытииНаСервере();
КонецПроцедуры

