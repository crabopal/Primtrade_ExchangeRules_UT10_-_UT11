&НаСервере
Процедура ВыполнитьЗаменуEmail()

	НачатьТранзакцию();
	
	Результат = Новый ТаблицаЗначений;
	
	Схема = Элементы.СписокКонтрагенты.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки = Элементы.СписокКонтрагенты.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = Компоновщик.Выполнить(Схема, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	ПроцессровВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Результат = ПроцессровВывода.Вывести(ПроцессорКомпоновки);
	
	Для каждого Строка Из Результат Цикл
	
		МенеджерЗаписи = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Объект = Строка.Контрагент;
		МенеджерЗаписи.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		МенеджерЗаписи.Вид = Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Акты сверки");
		МенеджерЗаписи.Представление = НовыйEmail;
		
		Попытка
			МенеджерЗаписи.Записать();	
			Строка.Email = НовыйEmail;
		Исключение
			ОтменитьТранзакцию();
			Сообщить(ОписаниеОшибки());
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СписокКонтрагенты.КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.Полное);
	СписокКонтрагенты.КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
	//СписокКонтрагенты.КомпоновщикНастроек.Настройки.
	СписокКонтрагентов = Параметры.СписокКонтрагентов;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокКонтрагенты,"Контрагент",СписокКонтрагентов,ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии,,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокКонтрагенты, "ВидКИ", Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Акты сверки"));
	//ОбщегоНазначенияКлиентСервер.Установить
КонецПроцедуры

&НаКлиенте
Процедура СписокКонтрагентыОтборПравоеЗначениеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СписокКонтрагентыОтбор.ТекущиеДанные;
	ПустоеЗначениеВСписке = ТекущиеДанные.ПравоеЗначение.НайтиПоЗначению(ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"));
	Если ПустоеЗначениеВСписке <> Неопределено ТОгда
		ТекущиеДанные.ПравоеЗначение.Удалить(ПустоеЗначениеВСписке);
	КонецЕсли;
		
	
КонецПроцедуры



