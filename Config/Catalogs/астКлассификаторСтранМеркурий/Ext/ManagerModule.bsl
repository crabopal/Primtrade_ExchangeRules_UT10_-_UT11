
Функция ПолучитьШаблонНомераАвтоПоМаске(МаскаНомера, ШаблонБукв) Экспорт
	
	Если НЕ ЗначениеЗаполнено(МаскаНомера) Тогда
		Возврат "";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ШаблонБукв) Тогда	
		ШаблонБукв = "A-Z";
	КонецЕсли;
	ШаблонБукв = СокрЛП(ШаблонБукв);
	
	// преобразуем доп символы с шаблон
	МассивСимволов = Новый Массив;
	МассивСимволов.Добавить("0");
	МассивСимволов.Добавить("Х");
	МассивСимволов.Добавить("X");
	МассивСимволов.Добавить("(");
	МассивСимволов.Добавить(")");
	
	ПреобразованнаяСтрока = "";
	Для х = 1 По СтрДлина(МаскаНомера) Цикл
		Символ = Сред(МаскаНомера, х, 1);
		Поиск = МассивСимволов.Найти(Символ);
		Если Поиск = Неопределено Тогда
			Если Символ = "-" Тогда // экранируем
				ПреобразованнаяСтрока = ПреобразованнаяСтрока + "\" + Символ + "";
			Иначе	
				ПреобразованнаяСтрока = ПреобразованнаяСтрока + "[" + Символ + "]";
			КонецЕсли;	
		Иначе
			ПреобразованнаяСтрока = ПреобразованнаяСтрока + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Шаблон = ПреобразованнаяСтрока;
	Шаблон = СтрЗаменить(Шаблон, "(0)", "\d{1,1}");
	Шаблон = СтрЗаменить(Шаблон, "0", "\d");
	Шаблон = СтрЗаменить(Шаблон, "{1,1}", "{0,1}");
	Шаблон = СтрЗаменить(Шаблон, "(Х)", "[" + ШаблонБукв + "]{0,1}");
	Шаблон = СтрЗаменить(Шаблон, "(X)", "[" + ШаблонБукв + "]{0,1}");
	Шаблон = СтрЗаменить(Шаблон, "Х", "[" + ШаблонБукв + "]");
	Шаблон = СтрЗаменить(Шаблон, "X", "[" + ШаблонБукв + "]");
	
	// сгруппируем символы
	ИсхСтрокаЦифры = "";
	ИсхСтрокаБуквы = "";
	
	РазмерЦикла = 10;
	Для х = 1 По РазмерЦикла Цикл
		ИсхСтрокаЦифры = ИсхСтрокаЦифры + "\d";	
		ИсхСтрокаБуквы = ИсхСтрокаБуквы + "[" + ШаблонБукв + "]";
	КонецЦикла;	
	ИсхСтрокаЦифры = ИсхСтрокаЦифры + "{0,1}";
	ИсхСтрокаБуквы = ИсхСтрокаБуквы + "{0,1}";
	
	РазмерПериода = СтрДлина("{0,1}");
	РазмерЦифры = 2;
	РазмерБуквы = СтрДлина("[" + ШаблонБукв + "]");
	
	х = 10;
	Пока х > 1 Цикл // сначала заменим строку с диапазоном
		СтрокаСимволов = Прав(ИсхСтрокаЦифры, х*РазмерЦифры + РазмерПериода);
		Шаблон = СтрЗаменить(Шаблон, СтрокаСимволов, "\d{" + (х - 1) + "," + х + "}");					
		
		СтрокаСимволов = Прав(ИсхСтрокаБуквы, х*РазмерБуквы + РазмерПериода);
		Шаблон = СтрЗаменить(Шаблон, СтрокаСимволов, "[" + ШаблонБукв + "]{" + (х - 1) + "," + х + "}");					
		х = х - 1;
	КонецЦикла;	
	
	х = 10;
	Пока х > 1 Цикл // заменив оставшиеся цифры
		СтрокаСимволов = Лев(ИсхСтрокаЦифры, х*РазмерЦифры);
		Шаблон = СтрЗаменить(Шаблон, СтрокаСимволов, "\d{" + х + "}");	
		
		СтрокаСимволов = Лев(ИсхСтрокаБуквы, х*РазмерБуквы);
		Шаблон = СтрЗаменить(Шаблон, СтрокаСимволов, "[" + ШаблонБукв + "]{" + х + "}");
		х = х - 1;
	КонецЦикла;	
	
	Возврат Шаблон;

КонецФункции
