
#Если Клиент Тогда
	
Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторХС = СокрЛП(ИдентификаторХС);
	
	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Наименование = ИдентификаторХС;	
	КонецЕсли;	
	
	Если НЕ ЭтоТестовыйКонтур Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	астНастройкиМеркурий.Ссылка
		|ИЗ
		|	Справочник.астНастройкиМеркурий КАК астНастройкиМеркурий
		|ГДЕ
		|	астНастройкиМеркурий.ИдентификаторХС = &ИдентификаторХС
		|	И НЕ астНастройкиМеркурий.ИдентификаторХС = """"
		|	И НЕ астНастройкиМеркурий.Ссылка = &Ссылка
		|	И НЕ астНастройкиМеркурий.ЭтоТестовыйКонтур";
		
		Запрос.УстановитьПараметр("ИдентификаторХС", СокрЛП(ИдентификаторХС));
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();	
		
		Если Выборка.Следующий() Тогда
			Предупреждение("Уже создана рабочая настройка с указанным идентификатором хоз. субъекта [" + ИдентификаторХС + "]: " + Выборка.Ссылка, 30);
			Отказ = Истина;
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли	

Процедура ПередУдалением(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Отказ = астОбщегоНазначенияМеркурий.ОбработкаУдаленияОбъектов(ЭтотОбъект);

КонецПроцедуры
